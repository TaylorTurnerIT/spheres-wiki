# Multistage Dockerfile for Playwright e2e testing of the spheres-wiki static site.
#
# Usage:
#   docker build -f Dockerfile.e2e -t spheres-wiki-e2e .
#   docker run --rm spheres-wiki-e2e
#
# For local iteration (faster — reuse host-built dist/):
#   npm run build
#   docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit

# ── Stage 1: Build the Astro static site ──────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

# ── Stage 2: Run Playwright tests ─────────────────────────────────────────
FROM mcr.microsoft.com/playwright:v1.60.0-noble
WORKDIR /app

# Install serve (static file server)
RUN npm install -g serve@14

# Copy test artifacts from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/playwright.config.ts ./
COPY --from=builder /app/tests/e2e ./tests/e2e

# Playwright browsers are pre-installed in the base image.
# Install only npm packages needed for test execution.
RUN npm install @playwright/test

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD npx playwright test --list 2>/dev/null || exit 1

CMD ["sh", "-c", "npx serve dist -l 4321 & sleep 3 && ./node_modules/.bin/playwright test"]
