{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Review major upgrades in the dashboard before creating branches.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep related Astro packages together for non-major updates.",
      "matchPackageNames": ["astro", "@astrojs/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Astro non-major dependencies"
    },
    {
      "matchPackageNames": ["@fontsource/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Fontsource non-major dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "groupName": "GitHub Actions non-major updates"
    }
  ]
}
