{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    "src/pages/**/*.astro",
    "src/pages/**/*.ts",
    "src/components/TabbedContent.astro",
    "scripts/catalog.mjs",
    "scripts/check-feat-category-tags.mjs",
    "scripts/check-feat-category-membership.mjs",
    "scripts/validate-tags.mjs",
    "scripts/repair-feat-category-membership.mjs",
    "scripts/generate-bestial-traits.mjs",
    "scripts/parse-wiki.test.mjs",
    "scripts/check-idioms.mjs",
    "scripts/check-links.mjs",
    "scripts/check-identity-collisions.mjs",
    "scripts/check-content-routes.mjs",
    "scripts/check-performance.mjs",
    "scripts/purge-dead-links.mjs",
    "scripts/purge-tag-colors.mjs",
    "scripts/validate-v2.mjs"
  ],
  "ignoreDependencies": [
    "lightningcss",
    "@astrojs/sitemap",
    "@astrojs/compiler-rs"
  ],
  "duplicates": {
    "minOccurrences": 3
  }
}
