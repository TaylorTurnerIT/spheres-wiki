---
import Base from './Base.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Sidebar from '@/components/Sidebar.astro';
import TabNav from '@/components/TabNav.astro';
import BetaToast from '@/components/BetaToast.astro';
import SiteFooter from '@/components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  activeNamespace?: string;
  pagefindIgnore?: boolean;
}

const {
  title,
  description,
  activeNamespace,
  pagefindIgnore = false,
} = Astro.props;
---
<Base title={title} description={description}>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <SiteHeader />
  <BetaToast />

  <div class="layout">
    <Sidebar />

    <main class="main" id="main-content" tabindex="-1">
      <TabNav />
      <div
        class="content-area"
        data-system={activeNamespace}
        data-pagefind-body={pagefindIgnore ? undefined : true}
        data-pagefind-ignore={pagefindIgnore ? true : undefined}
      >
        <slot />
      </div>
    </main>

  </div>
  <SiteFooter />
</Base>

<script>
import { setSidebarSemantics } from '@/lib/sidebarSemantics';

const FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

let cleanupSidebarPage = () => {};

function trapFocus(sidebar: HTMLElement, e: KeyboardEvent) {
  const focusable = [...sidebar.querySelectorAll<HTMLElement>(FOCUSABLE)];
  if (focusable.length === 0) return;
  const first = focusable[0];
  const last  = focusable[focusable.length - 1];
  if (e.shiftKey) {
    if (document.activeElement === first) { e.preventDefault(); last.focus(); }
  } else {
    if (document.activeElement === last) { e.preventDefault(); first.focus(); }
  }
}

document.addEventListener('astro:before-swap', () => {
  cleanupSidebarPage();
  cleanupSidebarPage = () => {};
});

document.addEventListener('astro:page-load', () => {
  cleanupSidebarPage();
  const toggle  = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('site-sidebar') as HTMLElement | null;
  const close   = document.getElementById('sidebar-close');
  if (!sidebar) return;
  const sidebarEl = sidebar;

  const controller = new AbortController();
  const media = window.matchMedia('(max-width: 1024px)');
  let wasOpen = false;
  let restoreFocus: HTMLElement | null = null;

  function syncSemantics() {
    const mobile = media.matches;
    if (!mobile && wasOpen) {
      closeSidebar(false);
      wasOpen = false;
    }
    setSidebarSemantics(sidebarEl, mobile, wasOpen);
  }

  function openSidebar() {
    if (!media.matches) return;
    restoreFocus = document.activeElement instanceof HTMLElement ? document.activeElement : toggle;
    wasOpen = true;
    sidebarEl.classList.add('open');
    setSidebarSemantics(sidebarEl, true, true);
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // Move focus to first focusable element inside
    const first = sidebarEl.querySelector<HTMLElement>(FOCUSABLE);
    first?.focus();
  }

  function closeSidebar(returnFocus = true) {
    wasOpen = false;
    sidebarEl.classList.remove('open');
    setSidebarSemantics(sidebarEl, media.matches, false);
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (returnFocus) (restoreFocus ?? toggle)?.focus();
    restoreFocus = null;
  }

  function handleKey(e: KeyboardEvent) {
    if (e.key === 'Escape') { closeSidebar(); return; }
    if (e.key === 'Tab' && wasOpen) trapFocus(sidebarEl, e);
  }

  toggle?.setAttribute('aria-controls', 'site-sidebar');
  toggle?.addEventListener('click', openSidebar, { signal: controller.signal });
  close?.addEventListener('click', () => closeSidebar(), { signal: controller.signal });
  sidebarEl.addEventListener('keydown', handleKey, { signal: controller.signal });
  sidebarEl.addEventListener('click', e => {
    if (e.target === sidebarEl) closeSidebar();
  }, { signal: controller.signal });
  media.addEventListener('change', syncSemantics, { signal: controller.signal });
  syncSemantics();

  cleanupSidebarPage = () => {
    controller.abort();
    closeSidebar(false);
  };
});
</script>
