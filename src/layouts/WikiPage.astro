---
import Base from './Base.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Sidebar from '@/components/Sidebar.astro';
import TabNav from '@/components/TabNav.astro';
import BetaToast from '@/components/BetaToast.astro';

interface Props {
  title?: string;
  description?: string;
  activeNamespace?: string;
}

const { title, description, activeNamespace } = Astro.props;
---
<Base title={title} description={description}>
  <SiteHeader />
  <BetaToast />

  <div class="layout">
    <Sidebar />

    <main class="main">
      <TabNav />
      <div class="content-area" data-system={activeNamespace} data-pagefind-body>
        <slot />
      </div>
    </main>
  </div>
</Base>

<script>
  const toggle = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('site-sidebar');
  const close   = document.getElementById('sidebar-close');

  function openSidebar() {
    sidebar?.classList.add('open');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeSidebar() {
    sidebar?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', openSidebar);
  close?.addEventListener('click', closeSidebar);
  sidebar?.addEventListener('click', e => {
    if (e.target === sidebar) closeSidebar();
  });

  document.addEventListener('astro:page-load', closeSidebar);
</script>
