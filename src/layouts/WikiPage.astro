---
import Base from './Base.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Sidebar from '@/components/Sidebar.astro';
import TabNav from '@/components/TabNav.astro';
import BetaToast from '@/components/BetaToast.astro';
import SiteFooter from '@/components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  activeNamespace?: string;
  pagefindIgnore?: boolean;
}

const {
  title,
  description,
  activeNamespace,
  pagefindIgnore = false,
} = Astro.props;
---
<Base title={title} description={description}>
  <a href="#main-content" class="skip-link">Skip to content</a>
  <SiteHeader />
  <BetaToast />

  <div class="layout">
    <Sidebar />

    <main class="main" id="main-content">
      <TabNav />
      <div
        class="content-area"
        data-system={activeNamespace}
        data-pagefind-body={pagefindIgnore ? undefined : true}
        data-pagefind-ignore={pagefindIgnore ? true : undefined}
      >
        <slot />
      </div>
    </main>

  </div>
  <SiteFooter />
</Base>

<script>
const FOCUSABLE = 'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

function trapFocus(sidebar: HTMLElement, e: KeyboardEvent) {
  const focusable = [...sidebar.querySelectorAll<HTMLElement>(FOCUSABLE)];
  if (focusable.length === 0) return;
  const first = focusable[0];
  const last  = focusable[focusable.length - 1];
  if (e.shiftKey) {
    if (document.activeElement === first) { e.preventDefault(); last.focus(); }
  } else {
    if (document.activeElement === last) { e.preventDefault(); first.focus(); }
  }
}

document.addEventListener('astro:page-load', () => {
  const toggle  = document.getElementById('sidebar-toggle');
  const sidebar = document.getElementById('site-sidebar') as HTMLElement | null;
  const close   = document.getElementById('sidebar-close');

  function openSidebar() {
    if (!sidebar) return;
    sidebar.classList.add('open');
    sidebar.removeAttribute('aria-hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // Move focus to first focusable element inside
    const first = sidebar.querySelector<HTMLElement>(FOCUSABLE);
    first?.focus();
    sidebar.addEventListener('keydown', handleKey);
  }

  function closeSidebar() {
    if (!sidebar) return;
    sidebar.classList.remove('open');
    sidebar.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    sidebar.removeEventListener('keydown', handleKey);
    toggle?.focus();
  }

  function handleKey(e: KeyboardEvent) {
    if (e.key === 'Escape') { closeSidebar(); return; }
    if (e.key === 'Tab' && sidebar) trapFocus(sidebar, e);
  }

  toggle?.addEventListener('click', openSidebar);
  close?.addEventListener('click', closeSidebar);
  sidebar?.addEventListener('click', e => {
    if (e.target === sidebar) closeSidebar();
  });
});
</script>
