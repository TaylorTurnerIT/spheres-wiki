---
import { url } from "@/lib/url";
import WikiPage from "@/layouts/WikiPage.astro";
import BookCard from "@/components/BookCard.astro";
import ArticleTOC from "@/components/ArticleTOC.astro";
import { SYSTEMS } from "@/config/site";
import { buildTocTree, type RenderedHeading } from "@/lib/articleToc";
import type { ArticleEntry, BookMeta } from "@/lib/types";

interface Props {
  article: ArticleEntry;
  book?: BookMeta;
  description?: string;
  headings?: RenderedHeading[];
  showToc?: boolean;
}

const {
  article,
  book,
  description,
  headings = [],
  showToc = true,
} = Astro.props;

// Determine system for color-coding
const sys = article.system || "power";
const sysLabel = SYSTEMS[sys as keyof typeof SYSTEMS]?.label || "Power";

const tocItems = showToc ? buildTocTree(headings) : [];
---

<WikiPage title={article.name} description={description} activeNamespace={sys}>
  <div class="article-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={url("/")}>Home</a>
      <span class="sep">/</span>
      <a href={url(`/${sys}/`)}>{sysLabel}</a>
      <span class="sep">/</span>
      <span class="current">{article.name}</span>
    </nav>

    <h1 class="page-title">{article.name}</h1>
  </div>

  <span data-pagefind-meta="type:guide" hidden></span>
  {sys && <span data-pagefind-meta={`system:${sysLabel}`} hidden></span>}
  <hr class="page-title-rule" />

  <div class="article-content entry-description">
    <slot name="before-content" />

    <div class="article-layout">
      <div class="content-body">
        <slot />
      </div>

      {(book || Astro.slots.has('sidebar') || tocItems.length >= 2) && (
        <aside class="article-sidebar" id="article-sidebar">
          {tocItems.length >= 2 && <ArticleTOC items={tocItems} system={sys} />}
          <slot name="sidebar" />
          {book && <BookCard book={book} />}
        </aside>
      )}
    </div>
  </div>
</WikiPage>

<style is:global>
  .article-layout {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    margin-top: 1.5rem;
  }

  .article-content .content-body {
    flex: 1;
    min-width: 0;
  }

  .article-content .article-sidebar {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: 1rem;
  }

  @media (max-width: 1000px) {
    .article-layout {
      flex-direction: column;
    }
    .article-content .article-sidebar {
      width: 100%;
      position: static;
    }
  }

  /* ── Article prose headers ───────────────────────────────── */
  .article-content .content-body > h1,
  .article-content .content-body > h2,
  .article-content .tab-panel > h1,
  .article-content .tab-panel > h2 {
    border-bottom: 1px solid var(--clr-border);
    padding-bottom: 0.35rem;
  }

  .article-content .content-body > h1:first-child,
  .article-content .content-body > h2:first-child,
  .article-content .tab-panel > h1:first-child,
  .article-content .tab-panel > h2:first-child {
    margin-top: 0;
  }

  /* ── Note boxes ──────────────────────────────────────────── */
  .article-content blockquote,
  .article-content .wiki-note {
    background: color-mix(in srgb, var(--clr-active) 8%, transparent);
    border-left: 3px solid var(--clr-active);
    border-radius: 0 4px 4px 0;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    font-size: var(--fs-sm);
  }

  .article-content blockquote > :first-child,
  .article-content .wiki-note > :first-child {
    margin-top: 0;
  }

  .article-content blockquote > :last-child,
  .article-content .wiki-note p:last-child {
    margin-bottom: 0;
  }

  .article-content blockquote h1,
  .article-content blockquote h2,
  .article-content blockquote h3,
  .article-content blockquote h4 {
    border-bottom: 0;
    padding-bottom: 0;
  }
</style>
