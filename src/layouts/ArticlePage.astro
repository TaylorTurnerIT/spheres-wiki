---
import { url } from "@/lib/url";
import WikiPage from "@/layouts/WikiPage.astro";
import BookCard from "@/components/BookCard.astro";
import ArticleTOC from "@/components/ArticleTOC.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PagefindMetadata from "@/components/PagefindMetadata.astro";
import { SYSTEMS } from "@/config/site";
import { buildTocTree, type RenderedHeading } from "@/lib/articleToc";
import type { ArticleEntry, BookMeta } from "@/lib/types";

interface Props {
  article: ArticleEntry;
  book?: BookMeta;
  description?: string;
  headings?: RenderedHeading[];
  showToc?: boolean;
}

const {
  article,
  book,
  description,
  headings = [],
  showToc = true,
} = Astro.props;

// Articles outside a system should remain top-level pages.
const sys = article.system;
const sysLabel = sys ? SYSTEMS[sys as keyof typeof SYSTEMS]?.label : undefined;

const tocItems = showToc ? buildTocTree(headings) : [];
---

<WikiPage title={article.name} description={description} activeNamespace={sys}>
  <div class="article-header">
    <Breadcrumb
      crumbs={[
        { label: "Home", href: url("/") },
        ...(sys && sysLabel ? [{ label: sysLabel, href: url(`/${sys}/`) }] : []),
        { label: article.name },
      ]}
      separator="/"
      separatorClass="sep"
      currentClass="current"
      prefetch={false}
    />

    <h1 class="page-title">{article.name}</h1>
  </div>

  <PagefindMetadata meta={{ type: "article", ...(sysLabel ? { system: sysLabel } : {}) }} />
  <hr class="page-title-rule" />

  <div class="article-content entry-description">
    <slot name="before-content" />

    <div class="article-layout">
      <div class="content-body">
        <slot />
      </div>

      {(book || Astro.slots.has('sidebar') || tocItems.length >= 2) && (
        <aside class="article-sidebar" id="article-sidebar">
          {tocItems.length >= 2 && <ArticleTOC items={tocItems} system={sys} />}
          <slot name="sidebar" />
          {book && <BookCard book={book} />}
        </aside>
      )}
    </div>
  </div>
</WikiPage>

<script>
  // Must load here (not in ArticleTOC.astro) because ArticleTOC can be rendered
  // inside <template> tags by TabbedContent, where scripts are inert.
  import '@/lib/articleTocClient';
</script>
