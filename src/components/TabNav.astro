---
import { url } from "@/lib/url";
import { SYSTEMS } from '@/config/site';

const pathname = Astro.url.pathname;

function currentTab(): string {
  const match = Object.entries(SYSTEMS).find(([, sys]) => pathname.startsWith(url(sys.route)));
  if (match) return match[0];
  if (pathname.startsWith(url('/store'))) return 'store';
  return 'home';
}

const active = currentTab();

const tabs = [
  { slug: 'home',  label: 'Home',  href: url('/'),      cls: '' },
  ...Object.entries(SYSTEMS).map(([id, sys]) => ({
    slug: id,
    label: sys.label,
    href: url(sys.route),
    cls: sys.cssKey,
  })),
  { slug: 'store', label: 'Store', href: url('/store/'), cls: '' },
];
---
<nav class="tab-nav" aria-label="System navigation">
  {tabs.map(tab => (
    <a
      href={tab.href}
      class:list={['tab', tab.cls, { active: active === tab.slug }]}
      data-astro-prefetch="hover"
      aria-current={active === tab.slug ? 'page' : undefined}
    >
      {tab.label}
    </a>
  ))}
</nav>
