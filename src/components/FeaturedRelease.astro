---
import type { BookMeta } from '@/lib/types';
import BookCard from './BookCard.astro';

interface Props {
  book: BookMeta;
}

const { book } = Astro.props;
---
<div class="shop-widget">
  <div class="shop-widget-label">Latest Release</div>
  <div class="featured-book-container">
    <BookCard book={book} />
  </div>
  <div class="shop-platform">via DriveThruRPG</div>
</div>

<style>
  .featured-book-container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  
  /* Remove BookCard's own border and background when featured on home page */
  .featured-book-container :global(.store-card) {
    border: none;
    background: transparent;
    padding: 10px;
    flex: 1;
    width: 100%;
    transform: none !important;
  }

  .featured-book-container :global(.store-card:hover) {
    transform: none !important;
  }

  .shop-platform {
    font-size: var(--fs-3xs);
    color: var(--clr-muted);
    text-align: center;
    padding: 4px 8px 8px;
    font-style: italic;
    border-top: 0.5px solid var(--clr-border);
  }
</style>
