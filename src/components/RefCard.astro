---
import { url } from "@/lib/url";
import { SYSTEMS, SYSTEM_DEFAULT } from '@/config/site';
import type { SphereEntry, ClassEntry } from '@/lib/types';

interface Props {
  system: string;
  spheres: SphereEntry[];
  classes: ClassEntry[];
}

const { system, spheres, classes } = Astro.props;

const sys = SYSTEMS[system];
const nsClass = sys?.cssKey ?? SYSTEM_DEFAULT.cssKey;
const cfg = sys
  ? { title: sys.label, subtitle: sys.subtitle, classLabel: sys.classLabel,
      buildText: sys.buildText, buildHref: sys.buildHref, nsRoute: system }
  : { title: system, subtitle: '', classLabel: 'Classes',
      buildText: 'Browse →', buildHref: `/${system}/`, nsRoute: system };

const isChampions = system === 'champions';
---
<div class:list={['ref-card', nsClass]}>
  <div class="ref-card-header">
    <span class="ref-card-title">{cfg.title}</span>
    <span class="ref-card-subtitle">{cfg.subtitle}</span>
  </div>
  <div class="ref-card-body">
    <div class="ref-card-lists">

      {isChampions ? (
        <div class:list={['sphere-list', 'single', `${nsClass}-list`]}>
          {classes.map(cls => (
            <a href={url(`/${cfg.nsRoute}/classes/${cls.id}/`)} class={nsClass} data-astro-prefetch="hover">
              <svg class="si" aria-hidden="true"><use href="#si-champ-star"/></svg>{cls.name}
            </a>
          ))}
        </div>
      ) : (
        <>
          <div class:list={['sphere-list', `${nsClass}-list`]}>
            {spheres.map(s => (
              <a href={url(`/${cfg.nsRoute}/${s.id}/`)} class={nsClass} data-astro-prefetch="hover">
                <svg class="si" aria-hidden="true"><use href={`#si-${s.icon}`}/></svg>{s.name}
              </a>
            ))}
          </div>
          {classes.length > 0 && (
            <div class="ref-subsection">
              <div class="ref-subsection-label">{cfg.classLabel}</div>
              <div class="sphere-list">
                {classes.map(cls => (
                  <a href={url(`/${cfg.nsRoute}/classes/${cls.id}/`)} class={nsClass} data-astro-prefetch="hover">{cls.name}</a>
                ))}
              </div>
              <a href={url(cfg.buildHref)} class:list={['build-link', nsClass]} data-astro-prefetch="hover">
                {cfg.buildText}
              </a>
            </div>
          )}
        </>
      )}

    </div>

    <div class="ref-card-cta">
      <a href={url(`/${cfg.nsRoute}/`)} class:list={['ref-card-btn', nsClass]} data-astro-prefetch="hover">
        Browse All →
      </a>
    </div>
  </div>
</div>
