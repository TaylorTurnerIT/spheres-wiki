---
import { url } from "@/lib/url";
import type { SphereEntry, ClassEntry } from '@/lib/types';

interface Props {
  system: string;
  spheres: SphereEntry[];
  classes: ClassEntry[];
}

const { system, spheres, classes } = Astro.props;

const nsClass = system === 'champions' ? 'champ' : system;

type NsConfig = {
  title: string;
  subtitle: string;
  classLabel: string;
  buildText: string;
  buildHref: string;
  nsRoute: string;
};

const nsConfigs: Record<string, NsConfig> = {
  power:     { title: 'Spheres of Power',  subtitle: 'Magic Spheres',   classLabel: 'Spherecaster Classes', buildText: 'How to Build a Spherecaster →', buildHref: '/power/', nsRoute: 'power' },
  might:     { title: 'Spheres of Might',  subtitle: 'Combat Spheres',  classLabel: 'Practitioner Classes', buildText: 'How to Build a Practitioner →', buildHref: '/might/', nsRoute: 'might' },
  guile:     { title: 'Spheres of Guile',  subtitle: 'Skill Spheres',   classLabel: 'Operative Classes',    buildText: 'How to Build an Operative →',   buildHref: '/guile/', nsRoute: 'guile' },
  champions: { title: 'Champions',         subtitle: 'Multi-system',    classLabel: 'Champion Classes',     buildText: 'How to Build a Champion →',     buildHref: '/champions/',        nsRoute: 'champions'        },
};

const cfg: NsConfig = nsConfigs[system] ?? {
  title: system, subtitle: '', classLabel: 'Classes',
  buildText: 'Browse →', buildHref: `/${system}/`, nsRoute: system,
};

// For champions: show classes in the main list (no spheres). For others: spheres first, classes in subsection.
const isChampions = system === 'champions';
---
<div class:list={['ref-card', nsClass]}>
  <div class="ref-card-header">
    <span class="ref-card-title">{cfg.title}</span>
    <span class="ref-card-subtitle">{cfg.subtitle}</span>
  </div>
  <div class="ref-card-body">
    <div class="ref-card-lists">

      {isChampions ? (
        <div class:list={['sphere-list', 'single', `${nsClass}-list`]}>
          {classes.map(cls => (
            <a href={url(`/${cfg.nsRoute}/classes/${cls.id}/`)} class={nsClass} data-astro-prefetch="hover">
              <svg class="si"><use href="#si-champ-star"/></svg>{cls.name}
            </a>
          ))}
        </div>
      ) : (
        <>
          <div class:list={['sphere-list', `${nsClass}-list`]}>
            {spheres.map(s => (
              <a href={url(`/${cfg.nsRoute}/${s.id}/`)} class={nsClass} data-astro-prefetch="hover">
                <svg class="si"><use href={`#si-${s.icon}`}/></svg>{s.name}
              </a>
            ))}
          </div>
          {classes.length > 0 && (
            <div class="ref-subsection">
              <div class="ref-subsection-label">{cfg.classLabel}</div>
              <div class="sphere-list">
                {classes.map(cls => (
                  <a href={url(`/${cfg.nsRoute}/classes/${cls.id}/`)} class={nsClass} data-astro-prefetch="hover">{cls.name}</a>
                ))}
              </div>
              <a href={url(cfg.buildHref)} class:list={['build-link', nsClass]} data-astro-prefetch="hover">
                {cfg.buildText}
              </a>
            </div>
          )}
        </>
      )}

    </div>

    <div class="ref-card-cta">
      <a href={url(`/${cfg.nsRoute}/`)} class:list={['ref-card-btn', nsClass]} data-astro-prefetch="hover">
        Browse All →
      </a>
    </div>
  </div>
</div>
