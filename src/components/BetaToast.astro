---
// localStorage: 'beta-toast-dismissed' = 'true' — persists until browser data cleared; user-removable via browser dev tools (Application → Storage → Clear site data)
// sessionStorage: 'beta-toast-dismissed-animated' = 'true' — cleared on tab/session close
import Toast from './Toast.astro';
---

<Toast
  id="beta-toast"
  title="BETA VERSION"
  storageKey="beta-toast-dismissed"
  bottom="170px"
>
  Some content and functionality may be incomplete.
  Report issues or discuss changes on
  <a href="https://github.com/TaylorTurnerIT/spheres-wiki" target="_blank" rel="noopener noreferrer">GitHub</a>.
</Toast>
