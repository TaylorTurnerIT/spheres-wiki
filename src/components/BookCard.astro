---
import { Image } from 'astro:assets';
import type { BookMeta } from '@/lib/types';

interface Props {
  book: BookMeta;
  /** Unreleased book: renders a dimmed, non-link card with a "Coming Soon" cover */
  comingSoon?: boolean;
}

const { book, comingSoon = false } = Astro.props;
const CardTag = book.buyUrl && !comingSoon ? 'a' : 'div';
const cardProps = book.buyUrl && !comingSoon
  ? { href: book.buyUrl, target: "_blank", rel: "noopener noreferrer", class: "store-card is-link", "aria-label": `${book.title} — buy on DriveThruRPG (opens in new tab)` }
  : { class: `store-card${comingSoon ? ' coming-soon-card' : ''}` };

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/covers/*.{jpeg,jpg,png,gif,webp}');
let coverImg;
if (book.coverImage) {
  const imagePath = `/src/assets/covers/${book.coverImage}`;
  if (images[imagePath]) {
    coverImg = (await images[imagePath]()).default;
  }
}
---
<CardTag {...cardProps}>
  {comingSoon
    ? <div class="store-card-cover-placeholder"><span>Coming Soon</span></div>
    : coverImg
      ? <Image src={coverImg} alt={book.title} class="store-card-cover" loading="lazy" />
      : <div class="store-card-cover-placeholder" aria-hidden="true"></div>
  }
  <div class="store-title">{book.title}</div>
  <div class="store-publisher">{book.publisher}</div>
  {book.price && !comingSoon && (
    <div class="store-buy">
      <span class="store-price">{book.price}</span>
      <div class="shop-btn">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 2h2l2.5 8h6l1.5-5H6.5"/>
          <circle cx="8.5" cy="12.5" r="1.2" fill="currentColor" stroke="none"/>
          <circle cx="12" cy="12.5" r="1.2" fill="currentColor" stroke="none"/>
        </svg>
        Buy
      </div>
    </div>
  )}
</CardTag>

<style>
  .coming-soon-card {
    opacity: 0.6;
    cursor: default;
    box-shadow: none !important;
    transform: none !important;
  }
  .coming-soon-card .store-card-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-muted);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
