---
/**
 * ContactCard — icon + heading + description + action block used by the
 * contact page. icon="discord" renders the shared si-discord sprite with
 * its service color; icon="info" renders the muted info circle used by
 * the note variant.
 */
interface Props {
  heading: string;
  icon?: "discord" | "info";
}

const { heading, icon = "info" } = Astro.props;
const isNote = icon === "info";
---
<div class:list={["contact-card", { "contact-card--note": isNote }]}>
  <div class:list={["contact-card-icon", icon === "discord" && "contact-card-icon--discord"]} aria-hidden="true">
    {icon === "discord" ? (
      <svg class="si" aria-hidden="true"><use href="#si-discord" /></svg>
    ) : (
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="8" cy="8" r="6.5"/>
        <path d="M8 7v4M8 5.5v.5"/>
      </svg>
    )}
  </div>
  <div class="contact-card-body">
    <h2 class="contact-card-heading">{heading}</h2>
    <div class="contact-card-desc">
      <slot name="description" />
    </div>
    <div class="contact-card-action">
      <slot name="action" />
    </div>
  </div>
</div>

<style>
  .contact-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
  }

  .contact-card--note {
    background: color-mix(in srgb, var(--clr-border) 30%, transparent);
  }

  .contact-card :global(.contact-card-icon) {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    color: var(--clr-brand);
    margin-top: 2px;
  }

  .contact-card :global(.contact-card-icon svg) {
    width: 100%;
    height: 100%;
  }

  .contact-card--note :global(.contact-card-icon) {
    color: var(--clr-muted);
  }

  .contact-card :global(.contact-card-icon--discord) {
    color: #5865F2;
  }

  .contact-card-body {
    flex: 1;
    min-width: 0;
  }

  .contact-card-heading {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 700;
    margin: 0 0 6px;
    color: var(--clr-text);
  }

  .contact-card-desc {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    margin: 0 0 10px;
    line-height: 1.5;
  }
</style>
