---
import { getEntry, render } from 'astro:content';
import ArticleTOC from '@/components/ArticleTOC.astro';
import EntryCardList from '@/components/EntryCardList.astro';
import { buildTocTree, type RenderedHeading } from '@/lib/articleToc';
import type { BookMeta, TagEntry } from '@/lib/types';

type SystemScope = 'power' | 'might' | 'guile' | 'champions';

type TabCardItem = {
  id: string;
  name: string;
  sourceBookTitle?: string | null;
  tagIds?: string[];
  Content?: any;
  href?: string;
  system?: SystemScope;
  filterKey?: string;
};

interface Tab {
  label: string;
  slug: string;
  articleId?: string;
  collection?: string;
  showToc?: boolean;
  builder?: boolean;
  system?: SystemScope;
  description?: string;
  RulesContent?: any;
  items?: TabCardItem[];
  emptyMessage?: string;
  sphereFilterOptions?: { id: string; label: string }[];
}

interface Props {
  tabs: Tab[];
  defaultTab?: string;
  id?: string;
  system?: string;
  /** Required when any tab provides `items` (rendered via EntryCardList) */
  tagMap?: Map<string, TagEntry>;
  bookMetaMap?: Map<string, BookMeta>;
}

const { tabs, defaultTab, id = "tab-container", system = 'power', tagMap, bookMetaMap } = Astro.props;
const initialTab = defaultTab || tabs[0].slug;

function decodeHtmlEntities(text: string): string {
  return text
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
}

function extractHeadingsFromHtml(html: string): RenderedHeading[] {
  const headings: RenderedHeading[] = [];
  const headingRegex = /<h([1-6])\b[^>]*\bid=["']([^"']+)["'][^>]*>([\s\S]*?)<\/h\1>/gi;
  let match: RegExpExecArray | null;

  while ((match = headingRegex.exec(html)) !== null) {
    headings.push({
      depth: Number(match[1]),
      slug: match[2],
      text: decodeHtmlEntities(match[3].replace(/<[^>]*>/g, "").trim()),
    });
  }

  return headings;
}

// Pre-render all tabs: article entries plus optional same-named slots.
const renderedTabs = await Promise.all(
  tabs.map(async (tab) => {
    let Content = null;
    let headings: RenderedHeading[] = [];
    let slotHtml: string | null = null;

    if (tab.articleId && tab.collection) {
      const entry = await getEntry(tab.collection as any, tab.articleId);
      if (entry) {
        const { Content: RenderedContent, headings: renderedHeadings } = await render(entry);
        Content = RenderedContent;
        headings = renderedHeadings;
      }
    }

    if (Astro.slots.has(tab.slug)) {
      slotHtml = await Astro.slots.render(tab.slug);
      if (tab.showToc) {
        headings = [...headings, ...extractHeadingsFromHtml(slotHtml)];
      }
    }

    if (tab.items) {
      headings = [
        ...headings,
        ...tab.items.map((item) => ({ depth: 3, slug: item.id, text: item.name })),
      ];
    }

    const tocItems = (tab.showToc || tab.items) ? buildTocTree(headings) : [];

    return { slug: tab.slug, Content, tocItems, slotHtml };
  })
);
---

<div class="tabbed-content" id={id} data-initial-tab={initialTab}>
  <nav class="tab-nav" role="tablist">
    {tabs.map((tab) => (
      <button
        class:list={['tab', { active: tab.slug === initialTab, 'tab--builder': tab.builder }]}
        role="tab"
        aria-selected={tab.slug === initialTab}
        aria-controls={`${id}-panel-${tab.slug}`}
        id={`${id}-tab-${tab.slug}`}
        data-tab={tab.slug}
        data-tab-builder={tab.builder ? "true" : undefined}
        data-system={tab.system}
      >
        {tab.label}
      </button>
    ))}
  </nav>

  <div class="tab-panels">
    {tabs.map((tab) => {
      const rendered = renderedTabs.find(r => r.slug === tab.slug);
      const Content = rendered?.Content;
      const tocItems = rendered?.tocItems || [];
      const slotHtml = rendered?.slotHtml ?? '';

      return (
        <div
          class:list={['tab-panel', { active: tab.slug === initialTab }]}
          role="tabpanel"
          id={`${id}-panel-${tab.slug}`}
          aria-labelledby={`${id}-tab-${tab.slug}`}
          hidden={tab.slug !== initialTab}
          data-tab-panel={tab.slug}
          data-tab-builder={tab.builder ? "true" : undefined}
          data-system={tab.system}
        >
          {/* TOC template for sidebar injection */}
          <template data-toc-template={tab.slug}>
             {tocItems.length > 0 && <ArticleTOC items={tocItems} system={tab.system ?? system} />}
          </template>
          {tab.description && <p class="tab-description">{tab.description}</p>}
          {tab.RulesContent && (
            <div class="tab-rules-callout">
              <tab.RulesContent />
            </div>
          )}
          {tab.sphereFilterOptions && tab.sphereFilterOptions.length > 0 && (
            <label class="sphere-filter">
              <span>Sphere</span>
              <select data-sphere-feat-filter>
                <option value="all">All spheres</option>
                {tab.sphereFilterOptions.map((sphere) => (
                  <option value={sphere.id}>{sphere.label}</option>
                ))}
              </select>
            </label>
          )}
          {tab.items && tagMap && bookMetaMap && (
            <EntryCardList
              items={tab.items}
              emptyMessage={tab.emptyMessage}
              tagMap={tagMap}
              bookMetaMap={bookMetaMap}
            />
          )}
          {Content && <Content />}
          {slotHtml && <Fragment set:html={slotHtml} />}
        </div>
      );
    })}
  </div>
</div>

<script is:inline>
  (function() {
    var hash = window.location.hash.slice(1);
    var containers = document.querySelectorAll('.tabbed-content:not([data-hash-processed])');
    var sidebar = document.getElementById('article-sidebar');
    
    for (var i = 0; i < containers.length; i++) {
      var container = containers[i];
      container.setAttribute('data-hash-processed', 'true');
      
      // Dynamic sidebar clearance
      function updateSidebarClearance() {
        if (!sidebar) return;
        var layout = sidebar.closest('.article-layout');
        var nav = container.querySelector('.tab-nav');
        if (layout && nav) {
          var layoutTop = layout.getBoundingClientRect().top;
          var navBottom = nav.getBoundingClientRect().bottom;
          var clearance = Math.max(0, navBottom - layoutTop);
          // 24px accounts for the 1.5rem margin-bottom on tab-nav
          sidebar.style.setProperty('--tab-nav-clearance', (clearance + 24) + 'px');
        }
      }
      
      // Update immediately, and then hook into resize
      if (window.ResizeObserver) {
        new ResizeObserver(updateSidebarClearance).observe(container.querySelector('.tab-nav'));
      } else {
        window.addEventListener('resize', updateSidebarClearance);
      }
      // Fallback update after fonts load
      requestAnimationFrame(updateSidebarClearance);
      setTimeout(updateSidebarClearance, 100);

      var activeSlug = hash || container.getAttribute('data-initial-tab');
      if (!activeSlug) continue;

      if (hash) {
        var targetTab = container.querySelector('.tab[data-tab="' + hash + '"]');
        var targetPanel = container.querySelector('.tab-panel[data-tab-panel="' + hash + '"]');
        if (targetTab && targetPanel) {
          var activeTab = container.querySelector('.tab.active');
          var activePanel = container.querySelector('.tab-panel.active');
          if (activeTab) {
            activeTab.classList.remove('active');
            activeTab.setAttribute('aria-selected', 'false');
          }
          if (activePanel) {
            activePanel.classList.remove('active');
            activePanel.hidden = true;
          }

          targetTab.classList.add('active');
          targetTab.setAttribute('aria-selected', 'true');
          targetPanel.classList.add('active');
          targetPanel.hidden = false;
        }
      }

      if (sidebar) {
        var template = container.querySelector('template[data-toc-template="' + activeSlug + '"]');
        if (template) {
          var oldToc = sidebar.querySelector('.article-toc');
          if (oldToc) oldToc.remove();
          sidebar.prepend(template.content.cloneNode(true));
        }
      }
      
      // Update book card visibility if tab is builder
      var targetActivePanel = container.querySelector('.tab-panel[data-tab-panel="' + activeSlug + '"]');
      var isBuilder = targetActivePanel ? targetActivePanel.getAttribute('data-tab-builder') === 'true' : false;
      var bookCard = sidebar ? sidebar.querySelector('.store-card') : null;
      if (bookCard) {
        bookCard.style.display = isBuilder ? 'none' : '';
      }
    }
  })();
</script>

<script>
  function initTabs(container: HTMLElement) {
    const tabs = container.querySelectorAll<HTMLButtonElement>('.tab');
    const panels = container.querySelectorAll<HTMLElement>('.tab-panel');

    const sidebar = document.getElementById('article-sidebar');

    function switchTab(slug: string, updateHash = true) {
      tabs.forEach(tab => {
        const isActive = tab.dataset.tab === slug;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive.toString());
      });

      panels.forEach(panel => {
        const isActive = panel.dataset.tabPanel === slug;
        panel.classList.toggle('active', isActive);
        panel.hidden = !isActive;
      });

      if (sidebar) {
        const oldToc = sidebar.querySelector('.article-toc');
        if (oldToc) oldToc.remove();

        const template = container.querySelector(`template[data-toc-template="${slug}"]`) as HTMLTemplateElement;
        if (template) {
           const clone = template.content.cloneNode(true);
           sidebar.prepend(clone);
           if ((window as any).reinitArticleToc) {
             (window as any).reinitArticleToc();
           }
           document.dispatchEvent(new CustomEvent('article-toc:reinit'));
        }
      }

      // Toggle book card visibility when builder tab is active
      const activePanel = container.querySelector(`[data-tab-panel="${slug}"]`) as HTMLElement | null;
      const isBuilder = activePanel?.dataset.tabBuilder === "true";
      const bookCard = sidebar?.querySelector('.store-card') as HTMLElement | null | undefined;
      if (bookCard) {
        bookCard.style.display = isBuilder ? 'none' : '';
      }
      // Toggle builder-active class on the content area
      const contentArea = container.closest('.content-area') ?? container.closest('.article-content');
      if (contentArea) {
        contentArea.classList.toggle('builder-active', isBuilder);
      }

      if (updateHash) {
        const url = new URL(window.location.href);
        url.hash = slug;
        window.history.replaceState({}, '', url);
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const slug = tab.dataset.tab;
        if (slug) switchTab(slug);
      });
    });

    // Sphere filter (bound once per select; hidden state persists across tab switches)
    container.querySelectorAll<HTMLSelectElement>('[data-sphere-feat-filter]').forEach(select => {
      const panel = select.closest('.tab-panel');
      if (!panel) return;
      const cards = [...panel.querySelectorAll<HTMLElement>('.entry-card-scope[data-filter-key]')];
      const applyFilter = () => {
        for (const card of cards) {
          card.hidden = select.value !== 'all' && card.dataset.filterKey !== select.value;
        }
      };
      select.addEventListener('change', applyFilter);
      applyFilter();
    });

    const hash = window.location.hash.slice(1);
    const initial = container.dataset.initialTab;

    // Use requestAnimationFrame so articleTocClient's module-level code
    // (which registers reinitArticleToc) has executed before we call it
    requestAnimationFrame(() => {
      if (hash && Array.from(tabs).some(t => t.dataset.tab === hash)) {
        switchTab(hash, false);
      } else if (initial) {
        switchTab(initial, false);
      }
    });
    }

    document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.tabbed-content').forEach(initTabs);
    });
</script>

<style>
  .tab-nav {
    display: flex;
    gap: 3px;
    border-bottom: 0.5px solid var(--clr-border);
    margin-bottom: 1.5rem;

    /* Extend line across whole area, including past the sidebar */
    margin-left: calc(-1 * var(--sp-5));
    margin-right: calc(-1 * var(--sp-5) - var(--rail-w, 0px) - var(--content-gap, 0rem));
    padding-left: var(--sp-5);
    padding-right: var(--sp-5);

    flex-wrap: wrap;
    position: relative;
    z-index: 10;
  }

  .tab {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-sm);
    padding: 5px 12px;
    border-radius: var(--radius) var(--radius) 0 0;
    border: 0.5px solid var(--clr-border);
    border-bottom: none;
    cursor: pointer;
    background: var(--clr-bg);
    color: var(--clr-ns, inherit);
    transition: background 0.13s ease;
    text-decoration: none;
    position: relative;
    z-index: 1;
  }

  .tab:hover:not(.active) {
    background: rgba(0, 0, 0, 0.04);
  }

  .tab.active {
    background: var(--clr-surface);
    color: var(--clr-active);
    z-index: 2;
    margin-bottom: -0.5px;
    box-shadow: 0 1px 0 var(--clr-surface);
  }

  .tab--builder::after {
    content: none;
  }

  .tab-panel:not(.active) {
    display: none;
  }

  .tab-description {
    font-size: var(--fs-sm);
    color: var(--clr-text);
    line-height: 1.55;
  }

  .tab-rules-callout {
    border-left: 3px solid var(--clr-active);
    background: color-mix(in srgb, var(--clr-active) 6%, transparent);
    padding: 0.85rem 1rem;
    margin: 1rem 0 1.25rem;
  }

  .tab-rules-callout :global(:first-child) {
    margin-top: 0;
  }

  .tab-rules-callout :global(:last-child) {
    margin-bottom: 0;
  }

  .sphere-filter {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin: 1rem 0 0.25rem;
    font-size: var(--fs-sm);
  }

  .sphere-filter span {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--clr-active);
  }

  .sphere-filter select {
    max-width: min(100%, 18rem);
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
    background: var(--clr-bg);
    color: var(--clr-text);
    font: inherit;
  }

  /* Sidebar clearance */
  :global(.article-content:has(.tabbed-content) .article-sidebar) {
    margin-top: var(--tab-nav-clearance, 50px);
  }

  @media (max-width: 640px) {
    .tab-nav {
      margin-left: calc(-1 * var(--sp-4));
      margin-right: calc(-1 * var(--sp-4));
      padding-left: var(--sp-4);
      padding-right: var(--sp-4);
      gap: 2px;
    }
    .tab {
      font-size: var(--fs-2xs);
      padding: 4px 8px;
    }
  }
</style>
