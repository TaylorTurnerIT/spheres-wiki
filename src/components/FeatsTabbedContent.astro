---
import ArticleTOC from "@/components/ArticleTOC.astro";
import EntryCardList from "@/components/EntryCardList.astro";
import { buildTocTree, type RenderedHeading } from "@/lib/articleToc";
import type { BookMeta, TagEntry } from "@/lib/types";

type SystemScope = "power" | "might" | "guile" | "champions";

type FeatCardItem = {
  id: string;
  name: string;
  sourceBookTitle?: string | null;
  tagIds?: string[];
  Content?: any;
  href?: string;
  system?: SystemScope;
  filterKey?: string;
};

type SphereFilterOption = {
  id: string;
  label: string;
};

type FeatsTab = {
  label: string;
  slug: string;
  description?: string;
  items: FeatCardItem[];
  RulesContent?: any;
  system?: SystemScope;
  emptyMessage?: string;
  sphereFilterOptions?: SphereFilterOption[];
};

interface Props {
  tabs: FeatsTab[];
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
  defaultTab?: string;
  id?: string;
}

const {
  tabs,
  tagMap,
  bookMetaMap,
  defaultTab,
  id = "feats-tabs",
} = Astro.props;

const initialTab = defaultTab || tabs[0]?.slug;

const tocBySlug = new Map(
  tabs.map((tab) => {
    const headings: RenderedHeading[] = tab.items.map((item) => ({
      depth: 3,
      slug: item.id,
      text: item.name,
    }));
    return [tab.slug, buildTocTree(headings)] as const;
  }),
);
---

<div class="tabbed-content feats-tabbed-content" id={id} data-initial-tab={initialTab}>
  <nav class="tab-nav" role="tablist">
    {tabs.map((tab) => (
      <button
        class:list={["tab", { active: tab.slug === initialTab }]}
        role="tab"
        aria-selected={tab.slug === initialTab}
        aria-controls={`${id}-panel-${tab.slug}`}
        id={`${id}-tab-${tab.slug}`}
        data-tab={tab.slug}
        data-system={tab.system}
      >
        {tab.label}
      </button>
    ))}
  </nav>

  <div class="tab-panels">
    {tabs.map((tab) => {
      const RulesContent = tab.RulesContent;
      const tocItems = tocBySlug.get(tab.slug) ?? [];

      return (
        <div
          class:list={["tab-panel", { active: tab.slug === initialTab }]}
          role="tabpanel"
          id={`${id}-panel-${tab.slug}`}
          aria-labelledby={`${id}-tab-${tab.slug}`}
          hidden={tab.slug !== initialTab}
          data-tab-panel={tab.slug}
          data-system={tab.system}
        >
          <template data-toc-template={tab.slug}>
            {tocItems.length > 0 && <ArticleTOC items={tocItems} system="power" />}
          </template>
          {tab.description && <p class="feat-tab-description">{tab.description}</p>}
          {RulesContent && (
            <div class="feat-category-rules">
              <RulesContent />
            </div>
          )}
          {tab.sphereFilterOptions && tab.sphereFilterOptions.length > 0 && (
            <label class="sphere-filter">
              <span>Sphere</span>
              <select data-sphere-feat-filter>
                <option value="all">All spheres</option>
                {tab.sphereFilterOptions.map((sphere) => (
                  <option value={sphere.id}>{sphere.label}</option>
                ))}
              </select>
            </label>
          )}
          <EntryCardList
            items={tab.items}
            emptyMessage={tab.emptyMessage}
            tagMap={tagMap}
            bookMetaMap={bookMetaMap}
          />
        </div>
      );
    })}
  </div>
</div>

<script>
  function initFeatsTabs(container: HTMLElement) {
    const tabs = container.querySelectorAll<HTMLButtonElement>(".tab");
    const panels = container.querySelectorAll<HTMLElement>(".tab-panel");
    const sidebar = document.getElementById("article-sidebar");

    function initSphereFilter(panel: HTMLElement) {
      const select = panel.querySelector<HTMLSelectElement>("[data-sphere-feat-filter]");
      if (!select) return;
      const filterSelect = select;
      const cards = [...panel.querySelectorAll<HTMLElement>(".entry-card-scope[data-filter-key]")];

      function applyFilter() {
        const selected = filterSelect.value;
        for (const card of cards) {
          const visible = selected === "all" || card.dataset.filterKey === selected;
          card.hidden = !visible;
        }
      }

      filterSelect.addEventListener("change", applyFilter);
      applyFilter();
    }

    function switchTab(slug: string, updateHash = true) {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.tab === slug;
        tab.classList.toggle("active", isActive);
        tab.setAttribute("aria-selected", isActive.toString());
      });

      panels.forEach((panel) => {
        const isActive = panel.dataset.tabPanel === slug;
        panel.classList.toggle("active", isActive);
        panel.hidden = !isActive;
        if (isActive) initSphereFilter(panel);
      });

      if (sidebar) {
        sidebar.querySelector(".article-toc")?.remove();
        const template = container.querySelector(`template[data-toc-template="${slug}"]`) as HTMLTemplateElement | null;
        if (template) {
          sidebar.prepend(template.content.cloneNode(true));
          if ((window as any).reinitArticleToc) {
            (window as any).reinitArticleToc();
          }
          document.dispatchEvent(new CustomEvent("article-toc:reinit"));
        }
      }

      if (updateHash) {
        const url = new URL(window.location.href);
        url.hash = slug;
        window.history.replaceState({}, "", url);
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const slug = tab.dataset.tab;
        if (slug) switchTab(slug);
      });
    });

    const hash = window.location.hash.slice(1);
    const initial = container.dataset.initialTab;

    requestAnimationFrame(() => {
      if (hash && Array.from(tabs).some((tab) => tab.dataset.tab === hash)) {
        switchTab(hash, false);
      } else if (initial) {
        switchTab(initial, false);
      }
    });
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>(".feats-tabbed-content").forEach(initFeatsTabs);
  });
</script>

<style>
  .tab-nav {
    display: flex;
    gap: 3px;
    border-bottom: 0.5px solid var(--clr-border);
    margin-bottom: 1.5rem;
    margin-left: calc(-1 * var(--sp-5));
    margin-right: calc(-1 * var(--sp-5) - var(--rail-w, 0px) - var(--content-gap, 0rem));
    padding-left: var(--sp-5);
    padding-right: var(--sp-5);
    flex-wrap: wrap;
    position: relative;
    z-index: 10;
  }

  .tab {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--fs-sm);
    padding: 5px 12px;
    border-radius: var(--radius) var(--radius) 0 0;
    border: 0.5px solid var(--clr-border);
    border-bottom: none;
    cursor: pointer;
    background: var(--clr-bg);
    color: var(--clr-active);
    transition: background 0.13s ease;
    text-decoration: none;
    position: relative;
    z-index: 1;
  }

  .tab:hover:not(.active) {
    background: rgba(0, 0, 0, 0.04);
  }

  .tab.active {
    background: var(--clr-surface);
    color: var(--clr-active);
    z-index: 2;
    margin-bottom: -0.5px;
    box-shadow: 0 1px 0 var(--clr-surface);
  }

  .tab-panel:not(.active) {
    display: none;
  }

  .feat-tab-description {
    font-size: var(--fs-sm);
    color: var(--clr-text);
    line-height: 1.55;
  }

  .feat-category-rules {
    border-left: 3px solid var(--clr-active);
    background: color-mix(in srgb, var(--clr-active) 6%, transparent);
    padding: 0.85rem 1rem;
    margin: 1rem 0 1.25rem;
  }

  .feat-category-rules :global(:first-child) {
    margin-top: 0;
  }

  .feat-category-rules :global(:last-child) {
    margin-bottom: 0;
  }

  .sphere-filter {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin: 1rem 0 0.25rem;
    font-size: var(--fs-sm);
  }

  .sphere-filter span {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--clr-active);
  }

  .sphere-filter select {
    max-width: min(100%, 18rem);
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
    background: var(--clr-bg);
    color: var(--clr-text);
    font: inherit;
  }

  @media (max-width: 640px) {
    .tab-nav {
      margin-left: calc(-1 * var(--sp-4));
      margin-right: calc(-1 * var(--sp-4));
      padding-left: var(--sp-4);
      padding-right: var(--sp-4);
      gap: 2px;
    }

    .tab {
      font-size: var(--fs-2xs);
      padding: 4px 8px;
    }
  }
</style>
