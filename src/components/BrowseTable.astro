---
/**
 * BrowseTable — generalized, filterable, alphabetically grouped catalog table.
 *
 * Renders every row on load (spec §7.1) grouped under letter headers
 * (`SectionHeading` eyebrow idiom), color-coded by system through the
 * `--clr-ns` mechanism (a `.power|.might|.guile|.champ` class per row — never a
 * raw system hex, and never color-only: the Tags column shows the system
 * textually via `TagBadge showSystem`).
 *
 * The client module (`browseFilterClient.ts`) filters by toggling the `hidden`
 * attribute on rows and letter groups — no scoped-CSS class is injected by JS,
 * so no `:global()` gymnastics are needed (V50). Columns are fixed for feats
 * (Name / Tags / Prerequisites / Summary); the row contract is generic so other
 * entry types can feed it the same shape.
 */
import TagBadge from "@/components/TagBadge.astro";
import { SYSTEMS } from "@/config/site";
import type { FeatBrowseRow } from "@/lib/featBrowse";
import type { BookMeta, TagEntry } from "@/lib/types";
import { url } from "@/lib/url";

interface Props {
  rows: FeatBrowseRow[];
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
  idPrefix?: string;
}

const { rows, tagMap, bookMetaMap, idPrefix = "browse" } = Astro.props;

const systemLabelMap: Record<string, string> = {
  power: "Power",
  might: "Might",
  guile: "Guile",
  champions: "Champions",
  champ: "Champions",
};

const EM_DASH = "—";

function letterOf(name: string): string {
  const ch = name.trim().charAt(0).toUpperCase();
  return /[A-Z]/.test(ch) ? ch : "#";
}

// Group rows by first letter; `rows` arrives pre-sorted by name (deterministic).
const groups = new Map<string, FeatBrowseRow[]>();
for (const row of rows) {
  const letter = letterOf(row.name);
  (groups.get(letter) ?? groups.set(letter, []).get(letter)!).push(row);
}
const letters = [...groups.keys()].sort((a, b) =>
  a === "#" ? 1 : b === "#" ? -1 : a.localeCompare(b),
);

// Combined lowercase haystack for the secondary (non-name) search fields.
function searchText(row: FeatBrowseRow): string {
  return [
    row.tags.map((t) => tagMap.get(t)?.label ?? t).join(" "),
    row.sphereLabel,
    row.sourceBookTitle,
    SYSTEMS[row.system]?.label ?? row.system,
    row.categoryLabel,
    row.summary,
  ]
    .join(" ")
    .toLowerCase();
}
---

<div class="browse-table-wrap" id={`${idPrefix}-table`} data-pagefind-ignore>
  <table class="browse-table">
    <thead>
      <tr>
        <th scope="col" class="browse-cell-name">Name</th>
        <th scope="col" class="browse-cell-tags">Tags</th>
        <th scope="col" class="browse-cell-prereq">Prerequisites</th>
        <th scope="col" class="browse-cell-summary">Summary</th>
      </tr>
    </thead>

    {letters.map((letter) => (
      <tbody class="browse-letter-group" data-letter={letter}>
        {groups.get(letter)!.map((row) => (
          <tr
            class:list={["browse-row", row.cssKey]}
            data-name={row.name.toLowerCase()}
            data-search={searchText(row)}
            data-system={row.system}
            data-category={row.category}
            data-tags={row.tags.join(" ")}
            data-href={row.href}
          >
            <td class="browse-cell browse-cell-name">
              <span class="browse-cell-label">Name</span>
              <a href={row.href} class="browse-name-link">{row.name}</a>
            </td>
            <td class="browse-cell browse-cell-tags">
              <span class="browse-cell-label">Tags</span>
              <span class="browse-tag-list">
                <span class="tag-wrapper">
                  <a href={url(SYSTEMS[row.system]?.route || "/")} class="talent-tag">
                    {systemLabelMap[row.system] || row.system}
                  </a>
                </span>
                {row.tags.map((tagId) => (
                  <TagBadge
                    tagId={tagId}
                    tagMap={tagMap}
                    bookMetaMap={bookMetaMap}
                  />
                ))}
              </span>
            </td>
            <td class="browse-cell browse-cell-prereq">
              <span class="browse-cell-label">Prerequisites</span>
              {row.prerequisites || <span class="browse-blank">{EM_DASH}</span>}
            </td>
            <td class="browse-cell browse-cell-summary">
              <span class="browse-cell-label">Summary</span>
              {row.summary || <span class="browse-blank">{EM_DASH}</span>}
            </td>
          </tr>
        ))}
      </tbody>
    ))}
  </table>

  <div class="browse-empty" id={`${idPrefix}-empty`} hidden>
    <p class="browse-empty-msg"></p>
    <button type="button" class="browse-reset btn" id={`${idPrefix}-reset`}>Reset filters</button>
  </div>
</div>

<style is:global>
  .browse-table-wrap {
    width: 100%;
    overflow-x: auto;
  }
  .browse-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
  }
  .browse-table tr[hidden],
  .browse-table tbody[hidden] {
    display: none !important;
  }
  .browse-table thead th {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--clr-text);
    text-align: left;
    padding: 8px 12px;
    border-top: 1px solid var(--clr-border);
    border-bottom: 2px solid var(--clr-border);
    position: sticky;
    top: 0;
    background: var(--clr-bg);
    z-index: 1;
  }
  .browse-row {
    border-bottom: 1px solid var(--clr-border);
    border-left: 3px solid var(--clr-ns, var(--clr-border));
    transition: background-color 0.15s ease;
    /* Keep the complete filterable table in the DOM while deferring layout
       and paint for rows that are far below the viewport. */
    content-visibility: auto;
    contain-intrinsic-size: auto 72px;
  }
  .browse-row:nth-child(even) {
    background: color-mix(in srgb, var(--clr-muted) 3%, transparent);
  }
  .browse-row:hover {
    background: color-mix(in srgb, var(--clr-ns, var(--clr-active)) 5%, var(--clr-surface));
  }
  .browse-cell {
    padding: 8px 12px;
    font-size: var(--fs-sm);
    color: var(--clr-text);
    vertical-align: top;
    line-height: 1.4;
  }

  /* Desktop-specific layout: vertical column borders */
  @media (min-width: 769px) {
    .browse-table thead tr {
      border-left: 1px solid var(--clr-border);
    }
    .browse-table thead th {
      border-right: 1px solid var(--clr-border);
    }
    .browse-cell {
      border-right: 1px solid var(--clr-border);
    }
    /* Column widths on desktop */
    .browse-cell-name {
      width: 20%;
      min-width: 150px;
    }
    .browse-cell-tags {
      width: 20%;
      min-width: 150px;
    }
    .browse-cell-prereq {
      width: 25%;
      min-width: 180px;
    }
    .browse-cell-summary {
      width: 35%;
      min-width: 250px;
    }
  }
  .browse-cell-name {
    white-space: normal;
  }
  .browse-name-link {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--clr-ns, var(--clr-active));
    text-decoration: none;
  }
  .browse-name-link:hover {
    text-decoration: underline;
  }
  .browse-cell-prereq,
  .browse-cell-summary {
    font-size: var(--fs-sm);
    color: var(--clr-text);
  }
  .browse-tag-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .browse-blank {
    color: var(--clr-muted);
    opacity: 0.6;
  }
  .browse-cell-label {
    display: none;
  }

  .browse-empty {
    text-align: center;
    padding: var(--sp-8) 0;
  }
  .browse-empty-msg {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    font-style: italic;
    margin-bottom: var(--sp-3);
  }
  /* Mobile: collapse the table into stacked cards (§8). */
  @media (max-width: 768px) {
    .browse-table-wrap {
      overflow-x: visible;
    }
    .browse-table thead {
      display: none;
    }
    .browse-table,
    .browse-table tbody,
    .browse-table tr,
    .browse-table td {
      display: block;
      width: 100%;
    }
    .browse-letter-row td {
      padding: var(--sp-4) 0 var(--sp-1);
    }
    .browse-row {
      border: 1px solid var(--clr-border);
      border-left: 3px solid var(--clr-ns, var(--clr-border));
      border-radius: var(--radius);
      margin-bottom: var(--sp-2);
      padding: var(--sp-2) 0;
    }
    .browse-cell {
      display: flex;
      gap: 8px;
      padding: 4px 12px;
      white-space: normal;
    }
    .browse-cell-label {
      display: block;
      position: static;
      width: auto;
      height: auto;
      padding: 0;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      border: 0;
      flex: 0 0 96px;
      font-family: var(--font-display);
      font-size: var(--fs-3xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--clr-muted);
    }
    .browse-cell-name .browse-cell-label {
      display: none;
    }
    .browse-cell-name {
      padding-bottom: var(--sp-1);
    }
    .browse-name-link {
      font-size: var(--fs-md);
    }
  }
</style>
