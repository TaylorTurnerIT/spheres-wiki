---
import type { BookMeta } from '@/lib/types';

interface Props {
  book: BookMeta | undefined;
}

const { book } = Astro.props;
---
{book && (
  <div class="source-callout">
    <span class="source-callout-label">Source</span>
    {book.coverImage && (
      <img src={book.coverImage} alt={`${book.title} cover`} class="source-callout-cover" />
    )}
    <span class="source-callout-title">{book.title}</span>
    {book.price && <span class="source-callout-price">{book.price}</span>}
    {book.buyUrl && (
      <a href={book.buyUrl} class="shop-btn" target="_blank" rel="noopener noreferrer">
        Buy on DriveThruRPG
      </a>
    )}
  </div>
)}
