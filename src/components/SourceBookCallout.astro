---
import type { BookMeta } from '@/lib/types';
import BookCard from './BookCard.astro';

interface Props {
  book: BookMeta | undefined;
}

const { book } = Astro.props;
---
{book && (
  <div class="source-callout-wrapper" style="display: flex; flex-direction: column; gap: 8px;">
    <span class="source-callout-label">Source</span>
    <BookCard book={book} />
  </div>
)}
