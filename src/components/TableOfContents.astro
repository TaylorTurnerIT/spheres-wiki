---
export interface TocItem {
  id: string;
  label: string;
  meta?: string;
  sub?: Array<{ id: string; label: string }>;
}

export interface TocGroup {
  label: string;
  categories: TocItem[];
}

interface Props {
  overview: TocItem;
  groups: TocGroup[];
  system: 'power' | 'might' | 'guile' | 'champ';
}

const { overview, groups, system } = Astro.props;
---
<nav class="toc" aria-label="On this page" style={`--clr-system: var(--clr-${system})`}>
  <p class="toc-title">On This Page</p>
  <ul class="toc-list">

    <li class="toc-category" data-toc-section={overview.id}>
      <a href={`#${overview.id}`} class="toc-cat-link">
        <span>{overview.label}</span>
        {overview.meta && <span class="toc-cat-level">{overview.meta}</span>}
      </a>
      {overview.sub && overview.sub.length > 0 && (
        <div class="toc-sub-list">
          <div class="toc-sub-inner">
            {overview.sub.map(s => (
              <a href={`#${s.id}`} data-toc-item={s.id}>{s.label}</a>
            ))}
          </div>
        </div>
      )}
    </li>

    {groups.map(group => (
      <li class="toc-group">
        <span class="toc-group-label">{group.label}</span>
        <ul class="toc-group-categories">
          {group.categories.map(cat => (
            <li class="toc-category" data-toc-section={cat.id}>
              <a href={`#${cat.id}`} class="toc-cat-link">
                <span>{cat.label}</span>
                {cat.meta && <span class="toc-cat-level">{cat.meta}</span>}
              </a>
              {cat.sub && cat.sub.length > 0 && (
                <div class="toc-sub-list">
                  <div class="toc-sub-inner">
                    {cat.sub.map(s => (
                      <a href={`#${s.id}`} data-toc-item={s.id}>{s.label}</a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </li>
    ))}

  </ul>
</nav>

<script>
import { createTocEngine, type TocEngine } from '@/lib/tocEngine';

let engine: TocEngine | null = null;
let activeCollapseHandler: ((e: Event) => void) | null = null;

// Accordion presentation: expand the active category's sub-list unless its
// page section is collapsed (live state read from the toggle button's
// aria-expanded via data-feature-id / data-cat-id)
function setActive(categories: HTMLElement[], active: HTMLElement | null) {
  categories.forEach(cat => {
    const subList = cat.querySelector<HTMLElement>('.toc-sub-list');
    const inner = cat.querySelector<HTMLElement>('.toc-sub-inner');
    const isActive = cat === active;

    const btn = document.querySelector<HTMLButtonElement>(`[data-feature-id="${cat.dataset.tocSection}"], [data-cat-id="${cat.dataset.tocSection}"]`);
    const isCollapsed = btn ? btn.getAttribute('aria-expanded') === 'false' : false;

    cat.classList.toggle('is-active', isActive);
    if (subList && inner) {
      if (isCollapsed) {
        subList.style.maxHeight = '0';
      } else {
        subList.style.maxHeight = isActive ? inner.scrollHeight + 'px' : '0';
      }
    }
  });
}

document.addEventListener('astro:page-load', () => {
  engine?.stop();
  engine = null;
  if (activeCollapseHandler) {
    document.removeEventListener('class-feature-collapse', activeCollapseHandler);
    activeCollapseHandler = null;
  }

  const nav = document.querySelector<HTMLElement>('.toc');
  if (!nav) return;

  engine = createTocEngine({ nav, applyActive: setActive });
  if (!engine) return;

  activeCollapseHandler = () => engine?.recalc();
  document.addEventListener('class-feature-collapse', activeCollapseHandler);
});
</script>
