---
import { url } from "@/lib/url";
import type { TagEntry, BookMeta } from "@/lib/types";

interface Props {
  tagId: string;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

const { tagId, tagMap, bookMetaMap } = Astro.props;
const tag = tagMap.get(tagId);
const color = tag?.color ?? "var(--clr-brand)";
const bookTitle =
  tag && tag.sourceBook !== "__builtin__"
    ? bookMetaMap.get(tag.sourceBook)?.title ?? tag.sourceBook
    : undefined;
---

<span class="tag-wrapper">
  <a
    href={url(`/tags/${tagId}/`)}
    class="talent-tag"
    data-tag={tagId}
    style={tag ? `--tag-clr: ${color}` : undefined}
    data-astro-prefetch="hover"
    aria-describedby={tag ? `tooltip-${tagId}` : undefined}
  >
    {tag?.label ?? tagId}
  </a>
  {
    tag && (
      <div class="tag-tooltip" role="tooltip" id={`tooltip-${tagId}`}>
        <span class="tag-tooltip-name">{tag.label}</span>
        <span class="tag-tooltip-desc" set:html={tag.description.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')} />
        {bookTitle && <span class="tag-tooltip-source">{bookTitle}</span>}
      </div>
    )
  }
</span>

<style>
  .talent-tag {
    text-decoration: none;
    cursor: pointer;
  }
  .talent-tag:hover {
    filter: brightness(1.1);
  }
</style>
