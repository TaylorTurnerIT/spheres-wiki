---
import { url } from "@/lib/url";
import type { TagEntry, BookMeta } from "@/lib/types";

interface Props {
  tagId: string;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
  asSpan?: boolean;
  stripLinks?: boolean;
}

const { tagId, tagMap, bookMetaMap, asSpan = false, stripLinks = false } = Astro.props;
const tag = tagMap.get(tagId);
const color = tag?.color ?? "var(--clr-brand)";
const bookTitle =
  tag && tag.sourceBook !== "__built-in__"
    ? bookMetaMap.get(tag.sourceBook)?.title ?? tag.sourceBook
    : undefined;

const TagElement = asSpan ? 'span' : 'a';

const ttDesc = tag
  ? tag.description.replace(
      /\[([^\]]+)\]\(([^)]+)\)/g,
      stripLinks ? '$1' : '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
    )
  : undefined;
---

<span
  class="tag-wrapper"
  data-system={tag?.system}
  data-tt-name={tag?.label}
  data-tt-desc={ttDesc}
  data-tt-source={bookTitle}
>
  <TagElement
    href={!asSpan ? url(`/tags/${tagId}/`) : undefined}
    class="talent-tag"
    data-tag={tagId}
    style={tag ? `--tag-clr: ${color}` : undefined}
    data-astro-prefetch={!asSpan ? "hover" : undefined}
  >
    {tag?.label ?? tagId}
  </TagElement>
</span>

<style>
  .talent-tag {
    text-decoration: none;
    cursor: pointer;
  }
  .talent-tag:hover {
    filter: brightness(1.1);
  }
</style>
