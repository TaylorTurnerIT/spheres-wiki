---
import { url } from "@/lib/url";
import { resolveSystem } from "@/lib/systems";
import { mdLinksToHtml } from "@/lib/mdLinks";
import type { TagEntry, BookMeta } from "@/lib/types";

interface Props {
  tagId: string;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
  asSpan?: boolean;
  stripLinks?: boolean;
  showSystem?: boolean;
  showTooltip?: boolean;
  /** Opt out of link prefetch — for lists repeating the same badges
      thousands of times (tag detail rows), where per-instance prefetch
      hints add bytes and runtime tracking without value. */
  prefetch?: boolean;
}

const {
  tagId,
  tagMap,
  bookMetaMap,
  asSpan = false,
  stripLinks = false,
  showSystem = false,
  showTooltip = true,
  prefetch = true,
} = Astro.props;
const tag = tagMap.get(tagId);
const bookTitle =
  tag && tag.sourceBook !== "__built-in__"
    ? bookMetaMap.get(tag.sourceBook)?.title ?? tag.sourceBook
    : undefined;
const systemLabel =
  showSystem && tag?.system ? resolveSystem(tag.system)?.label : undefined;

const TagElement = asSpan ? 'span' : 'a';

const ttDesc = tag ? mdLinksToHtml(tag.description, { stripLinks }) : undefined;
---

<TagElement
  href={!asSpan ? url(`/tags/${tagId}/`) : undefined}
  class="tag-wrapper talent-tag"
  data-tag={tagId}
  data-astro-prefetch={!asSpan && prefetch ? "hover" : undefined}
  data-tt-name={showTooltip ? tag?.label : undefined}
  data-tt-desc={showTooltip ? ttDesc : undefined}
  data-tt-source={showTooltip ? bookTitle : undefined}
>
  {tag?.label ?? tagId}{systemLabel && (
    <span class="talent-tag-system"> · {systemLabel}</span>
  )}
</TagElement>

<style>
  .talent-tag {
    text-decoration: none;
    cursor: pointer;
  }
  .talent-tag:hover {
    filter: brightness(1.1);
  }
  .talent-tag-system {
    font-weight: 400;
    font-style: italic;
    opacity: 0.75;
  }
</style>
