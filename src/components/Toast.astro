---
interface Props {
  id: string;
  title: string;
  storageKey: string;
  accentColor?: string;
  bottom?: string;
  hideClose?: boolean;
}

const {
  id,
  title,
  storageKey,
  accentColor = 'var(--clr-brand)',
  bottom = '25px',
  hideClose = false,
} = Astro.props;
---

<div
  id={id}
  class="site-toast is-hidden"
  role="status"
  aria-live="polite"
  aria-atomic="true"
  data-storage-key={storageKey}
  data-session-key={`${storageKey}-animated`}
  style={`--toast-accent: ${accentColor}; --toast-bottom: ${bottom};`}
>
  <div class="site-toast-content">
    <div class="site-toast-title">{title}</div>
    <div class="site-toast-body">
      <slot />
    </div>
  </div>
  {!hideClose && <button class="site-toast-close" aria-label="Close notification">&times;</button>}
</div>

<style>
  .site-toast {
    position: fixed;
    bottom: var(--toast-bottom, 25px);
    right: 5px;
    width: 320px;
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-left: 4px solid var(--toast-accent);
    border-radius: var(--radius);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
    padding: 12px 16px;
    display: flex;
    gap: 12px;
    z-index: 2000;
  }

  .site-toast.animate {
    animation: toast-slide-in 0.3s ease-out;
  }

  .site-toast.is-hidden {
    display: none !important;
  }

  @keyframes toast-slide-in {
    from { transform: translateX(120%); }
    to   { transform: translateX(0); }
  }

  .site-toast-content {
    flex: 1;
  }

  .site-toast-title {
    font-family: var(--font-display);
    font-size: var(--fs-3xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--toast-accent);
    margin-bottom: 4px;
  }

  .site-toast-body {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: var(--clr-text);
  }

  .site-toast-body a {
    color: var(--clr-power);
    font-weight: 600;
    text-decoration: underline;
  }

  .site-toast-close {
    background: none;
    border: none;
    font-size: 20px;
    color: var(--clr-muted);
    cursor: pointer;
    line-height: 1;
    padding: 0;
    align-self: flex-start;
  }

  .site-toast-close:hover {
    color: var(--clr-text);
  }

  @media (max-width: 768px) {
    .site-toast {
      top: auto;
      right: 20px;
      left: 20px;
      width: auto;
    }
  }
</style>

<script>
  function initToast(el: Element) {
    const toast = el as HTMLElement;
    const storageKey = toast.dataset.storageKey!;
    const sessionKey = toast.dataset.sessionKey!;
    const closeBtn = toast.querySelector('.site-toast-close') as HTMLButtonElement | null;

    try {
      if (localStorage.getItem(storageKey) === 'true') {
        toast.classList.add('is-hidden');
        return;
      }
    } catch (_) {}

    toast.classList.remove('is-hidden');

    try {
      if (!sessionStorage.getItem(sessionKey)) {
        toast.classList.add('animate');
        sessionStorage.setItem(sessionKey, 'true');
      } else {
        toast.classList.remove('animate');
      }
    } catch (_) {}

    if (closeBtn) {
      closeBtn.onclick = (e) => {
        e.stopPropagation();
        toast.classList.add('is-hidden');
        try { localStorage.setItem(storageKey, 'true'); } catch (_) {}
      };
    }
  }

  function initAllToasts() {
    document.querySelectorAll('.site-toast').forEach(initToast);
  }

  document.addEventListener('astro:page-load', initAllToasts);
</script>
