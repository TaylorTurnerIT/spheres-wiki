---
// src/components/ScrollToTop.astro
---
<button id="scroll-to-top" class="scroll-to-top" aria-label="Scroll to top" hidden>
  <svg class="si"><use href="#si-chevron-up"/></svg>
</button>

<style>
  .scroll-to-top {
    position: fixed;
    bottom: var(--sp-6);
    /* anchored to right edge of main content area + sp-6 */
    right: calc(max(0px, (100vw - var(--max-w)) / 2) + var(--sp-7));
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    color: var(--clr-active);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1000;
    box-shadow: var(--shadow-floating);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease,
      transform 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
    padding: 0;
  }

  .scroll-to-top:hover {
    background: color-mix(in srgb, var(--clr-active) 8%, var(--clr-surface));
    border-color: var(--clr-active);
    transform: translateY(-2px);
  }

  .scroll-to-top:active {
    transform: translateY(0) scale(0.95);
  }

  .scroll-to-top.is-visible {
    opacity: 1;
    visibility: visible;
  }

  .scroll-to-top svg {
    width: 24px;
    height: 24px;
  }

  @media (max-width: 768px) {
    .scroll-to-top {
      bottom: var(--sp-4);
      right: var(--sp-4);
      width: 40px;
      height: 40px;
    }
    .scroll-to-top svg {
      width: 20px;
      height: 20px;
    }
  }

  /* Support for system coloring based on data-system attribute */
  .scroll-to-top[data-system="power"] { --clr-active: var(--clr-power); }
  .scroll-to-top[data-system="might"] { --clr-active: var(--clr-might); }
  .scroll-to-top[data-system="guile"] { --clr-active: var(--clr-guile); }
  .scroll-to-top[data-system="champions"] { --clr-active: var(--clr-champ); }
</style>

<script>
  let cleanupScrollPage = () => {};

  function initScrollToTop() {
    cleanupScrollPage();
    const btn = document.getElementById('scroll-to-top');
    if (!btn) return;
    const controller = new AbortController();
    const { signal } = controller;

    // Detect system from content area to apply appropriate accent color
    const contentArea = document.querySelector('.content-area');
    if (contentArea) {
      const system = contentArea.getAttribute('data-system');
      if (system) {
        btn.setAttribute('data-system', system);
      } else {
        btn.removeAttribute('data-system');
      }
    } else {
      btn.removeAttribute('data-system');
    }

    const toggleVisibility = () => {
      if (window.scrollY > 300) {
        btn.classList.add('is-visible');
        btn.removeAttribute('hidden');
      } else {
        btn.classList.remove('is-visible');
      }
    };

    let isScrolling = false;

    const onScroll = () => {
      if (window.scrollY === 0) {
        isScrolling = false;
      }
      toggleVisibility();
    };
    window.addEventListener('scroll', onScroll, { passive: true, signal });

    btn.addEventListener('click', () => {
      if (isScrolling) return;
      isScrolling = true;
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    }, { signal });

    // Initial check in case we're already scrolled down (e.g., after a refresh)
    toggleVisibility();
    cleanupScrollPage = () => controller.abort();
  }

  document.addEventListener('astro:before-swap', () => {
    cleanupScrollPage();
    cleanupScrollPage = () => {};
  });

  // Bind on both initial load and view transition navigation
  document.addEventListener('astro:page-load', initScrollToTop);
</script>
