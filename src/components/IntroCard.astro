---
import { url } from "@/lib/url";
import { SYSTEMS } from '@/config/site';

interface Props {
  system: string;
}

const { system } = Astro.props;

const sys = SYSTEMS[system];
const cssClass = sys?.cssKey ?? system;
const name = sys?.label ?? system;
const description = sys?.description ?? '';
const linkText = sys?.introLinkText ?? 'Browse →';
const href = sys?.route ?? `/${system}/`;
---
<a href={url(href)} class:list={['intro-card', cssClass]} data-astro-prefetch="hover">
  <div class="intro-card-art" aria-hidden="true">
    {system === 'power' && (
      <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" style="overflow: visible;" aria-hidden="true">
        <rect width="200" height="80" fill="#0D2850"/>
        <g transform="translate(100, 40) scale(0.9) translate(-100, -40)">
          <circle cx="100" cy="40" r="30" fill="#174B93" opacity=".35"/>
          <circle cx="100" cy="40" r="22" fill="#1E60BE" opacity=".4"/>
          <path d="M 76 40 A 24 9 0 0 1 124 40" fill="none" stroke="#5B8ED4" stroke-width="1" opacity=".45" transform="rotate(-35 100 40)"/>
          <circle cx="100" cy="40" r="13" fill="#2E6FD6" opacity=".95"/>
          <circle cx="100" cy="40" r="8"  fill="#4A90E8"/>
          <circle cx="97"  cy="37" r="3"  fill="#A0CCFF" opacity=".7"/>
          <path d="M 124 40 A 24 9 0 0 1 76 40" fill="none" stroke="#5B8ED4" stroke-width="1" opacity=".45" transform="rotate(-35 100 40)"/>
        </g>
        <!-- Stars: Pulled in significantly from the 200x80 edges -->
        <circle cx="28"  cy="18" r="1.2" fill="#7AABFF" opacity=".6"/>
        <circle cx="165" cy="15" r="1.2" fill="#7AABFF" opacity=".7"/>
        <circle cx="154" cy="63" r="1"   fill="#7AABFF" opacity=".55"/>
        <circle cx="35"  cy="61" r="1.2" fill="#9ABFFF" opacity=".45"/>
        <circle cx="52"  cy="28" r="1"   fill="#9ABFFF" opacity=".5"/>
        <circle cx="178" cy="46" r="1"   fill="#9ABFFF" opacity=".4"/>
        <circle cx="18"  cy="35" r="0.8" fill="#7AABFF" opacity=".5"/>
        <circle cx="180" cy="22" r="0.9" fill="#9ABFFF" opacity=".45"/>
        <circle cx="15"  cy="15" r="1.1" fill="#7AABFF" opacity=".55"/>
        <circle cx="182" cy="65" r="1.0" fill="#9ABFFF" opacity=".4"/>
      </svg>
    )}
    {system === 'might' && (
      <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" style="overflow: visible;" aria-hidden="true">
        <rect width="200" height="80" fill="#3D1200"/>
        <g opacity=".3">
          <line x1="0"   y1="20"  x2="20"  y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="0"   y1="40"  x2="40"  y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="0"   y1="60"  x2="60"  y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="0"   y1="80"  x2="80"  y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="20"  y1="80"  x2="100" y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="40"  y1="80"  x2="120" y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="60"  y1="80"  x2="140" y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="80"  y1="80"  x2="160" y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="100" y1="80"  x2="180" y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="120" y1="80"  x2="200" y2="0"  stroke="#6B2200" stroke-width="1.5"/>
          <line x1="140" y1="80"  x2="200" y2="20" stroke="#6B2200" stroke-width="1.5"/>
          <line x1="160" y1="80"  x2="200" y2="40" stroke="#6B2200" stroke-width="1.5"/>
          <line x1="180" y1="80"  x2="200" y2="60" stroke="#6B2200" stroke-width="1.5"/>
        </g>
        <g transform="translate(100, 40) scale(0.75) translate(-100, -40)">
          <path d="M100 8 L134 20 L134 46 Q134 67 100 74 Q66 67 66 46 L66 20 Z" fill="#7A2400" opacity=".75"/>
          <path d="M100 8 L134 20 L134 46 Q134 67 100 74 Q66 67 66 46 L66 20 Z" fill="none" stroke="#D04800" stroke-width="1.5" opacity=".8"/>
          <line x1="82" y1="22" x2="118" y2="58" stroke="#F07848" stroke-width="2.5" stroke-linecap="round"/>
          <line x1="118" y1="22" x2="82" y2="58" stroke="#F07848" stroke-width="2.5" stroke-linecap="round"/>
          <g transform="translate(113,27) scale(1.2) translate(-12,-10)">
            <path d="m12 2l10 6c0 4-2 6-6 7l-3-5l-4-4z" fill="#C84A00" stroke="#F07848" stroke-width="1.2" opacity="1"/>
          </g>
          <g transform="translate(87,27) scale(-1.2,1.2) translate(-12,-10)">
            <path d="m12 2l10 6c0 4-2 6-6 7l-3-5l-4-4z" fill="#C84A00" stroke="#F07848" stroke-width="1.2" opacity="1"/>
          </g>
          <circle cx="100" cy="40" r="9" fill="#C84A00"/>
          <circle cx="100" cy="40" r="5.5" fill="#FF8050"/>
          <circle cx="98" cy="38" r="2.2" fill="#FFDAC0" opacity=".85"/>
        </g>
      </svg>
    )}
    {system === 'guile' && (
      <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" style="overflow: visible;" aria-hidden="true">
        <rect width="200" height="80" fill="#180B2E"/>
        <g transform="translate(100, 40) scale(1.05) translate(-100, -40)">
          <line x1="100" y1="40" x2="38"  y2="8"  stroke="#7A4EC0" stroke-width=".8" opacity=".5"/>
          <line x1="100" y1="40" x2="162" y2="8"  stroke="#7A4EC0" stroke-width=".8" opacity=".5"/>
          <line x1="100" y1="40" x2="18"  y2="52" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
          <line x1="100" y1="40" x2="182" y2="52" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
          <line x1="100" y1="40" x2="58"  y2="80" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
          <line x1="100" y1="40" x2="142" y2="80" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
          <line x1="100" y1="40" x2="100" y2="4"  stroke="#7A4EC0" stroke-width=".8" opacity=".45"/>
          <line x1="100" y1="40" x2="100" y2="76" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
          <path d="M100 12 L130 40 L100 68 L70 40 Z" fill="none" stroke="#6A3AAA" stroke-width="1"   opacity=".4"/>
          <path d="M100 22 L118 40 L100 58 L82 40 Z" fill="#2E1260" stroke="#8A52D0" stroke-width="1.2" opacity=".85"/>
          <ellipse cx="100" cy="40" rx="16" ry="10" fill="#200A40"/>
          <ellipse cx="100" cy="40" rx="16" ry="10" fill="none" stroke="#9060D8" stroke-width="1.5"/>
          <circle cx="100" cy="40" r="6"  fill="#6B38C0"/>
          <circle cx="100" cy="40" r="3"  fill="#B07AEE"/>
          <circle cx="98"  cy="38.5" r="1.2" fill="#DFC8FF" opacity=".8"/>
        </g>
      </svg>
    )}
    {system === 'champions' && (
      <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" style="overflow: visible;" aria-hidden="true">
        <rect width="200" height="80" fill="#091E0C"/>
        <g transform="translate(100, 40) scale(0.9) translate(-100, -40)">
          <line x1="100" y1="0"  x2="55"  y2="80" stroke="#1E5E24" stroke-width="10" opacity=".3"/>
          <line x1="100" y1="0"  x2="100" y2="80" stroke="#1E5E24" stroke-width="12" opacity=".3"/>
          <line x1="100" y1="0"  x2="145" y2="80" stroke="#1E5E24" stroke-width="10" opacity=".3"/>
          <circle cx="100" cy="40" r="36" fill="#165A1C" opacity=".3"/>
          <circle cx="100" cy="40" r="22" fill="#1E7028" opacity=".3"/>
          <path d="M100 14 L107 32 L126 32 L111 43 L118 61 L100 50 L82 61 L89 43 L74 32 L93 32 Z" fill="#1A6E22" stroke="#40C054" stroke-width="1.2"/>
          <circle cx="100" cy="40" r="9"  fill="#1E8030"/>
          <circle cx="100" cy="40" r="5.5" fill="#30AA46"/>
          <circle cx="98"  cy="38" r="2.2" fill="#90E8A0" opacity=".75"/>
        </g>
      </svg>
    )}
  </div>
  <div class="intro-card-body">
    <div class="intro-card-name">{name}</div>
    <div class="intro-card-desc">{description}</div>
    <span class="intro-card-link">{linkText}</span>
  </div>
</a>
