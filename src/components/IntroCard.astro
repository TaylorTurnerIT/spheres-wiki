---
import { url } from "@/lib/url";

type Namespace = 'power' | 'might' | 'guile' | 'champions';

interface Props {
  system: Namespace;
}

const { system } = Astro.props;

const cssClass = system === 'champions' ? 'champ' : system;

const meta: Record<Namespace, { name: string; description: string; linkText: string; href: string }> = {
  power: {
    name: 'Spheres of Power',
    description: 'The magic system. Build custom spellcasters by combining magical spheres — flexible talents over spell slots.',
    linkText: 'Using Spheres of Power →',
    href: '/power/',
  },
  might: {
    name: 'Spheres of Might',
    description: 'For martial characters. Craft fighters, archers, brawlers, and commanders from talents instead of rigid feat trees.',
    linkText: 'Using Spheres of Might →',
    href: '/might/',
  },
  guile: {
    name: 'Spheres of Guile',
    description: 'The skills system. Run organizations, craft masterworks, infiltrate networks — with real mechanical weight.',
    linkText: 'Using Spheres of Guile →',
    href: '/guile/',
  },
  champions: {
    name: 'Champions of the Spheres',
    description: 'Blend magic and martial together. Bridge both systems for characters who fight and cast in equal measure.',
    linkText: 'Using Champions →',
    href: '/champions/',
  },
};

const { name, description, linkText, href } = meta[system];
---
<a href={url(href)} class:list={['intro-card', cssClass]} data-astro-prefetch="hover">
  <div class="intro-card-art" aria-hidden="true">
    {system === 'power' && (
      <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="200" height="80" fill="#0D2850"/>
        <circle cx="100" cy="40" r="55" fill="#174B93" opacity=".35"/>
        <circle cx="100" cy="40" r="34" fill="#1E60BE" opacity=".4"/>
        <line x1="100" y1="40" x2="100" y2="4"  stroke="#5B8ED4" stroke-width="1"  opacity=".5"/>
        <line x1="100" y1="40" x2="100" y2="76" stroke="#5B8ED4" stroke-width="1"  opacity=".5"/>
        <line x1="100" y1="40" x2="60"  y2="40" stroke="#5B8ED4" stroke-width="1"  opacity=".5"/>
        <line x1="100" y1="40" x2="140" y2="40" stroke="#5B8ED4" stroke-width="1"  opacity=".5"/>
        <line x1="100" y1="40" x2="72"  y2="12" stroke="#5B8ED4" stroke-width=".8" opacity=".35"/>
        <line x1="100" y1="40" x2="128" y2="68" stroke="#5B8ED4" stroke-width=".8" opacity=".35"/>
        <line x1="100" y1="40" x2="128" y2="12" stroke="#5B8ED4" stroke-width=".8" opacity=".35"/>
        <line x1="100" y1="40" x2="72"  y2="68" stroke="#5B8ED4" stroke-width=".8" opacity=".35"/>
        <ellipse cx="100" cy="40" rx="24" ry="9" fill="none" stroke="#5B8ED4" stroke-width="1" opacity=".45" transform="rotate(-35 100 40)"/>
        <circle cx="100" cy="40" r="13" fill="#2E6FD6" opacity=".95"/>
        <circle cx="100" cy="40" r="8"  fill="#4A90E8"/>
        <circle cx="97"  cy="37" r="3"  fill="#A0CCFF" opacity=".7"/>
        <circle cx="22"  cy="14" r="1.2" fill="#7AABFF" opacity=".6"/>
        <circle cx="172" cy="11" r="1.2" fill="#7AABFF" opacity=".7"/>
        <circle cx="154" cy="63" r="1"  fill="#7AABFF" opacity=".55"/>
      </svg>
    )}
    {system === 'might' && (
      <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="200" height="80" fill="#3D1200"/>
        <line x1="0"   y1="20"  x2="20"  y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".4"/>
        <line x1="0"   y1="40"  x2="40"  y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".4"/>
        <line x1="0"   y1="60"  x2="60"  y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".35"/>
        <line x1="0"   y1="80"  x2="80"  y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".35"/>
        <line x1="20"  y1="80"  x2="100" y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".3"/>
        <line x1="40"  y1="80"  x2="120" y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".3"/>
        <line x1="60"  y1="80"  x2="140" y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".3"/>
        <line x1="80"  y1="80"  x2="160" y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".3"/>
        <line x1="100" y1="80"  x2="180" y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".3"/>
        <line x1="120" y1="80"  x2="200" y2="0"  stroke="#6B2200" stroke-width="1.5" opacity=".3"/>
        <line x1="140" y1="80"  x2="200" y2="20" stroke="#6B2200" stroke-width="1.5" opacity=".3"/>
        <line x1="160" y1="80"  x2="200" y2="40" stroke="#6B2200" stroke-width="1.5" opacity=".3"/>
        <line x1="180" y1="80"  x2="200" y2="60" stroke="#6B2200" stroke-width="1.5" opacity=".3"/>
        <path d="M100 8 L134 20 L134 46 Q134 67 100 74 Q66 67 66 46 L66 20 Z" fill="#7A2400" opacity=".75"/>
        <path d="M100 8 L134 20 L134 46 Q134 67 100 74 Q66 67 66 46 L66 20 Z" fill="none" stroke="#D04800" stroke-width="1.5" opacity=".8"/>
        <line x1="82" y1="22" x2="118" y2="58" stroke="#F07848" stroke-width="2.5" stroke-linecap="round"/>
        <line x1="118" y1="22" x2="82" y2="58" stroke="#F07848" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="100" cy="40" r="6" fill="#C84A00"/>
        <circle cx="100" cy="40" r="3.5" fill="#FF8050"/>
      </svg>
    )}
    {system === 'guile' && (
      <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="200" height="80" fill="#180B2E"/>
        <line x1="100" y1="40" x2="38"  y2="8"  stroke="#7A4EC0" stroke-width=".8" opacity=".5"/>
        <line x1="100" y1="40" x2="162" y2="8"  stroke="#7A4EC0" stroke-width=".8" opacity=".5"/>
        <line x1="100" y1="40" x2="18"  y2="52" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <line x1="100" y1="40" x2="182" y2="52" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <line x1="100" y1="40" x2="58"  y2="80" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <line x1="100" y1="40" x2="142" y2="80" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <line x1="100" y1="40" x2="100" y2="4"  stroke="#7A4EC0" stroke-width=".8" opacity=".45"/>
        <line x1="100" y1="40" x2="100" y2="76" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <path d="M100 12 L130 40 L100 68 L70 40 Z" fill="none" stroke="#6A3AAA" stroke-width="1"   opacity=".4"/>
        <path d="M100 22 L118 40 L100 58 L82 40 Z" fill="#2E1260" stroke="#8A52D0" stroke-width="1.2" opacity=".85"/>
        <ellipse cx="100" cy="40" rx="16" ry="10" fill="#200A40"/>
        <ellipse cx="100" cy="40" rx="16" ry="10" fill="none" stroke="#9060D8" stroke-width="1.5"/>
        <circle cx="100" cy="40" r="6"  fill="#6B38C0"/>
        <circle cx="100" cy="40" r="3"  fill="#B07AEE"/>
        <circle cx="98"  cy="38.5" r="1.2" fill="#DFC8FF" opacity=".8"/>
        <circle cx="55"  cy="19"   r="1.2" fill="#A06AE8" opacity=".65"/>
        <circle cx="148" cy="17"   r="1"   fill="#A06AE8" opacity=".55"/>
      </svg>
    )}
    {system === 'champions' && (
      <svg viewBox="0 0 200 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <rect width="200" height="80" fill="#091E0C"/>
        <line x1="100" y1="0"  x2="55"  y2="80" stroke="#1E5E24" stroke-width="10" opacity=".3"/>
        <line x1="100" y1="0"  x2="100" y2="80" stroke="#1E5E24" stroke-width="12" opacity=".3"/>
        <line x1="100" y1="0"  x2="145" y2="80" stroke="#1E5E24" stroke-width="10" opacity=".3"/>
        <circle cx="100" cy="40" r="36" fill="#165A1C" opacity=".3"/>
        <circle cx="100" cy="40" r="22" fill="#1E7028" opacity=".3"/>
        <path d="M100 10 L107 28 L126 28 L111 39 L118 57 L100 46 L82 57 L89 39 L74 28 L93 28 Z" fill="#1A6E22" stroke="#40C054" stroke-width="1.2"/>
        <circle cx="100" cy="38" r="9"  fill="#1E8030"/>
        <circle cx="100" cy="38" r="5.5" fill="#30AA46"/>
        <circle cx="98"  cy="36" r="2.2" fill="#90E8A0" opacity=".75"/>
        <circle cx="38"  cy="19" r="1.2" fill="#40C054" opacity=".5"/>
        <circle cx="166" cy="24" r="1"   fill="#40C054" opacity=".5"/>
        <circle cx="28"  cy="56" r="1.5" fill="#2A8034" opacity=".45"/>
        <circle cx="174" cy="59" r="1.2" fill="#2A8034" opacity=".45"/>
      </svg>
    )}
  </div>
  <div class="intro-card-body">
    <div class="intro-card-name">{name}</div>
    <div class="intro-card-desc">{description}</div>
    <span class="intro-card-link">{linkText}</span>
  </div>
</a>
