---
import { url } from "@/lib/url";
import { SITE_TITLE, SITE_TAGLINE, HEADER_NAV } from '@/config/site';
---
<div class="site-header-wrap">
  <header class="site-header" style="position:relative;">
    <button class="hamburger" id="sidebar-toggle" aria-label="Open navigation" aria-expanded="false">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M3 5h14M3 10h14M3 15h14"/>
      </svg>
    </button>
    <a href={url("/")} class="site-title" data-astro-prefetch="hover">
      <img src={url("/favicon.svg")} alt="Site Logo" class="site-logo" />
      <div class="site-title-text">
        <span class="name">{SITE_TITLE}</span>
        <span class="tagline">{SITE_TAGLINE}</span>
      </div>
    </a>
    <div class="header-search-anchor">
      <div class="search-bar" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-owns="search-results" id="search-combobox">
        <button class="search-icon-btn" id="search-icon-btn" aria-label="Open full search">
          <svg aria-hidden="true" width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l3.5 3.5"/></svg>
        </button>
        <input
          type="search"
          id="page-search"
          placeholder="Search spheres, classes, talents…"
          aria-label="Search"
          aria-autocomplete="list"
          aria-controls="search-results"
          autocomplete="off"
        />
      </div>
      <div id="search-results" class="search-results-dropdown" role="listbox" aria-label="Search results" aria-live="polite" hidden></div>
    </div>
    <nav class="header-nav" aria-label="Site navigation">
      {HEADER_NAV.map(({ label, href }) => (
        <a href={url(href)} data-astro-prefetch="hover">{label}</a>
      ))}
      <button class="a11y-trigger" id="a11y-trigger" aria-label="Accessibility options">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="16" cy="4" r="1"/>
          <path d="m18 19 1-7-6 1"/>
          <path d="m5 8 3-3 5.5 3-2.36 3.5"/>
          <path d="M4.24 14.5a5 5 0 0 0 6.88 6"/>
          <path d="M13.76 17.5a5 5 0 0 0-6.88-6"/>
        </svg>
      </button>
    </nav>
  </header>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    document.getElementById('a11y-trigger')?.addEventListener('click', () => {
      (window as any).__a11y?.toggleMenu();
    });
  });
</script>

<script>
  let pagefind: any;

  async function initPagefind() {
    if (pagefind) return;
    try {
      const path = "/spheres-wiki/pagefind/pagefind.js";
      // @ts-ignore
      pagefind = await import(/* @vite-ignore */ path);
      await pagefind.options({
        "excerptLength": 20
      });
      await pagefind.init();
    } catch (e) {
      console.error("Failed to load pagefind", e);
    }
  }

  document.addEventListener('astro:page-load', () => {
    const searchInput  = document.getElementById('page-search') as HTMLInputElement;
    const resultsDiv   = document.getElementById('search-results') as HTMLElement | null;
    const combobox     = document.getElementById('search-combobox');

    function setExpanded(expanded: boolean) {
      combobox?.setAttribute('aria-expanded', String(expanded));
      if (resultsDiv) resultsDiv.hidden = !expanded;
    }

    const searchIconBtn = document.getElementById('search-icon-btn') as HTMLButtonElement | null;

    searchIconBtn?.addEventListener('click', () => {
      const q = searchInput?.value.trim() ?? '';
      window.location.href = q.length >= 2
        ? `${import.meta.env.BASE_URL}search/?q=${encodeURIComponent(q)}`
        : `${import.meta.env.BASE_URL}search/`;
    });

    if (searchInput && resultsDiv) {
      searchInput.addEventListener('focus', initPagefind);

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          setExpanded(false);
          return;
        }
        if (e.key === 'Enter') {
          const q = searchInput.value.trim();
          if (q.length >= 2) {
            window.location.href = `${import.meta.env.BASE_URL}search/?q=${encodeURIComponent(q)}`;
          }
          return;
        }
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          (resultsDiv?.querySelector<HTMLAnchorElement>('.search-result-item'))?.focus();
        }
      });

      searchInput.addEventListener('input', async (e) => {
        const query = (e.target as HTMLInputElement).value;
        if (query.length < 2) {
          setExpanded(false);
          return;
        }

        await initPagefind();
        const search = await pagefind.search(query);

        if (search.results.length === 0) {
          resultsDiv.innerHTML = '<div class="search-no-results">No results found</div>';
          resultsDiv.hidden = false;
          return;
        }

        // Show top 8 results
        const totalCount = search.results.length;
        const results = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
        const q = searchInput.value.trim();

        resultsDiv.innerHTML = results.map(r => {
          const title = r.meta.title || "Untitled";
          const sphere = r.meta.sphere;
          const system = r.meta.system;
          const type = r.meta.type;
          const tier = r.meta.tier;
          const tags = r.meta.tags ? r.meta.tags.split(',').map((t: string) => t.trim()) : [];

          let displayTitle = title;
          if (sphere && type !== 'sphere') displayTitle += ` — ${sphere}`;
          if (system) displayTitle += ` — ${system}`;

          return `
            <a href="${r.url}" class="search-result-item" data-system="${system || ''}">
              <div class="search-result-title">${displayTitle}</div>
              <div class="search-result-meta">
                ${tier ? `<span class="search-badge">${tier}</span>` : ''}
                ${tags.map((t: string) => `<span class="search-badge">${t}</span>`).join('')}
              </div>
              <div class="search-result-excerpt">${r.excerpt}</div>
            </a>
          `;
        }).join('') + (totalCount > 8
          ? `<a href="${import.meta.env.BASE_URL}search/?q=${encodeURIComponent(q)}" class="search-see-all">See all ${totalCount} results →</a>`
          : '');

        setExpanded(true);
      });

      // Arrow nav within dropdown
      resultsDiv.addEventListener('keydown', (e) => {
        const items = [...resultsDiv.querySelectorAll<HTMLAnchorElement>('.search-result-item, .search-see-all')];
        if (e.key === 'Escape') {
          setExpanded(false);
          searchInput.focus();
          return;
        }
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        if (!items.length) return;
        e.preventDefault();
        const idx = items.indexOf(document.activeElement as HTMLAnchorElement);
        if (e.key === 'ArrowDown') {
          (items[idx + 1] ?? items[0]).focus();
        } else {
          if (idx <= 0) searchInput.focus();
          else items[idx - 1].focus();
        }
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target as Node) && !resultsDiv.contains(e.target as Node)) {
          setExpanded(false);
        }
      });
    }
  });
</script>
