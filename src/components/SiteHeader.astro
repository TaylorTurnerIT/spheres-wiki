---
import { url } from "@/lib/url";
import { SITE_TITLE, SITE_TAGLINE, HEADER_NAV } from '@/config/site';
---
<div class="site-header-wrap">
  <header class="site-header" style="position:relative;">
    <button class="hamburger" id="sidebar-toggle" aria-label="Open navigation" aria-expanded="false">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M3 5h14M3 10h14M3 15h14"/>
      </svg>
    </button>
    <a href={url("/")} class="site-title" data-astro-prefetch="hover">
      <span class="name">{SITE_TITLE}</span>
      <span class="tagline">{SITE_TAGLINE}</span>
    </a>
    <div class="header-search-anchor">
      <div class="search-bar">
        <svg aria-hidden="true" width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l3.5 3.5"/></svg>
        <input type="search" id="page-search" placeholder="Search spheres, classes, talents…" aria-label="Search" autocomplete="off" />
      </div>
      <div id="search-results" class="search-results-dropdown" hidden></div>
    </div>
    <nav class="header-nav" aria-label="Site navigation">
      {HEADER_NAV.map(({ label, href }) => (
        <a href={url(href)} data-astro-prefetch="hover">{label}</a>
      ))}
    </nav>
  </header>
</div>

<script>
  let pagefind: any;

  async function initPagefind() {
    if (pagefind) return;
    try {
      const path = "/spheres-wiki/pagefind/pagefind.js";
      // @ts-ignore
      pagefind = await import(/* @vite-ignore */ path);
      await pagefind.options({
        "excerptLength": 20
      });
      await pagefind.init();
    } catch (e) {
      console.error("Failed to load pagefind", e);
    }
  }

  const searchInput = document.getElementById('page-search') as HTMLInputElement;
  const resultsDiv = document.getElementById('search-results');

  if (searchInput && resultsDiv) {
    searchInput.addEventListener('focus', initPagefind);

    searchInput.addEventListener('input', async (e) => {
      const query = (e.target as HTMLInputElement).value;
      if (query.length < 2) {
        resultsDiv.hidden = true;
        return;
      }

      await initPagefind();
      const search = await pagefind.search(query);

      if (search.results.length === 0) {
        resultsDiv.innerHTML = '<div class="search-no-results">No results found</div>';
        resultsDiv.hidden = false;
        return;
      }

      // Show top 8 results
      const results = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));

      resultsDiv.innerHTML = results.map(r => `
        <a href="${r.url}" class="search-result-item">
          <div class="search-result-title">${r.meta.title}</div>
          <div class="search-result-excerpt">${r.excerpt}</div>
        </a>
      `).join('');

      resultsDiv.hidden = false;
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target as Node) && !resultsDiv.contains(e.target as Node)) {
        resultsDiv.hidden = true;
      }
    });
  }
</script>
