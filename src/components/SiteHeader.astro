---
import { url } from "@/lib/url";
import { SITE_TITLE, SITE_TAGLINE, HEADER_NAV } from '@/config/site';

const classImages = import.meta.glob<{ default: ImageMetadata }>('../assets/class-images/*.png', { eager: true });
const classImageMap: Record<string, string> = Object.fromEntries(
  Object.entries(classImages).map(([p, mod]) => [
    p.split('/').pop()!.split('.')[0],
    mod.default.src
  ])
);
---
<div class="site-header-wrap">
  <header class="site-header" style="position:relative;">
    <button class="hamburger" id="sidebar-toggle" aria-label="Open navigation" aria-expanded="false">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M3 5h14M3 10h14M3 15h14"/>
      </svg>
    </button>
    <a href={url("/")} class="site-title" data-astro-prefetch="hover">
      <svg class="site-logo-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="49" height="49" aria-hidden="true" focusable="false">
        <defs>
          <clipPath id="hdr-sphere"><circle cx="64" cy="64" r="52"/></clipPath>
          <radialGradient id="hdr-glow" cx="38%" cy="35%" r="62%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.22"/>
            <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
          </radialGradient>
        </defs>
        <circle cx="64" cy="64" r="52" fill="#111"/>
        <g clip-path="url(#hdr-sphere)">
          <rect x="12" y="12" width="52" height="52" fill="#174B93"/>
          <rect x="64" y="12" width="52" height="52" fill="#8f2d00"/>
          <rect x="12" y="64" width="52" height="52" fill="#5A2D96"/>
          <rect x="64" y="64" width="52" height="52" fill="#165A1C"/>
          <g class="logo-orb logo-orb-power">
            <circle cx="40" cy="40" r="14" fill="#1E60BE" opacity=".9"/>
            <circle cx="40" cy="40" r="8"  fill="#4A90E8"/>
            <circle cx="37" cy="37" r="3"  fill="#A0CCFF" opacity=".85"/>
          </g>
          <g class="logo-orb logo-orb-might">
            <circle cx="88" cy="40" r="14" fill="#B83C00" opacity=".9"/>
            <circle cx="88" cy="40" r="8"  fill="#E05800"/>
            <circle cx="85" cy="37" r="3"  fill="#FFD0A0" opacity=".85"/>
          </g>
          <g class="logo-orb logo-orb-guile">
            <circle cx="40" cy="88" r="14" fill="#7A42C0" opacity=".9"/>
            <circle cx="40" cy="88" r="8"  fill="#A870E8"/>
            <circle cx="37" cy="85" r="3"  fill="#E0C8FF" opacity=".85"/>
          </g>
          <g class="logo-orb logo-orb-champ">
            <circle cx="88" cy="88" r="14" fill="#1E7A28" opacity=".9"/>
            <circle cx="88" cy="88" r="8"  fill="#2EAA3C"/>
            <circle cx="85" cy="85" r="3"  fill="#98E8A8" opacity=".85"/>
          </g>
          <line x1="64" y1="12"  x2="64" y2="116" stroke="#0a0a0a" stroke-width="2.5"/>
          <line x1="12" y1="64"  x2="116" y2="64" stroke="#0a0a0a" stroke-width="2.5"/>
        </g>
        <circle cx="64" cy="64" r="52" fill="none" stroke="#333" stroke-width="2"/>
        <circle cx="64" cy="64" r="6"   fill="#111"/>
        <circle cx="64" cy="64" r="3"   fill="#e8dfc0"/>
        <circle cx="62" cy="62" r="1.2" fill="#fff" opacity=".8"/>
        <circle cx="64" cy="64" r="52"  fill="url(#hdr-glow)"/>
      </svg>
      <div class="site-title-text">
        <span class="name">{SITE_TITLE}</span>
        <span class="tagline">{SITE_TAGLINE}</span>
      </div>
    </a>
    <div class="header-search-anchor">
      <div class="search-bar" id="search-combobox" data-class-images={JSON.stringify(classImageMap)}>
        <button class="search-icon-btn" id="search-icon-btn" aria-label="Open full search" tabindex="-1">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
        </button>
        <input
          type="search"
          id="page-search"
          role="combobox"
          placeholder="Search spheres, classes, talents…"
          aria-label="Search"
          aria-autocomplete="list"
          aria-controls="search-results"
          aria-expanded="false"
          aria-haspopup="listbox"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      <div id="search-results" class="search-results-dropdown" role="listbox" aria-label="Search results" aria-live="polite" hidden></div>
    </div>
    <nav class="header-nav" aria-label="Site navigation">
      {HEADER_NAV.map(({ label, href }) => (
        <a href={url(href)} data-astro-prefetch="hover">{label}</a>
      ))}
    </nav>
  </header>
</div>

<script>
  import {
    detectEntryType,
    groupSearchResults,
    renderResultsPanel,
    type HeaderSearchItem,
  } from "@/lib/headerSearchClient";

  let pagefind: any;
  let browseManifest: any[] = [];
  let browseManifestPromise: Promise<void> | null = null;
  let cleanupHeaderPage = () => {};
  let searchSerial = 0;

  async function loadBrowseManifest() {
    if (browseManifest.length > 0) return;
    if (!browseManifestPromise) {
      browseManifestPromise = fetch(`${import.meta.env.BASE_URL}search/data.json`)
        .then((r) => r.json())
        .then((entries: any[]) => {
          browseManifest = entries;
        })
        .catch(() => {});
    }
    await browseManifestPromise;
  }

  async function initPagefind() {
    if (pagefind) return;
    try {
      const path = `${import.meta.env.BASE_URL}pagefind/pagefind.js`;
      // @ts-ignore
      pagefind = await import(/* @vite-ignore */ path);
      await pagefind.options({
        excerptLength: 20,
      });
      await pagefind.init();
    } catch {
      await loadBrowseManifest();
    }
  }

  document.addEventListener("astro:before-swap", () => {
    cleanupHeaderPage();
    cleanupHeaderPage = () => {};
  });

  document.addEventListener("astro:page-load", () => {
    cleanupHeaderPage();
    const searchInput = document.getElementById("page-search") as HTMLInputElement | null;
    const resultsDiv = document.getElementById("search-results") as HTMLElement | null;
    const combobox = document.getElementById("search-combobox") as HTMLElement | null;
    const searchIconBtn = document.getElementById("search-icon-btn") as HTMLButtonElement | null;
    const controller = new AbortController();
    const { signal } = controller;

    if (!searchInput || !resultsDiv || !combobox) {
      cleanupHeaderPage = () => controller.abort();
      return;
    }

    let classImageMap: Record<string, string> = {};
    try {
      classImageMap = JSON.parse(combobox.dataset.classImages || "{}");
    } catch {}

    let selectedIndex = -1;
    let totalItems = 0;

    function setExpanded(expanded: boolean) {
      searchInput?.setAttribute("aria-expanded", String(expanded));
      if (resultsDiv) resultsDiv.hidden = !expanded;
      if (!expanded) {
        selectedIndex = -1;
      }
    }

    function updateSelection(idx: number) {
      const items = [...resultsDiv!.querySelectorAll<HTMLAnchorElement>(".search-panel-item")];
      totalItems = items.length;
      if (totalItems === 0) {
        selectedIndex = -1;
        return;
      }
      if (idx < 0) idx = 0;
      if (idx >= totalItems) idx = totalItems - 1;
      selectedIndex = idx;

      items.forEach((item, i) => {
        const isSelected = i === selectedIndex;
        item.classList.toggle("is-selected", isSelected);
        item.setAttribute("aria-selected", String(isSelected));
        if (isSelected) {
          item.scrollIntoView({ block: "nearest" });
        }
      });
    }

    // Global / shortcut to focus search
    function handleGlobalSlash(e: KeyboardEvent) {
      if (e.key === "/" && !e.ctrlKey && !e.metaKey && !e.altKey) {
        const activeEl = document.activeElement as HTMLElement | null;
        if (
          activeEl &&
          (activeEl.tagName === "INPUT" ||
            activeEl.tagName === "TEXTAREA" ||
            activeEl.isContentEditable)
        ) {
          return;
        }
        e.preventDefault();
        searchInput!.focus();
        searchInput!.select();
      }
    }
    window.addEventListener("keydown", handleGlobalSlash, { signal });

    searchIconBtn?.addEventListener(
      "click",
      () => {
        const q = searchInput.value.trim();
        window.location.href =
          q.length >= 2
            ? `${import.meta.env.BASE_URL}search/?q=${encodeURIComponent(q)}`
            : `${import.meta.env.BASE_URL}search/`;
      },
      { signal },
    );

    searchInput.addEventListener(
      "focus",
      () => {
        void initPagefind();
        if (searchInput.value.trim().length >= 2) {
          setExpanded(true);
        }
      },
      { signal },
    );

    searchInput.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "Escape") {
          setExpanded(false);
          return;
        }
        if (e.key === "ArrowDown") {
          e.preventDefault();
          if (resultsDiv.hidden) {
            setExpanded(true);
          } else {
            updateSelection(selectedIndex + 1);
          }
          return;
        }
        if (e.key === "ArrowUp") {
          e.preventDefault();
          if (!resultsDiv.hidden) {
            updateSelection(selectedIndex - 1);
          }
          return;
        }
        if (e.key === "Enter") {
          e.preventDefault();
          const items = [...resultsDiv.querySelectorAll<HTMLAnchorElement>(".search-panel-item")];
          if (selectedIndex >= 0 && items[selectedIndex]) {
            window.location.href = items[selectedIndex].href;
            return;
          }
          const q = searchInput.value.trim();
          if (q.length >= 2) {
            window.location.href = `${import.meta.env.BASE_URL}search/?q=${encodeURIComponent(q)}`;
          }
        }
      },
      { signal },
    );

    searchInput.addEventListener(
      "input",
      async (e) => {
        const query = (e.target as HTMLInputElement).value.trim();
        const serial = ++searchSerial;
        if (query.length < 2) {
          setExpanded(false);
          return;
        }

        await initPagefind();
        if (signal.aborted || serial !== searchSerial) return;

        let searchItems: HeaderSearchItem[] = [];

        if (pagefind) {
          const search = await pagefind.search(query);
          if (signal.aborted || serial !== searchSerial) return;
          const top = search.results.slice(0, 30);
          const rawData = await Promise.all(top.map((r: any) => r.data()));
          if (signal.aborted || serial !== searchSerial) return;

          searchItems = rawData
            .filter((r: any) => !r.url.endsWith("#overview"))
            .map((r: any) => {
              const type = detectEntryType(r.meta?.type, r.url);
              const tags = r.meta?.tags
                ? r.meta.tags.split(",").map((t: string) => t.trim()).filter(Boolean)
                : [];
              return {
                url: r.url,
                title: r.meta?.title || "Untitled",
                type,
                sphere: r.meta?.sphere,
                system: r.meta?.system,
                tier: r.meta?.tier,
                tags,
                icon: r.meta?.icon,
                talentCount: r.meta?.talentCount ? parseInt(r.meta.talentCount, 10) : undefined,
                subtitle: r.meta?.subtitle,
              };
            });
        } else if (browseManifest.length > 0) {
          const qLower = query.toLowerCase();
          searchItems = browseManifest
            .filter((entry) =>
              (entry.title && entry.title.toLowerCase().includes(qLower)) ||
              (entry.sphere && entry.sphere.toLowerCase().includes(qLower)) ||
              (entry.tags && entry.tags.toLowerCase().includes(qLower))
            )
            .slice(0, 30)
            .map((entry) => ({
              url: entry.url,
              title: entry.title,
              type: entry.type,
              sphere: entry.sphere,
              system: entry.system,
              icon: entry.icon,
              talentCount: entry.talentCount,
              subtitle: entry.subtitle,
            }));
        }

        const groups = groupSearchResults(searchItems);
        const { html, totalRendered } = renderResultsPanel(groups, classImageMap, query);

        resultsDiv.innerHTML = html;
        totalItems = totalRendered;
        selectedIndex = totalRendered > 0 ? 0 : -1;
        setExpanded(true);
      },
      { signal },
    );

    // Mouse selection tracking
    resultsDiv.addEventListener(
      "mousemove",
      (e) => {
        const item = (e.target as HTMLElement).closest(".search-panel-item") as HTMLAnchorElement | null;
        if (!item) return;
        const idx = parseInt(item.dataset.idx || "-1", 10);
        if (idx >= 0 && idx !== selectedIndex) {
          updateSelection(idx);
        }
      },
      { signal },
    );

    // Close when clicking outside
    document.addEventListener(
      "click",
      (e) => {
        if (
          !searchInput.contains(e.target as Node) &&
          !resultsDiv.contains(e.target as Node)
        ) {
          setExpanded(false);
        }
      },
      { signal },
    );

    cleanupHeaderPage = () => {
      searchSerial += 1;
      controller.abort();
      setExpanded(false);
    };
  });
</script>
