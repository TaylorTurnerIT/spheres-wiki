---
import SphereBadge from "./SphereBadge.astro";

interface Props {
  spheres?: { id: string; name: string; icon: string; badge?: string }[];
  system?: "power" | "might" | "guile" | "champions";
  className?: string;
  style?: string;
}

const { spheres = [], system, className = "", style } = Astro.props;
---
<div class={`sphere-badge-grid ${className}`.trim()} style={style}>
  {system && spheres.map(s => (
    <SphereBadge id={s.id} name={s.name} icon={s.icon} system={system} badge={s.badge} />
  ))}
  <slot />
</div>
