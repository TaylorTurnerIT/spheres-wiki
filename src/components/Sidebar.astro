---
import { url } from '@/lib/url';
---
<aside
  class="sidebar"
  id="site-sidebar"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  aria-hidden="true"
>
  <div class="sidebar-inner">
    <button class="sidebar-close" id="sidebar-close" aria-label="Close navigation">✕</button>

    <div class="sidebar-section">
      <h2 class="sidebar-heading nav">Navigation</h2>
      <div class="sidebar-links">
        <a href={url("/about/")} data-astro-prefetch="hover" class="nav">About</a>
        <a href={url("/legal/")} data-astro-prefetch="hover" class="nav">Legal &amp; OGL</a>
        <a href={url("/recent-changes/")} data-astro-prefetch="hover" class="nav">Recent Changes</a>
        <a href={url("/contact/")} data-astro-prefetch="hover" class="nav">Contact</a>
        <a href={url("/contact/")} data-astro-prefetch="hover" class="nav">DDS Discord</a>
        <a href={url("/contact/")} data-astro-prefetch="hover" class="nav">DRS Discord</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <h2 class="sidebar-heading power">Spheres of Power</h2>
      <div class="sidebar-links">
        <a href={url("/power/")} data-astro-prefetch="hover" class="power">Spheres of Power Index</a>
        <a href={url("/power/using-spheres-of-power/")} data-astro-prefetch="hover" class="power">Using Spheres of Power</a>
        <a href={url("/power/casting-traditions/")} data-astro-prefetch="hover" class="power">Casting Traditions</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <h2 class="sidebar-heading might">Spheres of Might</h2>
      <div class="sidebar-links">
        <a href={url("/might/")} data-astro-prefetch="hover" class="might">Spheres of Might Index</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <h2 class="sidebar-heading guile">Spheres of Guile</h2>
      <div class="sidebar-links">
        <a href={url("/guile/")} data-astro-prefetch="hover" class="guile">Spheres of Guile Index</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <h2 class="sidebar-heading champ">Champions</h2>
      <div class="sidebar-links">
        <a href={url("/champions/")} data-astro-prefetch="hover" class="champ">Champions Index</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <div class="sidebar-heading nav">Other Systems</div>
      <div class="sidebar-links">
        <span class="nav" style="padding: 0.5rem 1.25rem; color: var(--clr-text-muted); font-style: italic;">Coming soon</span>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <div class="sidebar-heading nav">Quick Links</div>
      <div class="sidebar-links">
        <a href={url("/power/how-to-build-spherecaster/")} data-astro-prefetch="hover">How to Build a Spherecaster</a>
        <a href={url("/community-resources/")} data-astro-prefetch="hover">Community Resources</a>
      </div>
    </div>
  </div>
</aside>

