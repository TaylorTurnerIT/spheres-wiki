---
import { url } from '@/lib/url';
import ScrapeProof from '@/components/ScrapeProof.astro';
---
<aside
  class="sidebar"
  id="site-sidebar"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  aria-hidden="true"
>
  <div class="sidebar-inner">
    <button class="sidebar-close" id="sidebar-close" aria-label="Close navigation">✕</button>

    <div class="sidebar-section">
      <h2 class="sidebar-heading nav">Navigation</h2>
      <div class="sidebar-links">
        <a href={url("/about/")} data-astro-prefetch="hover" class="nav">About</a>
        <a href={url("/legal/")} data-astro-prefetch="hover" class="nav">Legal &amp; OGL</a>
        <a href={url("/recent-changes/")} data-astro-prefetch="hover" class="nav">Recent Changes</a>
        <a href={url("/contact/")} data-astro-prefetch="hover" class="nav">Contact</a>
        <ScrapeProof type="discord" value="EfDKxcH" label="DDS Discord" class="nav sidebar-discord" />
        <ScrapeProof type="discord" value="Q89NBmmK6a" label="DRS Discord" class="nav sidebar-discord" />
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <h2 class="sidebar-heading power">Spheres of Power</h2>
      <div class="sidebar-links">
        <a href={url("/power/")} data-astro-prefetch="hover" class="power">Using Spheres of Power</a>
        <a href={url("/power/")} data-astro-prefetch="hover" class="power">Magic Spheres</a>
        <a href={url("/power/")} data-astro-prefetch="hover" class="power">Spherecasters</a>
        <a href={url("/power/")} data-astro-prefetch="hover" class="power">Advanced Magic</a>
        <a href={url("/power/")} data-astro-prefetch="hover" class="power">Magic Options</a>
        <a href={url("/power/")} data-astro-prefetch="hover" class="power">Magical Items</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <h2 class="sidebar-heading might">Spheres of Might</h2>
      <div class="sidebar-links">
        <a href={url("/might/")} data-astro-prefetch="hover" class="might">Using Spheres of Might</a>
        <a href={url("/might/")} data-astro-prefetch="hover" class="might">Combat Spheres</a>
        <a href={url("/might/")} data-astro-prefetch="hover" class="might">Practitioners</a>
        <a href={url("/might/")} data-astro-prefetch="hover" class="might">Martial Options</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <h2 class="sidebar-heading guile">Spheres of Guile</h2>
      <div class="sidebar-links">
        <a href={url("/guile/")} data-astro-prefetch="hover" class="guile">Using Spheres of Guile</a>
        <a href={url("/guile/")} data-astro-prefetch="hover" class="guile">Skill Spheres</a>
        <a href={url("/guile/")} data-astro-prefetch="hover" class="guile">Operatives</a>
        <a href={url("/guile/")} data-astro-prefetch="hover" class="guile">Skill Options</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <h2 class="sidebar-heading champ">Champions</h2>
      <div class="sidebar-links">
        <a href={url("/champions/")} data-astro-prefetch="hover" class="champ">Using Champions</a>
        <a href={url("/champions/")} data-astro-prefetch="hover" class="champ">Champion Classes</a>
        <a href={url("/champions/")} data-astro-prefetch="hover" class="champ">Techniques</a>
        <a href={url("/champions/")} data-astro-prefetch="hover" class="champ">Champion Feats</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <div class="sidebar-heading nav">Other Systems</div>
      <div class="sidebar-links">
        <a href={url("/akashic-mysteries/")} data-astro-prefetch="hover">Akashic Mysteries</a>
        <a href={url("/arcforge/")} data-astro-prefetch="hover">Arcforge</a>
        <a href={url("/city-of-7-seraphs/")} data-astro-prefetch="hover">City of 7 Seraphs</a>
        <a href={url("/cthulhu-mythos/")} data-astro-prefetch="hover">Cthulhu Mythos</a>
        <a href={url("/gonzo/")} data-astro-prefetch="hover">Gonzo</a>
        <a href={url("/mythic-rules/")} data-astro-prefetch="hover">Mythic Rules</a>
        <a href={url("/pact-magic/")} data-astro-prefetch="hover">Pact Magic</a>
        <a href={url("/strange-magic/")} data-astro-prefetch="hover">Strange Magic</a>
      </div>
    </div>

    <hr class="sidebar-divider" />

    <div class="sidebar-section">
      <div class="sidebar-heading nav">Quick Links</div>
      <div class="sidebar-links">
        <a href={url("/how-to-build-champion/")} data-astro-prefetch="hover">How to Build a Champion</a>
        <a href={url("/how-to-build-practitioner/")} data-astro-prefetch="hover">How to Build a Practitioner</a>
        <a href={url("/how-to-build-spherecaster/")} data-astro-prefetch="hover">How to Build a Spherecaster</a>
        <a href={url("/community-resources/")} data-astro-prefetch="hover">Community Resources</a>
      </div>
    </div>
  </div>
</aside>

<style>
  :global(.sidebar-discord) {
    text-decoration: none;
  }
</style>
