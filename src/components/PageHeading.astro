---
import SphereIcon from "@/components/SphereIcon.astro";
/**
 * PageHeading — canonical listing-page title cluster: hidden Pagefind
 * meta/filter spans, system-colored h1, and the title rule. EntryDetailPage
 * covers detail routes; this covers the listing pages (class, archetype,
 * sphere index) that hand-rolled the same cluster.
 */
import { resolveSystem } from "@/lib/systems";
import PagefindMetadata from "@/components/PagefindMetadata.astro";

interface Props {
  name: string;
  system: string;
  /** e.g. "type:class", "type:archetype", "type:sphere" */
  type: string;
  /** System search filter, rendered as both filter and meta */
  searchFilter?: string;
  /** Sphere icon id rendered through the shared SphereIcon */
  icon?: string;
  /** Pagefind heading weight (default "10") */
  weight?: string;
  /** View-transition name */
  transitionName?: string;
  /** Sphere talent count for search metadata */
  talentCount?: number;
  /** Class or page subtitle for search metadata */
  subtitle?: string;
}

const { name, system, type, searchFilter, icon, weight = "10", transitionName, talentCount, subtitle } = Astro.props;
const sysConfig = resolveSystem(system)!;
const meta = {
  title: name,
  type: type.replace(/^type:/, ''),
  ...(searchFilter ? { system: searchFilter.replace(/^system:/, '') } : {}),
  ...(icon ? { icon } : {}),
  ...(talentCount !== undefined ? { talentCount: String(talentCount) } : {}),
  ...(subtitle ? { subtitle } : {}),
};
---
<PagefindMetadata meta={meta} />
<h1
  class={`page-title ${sysConfig.cssKey}`}
  id="overview"
  data-pagefind-weight={weight}
  transition:name={transitionName}
>
  {icon && <SphereIcon icon={icon} class="page-title-icon" loading="eager" />}
  {name}
</h1>
