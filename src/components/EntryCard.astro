---
import TagBadge from "@/components/TagBadge.astro";
import type { TagEntry, BookMeta } from "@/lib/types";

interface Props {
  name: string;
  sourceBookTitle?: string | null;
  tagIds?: string[];
  Content?: any;
  href?: string;
  metadata?: Record<string, string>;
  entryLists?: { label: string; items: { name: string; href: string }[] }[];
  id?: string;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
  builderActions?: { entryId: string; kind: "drawback" | "sphere-drawback" | "boon" }[];
  transitionName?: string;
  pagefindWeight?: string;
  anchorOn?: "heading" | "block";
}

const {
  name,
  sourceBookTitle,
  tagIds = [],
  Content,
  href,
  metadata,
  id,
  tagMap,
  bookMetaMap,
  entryLists = [],
  builderActions = [],
  transitionName,
  pagefindWeight,
  anchorOn = "heading",
} = Astro.props;

const hasMetadata = metadata && Object.keys(metadata).length > 0;
---

<div class="entry-card-block" id={anchorOn === "block" ? id : undefined} data-pagefind-weight={pagefindWeight}>
  <div class="talent-header">
    <div class="talent-header-top">
      <h3 class="entry-card-heading" id={anchorOn === "heading" ? id : undefined}>
        {href
          ? <a href={href} class="talent-name" data-astro-prefetch="hover" transition:name={transitionName}>{name}</a>
          : <span class="talent-name">{name}</span>
        }
      </h3>
      {sourceBookTitle && <span class="talent-source">{sourceBookTitle}</span>}
    </div>
    {tagIds.length > 0 && (
      <div class="talent-header-bottom">
        {tagIds.map(tagId => (
          <TagBadge tagId={tagId} tagMap={tagMap} bookMetaMap={bookMetaMap} />
        ))}
      </div>
    )}
  </div>
  <slot />
  {hasMetadata && (
    <div class="entry-card-details">
      {Object.entries(metadata!).map(([k, v]) => (
        <div class="ec-meta-row">
          <strong>{k}:</strong> {v}
        </div>
      ))}
    </div>
  )}
  {Content && <div class="entry-description"><Content /></div>}
  {entryLists.length > 0 && (
    <div class="entry-card-details">
      {entryLists.map((list) => (
        <div class="ec-meta-row">
          <strong>{list.label}:</strong>{" "}
          {list.items.map((item, i) => (
            <>
              {i > 0 && ", "}
              <a href={item.href}>{item.name}</a>
            </>
          ))}
        </div>
      ))}
    </div>
  )}
  {builderActions.length > 0 && (
    <div class="entry-card-actions">
      {builderActions.map((action) => (
        <button
          class="entry-card-action-btn"
          data-action-add={action.entryId}
          data-action-kind={action.kind}
          type="button"
        >
          Add to Builder
        </button>
      ))}
    </div>
  )}
</div>

<style>
  .entry-card-block {
    border: 1px solid var(--clr-border);
    border-left: 3px solid var(--clr-active);
    border-radius: var(--radius);
    background: var(--clr-bg);
    padding: 12px 14px;
    margin: 14px 0;
    position: relative;
  }

  .entry-card-block:hover,
  .entry-card-block:focus-within {
    z-index: 10;
  }

  /* .talent-list spaces cards with its own gap */
  :global(.talent-list) > .entry-card-block {
    margin: 0;
  }

  .entry-card-heading {
    font-size: inherit;
    line-height: inherit;
    margin: 0;
  }

  .entry-card-details {
    font-size: var(--fs-sm);
    margin: 6px 0 4px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--clr-border);
  }

  .ec-meta-row strong {
    font-weight: 600;
  }

  .ec-meta-row a {
    text-decoration: none;
  }

  .ec-meta-row a:hover {
    text-decoration: underline;
  }
</style>
