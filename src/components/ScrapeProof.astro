---
/**
 * Scrape-proof link component.
 *
 * Static HTML: bare <span id> only.
 * Encoding: key derived from uid via fold (never stored), value XOR'd into raw
 * binary base64. No comma-separated decimals, no named enc/key vars, no key
 * in payload. Scraper needs uid + derivation function + XOR to recover value.
 */

interface Props {
  type: 'email' | 'discord';
  value: string;
  label?: string;
  class?: string;
}

const { type, value, label, class: cls } = Astro.props;

const uid = `sp-${Math.random().toString(36).slice(2, 9)}`;
// Key derived from uid — same fold used in browser script, not stored in payload
const KEY = [...uid].reduce((a, c) => (a ^ c.charCodeAt(0)) & 0xff, 0x42);
const enc = [...value].map(c => c.charCodeAt(0) ^ KEY);
// Raw binary base64 — no delimiters, no decimal numbers after decode
const payload = Buffer.from(enc).toString('base64');

const linkSetup = type === 'email'
  ? `_4.href='ma'+'il'+'to:'+_3;_4.textContent=_3;`
  : `_4.href='ht'+'tps://'+'di'+'sc'+'or'+'d.gg/'+_3;_4.textContent=${JSON.stringify(label ?? 'Join Discord')};_4.target='_blank';_4.rel='noopener noreferrer';`;

const clsSetup = cls ? `_4.className=${JSON.stringify(cls)};` : '';

const script = `(function(){var _e=document.getElementById(${JSON.stringify(uid)});function _r(){if(!_e||_e.tagName==='A')return;var _k=[..._e.id].reduce(function(a,c){return(a^c.charCodeAt(0))&255},66);var _p=atob(${JSON.stringify(payload)});var _3=[..._p].map(function(c){return String.fromCharCode(c.charCodeAt(0)^_k)}).join('');var _4=document.createElement('a');${clsSetup}${linkSetup}_e.replaceWith(_4)}document.addEventListener('astro:page-load',_r);if(document.readyState!=='loading')_r()})();`;
---

<span id={uid}></span>
<script set:html={script}></script>
