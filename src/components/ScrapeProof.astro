---
/**
 * Scrape-proof link component.
 *
 * Static HTML: bare <span id> only — no href, no data attributes, no readable value.
 * Runtime: inline script XOR-decodes the value and document.createElement's the <a>.
 *
 * type "email"   — value is full address ("user@domain.com")
 * type "discord" — value is invite code only ("EfDKxcH")
 */

interface Props {
  type: 'email' | 'discord';
  value: string;
  label?: string;
  class?: string;
}

const { type, value, label, class: cls } = Astro.props;

const KEY = 0x1f;
const enc = [...value].map(c => c.charCodeAt(0) ^ KEY);
const uid = `sp-${Math.random().toString(36).slice(2, 9)}`;
---

<span id={uid}></span>

<script define:vars={{ uid, enc, type, label, cls, KEY }} is:inline>
(function() {
  function build() {
    var el = document.getElementById(uid);
    if (!el || el.tagName === 'A') return;
    var val = enc.map(function(n) { return String.fromCharCode(n ^ KEY); }).join('');
    var a = document.createElement('a');
    if (cls) a.className = cls;
    if (type === 'email') {
      a.href = 'ma' + 'il' + 'to:' + val;
      a.textContent = val;
    } else if (type === 'discord') {
      a.href = 'ht' + 'tps://' + 'di' + 'sc' + 'or' + 'd.gg/' + val;
      a.textContent = label || 'Join Discord';
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
    }
    el.replaceWith(a);
  }
  document.addEventListener('astro:page-load', build);
  if (document.readyState !== 'loading') build();
})();
</script>
