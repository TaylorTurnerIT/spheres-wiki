---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';

const { classMap } = await resolveEntries();

const classes = [...classMap.values()]
  .filter(c => c.system === 'champions')
  .sort((a, b) => a.name.localeCompare(b.name));
---
<WikiPage title="Champions of the Spheres — Spheres Wiki" activeNamespace="champions" pagefindIgnore={true}>

  <div class="system-banner" aria-hidden="true">
    <svg viewBox="0 0 800 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="champBannerGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#165A1C" stop-opacity="0.32"/>
          <stop offset="100%" stop-color="#091E0C" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="800" height="140" fill="#091E0C"/>
      <rect width="800" height="140" fill="url(#champBannerGlow)"/>
      
      <g>
        <path d="M -80 -20 L -80 -10 Q 200 45 400 4 Q 600 45 880 -10 L 880 -20 Z" fill="#0C2B12" opacity="0.9"/>
        <path d="M -80 -20 L -80 -15 Q 200 35 400 2 Q 600 35 880 -15 L 880 -20 Z" fill="#123F1B" />
      </g>
      
      <g transform="scale(2, 1.75)">
        <path d="M -20 -10 L 60 -10 C 40 25, 15 50, 30 85 L -20 85 Z" fill="#185625"/>
        <path d="M -20 -10 L 40 -10 C 25 25, 5  50, 18 85 L -20 85 Z" fill="#123F1B"/>
        <path d="M -20 -10 L 20 -10 C 10 25, -5 50, 6 85 L -20 85 Z" fill="#0C2B12"/>
        <path d="M -10 45 Q 15 52 29 45 L 27 50 Q 15 56 -10 50 Z" fill="#40C054"/>
      </g>
      
      <g transform="translate(800, 0) scale(-2, 1.75)">
        <path d="M -20 -10 L 60 -10 C 40 25, 15 50, 30 85 L -20 85 Z" fill="#185625"/>
        <path d="M -20 -10 L 40 -10 C 25 25, 5  50, 18 85 L -20 85 Z" fill="#123F1B"/>
        <path d="M -20 -10 L 20 -10 C 10 25, -5 50, 6 85 L -20 85 Z" fill="#0C2B12"/>
        <path d="M -10 45 Q 15 52 29 45 L 27 50 Q 15 56 -10 50 Z" fill="#40C054"/>
      </g>

      <g transform="translate(400,70) scale(1.9) translate(-100,-40)">
        <circle cx="100" cy="40" r="30" fill="#165A1C" opacity=".3"/>
        <circle cx="100" cy="40" r="22" fill="#1E7028" opacity=".3"/>
        <path d="M100 14 L107 32 L126 32 L111 43 L118 61 L100 50 L82 61 L89 43 L74 32 L93 32 Z" fill="#1A6E22" stroke="#40C054" stroke-width="1.2"/>
        <circle cx="100" cy="40" r="9"  fill="#1E8030"/>
        <circle cx="100" cy="40" r="5.5" fill="#30AA46"/>
        <circle cx="98"  cy="38" r="2.2" fill="#90E8A0" opacity=".75"/>
      </g>
    </svg>
  </div>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Champions of the Spheres</span>
  </nav>

  <h1 class="page-title champ">Champions of the Spheres</h1>
  <p>Champions of the Spheres bridges the gap between magic and martial combat, providing classes and options that seamlessly integrate Spheres of Power and Spheres of Might.</p>
  <hr class="page-title-rule" />
  <div class="gs-grid">
    <a href={url("/champions/using-champions/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 3h5a1 1 0 0 1 1 1v9H2V3zM14 3H9a1 1 0 0 0-1 1v9h6V3z"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">Using Champions of the Spheres</div>
        <div class="gs-card-desc">Rules for combining magic and martial prowess in combat.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
    <a href={url("/power/how-to-build-champion/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 3.5v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1zM4 6.5h8M4 9.5h5"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">How to Build a Champion</div>
        <div class="gs-card-desc">A step-by-step guide to creating your first hybrid character.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
  </div>
  <hr class="page-title-rule" />

  <div class="classes-and-links">
    <div class="class-column">
      {classes.length > 0 && (
        <>
          <div class="section-heading" style="margin-top: 0;">
            <span class="section-heading-text">Champion Classes</span>
            <div class="section-heading-rule"></div>
          </div>
          <div class="class-lists">
            <div class="class-tier-group">
              <div class="class-tier-label">Classes</div>
              <div class="class-roster">
                {classes.map(c => (
                  <a href={url(`/champions/${c.id}/`)} class="class-item" data-astro-prefetch="hover">
                    <div class="class-item-header">
                      <span class="class-item-name">{c.name}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </>
      )}
    </div>

    <div class="quick-links-column">
      <div class="section-heading" style="margin-top: 0;">
        <span class="section-heading-text">Quick Links</span>
        <div class="section-heading-rule"></div>
      </div>
      <div class="quick-links-grid">
        <div class="quick-links-group">
          <h3 class="quick-links-heading">Rules</h3>
          <ul class="quick-links-list">
            <li><a href={url("/champions/using-champions/")}>Using Champions of the Spheres</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

</WikiPage>
