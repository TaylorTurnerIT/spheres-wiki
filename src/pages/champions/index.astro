---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';

const { classMap } = await resolveEntries();

const classes = [...classMap.values()]
  .filter(c => c.system === 'champions')
  .sort((a, b) => a.name.localeCompare(b.name));
---
<WikiPage title="Champions of the Spheres — Spheres Wiki" activeNamespace="champions">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Champions of the Spheres</span>
  </nav>

  <h1 class="page-title champ">Champions of the Spheres</h1>
  <hr class="page-title-rule" />

  <div class="section-heading">
    <span class="section-heading-text">Champion Classes</span>
    <div class="section-heading-rule"></div>
  </div>

  <div class="entry-grid">
    {classes.map(c => (
      <a href={url(`/champions/${c.id}/`)} class="entry-card champ" data-astro-prefetch="hover">
        <div class="entry-card-header">
          <svg class="si entry-card-icon" aria-hidden="true"><use href="#si-champ-star" /></svg>
          <span class="entry-card-name">{c.name}</span>
        </div>
        {/* description from GFM body — wired in R1-6 */}
      </a>
    ))}
  </div>

</WikiPage>
