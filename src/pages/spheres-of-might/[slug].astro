---
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import type { SphereEntry, ClassEntry, TalentEntry } from '@/lib/types';

interface Props {
  kind: 'sphere' | 'class';
  sphere: SphereEntry | undefined;
  cls: ClassEntry | undefined;
  basic: TalentEntry[];
  advanced: TalentEntry[];
  legendary: TalentEntry[];
}

export async function getStaticPaths() {
  const { sphereMap, classMap, talentMap } = await resolveEntries();
  const paths = [];

  for (const [, sphere] of sphereMap) {
    if (sphere.namespace !== 'might') continue;
    const all = [...talentMap.values()].filter(t => t.sphere === sphere.id);
    const basic     = all.filter(t => t.tier === 'basic').sort((a, b) => a.name.localeCompare(b.name));
    const advanced  = all.filter(t => t.tier === 'advanced').sort((a, b) => a.name.localeCompare(b.name));
    const legendary = all.filter(t => t.tier === 'legendary').sort((a, b) => a.name.localeCompare(b.name));
    paths.push({ params: { slug: sphere.id }, props: { kind: 'sphere' as const, sphere, cls: undefined, basic, advanced, legendary } });
  }

  for (const [, cls] of classMap) {
    if (cls.namespace !== 'might') continue;
    paths.push({ params: { slug: cls.id }, props: { kind: 'class' as const, sphere: undefined, cls, basic: [], advanced: [], legendary: [] } });
  }

  return paths;
}

const { kind, sphere, cls, basic, advanced, legendary } = Astro.props;
const entryName = kind === 'sphere' ? sphere!.name : cls!.name;
---
<WikiPage title={`${entryName} — Spheres of Might Wiki`} activeNamespace="might">

  <nav class="breadcrumb">
    <a href="/">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/spheres-of-might/">Spheres of Might</a>
    <span class="breadcrumb-sep">›</span>
    <span>{entryName}</span>
  </nav>

  {kind === 'sphere' && sphere && (
    <>
      <div class="page-title might">
        <svg class="si page-title-icon" aria-hidden="true"><use href={`#si-${sphere.icon}`} /></svg>
        {sphere.name}
      </div>
      <hr class="page-title-rule" />

      <div class="entry-description">{sphere.description}</div>

      {basic.length > 0 && (
        <div style="margin-top: 18px;">
          <div class="section-heading">
            <span class="section-heading-text">Basic Talents</span>
            <div class="section-heading-rule"></div>
          </div>
          <div class="talent-list">
            {basic.map(t => (
              <div class="talent-entry">
                <div class="talent-header">
                  <span class="talent-name">{t.name}</span>
                  <span class="talent-tier basic">Basic</span>
                </div>
                <div class="talent-body">{t.description}</div>
              </div>
            ))}
          </div>
        </div>
      )}

      {advanced.length > 0 && (
        <div style="margin-top: 18px;">
          <div class="section-heading">
            <span class="section-heading-text">Advanced Talents</span>
            <div class="section-heading-rule"></div>
          </div>
          <div class="talent-list">
            {advanced.map(t => (
              <div class="talent-entry">
                <div class="talent-header">
                  <span class="talent-name">{t.name}</span>
                  <span class="talent-tier advanced">Advanced</span>
                </div>
                <div class="talent-body">{t.description}</div>
              </div>
            ))}
          </div>
        </div>
      )}

      {legendary.length > 0 && (
        <div style="margin-top: 18px;">
          <div class="section-heading">
            <span class="section-heading-text">Legendary Talents</span>
            <div class="section-heading-rule"></div>
          </div>
          <div class="talent-list">
            {legendary.map(t => (
              <div class="talent-entry">
                <div class="talent-header">
                  <span class="talent-name">{t.name}</span>
                  <span class="talent-tier legendary">Legendary</span>
                </div>
                <div class="talent-body">{t.description}</div>
              </div>
            ))}
          </div>
        </div>
      )}
    </>
  )}

  {kind === 'class' && cls && (
    <>
      <div class="page-title might">{cls.name}</div>
      <hr class="page-title-rule" />
      <div class="entry-description">{cls.description}</div>
    </>
  )}

</WikiPage>
