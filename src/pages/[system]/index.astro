---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import SystemArt from '@/components/SystemArt.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import SphereBadgeGrid from '@/components/SphereBadgeGrid.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { getSystemPaths, resolveSystem } from '@/lib/systems';
import type { SphereEntry, ClassEntry } from '@/lib/types';

interface Props {
  spheres: SphereEntry[];
  classes: ClassEntry[];
  prestigeClasses: ClassEntry[];
}

export async function getStaticPaths() {
  const { sphereMap, classMap } = await resolveEntries();

  const baseClassIds = [
    'armorist', 'elementalist', 'eliciter', 'fey-adept', 'hedgewitch',
    'incanter', 'mageknight', 'shifter', 'soul-weaver', 'symbiat',
    'thaumaturge', 'wraith',
  ];

  const paths = [];

  for (const { params: { system } } of getSystemPaths()) {
    let spheres = [...sphereMap.values()]
      .filter(s => s.system === system)
      .sort((a, b) => a.name.localeCompare(b.name));

    const allSystemClasses = [...classMap.values()].filter(c => c.system === system);

    const classes = system === 'power'
      ? allSystemClasses.filter(c => baseClassIds.includes(c.id)).sort((a, b) => a.name.localeCompare(b.name))
      : allSystemClasses.sort((a, b) => a.name.localeCompare(b.name));

    const prestigeClasses = system === 'power'
      ? allSystemClasses.filter(c => !baseClassIds.includes(c.id) && c.tags?.includes('prestige')).sort((a, b) => a.name.localeCompare(b.name))
      : [];

    paths.push({
      params: { system },
      props: { spheres, classes, prestigeClasses },
    });
  }

  return paths;
}

const system = Astro.params.system as 'power' | 'might' | 'guile' | 'champions';
const { spheres, classes, prestigeClasses } = Astro.props;

const sysConfig = resolveSystem(system)!;

const classDescs: Record<string, string> = {
  'armorist':     'Focuses on summoning magical weapons and armor to suit the task at hand.',
  'mageknight':   'Essentially a Magic Swordsman, with natural resilience against magical effects and martial techniques powered by Spell Points.',
  'elementalist': 'Focuses on manipulating one or more elements, specializing in the Destruction sphere.',
  'eliciter':     'Focuses on the use of the Mind Sphere to dominate enemies and bend them to your will.',
  'hedgewitch':   'Built around Paths — thematic combinations of powers that can be mixed to create a uniquely talented individual.',
  'shifter':      'Focuses on the Alteration Sphere, with unmatched ability to take and exploit different forms.',
  'symbiat':      'Possessed by a spirit granting control of the Mind and Telekinesis spheres, excelling as a battlefield leader.',
  'wraith':       'Excels in a variety of areas thanks to its choice of a Haunt Path and a suite of supernatural Wraith Haunts.',
  'fey-adept':    'Specializes in the Illusion Sphere, with the ability to imitate other powers through Shadowstuff.',
  'incanter':     'Not so much a class as a toolkit — trades class abilities for more Magic Talents and casting-focused feats than anyone else.',
  'soul-weaver':  'An expert in the use of Life and Death, with a particular emphasis on summoning and bolstering the spirits of the dead.',
  'thaumaturge':  'A dedicated specialist — knows fewer Magic Talents but can enhance and break the limits of what they focus on.',
};

const classTiers = [
  { label: 'Low Casters',  ids: ['armorist', 'mageknight'] },
  { label: 'Mid Casters',  ids: ['elementalist', 'eliciter', 'hedgewitch', 'shifter', 'symbiat', 'wraith'] },
  { label: 'High Casters', ids: ['fey-adept', 'incanter', 'soul-weaver', 'thaumaturge'] },
];

const classById = new Map(classes.map(c => [c.id, c]));

const systemContent: Record<string, {
  intro: string;
  card1Title: string; card1Desc: string; card1Href?: string;
  card2Title: string; card2Desc: string; card2Href?: string;
  card3Title: string; card3Desc: string; card3Href?: string;
}> = {
  power: {
    intro: 'Spheres of Power is a unique magic system created by Drop Dead Studios for use with the Pathfinder Roleplaying Game. In this variant system, players choose their magical abilities from among twenty different spheres, spending Magic Talents to create a uniquely customized character. Spheres of Power is more about what you can do than what you can\'t — it gives you the tools you need to create a character, then lets you decide how to flavor it.',
    card1Title: 'Using Spheres of Power',
    card1Desc: 'Fundamental rules for casting, spell points, and caster levels.',
    card1Href: '/power/using-spheres-of-power/',
    card2Title: 'How to Build a Spherecaster',
    card2Desc: 'A step-by-step guide to creating your first magical character.',
    card2Href: '/power/how-to-build-spherecaster/',
    card3Title: 'Casting Traditions',
    card3Desc: 'Rules for defining how your character uses magic.',
    card3Href: '/power/casting-traditions/',
  },
  might: {
    intro: 'Spheres of Might is a unique martial system created by Drop Dead Studios for use with the Pathfinder Roleplaying Game. In this system, players choose martial abilities from twenty-three different spheres, spending Combat Talents to create a uniquely customized practitioner. Spheres of Might is extremely flexible and focuses on allowing players to build up an idea, rather than pushing them into a specific role.',
    card1Title: 'Explore Spheres of Might',
    card1Desc: 'Browse martial spheres, talents, feats, and practitioner classes.',
    card1Href: '/might/',
    card2Title: 'How to Build a Practitioner',
    card2Desc: 'A step-by-step guide to creating your first martial character.',
    card3Title: 'Martial Traditions',
    card3Desc: 'Tradition rules for martial training and starting talents.',
  },
  guile: {
    intro: 'Spheres of Guile is a new skills-focused system created by Drop Dead Studios for use with the Pathfinder Roleplaying Game. In this variant system, players can learn many new ways to use and apply their skills, allowing them to create a uniquely customized character with abilities beyond simple combat and spellcasting. Spheres of Guile can be played standalone, combined with the other Spheres systems, or utilized as an expansion to the core game rules.',
    card1Title: 'Explore Spheres of Guile',
    card1Desc: 'Browse skill spheres, talents, feats, and operative classes.',
    card1Href: '/guile/',
    card2Title: 'How to Build an Operative',
    card2Desc: 'A step-by-step guide to creating your first skill-based character.',
    card3Title: 'Trade Traditions',
    card3Desc: 'Tradition rules for skill training and professional focus.',
  },
  champions: {
    intro: 'Champions of the Spheres bridges the gap between magic and martial combat, providing classes and options that seamlessly integrate Spheres of Power and Spheres of Might.',
    card1Title: 'Explore Champions of the Spheres',
    card1Desc: 'Browse hybrid classes and options that combine Power and Might.',
    card1Href: '/champions/',
    card2Title: 'How to Build a Champion',
    card2Desc: 'A step-by-step guide to creating your first hybrid character.',
    card3Title: 'Unified Traditions',
    card3Desc: 'Tradition rules for characters blending magic and martial training.',
  },
};

const content = systemContent[system]!;
const cards = [
  { title: content.card1Title, desc: content.card1Desc, href: content.card1Href },
  { title: content.card2Title, desc: content.card2Desc, href: content.card2Href },
  { title: content.card3Title, desc: content.card3Desc, href: content.card3Href },
];
---
<!-- fallow-ignore-next-line complexity -->
<WikiPage title={`${sysConfig.label} — Spheres Wiki`} activeNamespace={system} pagefindIgnore={true}>

<div class="system-banner" aria-hidden="true">
      <SystemArt system={system} variant="banner" />
    </div>

  <Breadcrumb crumbs={[
    { label: "Home", href: url("/") },
    { label: sysConfig.label },
  ]} />

  <h1 class={`page-title ${sysConfig.cssKey}`}>{sysConfig.label}</h1>
  <p>{content.intro}</p>

  <hr class="page-title-rule" />
  <div class="gs-grid">
    {cards.map(card => card.href ? (
      <a href={url(card.href)} class="gs-card" data-astro-prefetch="hover">
        <div class="gs-card-icon">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 3h5a1 1 0 0 1 1 1v9H2V3zM14 3H9a1 1 0 0 0-1 1v9h6V3z"/>
          </svg>
        </div>
        <div class="gs-card-body">
          <div class="gs-card-title">{card.title}</div>
          <div class="gs-card-desc">{card.desc}</div>
        </div>
        <span class="gs-card-arrow" aria-hidden="true">→</span>
      </a>
    ) : (
      <button type="button" class="gs-card" disabled title="Coming soon">
        <div class="gs-card-icon">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 3h5a1 1 0 0 1 1 1v9H2V3zM14 3H9a1 1 0 0 0-1 1v9h6V3z"/>
          </svg>
        </div>
        <div class="gs-card-body">
          <div class="gs-card-title">{card.title}</div>
          <div class="gs-card-desc">{card.desc}</div>
        </div>
        <span class="gs-card-arrow" aria-hidden="true">→</span>
      </button>
    ))}
  </div>
  <hr class="page-title-rule" />

  {spheres.length > 0 && (
    <>
      <SectionHeading level="eyebrow" label={sysConfig.subtitle} />
      <SphereBadgeGrid spheres={spheres} system={system} style={system !== 'power' ? 'margin-bottom: 24px;' : undefined} />
    </>
  )}

  <div class="classes-and-links">
    <div class="class-column">

      {system === 'power' && (
        <>
          <SectionHeading level="eyebrow" label={sysConfig.classLabel} style="margin-top: 0;" />
          <div class="class-lists">
            {classTiers.map(tier => {
              const tierClasses = tier.ids.map(id => classById.get(id)).filter(Boolean);
              return tierClasses.length > 0 && (
                <div class="class-tier-group">
                  <div class="class-tier-label">{tier.label}</div>
                  <div class="class-roster">
                    {tierClasses.map(c => (
                      <a href={url(`/${system}/classes/${c!.id}/`)} class="class-item" data-astro-prefetch="hover">
                        <div class="class-item-header">
                          <span class="class-item-name">{c!.name}</span>
                        </div>
                        {classDescs[c!.id] && <p class="class-item-desc">{classDescs[c!.id]}</p>}
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}

            {prestigeClasses.length > 0 && (
              <div class="class-tier-group">
                <div class="class-tier-label">Prestige Classes</div>
                <div class="class-roster">
                  {prestigeClasses.map(c => (
                    <a href={url(`/${system}/classes/${c.id}/`)} class="class-item" data-astro-prefetch="hover">
                      <div class="class-item-header">
                        <span class="class-item-name">{c.name}</span>
                      </div>
                      {classDescs[c.id] && <p class="class-item-desc">{classDescs[c.id]}</p>}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </>
      )}

      {system !== 'power' && classes.length > 0 && (
        <>
          <SectionHeading level="eyebrow" label={sysConfig.classLabel} style="margin-top: 0;" />
          <div class="class-lists">
            <div class="class-tier-group">
              <div class="class-tier-label">Classes</div>
              <div class="class-roster">
                {classes.map(c => (
                  <a href={url(`/${system}/classes/${c.id}/`)} class="class-item" data-astro-prefetch="hover">
                    <div class="class-item-header">
                      <span class="class-item-name">{c.name}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </>
      )}

    </div>

    <div class="quick-links-column">
      <SectionHeading level="eyebrow" label="Quick Links" style="margin-top: 0;" />
      <div class="quick-links-grid">

        {system === 'power' && (
          <>
            <div class="quick-links-group">
              <h3 class="quick-links-heading">Feats</h3>
              <ul class="quick-links-list">
                <li><a href={url("/feats/")}>Browse all feats</a></li>
              </ul>
            </div>
            <div class="quick-links-group">
              <h3 class="quick-links-heading">Equipment</h3>
              <ul class="quick-links-list">
                <li><a href={url("/power/how-to-build-spherecaster/#what-about-equipment")}>Equipment guidance</a></li>
              </ul>
            </div>
            <div class="quick-links-group">
              <h3 class="quick-links-heading">Rules</h3>
              <ul class="quick-links-list">
                <li><a href={url("/power/casting-traditions/")}>Casting Traditions</a></li>
                <li><a href={url("/power/using-spheres-of-power/#stacking-oaths")}>Stacking Oaths</a></li>
                <li><a href={url("/power/articles/about-advanced-magic/#wild-magic")}>Wild Magic</a></li>
              </ul>
            </div>
          </>
        )}

        {system === 'might' && (
          <div class="quick-links-group">
            <h3 class="quick-links-heading">Rules</h3>
            <ul class="quick-links-list">
              <li><a href={url("/might/")}>Browse Spheres of Might</a></li>
            </ul>
          </div>
        )}

        {system === 'guile' && (
          <div class="quick-links-group">
            <h3 class="quick-links-heading">Rules</h3>
            <ul class="quick-links-list">
              <li><a href={url("/guile/")}>Browse Spheres of Guile</a></li>
            </ul>
          </div>
        )}

      </div>
    </div>
  </div>

</WikiPage>
