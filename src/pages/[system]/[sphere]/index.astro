---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import type { TocItem, TocGroup } from '@/components/TableOfContents.astro';
import { resolveEntries, getCollEntriesMap } from '@/lib/resolveEntries';
import { buildSections } from '@/lib/categorize';
import type { SectionResult } from '@/lib/categorize';
import { splitBodyOnMarkers, renderMarkdownFragment } from '@/lib/renderBody';
import { buildOrderedTagIds } from '@/lib/tags';
import { getFeatUrl } from '@/lib/featCategories';
import EntryCard from '@/components/EntryCard.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { getSystemPaths, resolveSystem, getSystemSearchFilter } from '@/lib/systems';
import type { SphereEntry, TalentEntry, FeatEntry, BookMeta, TagEntry } from '@/lib/types';

interface Props {
  sphere: SphereEntry;
  base: TalentEntry[];
  allTalents: TalentEntry[];
  feats: FeatEntry[];
  sections: SectionResult[];
  mainCollEntry: any;
  talentCollEntries: Map<string, any>;
  featCollEntries: Map<string, any>;
  sourceBook: BookMeta | undefined;
  bookMetaMap: Map<string, BookMeta>;
  tagMap: Map<string, TagEntry>;
}

export async function getStaticPaths() {
  const { sphereMap, talentMap, featMap, bookMetaMap, tagMap } = await resolveEntries();
  const allCollEntries = await getCollEntriesMap();

  const paths = [];

  for (const { params: { system } } of getSystemPaths()) {
    for (const [, sphere] of sphereMap) {
      if (sphere.system !== system) continue;

      const allTalents = [...talentMap.values()].filter(t => (t.sphere === sphere.id || t.dualSphere === sphere.id || t.dualSphere === "any") && t.system === system);
      const base       = allTalents.filter(t => t.tier === 'base').sort((a, b) => a.name.localeCompare(b.name));
      const feats      = [...featMap.values()].filter(f => (f.sphere === sphere.id || f.dualSphere === sphere.id || f.dualSphere === "any") && f.system === system).sort((a, b) => a.name.localeCompare(b.name));

      const sections = buildSections(sphere, allTalents.filter(t => t.tier !== 'base'), feats);

      const talentCollEntries = new Map<string, any>();
      for (const t of allTalents) {
        const entry = allCollEntries.get(`talent:${t.id}`);
        if (entry) talentCollEntries.set(t.id, entry);
      }

      const featCollEntries = new Map<string, any>();
      for (const f of feats) {
        const entry = allCollEntries.get(`feat:${f.id}`);
        if (entry) featCollEntries.set(f.id, entry);
      }

      const mainCollEntry = allCollEntries.get(`sphere:${sphere.id}`);
      const digests = [
        mainCollEntry?.digest,
        ...allTalents.map(t => talentCollEntries.get(t.id)?.digest),
        ...feats.map(f => featCollEntries.get(f.id)?.digest),
      ].filter(Boolean);
      const cacheKey = digests.length > 0 ? digests.join(":") : undefined;

      paths.push({
        params: { system, sphere: sphere.id },
        props: {
          sphere,
          base,
          allTalents,
          feats,
          sections,
          mainCollEntry,
          talentCollEntries,
          featCollEntries,
          sourceBook: bookMetaMap.get(sphere.sourceBook),
          bookMetaMap,
          tagMap,
        },
        ...(cacheKey ? { cacheKey } : {}),
      });
    }
  }

  return paths;
}

const { system } = Astro.params;
const { sphere, base, allTalents, feats, sections, mainCollEntry, talentCollEntries, featCollEntries, sourceBook, bookMetaMap, tagMap } = Astro.props;

const sysConfig = resolveSystem(system!)!;
const searchFilter = getSystemSearchFilter(system!);

const talentById = new Map(allTalents.map(t => [t.id, t]));
const featById = new Map(feats.map(f => [f.id, f]));

type RenderedSegment = { type: 'markdown'; html: string } | { type: 'base-ability'; id: string };
const rawSegments = mainCollEntry ? splitBodyOnMarkers(mainCollEntry.body) : [];
const bodySegments: RenderedSegment[] = await Promise.all(
  rawSegments.map(async (seg) => {
    if (seg.type === 'markdown') {
      return { type: 'markdown' as const, html: await renderMarkdownFragment(seg.text) };
    }
    return seg as { type: 'base-ability'; id: string };
  })
);

const [talentRendered, featRendered] = await Promise.all([
  Promise.all([...talentCollEntries].map(async ([id, entry]) => {
    const { Content } = await render(entry);
    return { id, Content };
  })),
  Promise.all([...featCollEntries].map(async ([id, entry]) => {
    const { Content } = await render(entry);
    return { id, Content };
  })),
]);

const orderedBase: typeof base = [];
const baseSet = new Set(base.map(t => t.id));

for (const seg of bodySegments) {
  if (seg.type === 'base-ability' && baseSet.has(seg.id)) {
    const t = base.find(b => b.id === seg.id);
    if (t) {
      orderedBase.push(t);
      baseSet.delete(seg.id);
    }
  }
}

for (const t of base) {
  if (baseSet.has(t.id)) {
    orderedBase.push(t);
  }
}

const overview: TocItem = {
  id: 'overview',
  label: 'Overview',
  sub: orderedBase.length > 0 ? orderedBase.map(t => ({ id: t.id, label: t.name })) : undefined,
};

const groups: TocGroup[] = sections.map(sec => ({
  label: sec.label,
  categories: sec.categories.map(cat => ({
    id: cat.id,
    label: cat.label,
    sub: cat.entries.map(e => {
      const entry = talentById.get(e.id) ?? featById.get(e.id);
      return { id: e.id, label: entry?.name ?? e.id };
    }),
  })),
}));
---
<WikiPage title={`${sphere.name} — ${sysConfig.label} Wiki`} activeNamespace={system}>

  <Breadcrumb crumbs={[
    { label: "Home", href: url("/") },
    { label: sysConfig.label, href: url(`/${system}/`) },
    { label: sphere.name },
  ]} />

  <div class="content-columns">
    <div class="content-main">

      <span data-pagefind-meta={`title:${sphere.name}`} hidden></span>
      <span data-pagefind-filter="type:sphere" hidden></span>
      <span data-pagefind-filter={searchFilter} hidden></span>
      <h1
        class={`page-title ${sysConfig.cssKey}`}
        id="overview"
        data-pagefind-weight="10"
      >
        <svg class="si page-title-icon" aria-hidden="true"><use href={`#si-${sphere.icon}`} /></svg>
        {sphere.name}
      </h1>
      <span data-pagefind-meta="type:sphere" hidden></span>
      <span data-pagefind-meta={searchFilter} hidden></span>
      <hr class="page-title-rule" />

      {mainCollEntry?.data?.description && (
        <p class="sphere-description">{mainCollEntry.data.description}</p>
      )}

      {bodySegments.map(seg => {
        if (seg.type === 'markdown') {
          return <div class="entry-description" set:html={seg.html} />;
        }
        const t = base.find(b => b.id === seg.id);
        const tContent = talentRendered.find(r => r.id === seg.id);
        const tBook = t ? bookMetaMap.get(t.sourceBook) : undefined;
        return t ? (
          <div data-pagefind-weight="0.5">
            <EntryCard
              id={t.id}
              name={t.name}
              sourceBookTitle={tBook?.title}
              tagIds={buildOrderedTagIds(t, bookMetaMap, tagMap, { currentSphereId: sphere.id })}
              Content={tContent?.Content}
              href={url(`/${system}/${sphere.id}/${t.id}/`)}
              tagMap={tagMap}
              bookMetaMap={bookMetaMap}
            />
          </div>
        ) : null;
      })}
      {sections.length > 0 && (
        <div class="page-actions">
          <button id="toggle-all-sections" class="toggle-all-btn">Collapse All</button>
        </div>
      )}

      {sections.map(sec => (
        <div class="section-group">
          <SectionHeading label={sec.label} />

          {sec.categories.map(cat => (
            <div class="section-block">
              <button class="section-heading section-heading-toggle" data-cat-id={cat.id} aria-expanded="true" aria-controls={`${cat.id}-entries`}>
                <span class="section-heading-chevron" aria-hidden="true">▾</span>
                <span class="section-heading-text" id={cat.id}>{cat.label}</span>
              </button>
              <div class="section-entries" id={`${cat.id}-entries`} aria-hidden="false">
              {cat.entries.length === 0
                ? <p class="section-empty">No entries yet.</p>
                : <div class="talent-list">
                    {cat.entries.map(e => {
                      const talent = talentById.get(e.id);
                      const feat = featById.get(e.id);
                      const entry = talent || feat;
                      if (!entry) return null;

                      const content = talent ? talentRendered.find(r => r.id === e.id) : featRendered.find(r => r.id === e.id);
                      const entryBook = bookMetaMap.get(entry.sourceBook);

                      return (
                        <EntryCard
                          id={entry.id}
                          anchorOn="block"
                          pagefindWeight="0.5"
                          transitionName={`entry-title-${entry.id}`}
                          name={entry.name}
                          href={url(talent ? `/${system}/${sphere.id}/${entry.id}/` : getFeatUrl(entry as FeatEntry, tagMap))}
                          sourceBookTitle={entryBook?.title}
                          tagIds={buildOrderedTagIds(entry, bookMetaMap, tagMap, { currentSphereId: sphere.id })}
                          Content={content?.Content}
                          tagMap={tagMap}
                          bookMetaMap={bookMetaMap}
                        />
                      );
                    })}
                  </div>
              }
              </div>
            </div>
          ))}

          {sec.categories.length === 0 && (
            <p class="section-empty">No entries yet.</p>
          )}
        </div>
      ))}

    </div>

    <aside class="right-rail" aria-label="Page contents">
      <TableOfContents overview={overview} groups={groups} system={sysConfig.cssKey as 'power' | 'might' | 'guile' | 'champ'} />
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>

<script>
import { setCollapsibleState, bindCollapseToggle } from '@/lib/collapseClient';

document.addEventListener('astro:page-load', () => {
  function sectionTarget(btn: HTMLButtonElement): HTMLElement | null {
    return document.getElementById(`${btn.dataset.catId!}-entries`);
  }

  document.querySelectorAll<HTMLButtonElement>('.section-heading-toggle').forEach(btn => {
    const entries = sectionTarget(btn);
    if (entries) bindCollapseToggle(btn, entries, btn.dataset.catId);
  });

  const toggleAllBtn = document.getElementById('toggle-all-sections') as HTMLButtonElement | null;
  if (!toggleAllBtn) return;

  toggleAllBtn.addEventListener('click', () => {
    const shouldExpand = toggleAllBtn.textContent?.trim() === 'Expand All';
    document.querySelectorAll<HTMLButtonElement>('.section-heading-toggle').forEach(btn => {
      const entries = sectionTarget(btn);
      if (entries) setCollapsibleState(btn, entries, shouldExpand, btn.dataset.catId);
    });
    toggleAllBtn.textContent = shouldExpand ? 'Collapse All' : 'Expand All';
  });
});
</script>
