---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import TagBadge from '@/components/TagBadge.astro';
import { resolveEntries, getCollEntriesMap } from '@/lib/resolveEntries';
import { buildOrderedTagIds } from '@/lib/tags';
import { getSystemPaths, resolveSystem, getSystemSearchFilter } from '@/lib/systems';
import type { TalentEntry, SphereEntry, BookMeta, TagEntry } from '@/lib/types';

interface Props {
  talent: TalentEntry;
  sphere: SphereEntry;
  collEntry: any;
  sourceBook: BookMeta | undefined;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const { talentMap, sphereMap, bookMetaMap, tagMap } = await resolveEntries();
  const allCollEntries = await getCollEntriesMap();

  const paths = [];

  for (const { params: { system } } of getSystemPaths()) {
    for (const [, talent] of talentMap) {
      if (talent.system !== system) continue;

      const sphere = [...sphereMap.values()].find(s => s.id === talent.sphere && s.system === system);
      if (sphere) {
        paths.push({
          params: { system, sphere: sphere.id, talent: talent.id },
          props: { talent, sphere, collEntry: allCollEntries.get(`talent:${talent.id}`), sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
        });
      }

      if (talent.dualSphere === "any") {
        for (const s of sphereMap.values()) {
          if (s.system === system && s.id !== talent.sphere) {
            paths.push({
              params: { system, sphere: s.id, talent: talent.id },
              props: { talent, sphere: s, collEntry: allCollEntries.get(`talent:${talent.id}`), sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
            });
          }
        }
      } else if (talent.dualSphere) {
        const dualSphere = [...sphereMap.values()].find(s => s.id === talent.dualSphere && s.system === system);
        if (dualSphere) {
          paths.push({
            params: { system, sphere: dualSphere.id, talent: talent.id },
            props: { talent, sphere: dualSphere, collEntry: allCollEntries.get(`talent:${talent.id}`), sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
          });
        }
      }
    }
  }

  return paths;
}

const { system } = Astro.params;
const { talent, sphere, collEntry, sourceBook, tagMap, bookMetaMap } = Astro.props;

const sysConfig = resolveSystem(system)!;
const searchFilter = getSystemSearchFilter(system);

const TalentContent = collEntry ? (await render(collEntry)).Content : null;
---
<WikiPage title={`${talent.name} — ${sphere.name} — ${sysConfig.label} Wiki`} activeNamespace={system}>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url(`/${system}/`)} data-astro-prefetch="hover">{sysConfig.label}</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url(`/${system}/${sphere.id}/`)} data-astro-prefetch="hover">{sphere.name}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{talent.name}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">
      <span data-pagefind-meta={`title:${talent.name}`} hidden></span>
      <span data-pagefind-meta={`sphere:${sphere.name}`} hidden></span>
      <span data-pagefind-filter={searchFilter} hidden></span>
      <span data-pagefind-filter="type:talent" hidden></span>
      <span data-pagefind-meta={`tier:${talent.tier}`} hidden></span>
      <span data-pagefind-meta={`tags:${talent.tags.join(', ')}`} hidden></span>
      <h1
        class={`page-title ${sysConfig.cssKey}`}
        id="overview"
        transition:name={`entry-title-${talent.id}`}
        data-pagefind-weight="2.0"
      >
        {talent.name}
      </h1>
      <span data-pagefind-meta="type:talent" hidden></span>
      <span data-pagefind-meta={searchFilter} hidden></span>
      <div class="talent-page-meta">
        {buildOrderedTagIds(talent, bookMetaMap, tagMap, { currentSphereId: sphere.id })
          .map(tagId => <TagBadge tagId={tagId} tagMap={tagMap} bookMetaMap={bookMetaMap} />)
        }
      </div>
      <hr class="page-title-rule" />

      {TalentContent
        ? <div class="entry-description"><TalentContent /></div>
        : <p class="entry-description"><em>Description coming soon.</em></p>
      }
    </div>

    <aside class="right-rail" aria-label="Page contents">
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>
