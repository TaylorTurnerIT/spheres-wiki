---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import EntryDetailPage from '@/components/EntryDetailPage.astro';
import { resolveEntries, getCollEntriesMap } from '@/lib/resolveEntries';
import { buildOrderedTagIds } from '@/lib/tags';
import { getSystemPaths, resolveSystem, getSystemSearchFilter, buildSystemIdIndex, systemIdKey } from '@/lib/systems';
import type { TalentEntry, SphereEntry, BookMeta, TagEntry } from '@/lib/types';

interface Props {
  talent: TalentEntry;
  sphere: SphereEntry;
  collEntry: any;
  sourceBook: BookMeta | undefined;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const { talentMap, sphereMap, bookMetaMap, tagMap } = await resolveEntries();
  const allCollEntries = await getCollEntriesMap();

  const paths = [];
  const sphereIndex = buildSystemIdIndex(sphereMap.values());

  for (const { params: { system } } of getSystemPaths()) {
    for (const [, talent] of talentMap) {
      if (talent.system !== system) continue;

      const collEntry = allCollEntries.get(`talent:${talent.id}`);
      const cacheKey = collEntry?.digest as string | undefined;

      const sphere = sphereIndex.get(systemIdKey(system, talent.sphere ?? ""));
      if (sphere) {
        paths.push({
          params: { system, sphere: sphere.id, talent: talent.id },
          props: { talent, sphere, collEntry, sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
          ...(cacheKey ? { cacheKey } : {}),
        });
      }

      if (talent.dualSphere === "any") {
        for (const s of sphereMap.values()) {
          if (s.system === system && s.id !== talent.sphere) {
            paths.push({
              params: { system, sphere: s.id, talent: talent.id },
              props: { talent, sphere: s, collEntry, sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
              ...(cacheKey ? { cacheKey } : {}),
            });
          }
        }
      } else if (talent.dualSphere) {
        const dualSphere = sphereIndex.get(systemIdKey(system, talent.dualSphere));
        if (dualSphere) {
          paths.push({
            params: { system, sphere: dualSphere.id, talent: talent.id },
            props: { talent, sphere: dualSphere, collEntry, sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
            ...(cacheKey ? { cacheKey } : {}),
          });
        }
      }
    }
  }

  return paths;
}

const { system } = Astro.params;
const { talent, sphere, collEntry, sourceBook, tagMap, bookMetaMap } = Astro.props;

const sysConfig = resolveSystem(system)!;
const searchFilter = getSystemSearchFilter(system);

const TalentContent = collEntry ? (await render(collEntry)).Content : null;
---
<EntryDetailPage
  system={system!}
  title={`${talent.name} — ${sphere.name} — ${sysConfig.label} Wiki`}
  crumbs={[
    { label: "Home", href: url("/") },
    { label: sysConfig.label, href: url(`/${system}/`) },
    { label: sphere.name, href: url(`/${system}/${sphere.id}/`) },
    { label: talent.name },
  ]}
  name={talent.name}
  transitionName={`entry-title-${talent.id}`}
  tagIds={buildOrderedTagIds(talent, bookMetaMap, tagMap, { currentSphereId: sphere.id })}
  tagMap={tagMap}
  bookMetaMap={bookMetaMap}
  sourceBook={sourceBook}
  Content={TalentContent}
  pagefindFilters={[searchFilter, "type:talent"]}
  pagefindMeta={{
    title: talent.name,
    sphere: sphere.name,
    tier: talent.tier ?? "",
    tags: talent.tags.join(", "),
    type: "talent",
    system: sysConfig.label,
  }}
/>
