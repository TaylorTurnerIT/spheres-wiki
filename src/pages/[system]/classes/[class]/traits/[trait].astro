---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import EntryDetailPage from '@/components/EntryDetailPage.astro';
import { resolveEntries, getCollEntriesMap } from '@/lib/resolveEntries';
import { stripBodySource } from '@/lib/renderBody';
import { buildOrderedTagIds } from '@/lib/tags';
import { getSystemPaths, resolveSystem, getSystemSearchFilter, buildSystemIdIndex, systemIdKey } from '@/lib/systems';
import type { ClassTraitEntry, ClassEntry, BookMeta, TagEntry } from '@/lib/types';

interface Props {
  trait: ClassTraitEntry;
  cls: ClassEntry;
  collEntry: any;
  sourceBook: BookMeta | undefined;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const { classTraitMap, classMap, bookMetaMap, tagMap } = await resolveEntries();
  const allCollEntries = await getCollEntriesMap();

  const paths = [];
  const classIndex = buildSystemIdIndex(classMap.values());
  for (const { params: { system } } of getSystemPaths()) {
    for (const [, trait] of classTraitMap) {
      if (trait.system !== system) continue;

      const cls = classIndex.get(systemIdKey(system, trait.className ?? ""));
      if (!cls) continue;

      paths.push({
        params: { system, class: cls.id, trait: trait.id },
        props: {
          trait,
          cls,
          collEntry: allCollEntries.get(`class-trait:${trait.id}`),
          sourceBook: bookMetaMap.get(trait.sourceBook),
          tagMap,
          bookMetaMap,
        },
      });
    }
  }

  return paths;
}

const { system } = Astro.params;
const { trait, cls, collEntry, sourceBook, tagMap, bookMetaMap } = Astro.props;

const sysConfig = resolveSystem(system)!;
const searchFilter = getSystemSearchFilter(system);

const cleanBody = collEntry ? stripBodySource(collEntry.body || '') : null;
const TraitContent = (collEntry && cleanBody !== null) ? (await render({ ...collEntry, body: cleanBody })).Content : null;
---
<EntryDetailPage
  system={system!}
  title={`${trait.name} — ${cls.name} — ${sysConfig.label} Wiki`}
  crumbs={[
    { label: "Home", href: url("/") },
    { label: sysConfig.label, href: url(`/${system}/`) },
    { label: cls.name, href: url(`/${system}/classes/${cls.id}/`) },
    { label: trait.name },
  ]}
  name={trait.name}
  tagIds={buildOrderedTagIds(trait as any, bookMetaMap, tagMap, {})}
  tagMap={tagMap}
  bookMetaMap={bookMetaMap}
  sourceBook={sourceBook}
  Content={TraitContent}
  prerequisites={trait.requires}
  pagefindFilters={["type:class-trait", searchFilter]}
  pagefindMeta={{
    title: trait.name,
    class: cls.name,
    tags: trait.tags.join(", "),
    type: "class-trait",
    system: sysConfig.label,
  }}
/>
