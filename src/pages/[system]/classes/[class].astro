---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import type { TocItem, TocGroup } from '@/components/TableOfContents.astro';
import ClassProgressionTable from '@/components/ClassProgressionTable.astro';
import ClassFeatureBlock from '@/components/ClassFeatureBlock.astro';
import ArchetypeSwapper from '@/components/ArchetypeSwapper.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { resolveEntries, getCollEntriesMap } from '@/lib/resolveEntries';
import { stripBodySource } from '@/lib/renderBody';
import { getSystemPaths, resolveSystem, getSystemSearchFilter } from '@/lib/systems';
import type { ClassEntry, ClassFeatureEntry, ClassTraitEntry, ArchetypeEntry, ArchetypeFeatureEntry, BookMeta, TagEntry } from '@/lib/types';
import { compareByLevel, ordinal } from '@/lib/levelLabel';
import {
  buildFeaturesByLevel,
  computeBAB,
  computeCasterLevel,
  computeMagicTalents,
  computeSave,
  formatBAB,
  formatSave,
  levelOrdinal,
  parseClassTable,
} from '@/lib/classProgression';
import { contentEntryKey } from '@/lib/entryIdentity';

interface Props {
  cls: ClassEntry;
  classCollEntry: any;
  featureEntries: ClassFeatureEntry[];
  featureCollEntries: Map<string, any>;
  traitEntries: ClassTraitEntry[];
  traitCollEntries: Map<string, any>;
  sourceBook: BookMeta | undefined;
  archetypes: ArchetypeEntry[];
  archetypeFeatures: ArchetypeFeatureEntry[];
  archetypeFeatureCollEntries: Map<string, any>;
  archetypeCollEntries: Map<string, any>;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

// fallow-ignore-next-line complexity
export async function getStaticPaths() {
  const { classMap, classFeatureMap, classTraitMap, archetypeMap, archetypeFeatureMap, bookMetaMap, tagMap } = await resolveEntries();
  const allCollEntries = await getCollEntriesMap();

  const paths = [];

  for (const { params: { system } } of getSystemPaths()) {
    for (const [, cls] of classMap) {
      if (cls.system !== system) continue;

      const featureEntries = [...classFeatureMap.values()]
        .filter(f => f.className === cls.id)
        .sort(compareByLevel);

      const traitEntries = [...classTraitMap.values()]
        .filter(t => t.className === cls.id)
        .sort((a, b) => a.name.localeCompare(b.name));

      const featureCollEntries = new Map<string, any>();
      for (const f of featureEntries) {
        const entry = allCollEntries.get(
          contentEntryKey('class-feature', f.system, f.id),
        );
        if (entry) featureCollEntries.set(f.id, entry);
      }

      const traitCollEntries = new Map<string, any>();
      for (const t of traitEntries) {
        const entry = allCollEntries.get(
          contentEntryKey('class-trait', t.system, t.id),
        );
        if (entry) traitCollEntries.set(t.id, entry);
      }

      const classArchetypes = [...archetypeMap.values()]
        .filter(a => a.system === cls.system && a.className === cls.id);

      const featureNameById = new Map(featureEntries.map(f => [f.id, f.name]));

      const acfFeatures = [...archetypeFeatureMap.values()]
        .filter(f => f.system === cls.system && f.isAlternateClassFeature && f.archetypeId === `${cls.id}-alternate-class-features`);
      const acfArchetypes = acfFeatures.map(af => ({
        id: af.id,
        name: `Alternate Class Feature: ${af.name}`,
        className: cls.id,
        system: cls.system,
        sourceBook: cls.sourceBook,
        tags: [],
        type: "archetype" as const,
        _acfReplacesDesc: (af.replaces || []).map(id => featureNameById.get(id) || id.replace(/-/g, ' ')).join(', '),
      }));

      const allArchetypes = [...classArchetypes, ...acfArchetypes];

      const classArchetypeFeatures = [...archetypeFeatureMap.values()]
        .filter(f => f.system === cls.system && (allArchetypes.some(a => a.id === f.archetypeId) || f.isAlternateClassFeature))
        .sort(compareByLevel);

      const archetypeFeatureCollEntries = new Map<string, any>();
      for (const f of classArchetypeFeatures) {
        const entry = allCollEntries.get(
          contentEntryKey('archetype-feature', f.system, f.id),
        );
        if (entry) archetypeFeatureCollEntries.set(f.id, entry);
      }

      const archetypeCollEntries = new Map<string, any>();
      for (const a of classArchetypes) {
        const entry = allCollEntries.get(
          contentEntryKey('archetype', a.system, a.id),
        );
        if (entry) archetypeCollEntries.set(a.id, entry);
      }

      const classCollEntry = allCollEntries.get(
        contentEntryKey('class', cls.system, cls.id),
      );
      const digests = [
        classCollEntry?.digest,
        ...featureEntries.map(f => featureCollEntries.get(f.id)?.digest),
        ...traitEntries.map(t => traitCollEntries.get(t.id)?.digest),
        ...classArchetypes.map(a => archetypeCollEntries.get(a.id)?.digest),
        ...classArchetypeFeatures.map(f => archetypeFeatureCollEntries.get(f.id)?.digest),
      ].filter(Boolean);
      const cacheKey = digests.length > 0 ? digests.join(":") : undefined;

      paths.push({
        params: { system, class: cls.id },
        props: {
          cls,
          classCollEntry,
          featureEntries,
          featureCollEntries,
          traitEntries,
          traitCollEntries,
          sourceBook: bookMetaMap.get(cls.sourceBook),
          bookMetaMap,
          tagMap,
          archetypes: allArchetypes,
          archetypeCollEntries,
          archetypeFeatures: classArchetypeFeatures,
          archetypeFeatureCollEntries,
        },
        ...(cacheKey ? { cacheKey } : {}),
      });
    }
  }

  return paths;
}

const { system } = Astro.params;
const {
  cls,
  classCollEntry,
  featureEntries,
  featureCollEntries,
  traitEntries,
  traitCollEntries,
  sourceBook,
  bookMetaMap,
  tagMap,
  archetypes = [],
  archetypeCollEntries = new Map(),
  archetypeFeatures = [],
  archetypeFeatureCollEntries = new Map(),
} = Astro.props;

const sysConfig = resolveSystem(system!)!;
const searchFilter = getSystemSearchFilter(system!);

const ClassContent = classCollEntry ? (await render(classCollEntry)).Content : null;

function sourceTitle(sb: string): string | null {
  return bookMetaMap.get(sb)?.title ?? null;
}

type RenderedTrait = { trait: ClassTraitEntry; Content: any; sourceBookTitle: string | null };
type RenderedFeature = { feature: ClassFeatureEntry; Content: any; traits: RenderedTrait[]; sourceBookTitle: string | null };

async function renderEntryContent(collEntry: any): Promise<any> {
  if (!collEntry) return null;
  const cleanBody = stripBodySource(collEntry.body || '');
  return (await render({ ...collEntry, body: cleanBody })).Content;
}

async function renderClassTrait(trait: ClassTraitEntry): Promise<RenderedTrait> {
  return {
    trait,
    Content: await renderEntryContent(traitCollEntries.get(trait.id)),
    sourceBookTitle: sourceTitle(trait.sourceBook),
  };
}

async function renderClassFeature(feature: ClassFeatureEntry): Promise<RenderedFeature> {
  const featureTraits = traitEntries.filter((trait) => trait.featureId === feature.id);
  const traits = await Promise.all(featureTraits.map(renderClassTrait));
  return {
    feature,
    Content: await renderEntryContent(featureCollEntries.get(feature.id)),
    traits,
    sourceBookTitle: sourceTitle(feature.sourceBook),
  };
}

const featureRendered: RenderedFeature[] = await Promise.all(
  featureEntries.map(renderClassFeature),
);

const tocOverview: TocItem = { id: 'overview', label: 'Overview' };
const tocGroups: TocGroup[] = featureRendered.length > 0 ? [{
  label: 'Class Features',
  categories: featureRendered.map(({ feature, traits }) => {
    const minLevel = Array.isArray(feature.level) ? Math.min(...feature.level) : feature.level;
    return {
      id: feature.id,
      label: feature.name,
      meta: `${minLevel}${ordinal(minLevel)}`,
      sub: traits.length > 0 ? traits.map(({ trait }) => ({ id: trait.id, label: trait.name })) : undefined,
    };
  }),
}] : [];


const classTable = parseClassTable(cls.classTable as string | undefined);
const featuresByLevel = buildFeaturesByLevel(featureEntries);

const hasCasting = cls.casterTier && cls.casterTier !== "none";

const allHeaders: string[] = [
  "Level", "Base Attack Bonus", "Fort Save", "Ref Save", "Will Save", "Special",
  ...(hasCasting ? ["Caster Level", "Magic Talents", "Spell Pool"] : []),
  ...(classTable?.extraHeaders || []),
];

interface TableRow { cells: string[]; level: number; }
const tableRows: TableRow[] = [];
for (let lvl = 1; lvl <= 20; lvl++) {
  const bab = computeBAB(lvl, cls.babProgression);
  const fort = computeSave(lvl, cls.fortSaveProgression);
  const ref = computeSave(lvl, cls.refSaveProgression);
  const will = computeSave(lvl, cls.willSaveProgression);

  const featsAtLevel = featuresByLevel[lvl] || [];
  const special = featsAtLevel.length > 0
    ? featsAtLevel.map(f => `<a href="#${f.id}" class="table-feature-link">${f.name}</a>`).join(", ")
    : (classTable?.specialSource?.[lvl] || "—");

  const extraVals = classTable?.extraRowData?.[lvl] || [];
  const paddedExtras = (classTable?.extraHeaders || []).map((_, i) => extraVals[i] || "—");

  const rawMt = computeMagicTalents(lvl, cls.casterTier!);
  const mtDisplay = lvl === 1
    ? `${rawMt - 2} <span class="tt" data-tooltip="All characters gain two bonus magic talents the first time they gain a level in a class with the casting class feature, regardless of which class is chosen.">(+2)</span>`
    : String(rawMt - 2);

  const castingCells = hasCasting ? [
    String(computeCasterLevel(lvl, cls.casterTier!)),
    mtDisplay,
    `${lvl} + <span class="tt" data-tooltip="Casting Ability Modifier">CAM</span>`,
  ] : [];

  tableRows.push({
    level: lvl,
    cells: [levelOrdinal(lvl), formatBAB(bab), formatSave(fort), formatSave(ref), formatSave(will), special, ...castingCells, ...paddedExtras],
  });
}

function cleanArchetypeDescription(rawText: string): string {
  return rawText.trim().split('\n')[0].replace(/<[^>]+>/g, '').substring(0, 150) + (rawText.length > 150 ? '...' : '');
}

function getArchetypeDescription(replaces: string | undefined, rawText: string, fallback: string): string {
  if (replaces) return `Replaces: ${replaces}`;
  return cleanArchetypeDescription(rawText) || fallback;
}

function buildArchetypeOption(arc: ArchetypeEntry) {
  const collEntry = archetypeCollEntries.get(arc.id);
  const rawText = collEntry?.body || '';
  const acfReplacesDesc = (arc as any)._acfReplacesDesc as string | undefined;
  return { id: arc.id, name: arc.name, desc: getArchetypeDescription(acfReplacesDesc, rawText, arc.name) };
}

// Pre-compute archetype selector options for ArchetypeSwapper
const archetypeOptions = archetypes.map(buildArchetypeOption);
---
<WikiPage title={`${cls.name} — ${sysConfig.label} Wiki`} activeNamespace={system}>

  <Breadcrumb crumbs={[
    { label: "Home", href: url("/") },
    { label: sysConfig.label, href: url(`/${system}/`) },
    { label: cls.name },
  ]} />

  <div class="content-columns">
    <div class="content-main">

      <div class="class-header-row">
        <span data-pagefind-meta={`title:${cls.name}`} hidden></span>
        <span data-pagefind-filter="type:class" hidden></span>
        <span data-pagefind-filter={searchFilter} hidden></span>
        <h1
          class={`page-title ${sysConfig.cssKey}`}
          id="overview"
          data-pagefind-weight="10"
        >
          {cls.name}
        </h1>
        <span data-pagefind-meta="type:class" hidden></span>
        <span data-pagefind-meta={searchFilter} hidden></span>
        <ArchetypeSwapper
          options={archetypeOptions}
          archetypeFeatures={archetypeFeatures}
          archetypeFeatureCollEntries={archetypeFeatureCollEntries}
        />
      </div>
      <hr class="page-title-rule" />

      {ClassContent
        ? <div class="entry-description"><ClassContent /></div>
        : <p class="entry-description"><em>Description coming soon.</em></p>
      }

      <div class="class-info-block" style="margin-bottom: 1.5rem; padding: 1rem; background: var(--clr-surface); border-radius: 8px; border: 1px solid var(--clr-border);">
        <p style="margin: 0.25rem 0;"><strong>Alignment:</strong> <span id="class-val-alignment">{cls.alignment}</span></p>
        <p style="margin: 0.25rem 0;"><strong>Hit Die:</strong> d<span id="class-val-hitDie">{cls.hitDie}</span></p>
        <p style="margin: 0.25rem 0;"><strong>Starting Wealth:</strong> <span id="class-val-startingWealth">{cls.startingWealth}</span></p>
        <p style="margin: 0.25rem 0;"><strong>Class Skills:</strong> <span id="class-val-classSkills">{cls.classSkills.join(", ")}</span></p>
        <p style="margin: 0.25rem 0;"><strong>Skill Ranks per Level:</strong> <span id="class-val-skillRanks">{cls.skillRanks}</span> + Int modifier</p>
      </div>

      {tableRows.length > 0 && (
        <ClassProgressionTable clsName={cls.name} allHeaders={allHeaders} tableRows={tableRows} />
      )}

      {featureRendered.map(({ feature, Content, traits, sourceBookTitle }) => (
        <ClassFeatureBlock
          feature={feature}
          Content={Content}
          sourceBookTitle={sourceBookTitle}
          traits={traits}
          tagMap={tagMap}
          bookMetaMap={bookMetaMap}
          systemId={system}
          className={cls.id}
        />
      ))}

    </div>

    <aside class="right-rail" aria-label="Page contents">
      <TableOfContents overview={tocOverview} groups={tocGroups} system={sysConfig.cssKey as 'power' | 'might' | 'guile' | 'champ'} />
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>

<style>
  .class-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
    position: relative;
    flex-wrap: wrap;
  }

  .class-header-row .page-title {
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .class-header-row :global(.archetype-warning-banner) {
    flex: 0 0 100%;
    order: 3;
  }

  :global(#bound-equipment-su table td:nth-child(2)),
  :global(#bound-equipment-su table td:nth-child(4)),
  :global(#bound-equipment-su table td:nth-child(6)),
  :global(#bound-equipment-su table th:nth-child(2)),
  :global(#bound-equipment-su table th:nth-child(4)),
  :global(#bound-equipment-su table th:nth-child(6)) {
    border-right: 2px solid var(--clr-border);
  }
</style>
