---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import EntryDetailPage from '@/components/EntryDetailPage.astro';
import { resolveEntries, getCollEntriesMap } from '@/lib/resolveEntries';
import { buildOrderedTagIds } from '@/lib/tags';
import { getCanonicalFeatCategory } from '@/lib/featCategories';
import { getSystemPaths, resolveSystem, getSystemSearchFilter, buildSystemIdIndex, systemIdKey } from '@/lib/systems';
import type { FeatEntry, SphereEntry, BookMeta, TagEntry } from '@/lib/types';

interface Props {
  feat: FeatEntry;
  sphere?: SphereEntry;
  collEntry: any;
  sourceBook: BookMeta | undefined;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const { featMap, sphereMap, bookMetaMap, tagMap } = await resolveEntries();
  const allCollEntries = await getCollEntriesMap();

  const paths = [];
  const sphereIndex = buildSystemIdIndex(sphereMap.values());

  for (const { params: { system } } of getSystemPaths()) {
    for (const [, feat] of featMap) {
      if (feat.system !== system) continue;

      const category = getCanonicalFeatCategory(feat, tagMap);
      const sphere = feat.sphere
        ? sphereIndex.get(systemIdKey(system, feat.sphere))
        : undefined;

      const collEntry =
        allCollEntries.get(`feat:${feat.sourceBook}:${feat.id}`) ??
        allCollEntries.get(`feat:${feat.id}`);
      const cacheKey = collEntry?.digest as string | undefined;

      paths.push({
        params: { system, category, feat: feat.id },
        props: {
          feat,
          sphere,
          collEntry,
          sourceBook: bookMetaMap.get(feat.sourceBook),
          tagMap,
          bookMetaMap,
        },
        ...(cacheKey ? { cacheKey } : {}),
      });
    }
  }

  return paths;
}

const { system } = Astro.params;
const { feat, sphere, collEntry, sourceBook, tagMap, bookMetaMap } = Astro.props;

const sysConfig = resolveSystem(system!)!;
const searchFilter = getSystemSearchFilter(system!);
const categoryLabel = sphere?.name ?? tagMap.get(getCanonicalFeatCategory(feat, tagMap))?.label ?? "General";

const FeatContent = collEntry ? (await render(collEntry)).Content : null;
---
<EntryDetailPage
  system={system!}
  title={`${feat.name} — ${categoryLabel} — ${sysConfig.label} Wiki`}
  crumbs={[
    { label: "Home", href: url("/") },
    { label: sysConfig.label, href: url(`/${system}/`) },
    ...(sphere ? [{ label: sphere.name, href: url(`/${system}/${sphere.id}/`) }] : []),
    { label: feat.name },
  ]}
  name={feat.name}
  transitionName={`entry-title-${feat.id}`}
  tagIds={buildOrderedTagIds(feat, bookMetaMap, tagMap, { showHidden: !!(feat.dualSphere && feat.dualSphere !== "any"), currentSphereId: sphere?.id })}
  tagMap={tagMap}
  bookMetaMap={bookMetaMap}
  sourceBook={sourceBook}
  Content={FeatContent}
  pagefindFilters={[searchFilter, "type:feat"]}
  pagefindMeta={{
    title: feat.name,
    ...(sphere ? { sphere: sphere.name } : {}),
    tags: feat.tags.join(", "),
    type: "feat",
    system: sysConfig.label,
  }}
/>
