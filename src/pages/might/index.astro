---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';

const { sphereMap, classMap } = await resolveEntries();

const spheres = [...sphereMap.values()]
  .filter(s => s.system === 'might')
  .sort((a, b) => a.name.localeCompare(b.name));

const classes = [...classMap.values()]
  .filter(c => c.system === 'might')
  .sort((a, b) => a.name.localeCompare(b.name));
---
<WikiPage title="Spheres of Might — Spheres Wiki" activeNamespace="might" pagefindIgnore={true}>

  <div class="system-banner" aria-hidden="true">
    <svg viewBox="0 0 800 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <pattern id="mightPattern" width="20" height="20" patternUnits="userSpaceOnUse">
          <line x1="0" y1="20" x2="20" y2="0" stroke="#6B2200" stroke-width="1.5"/>
        </pattern>
        <radialGradient id="mightBannerGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#8f2d00" stop-opacity="0.32"/>
          <stop offset="100%" stop-color="#3D1200" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="800" height="140" fill="#3D1200"/>
      <rect width="800" height="140" fill="url(#mightPattern)" opacity="0.3"/>
      <rect width="800" height="140" fill="url(#mightBannerGlow)"/>
      <g transform="translate(400,70) scale(1.6) translate(-100,-40)">
        <path d="M100 8 L134 20 L134 46 Q134 67 100 74 Q66 67 66 46 L66 20 Z" fill="#7A2400" opacity=".75"/>
        <path d="M100 8 L134 20 L134 46 Q134 67 100 74 Q66 67 66 46 L66 20 Z" fill="none" stroke="#D04800" stroke-width="1.5" opacity=".8"/>
        <line x1="82" y1="22" x2="118" y2="58" stroke="#F07848" stroke-width="2.5" stroke-linecap="round"/>
        <line x1="118" y1="22" x2="82" y2="58" stroke="#F07848" stroke-width="2.5" stroke-linecap="round"/>
        <g transform="translate(113,27) scale(1.2) translate(-12,-10)">
          <path d="m12 2l10 6c0 4-2 6-6 7l-3-5l-4-4z" fill="#C84A00" stroke="#F07848" stroke-width="1.2" opacity="1"/>
        </g>
        <g transform="translate(87,27) scale(-1.2,1.2) translate(-12,-10)">
          <path d="m12 2l10 6c0 4-2 6-6 7l-3-5l-4-4z" fill="#C84A00" stroke="#F07848" stroke-width="1.2" opacity="1"/>
        </g>
        <circle cx="100" cy="40" r="9" fill="#C84A00"/>
        <circle cx="100" cy="40" r="5.5" fill="#FF8050"/>
        <circle cx="98" cy="38" r="2.2" fill="#FFDAC0" opacity=".85"/>
      </g>
    </svg>
  </div>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Spheres of Might</span>
  </nav>

  <h1 class="page-title might">Spheres of Might</h1>
  <p>Spheres of Might is a unique martial combat system created by Drop Dead Studios for use with the Pathfinder Roleplaying Game. It allows practitioners to excel in combat through martial techniques rather than magic.</p>
  <hr class="page-title-rule" />
  <div class="gs-grid">
    <a href={url("/might/using-spheres-of-might/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 3h5a1 1 0 0 1 1 1v9H2V3zM14 3H9a1 1 0 0 0-1 1v9h6V3z"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">Using Spheres of Might</div>
        <div class="gs-card-desc">Fundamental rules for martial traditions, combat fatigue, and spheres.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
    <a href={url("/power/how-to-build-practitioner/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 3.5v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1zM4 6.5h8M4 9.5h5"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">How to Build a Practitioner</div>
        <div class="gs-card-desc">A step-by-step guide to creating your first martial character.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
  </div>
  <hr class="page-title-rule" />

  <div class="section-heading">
    <span class="section-heading-text">Combat Spheres</span>
    <div class="section-heading-rule"></div>
  </div>

  <div class="sphere-badge-grid" style="margin-bottom: 24px;">
    {spheres.map(s => (
      <a href={url(`/might/${s.id}/`)} class="sphere-badge might" data-astro-prefetch="hover">
        <div class="sphere-badge-icon">
          <svg class="si" aria-hidden="true"><use href={`#si-${s.icon}`} /></svg>
        </div>
        <span class="sphere-badge-name">{s.name}</span>
      </a>
    ))}
  </div>

  <div class="classes-and-links">
    <div class="class-column">
      {classes.length > 0 && (
        <>
          <div class="section-heading" style="margin-top: 0;">
            <span class="section-heading-text">Practitioner Classes</span>
            <div class="section-heading-rule"></div>
          </div>
          <div class="class-lists">
            <div class="class-tier-group">
              <div class="class-tier-label">Classes</div>
              <div class="class-roster">
                {classes.map(c => (
                  <a href={url(`/might/classes/${c.id}/`)} class="class-item" data-astro-prefetch="hover">
                    <div class="class-item-header">
                      <span class="class-item-name">{c.name}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </>
      )}
    </div>

    <div class="quick-links-column">
      <div class="section-heading" style="margin-top: 0;">
        <span class="section-heading-text">Quick Links</span>
        <div class="section-heading-rule"></div>
      </div>
      <div class="quick-links-grid">
        <div class="quick-links-group">
          <h3 class="quick-links-heading">Rules</h3>
          <ul class="quick-links-list">
            <li><a href={url("/might/using-spheres-of-might/")}>Using Spheres of Might</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

</WikiPage>
