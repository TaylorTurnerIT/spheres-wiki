---
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';

const { sphereMap, classMap } = await resolveEntries();

const spheres = [...sphereMap.values()]
  .filter(s => s.namespace === 'might')
  .sort((a, b) => a.name.localeCompare(b.name));

const classes = [...classMap.values()]
  .filter(c => c.namespace === 'might')
  .sort((a, b) => a.name.localeCompare(b.name));
---
<WikiPage title="Spheres of Might — Spheres Wiki" activeNamespace="might">

  <div class="page-title might">Spheres of Might</div>
  <hr class="page-title-rule" />

  <div class="section-heading">
    <span class="section-heading-text">Combat Spheres</span>
    <div class="section-heading-rule"></div>
  </div>

  <div class="entry-grid">
    {spheres.map(s => (
      <a href={`/might/${s.id}/`} class="entry-card might" data-astro-prefetch="hover">
        <div class="entry-card-header">
          <svg class="si entry-card-icon" aria-hidden="true"><use href={`#si-${s.icon}`} /></svg>
          <span class="entry-card-name">{s.name}</span>
        </div>
        {/* description from GFM body — wired in R1-6 */}
      </a>
    ))}
  </div>

  {classes.length > 0 && (
    <div style="margin-top: 20px;">
      <div class="section-heading">
        <span class="section-heading-text">Practitioner Classes</span>
        <div class="section-heading-rule"></div>
      </div>
      <div class="entry-grid">
        {classes.map(c => (
          <a href={`/might/${c.id}/`} class="entry-card might" data-astro-prefetch="hover">
            <div class="entry-card-header">
              <span class="entry-card-name">{c.name}</span>
            </div>
            {/* description from GFM body — wired in R1-6 */}
          </a>
        ))}
      </div>
    </div>
  )}

</WikiPage>
