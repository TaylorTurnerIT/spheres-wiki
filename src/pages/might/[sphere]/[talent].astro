---
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import type { TalentEntry, SphereEntry } from '@/lib/types';

interface Props {
  talent: TalentEntry;
  sphere: SphereEntry;
}

export async function getStaticPaths() {
  const { talentMap, sphereMap } = await resolveEntries();
  const paths = [];

  for (const [, talent] of talentMap) {
    if (talent.namespace !== 'might') continue;
    const sphere = [...sphereMap.values()].find(s => s.id === talent.sphere && s.namespace === 'might');
    if (!sphere) continue;
    paths.push({
      params: { sphere: sphere.id, talent: talent.id },
      props: { talent, sphere },
    });
  }

  return paths;
}

const { talent, sphere } = Astro.props;
---
<WikiPage title={`${talent.name} — ${sphere.name} — Spheres of Might Wiki`} activeNamespace="might">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/" data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/might/" data-astro-prefetch="hover">Spheres of Might</a>
    <span class="breadcrumb-sep">›</span>
    <a href={`/might/${sphere.id}/`} data-astro-prefetch="hover">{sphere.name}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{talent.name}</span>
  </nav>

  <div class="page-title might">{talent.name}</div>
  <span class={`talent-tier ${talent.tier}`}>{talent.tier}</span>
  <hr class="page-title-rule" />

  {/* GFM body rendered here in R1-7 */}
  <p class="entry-description"><em>Full talent description coming soon.</em></p>

</WikiPage>
