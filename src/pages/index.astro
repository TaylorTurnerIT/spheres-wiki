---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import IntroCard from '@/components/IntroCard.astro';
import StoreBar from '@/components/StoreBar.astro';
import RefCard from '@/components/RefCard.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { SYSTEMS } from '@/config/site';
import heroBg from '@/assets/hero-bg.webp';
import heroBgNight from '@/assets/hero-bg-dark-night.webp';
import heroBgParchment from '@/assets/hero-bg-dark-parchment.webp';

const HERO_LQIP_NIGHT = "data:image/webp;base64,UklGRkoAAABXRUJQVlA4ID4AAAAwAwCdASoYAAkAPxFysFAsJqSisAgBgCIJYwCdAC0HgQgAAP7u2OXsYnwhxkJuq6waeTNJBM3Vbh5QsQKAAA==";
const HERO_LQIP_PARCHMENT = "data:image/webp;base64,UklGRkYAAABXRUJQVlA4IDoAAAAwAwCdASoYAAkAPxFysFCsJqSisAgBgCIJYwC7AC0HdeAAAP7svSOGAOUAzauJ55Bu3AJCoo8IrAAA";
import {
  isOfficialPublisher,
  isVisibleThirdParty,
  latestBook,
  coreBooksOf,
  CORE_BOOK_SLUGS,
} from '@/lib/bookCuration';

const { sphereMap, classMap, bookMetaMap } = await resolveEntries();

const allBooks = [...bookMetaMap.values()];
const EXCLUDED = new Set([...CORE_BOOK_SLUGS, 'unknown-source']);

const latestFirstParty = latestBook(allBooks, b => isOfficialPublisher(b) && !EXCLUDED.has(b.slug));
const latestThirdParty = latestBook(allBooks, b => isVisibleThirdParty(b) && !EXCLUDED.has(b.slug));

const coreBooks = coreBooksOf(bookMetaMap);

const systemData = Object.keys(SYSTEMS).map(id => ({
  id,
  spheres: [...sphereMap.values()].filter(s => s.system === id),
  classes: [...classMap.values()].filter(c => c.system === id),
}));
---
<WikiPage title="Home — Spheres Wiki" pagefindIgnore={true}>
  <link
    rel="preload"
    as="image"
    href={heroBg.src}
    type="image/webp"
    fetchpriority="high"
    slot="head"
  />
  <link
    rel="preload"
    as="image"
    href={heroBgNight.src}
    type="image/webp"
    slot="head"
  />
  <link
    rel="preload"
    as="image"
    href={heroBgParchment.src}
    type="image/webp"
    slot="head"
  />

  <div
    class="hero-section"
    style={`--hero-light: url('${heroBg.src}'); --hero-light-lqip: url('data:image/webp;base64,UklGRrYAAABXRUJQVlA4IKoAAAAQBQCdASo8ABYAPu1urVCppqQjrBqoATAdiWUAyF2L6yLajDaJqblDdjlNuQYOKASAAP7xzJf/+wb5T+h72E9biHiDKFi4Fu7VO4Q2GTNQGDDP0E6PEuhDlWZo7G0gkni2T44DOHESCi23diWXh7evF6IxVyovB6/FjBCYkE49sFI+GuZ3GzMLEkqQz9z8xUZ7huGvhxbRV5zdrWR4AZqnFOuE13uhlwwAAA=='); --hero-night: url('${heroBgNight.src}'); --hero-night-lqip: url('${HERO_LQIP_NIGHT}'); --hero-parchment: url('${heroBgParchment.src}'); --hero-parchment-lqip: url('${HERO_LQIP_PARCHMENT}');`}
  >
    <h1 class="hero-title">Spheres Wiki</h1>
    <div class="hero-search-wrap" id="hero-search">
      <div class="hero-search-bar" id="hero-search-combobox">
        <button class="hero-search-icon-btn" id="hero-search-icon-btn" aria-label="Open full search" type="button">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="8.5" cy="8.5" r="5.5"/>
            <path d="M13 13l3.5 3.5"/>
          </svg>
        </button>
        <input
          type="search"
          id="hero-search-input"
          role="combobox"
          placeholder="Search spheres, talents, feats, classes…"
          aria-label="Search spheres, talents, feats, classes"
          aria-autocomplete="list"
          aria-controls="hero-search-results"
          aria-expanded="false"
          aria-haspopup="listbox"
          autocomplete="off"
        />
      </div>
      <div id="hero-search-results" class="search-results-dropdown hero-results-dropdown" role="listbox" aria-label="Search results" aria-live="polite" hidden></div>
    </div>
  </div>

  <SectionHeading label="New to Spheres? Choose a system to start" />
  <div class="intro-cards">
    {systemData.map(({ id }) => <IntroCard system={id} />)}
  </div>

  <SectionHeading label="Quick Reference — All Spheres" />

  <div class="ref-grid">
    {systemData.map(({ id, spheres, classes }) => (
      <RefCard system={id} spheres={id === 'champions' ? [] : spheres} classes={classes} />
    ))}
  </div>

  <div class="resources-row">
    <ResourceCard name="Archetypes Index" description="PF1e crossover archetypes" href={url("/archetypes/")}>
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 2h7l3 3v9H3z"/><path d="M10 2v3h3"/><path d="M5 8h6M5 10.5h6M5 6h3"/>
      </svg>
    </ResourceCard>
    <ResourceCard name="Tags Index" description="Browse all content tags" href={url("/tags/")}>
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 2h5.5l6.5 6.5-5.5 5.5L2 7.5V2z"/><circle cx="5" cy="5" r="1" fill="currentColor" stroke="none"/>
      </svg>
    </ResourceCard>
    <ResourceCard name="Feats Index" description="Browse all feats" href={url("/feats/")}>
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="8 1.5 10 6 15 6.5 11 10 12 15 8 12.5 4 15 5 10 1 6.5 6 6 8 1.5"/>
      </svg>
    </ResourceCard>
    <ResourceCard name="Community Resources" description="Discords, forums &amp; tools" href={url("/community-resources/")}>
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="5.5" cy="5.5" r="2.5"/><path d="M1.5 13c0-2.5 2-4 4-4s4 1.5 4 4"/>
        <circle cx="11" cy="4.5" r="2"/><path d="M8.5 13c0-2 1.5-3.5 3-3.5s3 1.5 3 3.5"/>
      </svg>
    </ResourceCard>
  </div>

  <StoreBar latestFirstParty={latestFirstParty} latestThirdParty={latestThirdParty} coreBooks={coreBooks} />

</WikiPage>

<script>
  import { attachQuickSearch } from '@/lib/quickSearch';

  let cleanupHeroSearch = () => {};

  document.addEventListener('astro:before-swap', () => {
    cleanupHeroSearch();
    cleanupHeroSearch = () => {};
  });

  document.addEventListener('astro:page-load', () => {
    cleanupHeroSearch();
    const heroInput = document.getElementById('hero-search-input') as HTMLInputElement | null;
    const heroResults = document.getElementById('hero-search-results') as HTMLElement | null;
    const heroIconBtn = document.getElementById('hero-search-icon-btn') as HTMLButtonElement | null;

    if (!heroInput || !heroResults) return;

    const controller = new AbortController();
    attachQuickSearch({
      input: heroInput,
      resultsDiv: heroResults,
      iconBtn: heroIconBtn,
      signal: controller.signal,
    });

    const headerAnchor = document.querySelector(
      '.header-search-anchor.header-search--fade'
    ) as HTMLElement | null;
    const heroSearchWrap = document.getElementById('hero-search');

    if (headerAnchor && heroSearchWrap) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              headerAnchor.classList.remove('is-scrolled-in');
            } else {
              headerAnchor.classList.add('is-scrolled-in');
            }
          }
        },
        {
          rootMargin: '-56px 0px 0px 0px',
          threshold: 0,
        }
      );
      observer.observe(heroSearchWrap);
      controller.signal.addEventListener('abort', () => {
        observer.disconnect();
        headerAnchor.classList.remove('is-scrolled-in');
      });
    }

    cleanupHeroSearch = () => controller.abort();
  });
</script>

<style>
  .hero-section {
    position: relative;
    z-index: 30;
    padding: 7.5rem 1rem 4.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 2rem;
    background-color: #f5f1e4;
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    border: 0.5px solid var(--clr-border);
    border-radius: var(--radius);
  }

  /* Per-theme hero art — same 1672×624 geometry + cover, so no layout
     shift when the theme (or image load state) changes. URLs come from
     inline --hero-* vars; background-image lives here (not inline) so the
     theme overrides below can win. */
  .hero-section {
    background-image: var(--hero-light), var(--hero-light-lqip);
  }
  :global(:root[data-theme="dark-night"]) .hero-section {
    background-color: #131a2b;
    background-image: var(--hero-night), var(--hero-night-lqip);
  }
  :global(:root[data-theme="dark-parchment"]) .hero-section {
    background-color: #211a12;
    background-image: var(--hero-parchment), var(--hero-parchment-lqip);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 700;
    color: var(--clr-brand);
    letter-spacing: 0.04em;
    line-height: 1.15;
    margin: 0 0 1.75rem;
  }

  .hero-search-wrap {
    position: relative;
    z-index: 40;
    width: 100%;
    max-width: 620px;
  }

  .hero-search-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--clr-bg);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
    padding: 0 14px 0 18px;
    height: 52px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }

  .hero-search-bar:focus-within {
    border-color: var(--clr-brand);
    box-shadow:
      0 0 0 2px var(--clr-brand),
      0 4px 20px rgba(153, 0, 0, 0.12);
    background: color-mix(in srgb, var(--clr-bg) 90%, #fff);
  }

  .hero-search-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--clr-muted);
    transition:
      color 0.15s ease,
      transform 0.1s ease;
  }

  .hero-search-icon-btn:hover {
    color: var(--clr-brand);
  }

  .hero-search-icon-btn:active {
    transform: scale(0.9);
  }

  .hero-search-icon-btn:focus-visible {
    outline: 2px solid var(--clr-brand);
    outline-offset: 2px;
    border-radius: 50%;
  }

  .hero-search-bar input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    outline: none;
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--clr-text);
  }

  .hero-search-bar input::placeholder {
    color: var(--clr-muted);
    opacity: 0.75;
    font-style: italic;
  }

  .hero-results-dropdown {
    top: calc(100% + 8px);
    text-align: left;
    z-index: 1000;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 5rem 0.5rem 2.5rem;
    }

    .hero-search-bar {
      height: 46px;
      padding: 0 12px 0 14px;
    }

    .hero-search-bar input {
      font-size: 0.95rem;
    }
  }
</style>
