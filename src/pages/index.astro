---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import IntroCard from '@/components/IntroCard.astro';
import StoreBar from '@/components/StoreBar.astro';
import RefCard from '@/components/RefCard.astro';
import ResourceCard from '@/components/ResourceCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { ANNOUNCEMENT, SYSTEMS } from '@/config/site';
import type { BookMeta } from '@/lib/types';

const { sphereMap, classMap, bookMetaMap } = await resolveEntries();

const FIRST_PARTY = new Set(['Drop Dead Studios', 'Diamond Recreational Studios']);
const CORE_SLUGS = ['ultimate-spheres-of-power', 'spheres-of-might', 'spheres-of-guile', 'champions-of-the-spheres'];
const EXCLUDED = new Set([...CORE_SLUGS, 'unknown-source']);
const sortByDate = (a: BookMeta, b: BookMeta) =>
  new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime();

const latestFirstParty = [...bookMetaMap.values()]
  .filter(b => FIRST_PARTY.has(b.publisher) && !EXCLUDED.has(b.slug))
  .sort(sortByDate)[0];

const latestThirdParty = [...bookMetaMap.values()]
  .filter(b => !FIRST_PARTY.has(b.publisher) && b.publisher !== 'Unknown' && !EXCLUDED.has(b.slug))
  .sort(sortByDate)[0];

const coreBooks = CORE_SLUGS
  .map(slug => bookMetaMap.get(slug))
  .filter((b): b is BookMeta => b !== undefined);

const systemData = Object.keys(SYSTEMS).map(id => ({
  id,
  spheres: [...sphereMap.values()].filter(s => s.system === id),
  classes: [...classMap.values()].filter(c => c.system === id),
}));
---
<WikiPage title="Home — Spheres of Power Wiki" pagefindIgnore={true}>

  <h1 class="page-title">Home Page</h1>
  <hr class="page-title-rule" />

  {ANNOUNCEMENT && (
    <div class="update-banner">
      <strong>Latest Update:</strong> <Fragment set:html={ANNOUNCEMENT} />
    </div>
  )}

  <SectionHeading label="About the Spheres" />
  <p class="intro-description">
    The Spheres are a collection of three optional rule systems for the Pathfinder Roleplaying Game, published mainly by Drop Dead Studios and supported by other third-party companies. In these systems, players may choose from a range of martial, magical, and skill spheres, spending Talents to create a uniquely customized character. The Spheres rules are very flexible and allow players to build to an idea, rather than a specific class.
  </p>

  <SectionHeading label="New to Spheres? Choose a system to start" />
  <div class="intro-cards">
    {systemData.map(({ id }) => <IntroCard system={id} />)}
  </div>

  <style>
    .intro-description {
      font-size: var(--fs-md);
      line-height: 1.6;
      color: var(--clr-text);
      margin-bottom: 16px;
    }
  </style>

  <SectionHeading label="Quick Reference — All Spheres" />

  <div class="ref-grid">
    {systemData.map(({ id, spheres, classes }) => (
      <RefCard system={id} spheres={id === 'champions' ? [] : spheres} classes={classes} />
    ))}
  </div>

  <div class="resources-row">
    <ResourceCard name="Archetypes Index" description="PF1e crossover archetypes" href={url("/archetypes/")}>
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 2h7l3 3v9H3z"/><path d="M10 2v3h3"/><path d="M5 8h6M5 10.5h6M5 6h3"/>
      </svg>
    </ResourceCard>
    <ResourceCard name="Tags Index" description="Browse all content tags" href={url("/tags/")}>
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 2h5.5l6.5 6.5-5.5 5.5L2 7.5V2z"/><circle cx="5" cy="5" r="1" fill="currentColor" stroke="none"/>
      </svg>
    </ResourceCard>
    <ResourceCard name="Feats Index" description="Browse all feats" href={url("/feats/")}>
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="8 1.5 10 6 15 6.5 11 10 12 15 8 12.5 4 15 5 10 1 6.5 6 6 8 1.5"/>
      </svg>
    </ResourceCard>
    <ResourceCard name="Community Resources" description="Discords, forums &amp; tools" href={url("/community-resources/")}>
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="5.5" cy="5.5" r="2.5"/><path d="M1.5 13c0-2.5 2-4 4-4s4 1.5 4 4"/>
        <circle cx="11" cy="4.5" r="2"/><path d="M8.5 13c0-2 1.5-3.5 3-3.5s3 1.5 3 3.5"/>
      </svg>
    </ResourceCard>
  </div>

  <StoreBar latestFirstParty={latestFirstParty} latestThirdParty={latestThirdParty} coreBooks={coreBooks} />

</WikiPage>
