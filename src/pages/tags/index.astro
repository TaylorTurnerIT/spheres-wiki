---
import { url } from "@/lib/url";
import WikiPage from "@/layouts/WikiPage.astro";
import TagBadge from "@/components/TagBadge.astro";
import { resolveEntries } from "@/lib/resolveEntries";

const { tagMap, bookMetaMap } = await resolveEntries();

const sortedTags = [...tagMap.values()].sort(
  (a, b) => a.priority - b.priority || a.label.localeCompare(b.label),
);

const builtinTags = sortedTags.filter((t) => t.sourceBook === "__builtin__");
const userTags = sortedTags.filter((t) => t.sourceBook !== "__builtin__");
---

<WikiPage title="All Tags — Spheres Wiki" pagefindIgnore={true}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Tags</span>
  </nav>

  <div class="content-main" style="max-width: 640px;">
    <h1 class="page-title" id="overview">Tags</h1>
    <hr class="page-title-rule" />

    {
      builtinTags.length > 0 && (
        <>
          <div class="section-group">
            <div class="section-group-header">
              <span class="section-group-label">System Tags</span>
              <div class="section-group-rule" />
            </div>
            <div class="tag-index-list">
              {builtinTags.map((tag) => (
                <div class="tag-index-row">
                  <TagBadge
                    tagId={tag.id}
                    tagMap={tagMap}
                    bookMetaMap={bookMetaMap}
                  />
                  <span class="tag-index-desc">{tag.description}</span>
                </div>
              ))}
            </div>
          </div>
        </>
      )
    }

    <div class="section-group" style="margin-top: 32px;">
      <div class="section-group-header">
        <span class="section-group-label">Descriptors & Content Tags</span>
        <div class="section-group-rule" />
      </div>
      <div class="tag-index-list">
        {
          userTags.map((tag) => (
            <div class="tag-index-row">
              <TagBadge
                tagId={tag.id}
                tagMap={tagMap}
                bookMetaMap={bookMetaMap}
              />
              <span class="tag-index-desc">{tag.description}</span>
            </div>
          ))
        }
        {userTags.length === 0 && <p>No tags defined yet.</p>}
      </div>
    </div>
  </div>
</WikiPage>

<style>
  .tag-index-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 10px;
  }
  .tag-index-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .tag-index-desc {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
  }
</style>
