---
import { url } from "@/lib/url";
import WikiPage from "@/layouts/WikiPage.astro";
import TagBadge from "@/components/TagBadge.astro";
import { resolveEntries } from "@/lib/resolveEntries";

const { tagMap, bookMetaMap, talentMap, featMap, sphereMap, classMap } = await resolveEntries();

// Count explicit tag usage per tag id, with per-system breakdown
type TagStats = {
  total: number;
  bySystem: Record<string, number>;
};

const stats = new Map<string, TagStats>();
for (const [id] of tagMap) {
  stats.set(id, { total: 0, bySystem: {} });
}

function tally(tags: string[], system: string) {
  for (const t of tags) {
    if (!stats.has(t)) continue;
    const s = stats.get(t)!;
    s.total++;
    s.bySystem[system] = (s.bySystem[system] ?? 0) + 1;
  }
}

for (const t of talentMap.values())  tally(t.tags, t.system);
for (const f of featMap.values())    tally(f.tags, f.system);
for (const s of sphereMap.values())  tally(s.tags, s.system);
for (const c of classMap.values())   tally(c.tags, c.system);

const SYSTEM_LABELS: Record<string, string> = {
  power: "Power", might: "Might", guile: "Guile", champions: "Champ",
};
const SYSTEM_ORDER = ["power", "might", "guile", "champions"];

// Split + sort: system tags by priority, user tags by priority then alpha
const builtinTags = [...tagMap.values()]
  .filter(t => t.sourceBook === "__built-in__")
  .sort((a, b) => a.priority - b.priority || a.label.localeCompare(b.label));

const userTags = [...tagMap.values()]
  .filter(t => t.sourceBook !== "__built-in__")
  .sort((a, b) => a.priority - b.priority || a.label.localeCompare(b.label));

// Group content tags by sphere
type SphereGroup = {
  sphereId: string;
  sphereName: string;
  sphereSystem: string;
  tags: typeof userTags;
};

const sphereGroupMap = new Map<string, SphereGroup>();
const unassignedTags: typeof userTags = [];

for (const tag of userTags) {
  if (!tag.sphere) { unassignedTags.push(tag); continue; }
  const sphereEntry = sphereMap.get(`sphere:${tag.sphere}`);
  if (!sphereGroupMap.has(tag.sphere)) {
    sphereGroupMap.set(tag.sphere, {
      sphereId: tag.sphere,
      sphereName: sphereEntry?.name ?? tag.sphere,
      sphereSystem: sphereEntry?.system ?? "power",
      tags: [],
    });
  }
  sphereGroupMap.get(tag.sphere)!.tags.push(tag);
}

const sphereGroups = [...sphereGroupMap.values()]
  .sort((a, b) => a.sphereName.localeCompare(b.sphereName));
---

<WikiPage title="Tags — Spheres Wiki" pagefindIgnore={true}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Tags</span>
  </nav>

  <h1 class="page-title" id="overview">Tags</h1>
  <hr class="page-title-rule" />

  <p class="tags-intro">
    Tags appear as colored badges on every entry — talents, feats, spheres, and classes.
    Hover any badge for a description. Click it to browse every entry that carries that tag.
  </p>

  <div class="tags-legend">
    <div class="tags-legend-col">
      <strong>System Tags</strong> are applied automatically by the wiki based on entry type, tier, and publisher.
      They appear in the same order on every entry and cannot be set manually in content files.
    </div>
    <div class="tags-legend-col">
      <strong>Descriptor &amp; Content Tags</strong> come from the source books themselves.
      They describe game mechanics, damage types, creature keywords, and other rule categories
      defined by each book's authors.
    </div>
  </div>

  <p class="tags-summary">
    {tagMap.size} tag{tagMap.size !== 1 ? "s" : ""} total &mdash; {builtinTags.length} system, {userTags.length} content.
  </p>

  {builtinTags.length > 0 && (
    <div class="section-group" style="margin-top: 16px;">
      <div class="section-group-header">
        <span class="section-group-label">System Tags</span>
        <div class="section-group-rule" />
      </div>
      <div class="tag-table">
        {builtinTags.map(tag => {
          const s = stats.get(tag.id)!;
          return (
            <div class="tag-row">
              <div class="tag-row-badge">
                <TagBadge tagId={tag.id} tagMap={tagMap} bookMetaMap={bookMetaMap} />
              </div>
              <div class="tag-row-desc" set:html={tag.description.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')} />
              <div class="tag-row-stats">
                {s.total > 0 && (
                  <span class="tag-count">{s.total}</span>
                )}
                {SYSTEM_ORDER.filter(sys => s.bySystem[sys]).map(sys => (
                  <span class={`tag-sys-pip ${sys === 'champions' ? 'champ' : sys}`}
                    title={`${s.bySystem[sys]} ${SYSTEM_LABELS[sys]} entries`}>
                    {SYSTEM_LABELS[sys]} {s.bySystem[sys]}
                  </span>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  )}

  {userTags.length === 0 ? (
    <p class="section-empty" style="margin-top: 32px;">No content tags defined yet.</p>
  ) : (
    <>
      {sphereGroups.map(group => (
        <div class="section-group" style="margin-top: 24px;">
          <div class="section-group-header">
            <a
              href={url(`/power/${group.sphereId}/`)}
              class={`section-group-label sphere-group-label ${group.sphereSystem}`}
              data-astro-prefetch="hover"
            >
              {group.sphereName}
            </a>
            <div class="section-group-rule" />
          </div>
          <div class="tag-table">
            {group.tags.map(tag => {
              const s = stats.get(tag.id)!;
              return (
                <div class="tag-row">
                  <div class="tag-row-badge">
                    <TagBadge tagId={tag.id} tagMap={tagMap} bookMetaMap={bookMetaMap} />
                  </div>
                  <div class="tag-row-desc" set:html={tag.description.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')} />
                  <div class="tag-row-stats">
                    {s.total > 0 && <span class="tag-count">{s.total}</span>}
                    {SYSTEM_ORDER.filter(sys => s.bySystem[sys]).map(sys => (
                      <span class={`tag-sys-pip ${sys === 'champions' ? 'champ' : sys}`}
                        title={`${s.bySystem[sys]} ${SYSTEM_LABELS[sys]} entries`}>
                        {SYSTEM_LABELS[sys]} {s.bySystem[sys]}
                      </span>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}

      {unassignedTags.length > 0 && (
        <div class="section-group" style="margin-top: 24px;">
          <div class="section-group-header">
            <span class="section-group-label">General</span>
            <div class="section-group-rule" />
          </div>
          <div class="tag-table">
            {unassignedTags.map(tag => {
              const s = stats.get(tag.id)!;
              return (
                <div class="tag-row">
                  <div class="tag-row-badge">
                    <TagBadge tagId={tag.id} tagMap={tagMap} bookMetaMap={bookMetaMap} />
                  </div>
                  <div class="tag-row-desc" set:html={tag.description.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>')} />
                  <div class="tag-row-stats">
                    {s.total > 0 && <span class="tag-count">{s.total}</span>}
                    {SYSTEM_ORDER.filter(sys => s.bySystem[sys]).map(sys => (
                      <span class={`tag-sys-pip ${sys === 'champions' ? 'champ' : sys}`}
                        title={`${s.bySystem[sys]} ${SYSTEM_LABELS[sys]} entries`}>
                        {SYSTEM_LABELS[sys]} {s.bySystem[sys]}
                      </span>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </>
  )}
</WikiPage>

<style>
  .tags-intro {
    font-size: var(--fs-sm);
    color: var(--clr-text);
    line-height: 1.55;
    margin-bottom: 16px;
  }

  .tags-legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
    background: var(--clr-surface);
    border: 0.5px solid var(--clr-border);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin-bottom: 16px;
  }

  .tags-legend-col {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    line-height: 1.5;
  }

  .tags-legend-col strong {
    color: var(--clr-text);
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .tags-legend {
      grid-template-columns: 1fr;
    }
  }

  .tags-summary {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    margin-bottom: 4px;
  }

  .tag-table {
    display: flex;
    flex-direction: column;
    margin-top: 10px;
    border: 0.5px solid var(--clr-border);
    border-radius: var(--radius);
  }

  .tag-row {
    display: grid;
    grid-template-columns: 160px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    border-bottom: 0.5px solid var(--clr-border);
    position: relative;
  }

  .tag-row:first-child {
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
  }

  .tag-row:last-child {
    border-bottom: none;
    border-bottom-left-radius: var(--radius);
    border-bottom-right-radius: var(--radius);
  }

  .tag-row:hover,
  .tag-row:focus-within {
    background: color-mix(in srgb, var(--clr-brand) 4%, transparent);
    z-index: 10;
  }

  .tag-row-badge {
    display: flex;
    align-items: center;
  }

  .tag-row-desc {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    line-height: 1.4;
  }

  .tag-row-stats {
    display: flex;
    align-items: center;
    gap: 4px;
    justify-content: flex-end;
    flex-wrap: nowrap;
    min-width: 0;
  }

  .tag-count {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--clr-muted);
    background: color-mix(in srgb, var(--clr-border) 60%, transparent);
    padding: 1px 6px;
    border-radius: 99px;
    white-space: nowrap;
  }

  .tag-sys-pip {
    font-family: var(--font-display);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 1px 5px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .tag-sys-pip.power { background: color-mix(in srgb, var(--clr-power) 12%, transparent); color: var(--clr-power); }
  .tag-sys-pip.might { background: color-mix(in srgb, var(--clr-might) 12%, transparent); color: var(--clr-might); }
  .tag-sys-pip.guile { background: color-mix(in srgb, var(--clr-guile) 12%, transparent); color: var(--clr-guile); }
  .tag-sys-pip.champ { background: color-mix(in srgb, var(--clr-champ) 12%, transparent); color: var(--clr-champ); }

  a.sphere-group-label {
    text-decoration: none;
  }
  a.sphere-group-label:hover {
    text-decoration: underline;
  }
  a.sphere-group-label.power { color: var(--clr-power); }
  a.sphere-group-label.might { color: var(--clr-might); }
  a.sphere-group-label.guile { color: var(--clr-guile); }
  a.sphere-group-label.champions { color: var(--clr-champ); }

  @media (max-width: 600px) {
    .tag-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .tag-row-stats {
      justify-content: flex-start;
    }
  }
</style>
