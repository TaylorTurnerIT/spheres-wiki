---
import { url } from "@/lib/url";
import WikiPage from "@/layouts/WikiPage.astro";
import TagRow from "@/components/TagRow.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { buildSystemIdIndex, systemCssKey, systemIdKey } from "@/lib/systems";
import { SYSTEMS } from "@/config/site";
import { resolveEntries } from "@/lib/resolveEntries";

const { tagMap, bookMetaMap, talentMap, featMap, sphereMap, classMap } = await resolveEntries();
const sphereIndex = buildSystemIdIndex(sphereMap.values());

// Count explicit tag usage per tag id, with per-system breakdown
type TagStats = {
  total: number;
  bySystem: Record<string, number>;
};

const stats = new Map<string, TagStats>();
for (const [id] of tagMap) {
  stats.set(id, { total: 0, bySystem: {} });
}

function tally(tags: string[], system: string) {
  for (const t of tags) {
    if (!stats.has(t)) continue;
    const s = stats.get(t)!;
    s.total++;
    s.bySystem[system] = (s.bySystem[system] ?? 0) + 1;
  }
}

for (const t of talentMap.values())  tally(t.tags, t.system);
for (const f of featMap.values())    tally(f.tags, f.system);
for (const s of sphereMap.values())  tally(s.tags, s.system);
for (const c of classMap.values())   tally(c.tags, c.system);

const SYSTEM_ORDER = Object.keys(SYSTEMS);

// Split + sort: system tags by priority, user tags by priority then alpha
const builtinTags = [...tagMap.values()]
  .filter(t => t.sourceBook === "__built-in__")
  .sort((a, b) => a.priority - b.priority || a.label.localeCompare(b.label));

const userTags = [...tagMap.values()]
  .filter(t => t.sourceBook !== "__built-in__")
  .sort((a, b) => a.priority - b.priority || a.label.localeCompare(b.label));

// Group content tags by sphere
type SphereGroup = {
  sphereId: string;
  sphereName: string;
  sphereSystem: string;
  tags: typeof userTags;
};

const sphereGroupMap = new Map<string, SphereGroup>();
const unassignedTags: typeof userTags = [];

for (const tag of userTags) {
  if (!tag.sphere) { unassignedTags.push(tag); continue; }
  const sphereEntry = sphereIndex.get(
    systemIdKey(tag.system ?? "power", tag.sphere),
  );
  const sphereSystem = sphereEntry?.system ?? tag.system ?? "power";
  const sphereGroupKey = sphereSystem + ":" + tag.sphere;
  if (!sphereGroupMap.has(sphereGroupKey)) {
    sphereGroupMap.set(sphereGroupKey, {
      sphereId: tag.sphere,
      sphereName: sphereEntry?.name ?? tag.sphere,
      sphereSystem,
      tags: [],
    });
  }
  sphereGroupMap.get(sphereGroupKey)!.tags.push(tag);
}

const sphereGroups = [...sphereGroupMap.values()]
  .sort((a, b) => a.sphereName.localeCompare(b.sphereName));
---

<WikiPage title="Tags — Spheres Wiki" pagefindIgnore={true}>
  <Breadcrumb crumbs={[
    { label: "Home", href: url("/") },
    { label: "Tags" },
  ]} />

  <h1 class="page-title" id="overview">Tags</h1>
  <hr class="page-title-rule" />

  <p class="tags-intro">
    Tags appear as colored badges on every entry — talents, feats, spheres, and classes.
    Hover any badge for a description. Click it to browse every entry that carries that tag.
  </p>

  <div class="tags-legend">
    <div class="tags-legend-col">
      <strong>System Tags</strong> are applied automatically by the wiki based on entry type, tier, and publisher.
      They appear in the same order on every entry and cannot be set manually in content files.
    </div>
    <div class="tags-legend-col">
      <strong>Descriptor &amp; Content Tags</strong> come from the source books themselves.
      They describe game mechanics, damage types, creature keywords, and other rule categories
      defined by each book's authors.
    </div>
  </div>

  <p class="tags-summary">
    {tagMap.size} tag{tagMap.size !== 1 ? "s" : ""} total &mdash; {builtinTags.length} system, {userTags.length} content.
  </p>

  {builtinTags.length > 0 && (
    <div class="section-group" style="margin-top: 16px;">
      <SectionHeading label="System Tags" />
      <div class="tag-table">
        {builtinTags.map(tag => (
          <TagRow tag={tag} stats={stats.get(tag.id)!} systemOrder={SYSTEM_ORDER} tagMap={tagMap} bookMetaMap={bookMetaMap} />
        ))}
      </div>
    </div>
  )}

  {userTags.length === 0 ? (
    <p class="section-empty" style="margin-top: 32px;">No content tags defined yet.</p>
  ) : (
    <>
      {sphereGroups.map(group => (
        <div class="section-group" data-system={group.sphereSystem} style="margin-top: 24px;">
          <SectionHeading
            label={group.sphereName}
            href={url(`/${group.sphereSystem}/${group.sphereId}/`)}
            labelClass={`sphere-group-label ${systemCssKey(group.sphereSystem)}`}
          />
          <div class="tag-table">
            {group.tags.map(tag => (
              <TagRow tag={tag} stats={stats.get(tag.id)!} systemOrder={SYSTEM_ORDER} tagMap={tagMap} bookMetaMap={bookMetaMap} />
            ))}
          </div>
        </div>
      ))}

      {unassignedTags.length > 0 && (
        <div class="section-group" style="margin-top: 24px;">
          <SectionHeading label="General" />
          <div class="tag-table">
            {unassignedTags.map(tag => (
              <TagRow tag={tag} stats={stats.get(tag.id)!} systemOrder={SYSTEM_ORDER} tagMap={tagMap} bookMetaMap={bookMetaMap} />
            ))}
          </div>
        </div>
      )}
    </>
  )}
</WikiPage>

<style>
  .tags-intro {
    font-size: var(--fs-sm);
    color: var(--clr-text);
    line-height: 1.55;
    margin-bottom: 16px;
  }

  .tags-legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
    background: var(--clr-surface);
    border: 0.5px solid var(--clr-border);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin-bottom: 16px;
  }

  .tags-legend-col {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    line-height: 1.5;
  }

  .tags-legend-col strong {
    color: var(--clr-text);
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .tags-legend {
      grid-template-columns: 1fr;
    }
  }

  .tags-summary {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    margin-bottom: 4px;
  }

  .tag-table {
    display: flex;
    flex-direction: column;
    margin-top: 10px;
    border: 0.5px solid var(--clr-border);
    border-radius: var(--radius);
  }

  :global(a.sphere-group-label) {
    text-decoration: none;
    color: var(--clr-ns);
  }
  :global(a.sphere-group-label:hover) {
    text-decoration: underline;
  }

</style>
