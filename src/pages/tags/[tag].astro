---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import WikiPage from "@/layouts/WikiPage.astro";
import TagBadge from "@/components/TagBadge.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { renderMarkdownFragment } from "@/lib/renderBody";
import { buildTagDetails, TAG_DETAIL_SSR_CAP, type TagDetailGroup } from "@/lib/tagDetail";
import type { TagEntry, BookMeta } from "@/lib/types";

interface Props {
  tag: TagEntry;
  groups: TagDetailGroup[];
  totalRows: number;
  collEntry: any;
  bookTitle: string;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const details = await buildTagDetails();
  const { tagMap, bookMetaMap } = await (await import("@/lib/resolveEntries")).resolveEntries();
  return [...details.values()].map((detail) => ({
    params: { tag: detail.tag.id },
    props: {
      tag: detail.tag,
      groups: detail.groups,
      totalRows: detail.groups.reduce((n, g) => n + g.entries.length, 0),
      collEntry: detail.collEntry,
      bookTitle: detail.bookTitle,
      tagMap,
      bookMetaMap,
    },
  }));
}

const { tag, groups, totalRows, collEntry, bookTitle, tagMap, bookMetaMap } =
  Astro.props as Props;
const TagBody = collEntry?.body ? (await render(collEntry)).Content : null;

// Tag descriptions go through the shared markdown pipeline; external links
// keep the previous new-tab behavior.
const descriptionHtml = (await renderMarkdownFragment(tag.description)).replace(
  /<a href="(https?:[^"]+)"/g,
  '<a href="$1" target="_blank" rel="noopener noreferrer"',
);

// Server-render the head rows; the tail is fetched client-side
// (lib/tagDetailClient) so the giant system-tag pages stay light.
const ssrRows = Math.min(TAG_DETAIL_SSR_CAP, totalRows);
const capped = totalRows > ssrRows;
let rendered = 0;
const headGroups = groups.map((group) => {
  if (rendered >= ssrRows) return { ...group, head: [] as typeof group.entries };
  const head = group.entries.slice(0, ssrRows - rendered);
  rendered += head.length;
  return { ...group, head };
});
---

<WikiPage title={`${tag.label} — Tags — Spheres Wiki`} pagefindIgnore={true}>
  <Breadcrumb crumbs={[
    { label: "Home", href: url("/") },
    { label: "Tags", href: url("/tags/") },
    { label: tag.label },
  ]} />

  <div class="content-main">
    <h1 class="page-title" id="overview">
      <TagBadge tagId={tag.id} tagMap={tagMap} bookMetaMap={bookMetaMap} />
    </h1>
    <hr class="page-title-rule" />

    {bookTitle && <p class="talent-source">{bookTitle}</p>}

    <div class="entry-description" set:html={descriptionHtml} />

    {
      TagBody && (
        <div class="entry-description">
          <TagBody />
        </div>
      )
    }

    {
      groups.length === 0 && (
        <p class="section-empty">No content with this tag yet.</p>
      )
    }

    {
      headGroups.map((group) => (
        <div class="section-group">
          <SectionHeading label={group.systemLabel} />
          <div class="tag-entry-list">
            {group.head.map((row) => (
              <div class="tag-entry-row" data-system={row.system}>
                <a href={url(row.href)} class="tag-entry-name" data-astro-prefetch="hover">
                  {row.name}
                </a>
                {row.badges.map((tagId) => (
                  <TagBadge
                    tagId={tagId}
                    tagMap={tagMap}
                    bookMetaMap={bookMetaMap}
                    showTooltip={false}
                    prefetch={false}
                  />
                ))}
                <span class="tag-entry-sphere">{row.sphereName}</span>{" "}
              </div>
            ))}
          </div>
        </div>
      ))
    }

    {
      capped && (
        <p
          class="tag-entry-status section-empty"
          data-tag-tail-status
          data-tag-id={tag.id}
        >
          Showing first {ssrRows} of {totalRows} entries — loading the rest…
        </p>
      )
    }
  </div>
</WikiPage>

<style>
  .tag-entry-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 24px;
  }
  .tag-entry-row {
    display: flex;
    align-items: center;
    gap: 8px;
    /* Preserve every tag entry in the static document without laying out all
       thousands of off-screen rows up front. */
    content-visibility: auto;
    contain-intrinsic-size: auto 32px;
  }
  .tag-entry-name {
    font-size: var(--fs-sm);
    color: var(--clr-link);
    text-decoration: none;
    font-weight: 500;
  }
  .tag-entry-name:hover {
    text-decoration: underline;
  }
  .tag-entry-sphere {
    font-size: var(--fs-xs);
    color: var(--clr-muted);
    font-style: italic;
  }
</style>

<script>
  import { initTagDetailTail } from "@/lib/tagDetailClient";

  document.addEventListener("astro:page-load", () => {
    initTagDetailTail();
  });
</script>
