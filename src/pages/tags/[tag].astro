---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import WikiPage from "@/layouts/WikiPage.astro";
import TagBadge from "@/components/TagBadge.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { resolveEntries, getCollEntriesMap } from "@/lib/resolveEntries";
import { renderMarkdownFragment } from "@/lib/renderBody";
import { buildOrderedTagIds } from "@/lib/tags";
import { getFeatUrl } from "@/lib/featCategories";
import { resolveSystem, buildSystemIdIndex, systemIdKey } from "@/lib/systems";
import { contentEntryKey } from "@/lib/entryIdentity";
import { SYSTEMS } from "@/config/site";
import type { TagEntry, BookMeta } from "@/lib/types";

type EntryRow = {
  id: string;
  name: string;
  system: string;
  href: string;
  sphereId?: string;
  entryType: "talent" | "feat" | "sphere";
  sphereName: string;
  sourceBook: string;
  tags: string[];
  tier?: string;
};

type SystemGroup = {
  systemLabel: string;
  entries: EntryRow[];
};

interface Props {
  tag: TagEntry;
  groups: SystemGroup[];
  collEntry: any;
  bookTitle: string;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

// fallow-ignore-next-line complexity
export async function getStaticPaths() {
  const { tagMap, talentMap, featMap, sphereMap, bookMetaMap } =
    await resolveEntries();
  const allCollEntries = await getCollEntriesMap();

  const paths = [];
  const sphereIndex = buildSystemIdIndex(sphereMap.values());

  for (const [, tag] of tagMap) {
    const groups: SystemGroup[] = [];

    for (const system of Object.keys(SYSTEMS)) {
      const rows: EntryRow[] = [];

      for (const [, talent] of talentMap) {
        if (talent.system !== system) continue;
        const entryTags = buildOrderedTagIds(talent, bookMetaMap, tagMap, {
          showHidden: true,
        });
        if (!entryTags.includes(tag.id)) continue;

        const sphere = sphereIndex.get(systemIdKey(system, talent.sphere ?? ""));
        rows.push({
          id: talent.id,
          name: talent.name,
          system,
          href: `/${system}/${talent.sphere}/${talent.id}/`,
          sphereId: talent.sphere,
          entryType: "talent",
          sphereName: sphere?.name ?? talent.sphere,
          sourceBook: talent.sourceBook,
          tags: talent.tags,
          tier: talent.tier,
        });
      }

      for (const [, feat] of featMap) {
        if (feat.system !== system) continue;
        const entryTags = buildOrderedTagIds(feat, bookMetaMap, tagMap, {
          showHidden: true,
        });
        if (!entryTags.includes(tag.id)) continue;

        const sphere = sphereIndex.get(systemIdKey(system, feat.sphere ?? ""));
        rows.push({
          id: feat.id,
          name: feat.name,
          system,
          href: getFeatUrl(feat, tagMap),
          sphereId: feat.sphere,
          entryType: "feat",
          sphereName: sphere?.name ?? feat.sphere ?? "General",
          sourceBook: feat.sourceBook,
          tags: feat.tags,
        });
      }

      for (const [, sphere] of sphereMap) {
        if (sphere.system !== system) continue;
        const entryTags = buildOrderedTagIds(sphere, bookMetaMap, tagMap, {
          showHidden: true,
        });
        if (!entryTags.includes(tag.id)) continue;

        rows.push({
          id: sphere.id,
          name: sphere.name,
          system,
          href: `/${system}/${sphere.id}/`,
          sphereId: sphere.id,
          entryType: "sphere",
          sphereName: sphere.name,
          sourceBook: sphere.sourceBook,
          tags: sphere.tags,
        });
      }

      rows.sort((a, b) => a.name.localeCompare(b.name));

      if (rows.length > 0) {
        groups.push({
          systemLabel: resolveSystem(system)?.label ?? system,
          entries: rows,
        });
      }
    }

    const collEntry = allCollEntries.get(contentEntryKey("tag", undefined, tag.id));
    const cacheKey = [
      collEntry?.digest ?? tag.id,
      groups.map((g) => g.entries.map((e) => e.id).join(",")).join(";"),
    ].join("::");

    paths.push({
      params: { tag: tag.id },
      props: {
        tag,
        groups,
        collEntry,
        bookTitle:
          tag.sourceBook === "__built-in__"
            ? "Built-in"
            : bookMetaMap.get(tag.sourceBook)?.title ?? tag.sourceBook,
        tagMap,
        bookMetaMap,
      },
      cacheKey,
    });
  }

  return paths;
}

const { tag, groups, collEntry, bookTitle, tagMap, bookMetaMap } = Astro.props;
const TagBody = collEntry?.body ? (await render(collEntry)).Content : null;

// Tag descriptions go through the shared markdown pipeline; external links
// keep the previous new-tab behavior.
const descriptionHtml = (await renderMarkdownFragment(tag.description)).replace(
  /<a href="(https?:[^"]+)"/g,
  '<a href="$1" target="_blank" rel="noopener noreferrer"',
);
---

<WikiPage title={`${tag.label} — Tags — Spheres Wiki`} pagefindIgnore={true}>
  <Breadcrumb crumbs={[
    { label: "Home", href: url("/") },
    { label: "Tags", href: url("/tags/") },
    { label: tag.label },
  ]} />

  <div class="content-main">
    <h1 class="page-title" id="overview">
      <TagBadge tagId={tag.id} tagMap={tagMap} bookMetaMap={bookMetaMap} />
    </h1>
    <hr class="page-title-rule" />

    {bookTitle && <p class="talent-source">{bookTitle}</p>}

    <div class="entry-description" set:html={descriptionHtml} />

    {
      TagBody && (
        <div class="entry-description">
          <TagBody />
        </div>
      )
    }

    {
      groups.length === 0 && (
        <p class="section-empty">No content with this tag yet.</p>
      )
    }

    {
      groups.map((group) => (
        <div class="section-group">
          <SectionHeading label={group.systemLabel} />
          <div class="tag-entry-list">
            {group.entries.map((row) => (
              <div class="tag-entry-row" data-system={row.system}>
                {row.entryType === "talent" && (
                  <a
                    href={url(row.href)}
                    class="tag-entry-name"
                    data-astro-prefetch="hover"
                  >
                    {row.name}
                  </a>
                )}
                {row.entryType === "feat" && (
                  <a
                    href={url(row.href)}
                    class="tag-entry-name"
                    data-astro-prefetch="hover"
                  >
                    {row.name}
                  </a>
                )}
                {row.entryType === "sphere" && (
                  <a
                    href={url(row.href)}
                    class="tag-entry-name"
                    data-astro-prefetch="hover"
                  >
                    {row.name}
                  </a>
                )}
                {buildOrderedTagIds(
                  {
                    type: row.entryType,
                    id: row.id,
                    sourceBook: row.sourceBook,
                    tags: row.tags,
                    tier: row.tier as any,
                    sphere: row.sphereId,
                  } as any,
                  bookMetaMap,
                  tagMap,
                  {},
                ).map((tagId) => (
                  <TagBadge
                    tagId={tagId}
                    tagMap={tagMap}
                    bookMetaMap={bookMetaMap}
                    showTooltip={false}
                  />
                ))}
                <span class="tag-entry-sphere">{row.sphereName}</span>{" "}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</WikiPage>

<style>
  .tag-entry-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 24px;
  }
  .tag-entry-row {
    display: flex;
    align-items: center;
    gap: 8px;
    /* Preserve every tag entry in the static document without laying out all
       thousands of off-screen rows up front. */
    content-visibility: auto;
    contain-intrinsic-size: auto 32px;
  }
  .tag-entry-name {
    font-size: var(--fs-sm);
    color: var(--clr-link);
    text-decoration: none;
    font-weight: 500;
  }
  .tag-entry-name:hover {
    text-decoration: underline;
  }
  .tag-entry-sphere {
    font-size: var(--fs-xs);
    color: var(--clr-muted);
    font-style: italic;
  }
</style>
