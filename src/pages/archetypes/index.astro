---
import { url } from "@/lib/url";
import WikiPage from "@/layouts/WikiPage.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import CollapsibleSectionHeading from "@/components/CollapsibleSectionHeading.astro";
import { buildSystemIdIndex, systemIdKey, systemCssKey } from "@/lib/systems";
import { resolveEntries } from "@/lib/resolveEntries";
import { SYSTEMS } from "@/config/site";
import type { ArchetypeEntry, ClassEntry } from "@/lib/types";

const { archetypeMap, classMap, bookMetaMap } = await resolveEntries();

// Every registered system exposes the same class/archetype detail route.
const SPHERE_SYSTEMS = new Set(Object.keys(SYSTEMS));

type ArcRow = {
  arc: ArchetypeEntry;
  book: string | undefined;
  href: string | null; // null = no detail page yet
};

type ClassGroup = {
  classId: string;
  className: string;
  arcs: ArcRow[];
};

type SystemGroup = {
  system: string;
  label: string;
  groups: ClassGroup[];
};

// Class ids can be reused by different systems, so resolve them with the
// same system-scoped identity used by the content maps.
const classIndex = buildSystemIdIndex(classMap.values());
function classForArchetype(arc: ArchetypeEntry): ClassEntry | undefined {
  return (
    classIndex.get(systemIdKey(arc.system, arc.className)) ??
    classIndex.get(systemIdKey("pf1e", arc.className))
  );
}

// Separate archetypes into sphere-class vs pf1e
const sphereBySystem = new Map<string, Map<string, ArcRow[]>>();
const pf1eByClass = new Map<string, ArcRow[]>();

for (const [, arc] of archetypeMap) {
  const cls = classForArchetype(arc);
  const book = bookMetaMap.get(arc.sourceBook)?.title;

  if (cls && SPHERE_SYSTEMS.has(cls.system)) {
    // Sphere class archetype
    const href = SYSTEMS[arc.system]
      ? url(`/${arc.system}/classes/${arc.className}/${arc.id}/`)
      : null;
    const row: ArcRow = { arc, book, href };

    if (!sphereBySystem.has(cls.system)) sphereBySystem.set(cls.system, new Map());
    const byClass = sphereBySystem.get(cls.system)!;
    if (!byClass.has(arc.className)) byClass.set(arc.className, []);
    byClass.get(arc.className)!.push(row);

  } else if (cls?.system === "pf1e" || !cls) {
    // PF1e base class archetype (or unknown class — treat as pf1e)
    const href = SYSTEMS[arc.system]
      ? url(`/${arc.system}/classes/${arc.className}/${arc.id}/`)
      : null;
    const row: ArcRow = { arc, book, href };
    const key = arc.className;
    if (!pf1eByClass.has(key)) pf1eByClass.set(key, []);
    pf1eByClass.get(key)!.push(row);
  }
}

// Sort archetypes within each class group alphabetically,
// but "Spheres {ClassName}" always first
function sortArcs(arcs: ArcRow[], className: string): ArcRow[] {
  const classEntry = arcs.map(({ arc }) => classForArchetype(arc)).find(Boolean);
  const baseConversionName = `Spheres ${classEntry?.name ?? className}`;
  return [...arcs].sort((a, b) => compareArcRows(a, b, baseConversionName));
}

function compareArcRows(a: ArcRow, b: ArcRow, baseConversionName: string): number {
  const aPriority = Number(a.arc.name !== baseConversionName);
  const bPriority = Number(b.arc.name !== baseConversionName);
  return aPriority - bPriority || a.arc.name.localeCompare(b.arc.name);
}

// Build final sphere groups in system order
const SYSTEM_ORDER = Object.keys(SYSTEMS);
const sphereGroups: SystemGroup[] = SYSTEM_ORDER
  .filter(sys => sphereBySystem.has(sys))
  .map(sys => {
    const byClass = sphereBySystem.get(sys)!;
    const groups: ClassGroup[] = [...byClass.entries()].map(([classId, arcs]) => ({
      classId,
      className: classForArchetype(arcs[0].arc)?.name ?? classId,
      arcs: sortArcs(arcs, classId),
    })).sort((a, b) => a.className.localeCompare(b.className));
    return { system: sys, label: SYSTEMS[sys].label, groups };
  });

// Build pf1e groups sorted by class name, "Spheres X" first within each
const pf1eGroups: ClassGroup[] = [...pf1eByClass.entries()].map(([classId, arcs]) => ({
  classId,
  className: classForArchetype(arcs[0].arc)?.name ?? classId,
  arcs: sortArcs(arcs, classId),
})).sort((a, b) => a.className.localeCompare(b.className));

const totalCount = archetypeMap.size;

---
<WikiPage title="Archetypes Index — Spheres Wiki" pagefindIgnore={true}>

  <Breadcrumb crumbs={[
    { label: "Home", href: url("/") },
    { label: "Archetypes" },
  ]} />

  <h1 class="page-title" id="overview">Archetypes</h1>
  <hr class="page-title-rule" />

  <p class="arc-intro">
    {totalCount} archetype{totalCount !== 1 ? "s" : ""} indexed.
    Sphere class archetypes modify a sphere system class. Pathfinder 1e archetypes adapt base classes to use the Spheres system.
  </p>

  <!-- ── Sphere Class Archetypes ─────────────────────────── -->
  {sphereGroups.length > 0 && (
    <section class="arc-section">
      <SectionHeading label="Sphere Class Archetypes" style="margin-top: 24px;" />

      {sphereGroups.map(sg => (
        <div class={`arc-system-block arc-system-${sg.system}`}>
          <SectionHeading level="eyebrow" label={sg.label} labelClass={systemCssKey(sg.system)} class="arc-system-heading" />

          {sg.groups.map(cg => (
            <div class="arc-class-group">
              <CollapsibleSectionHeading
                label={cg.className}
                id={`sphere-${sg.system}-${cg.classId}`}
                controls={`sphere-${sg.system}-${cg.classId}-list`}
                dataKey="groupId"
                dataValue={`sphere-${sg.system}-${cg.classId}`}
                class="arc-class-toggle"
                labelClass={systemCssKey(sg.system)}
              />

              <div class="arc-list" id={`sphere-${sg.system}-${cg.classId}-list`} aria-hidden="false">
                {cg.arcs.map(({ arc, book, href }) => (
                  <div class="arc-entry">
                    {href
                      ? <a href={href} class={`arc-name ${systemCssKey(sg.system)}`} data-astro-prefetch="hover">{arc.name}</a>
                      : <span class={`arc-name arc-name--nolink ${systemCssKey(sg.system)}`}>{arc.name}</span>
                    }
                    {book && <span class="arc-source">{book}</span>}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      ))}
    </section>
  )}

  <!-- ── Pathfinder 1e Archetypes ───────────────────────── -->
  <section class="arc-section">
    <SectionHeading label="Pathfinder 1e Archetypes" style="margin-top: 32px;" />

    {pf1eGroups.length === 0 ? (
      <p class="section-empty">No Pathfinder 1e archetypes indexed yet.</p>
    ) : (
      pf1eGroups.map(cg => (
        <div class="arc-class-group">
          <CollapsibleSectionHeading
            label={cg.className}
            id={`pf1e-${cg.classId}`}
            controls={`pf1e-${cg.classId}-list`}
            dataKey="groupId"
            dataValue={`pf1e-${cg.classId}`}
            class="arc-class-toggle"
          />

          <div class="arc-list" id={`pf1e-${cg.classId}-list`} aria-hidden="false">
            {cg.arcs.map(({ arc, book, href }) => {
              const sysKey = systemCssKey(arc.system);
              return (
                <div class="arc-entry">
                  {href
                    ? <a href={href} class={`arc-name ${sysKey}`} data-astro-prefetch="hover">{arc.name}</a>
                    : <span class={`arc-name arc-name--nolink`}>{arc.name}</span>
                  }
                  <span class={`sys-pill arc-sys-badge ${sysKey}`}>{SYSTEMS[arc.system]?.label ?? arc.system}</span>
                  {book && <span class="arc-source">{book}</span>}
                </div>
              );
            })}
          </div>
        </div>
      ))
    )}
  </section>

</WikiPage>

<script>
import { bindCollapseToggle } from '@/lib/collapseClient';

document.addEventListener('astro:page-load', () => {
  document.querySelectorAll<HTMLButtonElement>('.arc-class-toggle').forEach(btn => {
    const list = document.getElementById(`${btn.dataset.groupId!}-list`);
    if (list) bindCollapseToggle(btn, list);
  });
});
</script>

<style>
  .arc-intro {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    margin-bottom: 8px;
  }

  .arc-section {
    max-width: 720px;
  }

  .arc-system-block {
    margin-bottom: 16px;
  }

  .arc-class-group {
    margin-bottom: 4px;
  }

  /* Expand/collapse animation */
  .arc-list {
    transition: max-height 0.25s ease, overflow 0.25s ease;
    overflow: visible;
  }

  .arc-list[aria-hidden="true"] {
    max-height: 0 !important;
    overflow: hidden;
  }

  /* Entry row */
  .arc-entry {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 5px 12px;
    border-bottom: 0.5px solid var(--clr-border);
  }

  .arc-entry:last-child {
    border-bottom: none;
  }

  /* System class on the element sets --clr-ns (global.css) */
  .arc-name {
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    flex-shrink: 0;
    color: var(--clr-ns, var(--clr-text));
  }

  a.arc-name:hover {
    text-decoration: underline;
  }

  /* PF1e system badge — layout only; visuals from the shared .sys-pill */
  .arc-sys-badge {
    flex-shrink: 0;
  }

  .arc-source {
    font-size: var(--fs-xs);
    color: var(--clr-muted);
    font-style: italic;
    margin-left: auto;
  }
</style>
