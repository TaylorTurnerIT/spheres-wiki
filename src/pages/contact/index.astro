---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import ScrapeProof from '@/components/ScrapeProof.astro';
import ContactCard from '@/components/ContactCard.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
---
<WikiPage title="Contact — Spheres Wiki" pagefindIgnore={true}>

  <Breadcrumb crumbs={[
    { label: "Home", href: url("/") },
    { label: "Contact" },
  ]} />

  <h1 class="page-title" id="overview">Contact</h1>
  <hr class="page-title-rule" />

  <div class="contact-blocks">

    <ContactCard heading="Contact the Staff" icon="discord">
      <p slot="description">
        Join the Drop Dead Studios Discord and reach out to <strong>@Chef</strong> for technical concerns or <strong>@Rednal</strong> for content issues.
      </p>
      <ScrapeProof slot="action" type="discord" value="EfDKxcH" label="Join DDS Discord →" class="contact-discord-link" reveal={true} revealLabel="Show DDS invite link" />
    </ContactCard>

    <ContactCard heading="Drop Dead Studios Discord" icon="discord">
      <p slot="description">
        Official DDS server. Best place for rules questions — community and developers are active.
      </p>
      <ScrapeProof slot="action" type="discord" value="EfDKxcH" label="Join DDS Discord →" class="contact-discord-link" reveal={true} revealLabel="Show DDS invite link" />
    </ContactCard>

    <ContactCard heading="Diamond Recreational Studios Discord" icon="discord">
      <p slot="description">
        The newer server run by the official successors to Drop Dead Studios. Still worth joining both — the communities are active on each.
      </p>
      <ScrapeProof slot="action" type="discord" value="Q89NBmmK6a" label="Join DRS Discord →" class="contact-discord-link" reveal={true} revealLabel="Show DRS invite link" />
    </ContactCard>

    <ContactCard heading="Rules Questions?" icon="info">
      <p slot="description">
        Please use the public Discord channels for rules questions. The staff tags provided above are for technical wiki issues or content corrections only.
      </p>
      <a slot="action" href={url("/community-resources/")} class="contact-community-link" data-astro-prefetch="hover">
        Find Discord &amp; community links →
      </a>
    </ContactCard>

  </div>

</WikiPage>

<style>
  .contact-blocks {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 560px;
    margin-top: 8px;
  }

  /* :global needed — these classes are applied to <a> tags created by JS at runtime */
  :global(.contact-email-link) {
    font-family: var(--font-mono, monospace);
    font-size: var(--fs-sm);
    color: var(--clr-brand);
    text-decoration: none;
  }

  :global(.contact-email-link:hover) {
    text-decoration: underline;
  }

  :global(.contact-discord-link) {
    font-size: var(--fs-sm);
    color: #5865F2;
    text-decoration: none;
    font-weight: 600;
  }

  :global(.contact-discord-link:hover) {
    text-decoration: underline;
  }

  /* reveal buttons — in DOM at build time so scoped CSS works, but :global for symmetry */
  :global(.sp-reveal-btn) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
    padding: 5px 12px;
    font-size: var(--fs-sm);
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--clr-muted);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  :global(.sp-reveal-btn:hover) {
    border-color: var(--clr-brand);
    color: var(--clr-brand);
  }

  :global(.sp-reveal-btn.contact-discord-link) {
    color: #5865F2;
    border-color: color-mix(in srgb, #5865F2 40%, transparent);
  }

  :global(.sp-reveal-btn.contact-discord-link:hover) {
    border-color: #5865F2;
    color: #5865F2;
  }

  .contact-community-link {
    font-size: var(--fs-sm);
    color: var(--clr-brand);
    text-decoration: none;
  }

  .contact-community-link:hover {
    text-decoration: underline;
  }
</style>
