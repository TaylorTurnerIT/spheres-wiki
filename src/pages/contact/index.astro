---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
---
<WikiPage title="Contact — Spheres Wiki" pagefindIgnore={true}>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Contact</span>
  </nav>

  <h1 class="page-title" id="overview">Contact</h1>
  <hr class="page-title-rule" />

  <div class="contact-blocks">

    <div class="contact-card">
      <div class="contact-card-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1.5" y="3.5" width="13" height="9" rx="1"/>
          <path d="M1.5 5l6.5 4.5L14.5 5"/>
        </svg>
      </div>
      <div class="contact-card-body">
        <h2 class="contact-card-heading">Email the Administrator</h2>
        <p class="contact-card-desc">
          Direct email is the fastest way to reach the site administrator for wiki-related issues,
          corrections, or contributions.
        </p>
        <p class="contact-email-line">
          <a
            class="contact-email-link"
            data-u="sphereswiki1"
            data-d="gmail.com"
            href="#contact-email"
            aria-label="Email the administrator"
          >Loading&hellip;</a>
        </p>
      </div>
    </div>

    <div class="contact-card contact-card--note">
      <div class="contact-card-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="8" cy="8" r="6.5"/>
          <path d="M8 7v4M8 5.5v.5"/>
        </svg>
      </div>
      <div class="contact-card-body">
        <h2 class="contact-card-heading">Rules Questions?</h2>
        <p class="contact-card-desc">
          This is not the right place to ask about the rules. For rules questions,
          join the DDS Discord server and ask there — the community and developers are active.
        </p>
        <a href={url("/community-resources/")} class="contact-community-link" data-astro-prefetch="hover">
          Find Discord &amp; community links →
        </a>
      </div>
    </div>

  </div>

</WikiPage>

<script>
document.addEventListener('astro:page-load', () => {
  document.querySelectorAll<HTMLAnchorElement>('a[data-u][data-d]').forEach(el => {
    const u = el.dataset.u!;
    const d = el.dataset.d!;
    const addr = `${u}@${d}`;
    el.href = `mailto:${addr}`;
    el.textContent = addr;
  });
});
</script>

<style>
  .contact-blocks {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 560px;
    margin-top: 8px;
  }

  .contact-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
  }

  .contact-card--note {
    background: color-mix(in srgb, var(--clr-border) 30%, transparent);
  }

  .contact-card-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    color: var(--clr-brand);
    margin-top: 2px;
  }

  .contact-card-icon svg {
    width: 100%;
    height: 100%;
  }

  .contact-card--note .contact-card-icon {
    color: var(--clr-muted);
  }

  .contact-card-body {
    flex: 1;
    min-width: 0;
  }

  .contact-card-heading {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 700;
    margin: 0 0 6px;
    color: var(--clr-text);
  }

  .contact-card-desc {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    margin: 0 0 10px;
    line-height: 1.5;
  }

  .contact-email-line {
    margin: 0;
  }

  .contact-email-link {
    font-family: var(--font-mono, monospace);
    font-size: var(--fs-sm);
    color: var(--clr-brand);
    text-decoration: none;
  }

  .contact-email-link:hover {
    text-decoration: underline;
  }

  .contact-community-link {
    font-size: var(--fs-sm);
    color: var(--clr-brand);
    text-decoration: none;
  }

  .contact-community-link:hover {
    text-decoration: underline;
  }
</style>
