---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';

const { sphereMap, classMap } = await resolveEntries();

const spheres = [...sphereMap.values()]
  .filter(s => s.system === 'guile')
  .sort((a, b) => a.name.localeCompare(b.name));

const classes = [...classMap.values()]
  .filter(c => c.system === 'guile')
  .sort((a, b) => a.name.localeCompare(b.name));
---
<WikiPage title="Spheres of Guile — Spheres Wiki" activeNamespace="guile" pagefindIgnore={true}>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Spheres of Guile</span>
  </nav>

  <h1 class="page-title guile">Spheres of Guile</h1>
  <hr class="page-title-rule" />

  <div class="section-heading">
    <span class="section-heading-text">Skill Spheres</span>
    <div class="section-heading-rule"></div>
  </div>

  <div class="entry-grid">
    {spheres.map(s => (
      <a href={url(`/guile/${s.id}/`)} class="entry-card guile" data-astro-prefetch="hover">
        <div class="entry-card-header">
          <svg class="si entry-card-icon" aria-hidden="true"><use href={`#si-${s.icon}`} /></svg>
          <span class="entry-card-name">{s.name}</span>
        </div>
        {/* description from GFM body — wired in R1-6 */}
      </a>
    ))}
  </div>

  {classes.length > 0 && (
    <div style="margin-top: 20px;">
      <div class="section-heading">
        <span class="section-heading-text">Operative Classes</span>
        <div class="section-heading-rule"></div>
      </div>
      <div class="entry-grid">
        {classes.map(c => (
          <a href={url(`/guile/classes/${c.id}/`)} class="entry-card guile" data-astro-prefetch="hover">
            <div class="entry-card-header">
              <span class="entry-card-name">{c.name}</span>
            </div>
            {/* description from GFM body — wired in R1-6 */}
          </a>
        ))}
      </div>
    </div>
  )}

</WikiPage>
