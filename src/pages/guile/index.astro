---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import SphereBadgeGrid from '@/components/SphereBadgeGrid.astro';

const { sphereMap, classMap } = await resolveEntries();

const spheres = [...sphereMap.values()]
  .filter(s => s.system === 'guile')
  .sort((a, b) => a.name.localeCompare(b.name));

const classes = [...classMap.values()]
  .filter(c => c.system === 'guile')
  .sort((a, b) => a.name.localeCompare(b.name));
---
<WikiPage title="Spheres of Guile — Spheres Wiki" activeNamespace="guile" pagefindIgnore={true}>

  <div class="system-banner" aria-hidden="true">
    <svg viewBox="0 0 800 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="guileBannerGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#5A2D96" stop-opacity="0.32"/>
          <stop offset="100%" stop-color="#180B2E" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="800" height="140" fill="#180B2E"/>
      <rect width="800" height="140" fill="url(#guileBannerGlow)"/>
      <g transform="translate(400,70) scale(2.2) translate(-100,-40)">
        <line x1="100" y1="40" x2="-272" y2="-152" stroke="#7A4EC0" stroke-width=".8" opacity=".5"/>
        <line x1="100" y1="40" x2="472" y2="-152" stroke="#7A4EC0" stroke-width=".8" opacity=".5"/>
        <line x1="100" y1="40" x2="-392" y2="112" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <line x1="100" y1="40" x2="592" y2="112" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <line x1="100" y1="40" x2="-152" y2="280" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <line x1="100" y1="40" x2="352" y2="280" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <line x1="100" y1="40" x2="100" y2="-176" stroke="#7A4EC0" stroke-width=".8" opacity=".45"/>
        <line x1="100" y1="40" x2="100" y2="256" stroke="#7A4EC0" stroke-width=".8" opacity=".4"/>
        <path d="M100 12 L130 40 L100 68 L70 40 Z" fill="none" stroke="#6A3AAA" stroke-width="1"   opacity=".4"/>
        <path d="M100 22 L118 40 L100 58 L82 40 Z" fill="#2E1260" stroke="#8A52D0" stroke-width="1.2" opacity=".85"/>
        <ellipse cx="100" cy="40" rx="16" ry="10" fill="#200A40"/>
        <ellipse cx="100" cy="40" rx="16" ry="10" fill="none" stroke="#9060D8" stroke-width="1.5"/>
        <circle cx="100" cy="40" r="6"  fill="#6B38C0"/>
        <circle cx="100" cy="40" r="3"  fill="#B07AEE"/>
        <circle cx="98"  cy="38.5" r="1.2" fill="#DFC8FF" opacity=".8"/>
      </g>
    </svg>
  </div>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Spheres of Guile</span>
  </nav>

  <h1 class="page-title guile">Spheres of Guile</h1>
  <p>Spheres of Guile provides a complete skill-based system for outwitting opponents, leveraging social prowess, and utilizing tactical cunning in the Pathfinder Roleplaying Game.</p>
  <hr class="page-title-rule" />
  <div class="gs-grid">
    <a href={url("/guile/using-spheres-of-guile/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 3h5a1 1 0 0 1 1 1v9H2V3zM14 3H9a1 1 0 0 0-1 1v9h6V3z"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">Using Spheres of Guile</div>
        <div class="gs-card-desc">Fundamental rules for skill spheres, social combat, and leverage.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
    <a href={url("/guile/how-to-build-operative/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 3.5v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1zM4 6.5h8M4 9.5h5"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">How to Build an Operative</div>
        <div class="gs-card-desc">A step-by-step guide to creating your first skill-based character.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
  </div>
  <hr class="page-title-rule" />

  <div class="section-heading">
    <span class="section-heading-text">Skill Spheres</span>
    <div class="section-heading-rule"></div>
  </div>

  <SphereBadgeGrid spheres={spheres} system="guile" style="margin-bottom: 24px;" />

  <div class="classes-and-links">
    <div class="class-column">
      {classes.length > 0 && (
        <>
          <div class="section-heading" style="margin-top: 0;">
            <span class="section-heading-text">Operative Classes</span>
            <div class="section-heading-rule"></div>
          </div>
          <div class="class-lists">
            <div class="class-tier-group">
              <div class="class-tier-label">Classes</div>
              <div class="class-roster">
                {classes.map(c => (
                  <a href={url(`/guile/classes/${c.id}/`)} class="class-item" data-astro-prefetch="hover">
                    <div class="class-item-header">
                      <span class="class-item-name">{c.name}</span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </>
      )}
    </div>

    <div class="quick-links-column">
      <div class="section-heading" style="margin-top: 0;">
        <span class="section-heading-text">Quick Links</span>
        <div class="section-heading-rule"></div>
      </div>
      <div class="quick-links-grid">
        <div class="quick-links-group">
          <h3 class="quick-links-heading">Rules</h3>
          <ul class="quick-links-list">
            <li><a href={url("/guile/using-spheres-of-guile/")}>Using Spheres of Guile</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

</WikiPage>
