---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import type { TocItem } from '@/components/TableOfContents.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { BOOK_COLLECTIONS } from '@/content/config';
import { splitBodyOnMarkers, renderMarkdownFragment } from '@/lib/renderBody';
import type { SphereEntry, ClassEntry, TalentEntry, FeatEntry, BookMeta } from '@/lib/types';

interface Props {
  kind: 'sphere' | 'class';
  sphere: SphereEntry | undefined;
  cls: ClassEntry | undefined;
  base: TalentEntry[];
  basic: TalentEntry[];
  advanced: TalentEntry[];
  feats: FeatEntry[];
  mainCollEntry: any;
  talentCollEntries: Map<string, any>;
  featCollEntries: Map<string, any>;
  sourceBook: BookMeta | undefined;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { sphereMap, classMap, talentMap, featMap, bookMetaMap } = await resolveEntries();

  const allCollEntries = new Map<string, any>();
  for (const slug of BOOK_COLLECTIONS) {
    try {
      const entries = await getCollection(slug as any);
      for (const e of entries) {
        allCollEntries.set((e.data as any).id, e);
      }
    } catch { /* empty collection */ }
  }

  const paths = [];

  for (const [, sphere] of sphereMap) {
    if (sphere.system !== 'guile') continue;
    const all = [...talentMap.values()].filter(t => t.sphere === sphere.id && t.system === 'guile');
    const base     = all.filter(t => t.tier === 'base').sort((a, b) => a.name.localeCompare(b.name));
    const basic    = all.filter(t => t.tier === 'basic').sort((a, b) => a.name.localeCompare(b.name));
    const advanced = all.filter(t => t.tier === 'advanced').sort((a, b) => a.name.localeCompare(b.name));
    const feats    = [...featMap.values()].filter(f => f.sphere === sphere.id && f.system === 'guile').sort((a, b) => a.name.localeCompare(b.name));

    const talentCollEntries = new Map<string, any>();
    for (const t of [...base, ...basic, ...advanced]) {
      const entry = allCollEntries.get(t.id);
      if (entry) talentCollEntries.set(t.id, entry);
    }

    const featCollEntries = new Map<string, any>();
    for (const f of feats) {
      const entry = allCollEntries.get(f.id);
      if (entry) featCollEntries.set(f.id, entry);
    }

    paths.push({
      params: { sphere: sphere.id },
      props: {
        kind: 'sphere' as const,
        sphere,
        cls: undefined,
        base,
        basic,
        advanced,
        feats,
        mainCollEntry: allCollEntries.get(sphere.id),
        talentCollEntries,
        featCollEntries,
        sourceBook: bookMetaMap.get(sphere.sourceBook),
        bookMetaMap,
      },
    });
  }

  for (const [, cls] of classMap) {
    if (cls.system !== 'guile') continue;
    paths.push({
      params: { sphere: cls.id },
      props: {
        kind: 'class' as const,
        sphere: undefined,
        cls,
        base: [],
        basic: [],
        advanced: [],
        feats: [],
        mainCollEntry: allCollEntries.get(cls.id),
        talentCollEntries: new Map(),
        featCollEntries: new Map(),
        sourceBook: bookMetaMap.get(cls.sourceBook),
        bookMetaMap,
      },
    });
  }

  return paths;
}

const { kind, sphere, cls, base, basic, advanced, feats, mainCollEntry, talentCollEntries, featCollEntries, sourceBook, bookMetaMap } = Astro.props;
const entryName = kind === 'sphere' ? sphere!.name : cls!.name;

const FIRST_PARTY = new Set(['Drop Dead Studios', 'Diamond Recreational Studios']);
const is3pp = (sbSlug: string) => {
  const pub = bookMetaMap.get(sbSlug)?.publisher;
  return !!pub && !FIRST_PARTY.has(pub);
};

type RenderedSegment = { type: 'markdown'; html: string } | { type: 'base-ability'; id: string };
const bodySegments: RenderedSegment[] = [];
if (kind === 'sphere' && mainCollEntry) {
  for (const seg of splitBodyOnMarkers(mainCollEntry.body)) {
    if (seg.type === 'markdown') {
      bodySegments.push({ type: 'markdown', html: await renderMarkdownFragment(seg.text) });
    } else {
      bodySegments.push(seg);
    }
  }
}

const MainContent = (kind === 'class' && mainCollEntry)
  ? (await mainCollEntry.render()).Content
  : null;

const talentRendered: Array<{ id: string; Content: any }> = [];
for (const [id, entry] of talentCollEntries) {
  const { Content } = await entry.render();
  talentRendered.push({ id, Content });
}

const featRendered: Array<{ id: string; Content: any }> = [];
for (const [id, entry] of featCollEntries) {
  const { Content } = await entry.render();
  featRendered.push({ id, Content });
}

const tocItems: TocItem[] = [
  {
    id: 'overview',
    label: 'Overview',
    sub: base.length > 0 ? base.map(t => ({ id: t.id, label: t.name })) : undefined,
  },
];
if (basic.length > 0) tocItems.push({ id: 'basic-talents', label: 'Basic Talents', sub: basic.map(t => ({ id: t.id, label: t.name })) });
if (advanced.length > 0) tocItems.push({ id: 'advanced-talents', label: 'Advanced Talents', sub: advanced.map(t => ({ id: t.id, label: t.name })) });
if (feats.length > 0) tocItems.push({ id: 'feats', label: 'Feats', sub: feats.map(f => ({ id: f.id, label: f.name })) });
---
<WikiPage title={`${entryName} — Spheres of Guile Wiki`} activeNamespace="guile">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url("/guile/")} data-astro-prefetch="hover">Spheres of Guile</a>
    <span class="breadcrumb-sep">›</span>
    <span>{entryName}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">

      {kind === 'sphere' && sphere && (
        <>
          <div class="page-title guile" id="overview">
            <svg class="si page-title-icon" aria-hidden="true"><use href={`#si-${sphere.icon}`} /></svg>
            {sphere.name}
          </div>
          <hr class="page-title-rule" />

          {bodySegments.map(seg => {
            if (seg.type === 'markdown') {
              return <div class="entry-description" set:html={seg.html} />;
            }
            const t = base.find(b => b.id === seg.id);
            const tContent = talentRendered.find(r => r.id === seg.id);
            return t ? (
              <div class="base-ability-block" id={t.id}>
                <div class="base-ability-header">
                  <a href={url(`/guile/${sphere!.id}/${t.id}/`)} class="base-ability-name" data-astro-prefetch="hover">{t.name}</a>
                  <span class="base-ability-badge">Base Ability</span>
                </div>
                {tContent && <div class="talent-body"><tContent.Content /></div>}
              </div>
            ) : null;
          })}

          {basic.length > 0 && (
            <div style="margin-top: 18px;">
              <div class="section-heading">
                <span class="section-heading-text" id="basic-talents">Basic Talents</span>
                <div class="section-heading-rule"></div>
              </div>
              <div class="talent-list">
                {basic.map(t => {
                  const tContent = talentRendered.find(r => r.id === t.id);
                  const extBook = t.sourceBook !== sphere!.sourceBook ? bookMetaMap.get(t.sourceBook) : undefined;
                  return (
                    <div class="talent-entry" id={t.id}>
                      <div class="talent-header">
                        <div class="talent-header-top">
                          <a href={url(`/guile/${sphere!.id}/${t.id}/`)} class="talent-name" data-astro-prefetch="hover">{t.name}</a>
                          {extBook && <span class="talent-source">{extBook.title}</span>}
                        </div>
                        <div class="talent-header-bottom">
                          <span class="talent-tier basic">Basic</span>
                          {is3pp(t.sourceBook) && <span class="talent-tag" data-tag="3pp">3PP</span>}
                          {t.tags.map(tag => <span class="talent-tag" data-tag={tag.toLowerCase()}>{tag}</span>)}
                        </div>
                      </div>
                      {tContent && <div class="talent-body"><tContent.Content /></div>}
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {advanced.length > 0 && (
            <div style="margin-top: 18px;">
              <div class="section-heading">
                <span class="section-heading-text" id="advanced-talents">Advanced Talents</span>
                <div class="section-heading-rule"></div>
              </div>
              <div class="talent-list">
                {advanced.map(t => {
                  const tContent = talentRendered.find(r => r.id === t.id);
                  const extBook = t.sourceBook !== sphere!.sourceBook ? bookMetaMap.get(t.sourceBook) : undefined;
                  return (
                    <div class="talent-entry" id={t.id}>
                      <div class="talent-header">
                        <div class="talent-header-top">
                          <a href={url(`/guile/${sphere!.id}/${t.id}/`)} class="talent-name" data-astro-prefetch="hover">{t.name}</a>
                          {extBook && <span class="talent-source">{extBook.title}</span>}
                        </div>
                        <div class="talent-header-bottom">
                          <span class="talent-tier advanced">Advanced</span>
                          {is3pp(t.sourceBook) && <span class="talent-tag" data-tag="3pp">3PP</span>}
                          {t.tags.map(tag => <span class="talent-tag" data-tag={tag.toLowerCase()}>{tag}</span>)}
                        </div>
                      </div>
                      {tContent && <div class="talent-body"><tContent.Content /></div>}
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {feats.length > 0 && (
            <div style="margin-top: 18px;">
              <div class="section-heading">
                <span class="section-heading-text" id="feats">Feats</span>
                <div class="section-heading-rule"></div>
              </div>
              <div class="talent-list">
                {feats.map(f => {
                  const fContent = featRendered.find(r => r.id === f.id);
                  const extBook = f.sourceBook !== sphere!.sourceBook ? bookMetaMap.get(f.sourceBook) : undefined;
                  return (
                    <div class="talent-entry" id={f.id}>
                      <div class="talent-header">
                        <div class="talent-header-top">
                          <a href={url(`/guile/${sphere!.id}/feats/${f.id}/`)} class="talent-name" data-astro-prefetch="hover">{f.name}</a>
                          {extBook && <span class="talent-source">{extBook.title}</span>}
                        </div>
                        <div class="talent-header-bottom">
                          <span class="talent-tier feat">Feat</span>
                          {is3pp(f.sourceBook) && <span class="talent-tag" data-tag="3pp">3PP</span>}
                          {f.tags.map(tag => <span class="talent-tag" data-tag={tag.toLowerCase()}>{tag}</span>)}
                        </div>
                      </div>
                      {fContent && <div class="talent-body"><fContent.Content /></div>}
                    </div>
                  );
                })}
              </div>
            </div>
          )}
        </>
      )}

      {kind === 'class' && cls && (
        <>
          <div class="page-title guile" id="overview">{cls.name}</div>
          <hr class="page-title-rule" />
          {MainContent && <div class="entry-description"><MainContent /></div>}
        </>
      )}

    </div>

    <aside class="right-rail">
      <TableOfContents items={tocItems} />
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>
