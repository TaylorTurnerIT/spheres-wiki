---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import type { TocItem, TocGroup } from '@/components/TableOfContents.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { buildSections } from '@/lib/categorize';
import type { SectionResult } from '@/lib/categorize';
import { BOOK_COLLECTIONS } from '@/content.config';
import { splitBodyOnMarkers, renderMarkdownFragment } from '@/lib/renderBody';
import { buildOrderedTagIds } from '@/lib/tags';
import TagBadge from '@/components/TagBadge.astro';
import type { SphereEntry, ClassEntry, TalentEntry, FeatEntry, BookMeta, TagEntry } from '@/lib/types';

interface Props {
  kind: 'sphere' | 'class';
  sphere: SphereEntry | undefined;
  cls: ClassEntry | undefined;
  base: TalentEntry[];
  allTalents: TalentEntry[];
  feats: FeatEntry[];
  sections: SectionResult[];
  mainCollEntry: any;
  talentCollEntries: Map<string, any>;
  featCollEntries: Map<string, any>;
  sourceBook: BookMeta | undefined;
  bookMetaMap: Map<string, BookMeta>;
  tagMap: Map<string, TagEntry>;
}

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { sphereMap, classMap, talentMap, featMap, bookMetaMap, tagMap } = await resolveEntries();

  const allCollEntries = new Map<string, any>();
  for (const slug of BOOK_COLLECTIONS) {
    try {
      const entries = await getCollection(slug as any);
      for (const e of entries) {
        if ((e.data as any).type !== 'tag') {
          allCollEntries.set(`${(e.data as any).type}:${(e.data as any).id}`, e);
        }
      }
    } catch { /* empty collection */ }
  }

  const paths = [];

  for (const [, sphere] of sphereMap) {
    if (sphere.system !== 'guile') continue;
    const allTalents = [...talentMap.values()].filter(t => (t.sphere === sphere.id || t.dualSphere === sphere.id) && t.system === 'guile');
    const base       = allTalents.filter(t => t.tier === 'base').sort((a, b) => a.name.localeCompare(b.name));
    const feats      = [...featMap.values()].filter(f => (f.sphere === sphere.id || f.dualSphere === sphere.id) && f.system === 'guile').sort((a, b) => a.name.localeCompare(b.name));

    const sections = buildSections(sphere, allTalents.filter(t => t.tier !== 'base'), feats);

    const talentCollEntries = new Map<string, any>();
    for (const t of allTalents) {
      const entry = allCollEntries.get(`talent:${t.id}`);
      if (entry) talentCollEntries.set(t.id, entry);
    }

    const featCollEntries = new Map<string, any>();
    for (const f of feats) {
      const entry = allCollEntries.get(`feat:${f.id}`);
      if (entry) featCollEntries.set(f.id, entry);
    }

    paths.push({
      params: { sphere: sphere.id },
      props: {
        kind: 'sphere' as const,
        sphere,
        cls: undefined,
        base,
        allTalents,
        feats,
        sections,
        mainCollEntry: allCollEntries.get(`sphere:${sphere.id}`),
        talentCollEntries,
        featCollEntries,
        sourceBook: bookMetaMap.get(sphere.sourceBook),
        bookMetaMap,
        tagMap,
      },
    });
  }

  for (const [, cls] of classMap) {
    if (cls.system !== 'guile') continue;
    paths.push({
      params: { sphere: cls.id },
      props: {
        kind: 'class' as const,
        sphere: undefined,
        cls,
        base: [],
        allTalents: [],
        feats: [],
        sections: [],
        mainCollEntry: allCollEntries.get(`class:${cls.id}`),
        talentCollEntries: new Map(),
        featCollEntries: new Map(),
        sourceBook: bookMetaMap.get(cls.sourceBook),
        bookMetaMap,
        tagMap,
      },
    });
  }

  return paths;
}

const { kind, sphere, cls, base, allTalents, feats, sections, mainCollEntry, talentCollEntries, featCollEntries, sourceBook, bookMetaMap, tagMap } = Astro.props;
const { talentMap, featMap } = await resolveEntries();
const entryName = kind === 'sphere' ? sphere!.name : cls!.name;

// For sphere pages: split body on [TalentName] markers and render each segment
type RenderedSegment = { type: 'markdown'; html: string } | { type: 'base-ability'; id: string };
const bodySegments: RenderedSegment[] = [];
if (kind === 'sphere' && mainCollEntry) {
  for (const seg of splitBodyOnMarkers(mainCollEntry.body)) {
    if (seg.type === 'markdown') {
      bodySegments.push({ type: 'markdown', html: await renderMarkdownFragment(seg.text) });
    } else {
      bodySegments.push(seg);
    }
  }
}

// For class pages: render full body as-is
const MainContent = (kind === 'class' && mainCollEntry)
  ? (await render(mainCollEntry)).Content
  : null;

const talentRendered: Array<{ id: string; Content: any }> = [];
for (const [id, entry] of talentCollEntries) {
  const { Content } = await render(entry);
  talentRendered.push({ id, Content });
}

const featRendered: Array<{ id: string; Content: any }> = [];
for (const [id, entry] of featCollEntries) {
  const { Content } = await render(entry);
  featRendered.push({ id, Content });
}

const orderedBase: typeof base = [];
const baseSet = new Set(base.map(t => t.id));
for (const seg of bodySegments) {
  if (seg.type === 'base-ability' && baseSet.has(seg.id)) {
    const t = base.find(b => b.id === seg.id);
    if (t) {
      orderedBase.push(t);
      baseSet.delete(seg.id);
    }
  }
}
for (const t of base) {
  if (baseSet.has(t.id)) {
    orderedBase.push(t);
  }
}

// Build ToC
const overview: TocItem = {
  id: 'overview',
  label: 'Overview',
  sub: orderedBase.length > 0 ? orderedBase.map(t => ({ id: t.id, label: t.name })) : undefined,
};

const groups: TocGroup[] = sections.map(sec => ({
  label: sec.label,
  categories: sec.categories.map(cat => ({
    id: cat.id,
    label: cat.label,
    sub: cat.entries.map(e => {
      const talent = [...talentMap.values()].find(t => t.id === e.id);
      const feat = [...featMap.values()].find(f => f.id === e.id);
      return { id: e.id, label: talent?.name ?? feat?.name ?? e.id };
    }),
  })),
}));
---
<WikiPage title={`${entryName} — Spheres of Guile Wiki`} activeNamespace="guile">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url("/guile/")} data-astro-prefetch="hover">Spheres of Guile</a>
    <span class="breadcrumb-sep">›</span>
    <span>{entryName}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">

      {kind === 'sphere' && sphere && (
        <>
          <h1
            class="page-title guile"
            id="overview"
            data-pagefind-weight="10"
            data-pagefind-meta={`title:${sphere.name}`}
            data-pagefind-meta="type:sphere"
            data-pagefind-filter="type:sphere"
            data-pagefind-meta="system:Spheres of Guile"
            data-pagefind-filter="system:Spheres of Guile"
          >
            <svg class="si page-title-icon" aria-hidden="true"><use href={`#si-${sphere.icon}`} /></svg>
            {sphere.name}
          </h1>
          <hr class="page-title-rule" />

          {bodySegments.map(seg => {
            if (seg.type === 'markdown') {
              return <div class="entry-description" set:html={seg.html} />;
            }
            const t = base.find(b => b.id === seg.id);
            const tContent = talentRendered.find(r => r.id === seg.id);
            const tBook = t ? bookMetaMap.get(t.sourceBook) : undefined;
            return t ? (
              <div class="base-ability-block" id={t.id} data-pagefind-weight="0.5">
                <div class="base-ability-header">
                  <div class="base-ability-header-top">
                    <a href={url(`/guile/${sphere!.id}/${t.id}/`)} class="base-ability-name" data-astro-prefetch="hover">{t.name}</a>
                    {tBook && <span class="talent-source">{tBook.title}</span>}
                  </div>
                  <div class="base-ability-header-bottom">
                    {buildOrderedTagIds(t, bookMetaMap, tagMap, { includeSphere: false, currentSphereId: sphere!.id })
                      .map(tagId => <TagBadge tagId={tagId} tagMap={tagMap} bookMetaMap={bookMetaMap} />)
                    }
                  </div>
                </div>
                {tContent && <div class="talent-body"><tContent.Content /></div>}
              </div>
            ) : null;
          })}

          {sections.map(sec => (
            <div class="section-group">
              <div class="section-group-header">
                <span class="section-group-label">{sec.label}</span>
                <div class="section-group-rule"></div>
              </div>

              {sec.categories.map(cat => (
                <div class="section-block">
                  <div class="section-heading">
                    <span class="section-heading-text" id={cat.id}>{cat.label}</span>
                    <div class="section-heading-rule"></div>
                  </div>
                  {cat.entries.length === 0
                    ? <p class="section-empty">No entries yet.</p>
                    : <div class="talent-list">
                        {cat.entries.map(e => {
                          const talent = [...talentMap.values()].find(t => t.id === e.id);
                          const feat = [...featMap.values()].find(f => f.id === e.id);
                          const entry = talent || feat;
                          if (!entry) return null;

                          const content = talent ? talentRendered.find(r => r.id === e.id) : featRendered.find(r => r.id === e.id);
                          const entryBook = bookMetaMap.get(entry.sourceBook);
                          const tierLabel = talent ? (talent.tier.charAt(0).toUpperCase() + talent.tier.slice(1)) : 'Feat';

                          return (
                            <div class="talent-entry" id={entry.id} data-pagefind-weight="0.5">
                              <div class="talent-header">
                                <div class="talent-header-top">
                                  <a
                                    href={url(`/guile/${sphere!.id}/${talent ? '' : 'feats/'}${entry.id}/`)}
                                    class="talent-name"
                                    data-astro-prefetch="hover"
                                    transition:name={`entry-title-${entry.id}`}
                                  >
                                    {entry.name}
                                  </a>
                                  {entryBook && <span class="talent-source">{entryBook.title}</span>}
                                </div>
                                <div class="talent-header-bottom">
                                  {buildOrderedTagIds(entry, bookMetaMap, tagMap, { includeSphere: false, currentSphereId: sphere!.id })
                                    .map(tagId => <TagBadge tagId={tagId} tagMap={tagMap} bookMetaMap={bookMetaMap} />)
                                  }
                                </div>
                              </div>
                              {content && <div class="talent-body"><content.Content /></div>}
                            </div>
                          );
                        })}
                      </div>
                  }
                </div>
              ))}

              {sec.categories.length === 0 && (
                <p class="section-empty">No entries yet.</p>
              )}
            </div>
          ))}
        </>
      )}

      {kind === 'class' && cls && (
        <>
          <h1
            class="page-title guile"
            id="overview"
            data-pagefind-weight="10"
            data-pagefind-meta={`title:${cls.name}`}
            data-pagefind-meta="type:class"
            data-pagefind-filter="type:class"
            data-pagefind-meta="system:Spheres of Guile"
            data-pagefind-filter="system:Spheres of Guile"
          >
            {cls.name}
          </h1>
          <hr class="page-title-rule" />
          {MainContent && <div class="entry-description"><MainContent /></div>}
        </>
      )}

    </div>

    <aside class="right-rail" aria-label="Page contents">
      <TableOfContents overview={overview} groups={groups} system="guile" />
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>
