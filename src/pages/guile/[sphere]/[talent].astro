---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { BOOK_COLLECTIONS } from '@/content/config';
import type { TalentEntry, SphereEntry, BookMeta } from '@/lib/types';

interface Props {
  talent: TalentEntry;
  sphere: SphereEntry;
  collEntry: any;
  sourceBook: BookMeta | undefined;
}

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { talentMap, sphereMap, bookMetaMap } = await resolveEntries();

  const allCollEntries = new Map<string, any>();
  for (const slug of BOOK_COLLECTIONS) {
    try {
      const entries = await getCollection(slug as any);
      for (const e of entries) {
        allCollEntries.set((e.data as any).id, e);
      }
    } catch {}
  }

  const paths = [];
  for (const [, talent] of talentMap) {
    if (talent.system !== 'guile') continue;
    const sphere = [...sphereMap.values()].find(s => s.id === talent.sphere && s.system === 'guile');
    if (!sphere) continue;
    paths.push({
      params: { sphere: sphere.id, talent: talent.id },
      props: { talent, sphere, collEntry: allCollEntries.get(talent.id), sourceBook: bookMetaMap.get(talent.sourceBook) },
    });
  }

  return paths;
}

const { talent, sphere, collEntry, sourceBook } = Astro.props;

const FIRST_PARTY = new Set(['Drop Dead Studios', 'Diamond Recreational Studios']);
const is3pp = !!sourceBook?.publisher && !FIRST_PARTY.has(sourceBook.publisher);

const TalentContent = collEntry ? (await collEntry.render()).Content : null;
---
<WikiPage title={`${talent.name} — ${sphere.name} — Spheres of Guile Wiki`} activeNamespace="guile">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url("/guile/")} data-astro-prefetch="hover">Spheres of Guile</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url(`/guile/${sphere.id}/`)} data-astro-prefetch="hover">{sphere.name}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{talent.name}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">
      <div
        class="page-title guile"
        id="overview"
        data-pagefind-weight="10"
        data-pagefind-meta={`title:${talent.name}`}
        data-pagefind-meta={`sphere:${sphere.name}`}
        data-pagefind-meta="system:Spheres of Guile"
        data-pagefind-meta="type:talent"
        data-pagefind-meta={`tier:${talent.tier}`}
        data-pagefind-meta={`tags:${talent.tags.join(', ')}`}
      >
        {talent.name}
      </div>
      <div class="talent-page-meta">
        <span class={`talent-tier ${talent.tier}`}>{talent.tier === 'base' ? 'Base Ability' : talent.tier}</span>
        {is3pp && <span class="talent-tag" data-tag="3pp">3PP</span>}
        {talent.tags.map(tag => <span class="talent-tag" data-tag={tag.toLowerCase()}>{tag}</span>)}
      </div>
      <hr class="page-title-rule" />

      {TalentContent
        ? <div class="entry-description"><TalentContent /></div>
        : <p class="entry-description"><em>Description coming soon.</em></p>
      }
    </div>

    <aside class="right-rail">
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>
