---
import WikiPage from "@/layouts/WikiPage.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import FeatsBrowse from "@/components/FeatsBrowse.astro";
import { resolveEntries, getCollEntriesMap } from "@/lib/resolveEntries";
import { buildFeatBrowseRows } from "@/lib/featBrowse";
import { SYSTEMS } from "@/config/site";
import { url } from "@/lib/url";
import type { FeatEntry } from "@/lib/types";

const description =
  "Search and filter every feat on the Spheres Wiki by system, category, sphere, or tag — with prerequisites and a summary shown right in the browse table.";

const { featMap, tagMap, bookMetaMap, sphereMap } = await resolveEntries();
const allCollEntries = await getCollEntriesMap();

const feats = [...featMap.values()];

// Only raw markdown bodies are read here — never render()'d — so the initial
// HTML carries short derived excerpts, not full feat prose (SPEC §feats-browse).
const bodies = new Map<string, string | undefined>(
  feats.map((feat: FeatEntry) => {
    const collEntry =
      allCollEntries.get(`feat:${feat.sourceBook}:${feat.id}`) ??
      allCollEntries.get(`feat:${feat.id}`);
    return [`${feat.sourceBook}:${feat.id}`, collEntry?.body as string | undefined];
  }),
);

const rows = buildFeatBrowseRows(feats, { tagMap, bookMetaMap, sphereMap, bodies });

const presentSystems = new Set(rows.map((r) => r.system));
const systemOptions = (["power", "might", "guile", "champions"] as const)
  .filter((key) => presentSystems.has(key))
  .map((key) => ({ key, label: SYSTEMS[key].label }));
---

<WikiPage title="Feats Index — Spheres Wiki" description={description} pagefindIgnore={true}>
  <Breadcrumb crumbs={[
    { label: "Home", href: url("/") },
    { label: "Feats" },
  ]} />

  <h1 class="page-title" id="overview">Feats Index</h1>
  <hr class="page-title-rule" />

  <p class="feats-intro">
    Search {rows.length} feat{rows.length !== 1 ? "s" : ""} across every Spheres system by name, tag, sphere, or text.
  </p>

  <FeatsBrowse rows={rows} systemOptions={systemOptions} tagMap={tagMap} bookMetaMap={bookMetaMap} />
</WikiPage>

<style>
  .feats-intro {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    line-height: 1.55;
    margin-bottom: var(--sp-4);
  }
</style>
