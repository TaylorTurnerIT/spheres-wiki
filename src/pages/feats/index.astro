---
import BrowseControls from "@/components/BrowseControls.astro";
import BrowseTable from "@/components/BrowseTable.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import WikiPage from "@/layouts/WikiPage.astro";
import {
  buildFeatBrowseRows,
  featCategoryOptions,
  featSystemOptions,
  featTagOptions,
} from "@/lib/featBrowse";
import { getCollEntriesMap, resolveEntries } from "@/lib/resolveEntries";
import { url } from "@/lib/url";

const description =
  "Search and browse every feat on the Spheres Wiki — filter by system, category, or tag, and jump straight to the canonical feat page.";

const maps = await resolveEntries();
const collEntriesMap = await getCollEntriesMap();

const rows = buildFeatBrowseRows(maps, collEntriesMap);
const systemOptions = featSystemOptions(rows);
const categoryOptions = featCategoryOptions(rows, maps.tagMap);
const tagOptions = featTagOptions(rows, maps.tagMap);
---

<WikiPage title="Feats Index — Spheres Wiki" description={description}>
  <Breadcrumb crumbs={[{ label: "Home", href: url("/") }, { label: "Feats" }]} />

  <h1 class="page-title" id="overview">Feats Index</h1>
  <hr class="page-title-rule" />

  <BrowseControls
    noun="Feats"
    searchPlaceholder="Search feats, tags, spheres, or text…"
    systemOptions={systemOptions}
    categoryOptions={categoryOptions}
    tagOptions={tagOptions}
  >
    <p class="feats-intro" slot="intro">
      A searchable catalog of every feat across the Spheres systems. Filter, sort,
      and open any feat's full page.
    </p>
  </BrowseControls>

  <BrowseTable rows={rows} tagMap={maps.tagMap} bookMetaMap={maps.bookMetaMap} />
</WikiPage>

<script>
  import "@/lib/browseFilterClient";
</script>

<style>
  .feats-intro {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    line-height: 1.55;
    margin-bottom: var(--sp-4);
    text-align: center;
  }
</style>
