---
import WikiPage from '@/layouts/WikiPage.astro';
import TagBadge from '@/components/TagBadge.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { SYSTEMS } from '@/config/site';
import { buildSearchManifest, type ManifestEntry } from '@/lib/searchManifest';

const { sphereMap, tagMap, bookMetaMap } = await resolveEntries();

const manifest = await buildSearchManifest();

const staticSpheres = [...new Set([...sphereMap.values()].map(s => s.name))].sort();
const sphereNamesLower = new Set(staticSpheres.map(s => s.toLowerCase()));
const systemKeys = new Set(Object.keys(SYSTEMS));
const typeKeys   = new Set(['sphere', 'talent', 'feat', 'class', 'archetype', 'class-trait', 'article', 'drawback', 'boon', 'tradition']);
const staticTags = [...tagMap.entries()]
  .filter(([id]) => !sphereNamesLower.has(id) && !systemKeys.has(id) && !typeKeys.has(id))
  .sort((a, b) => (a[1].priority ?? 999) - (b[1].priority ?? 999) || a[0].localeCompare(b[0]))
  .map(([id, tag]) => ({ value: id, text: tag.label || id }));

// ── Server-rendered first page ───────────────────────────
// The static HTML ships a few "browse all" cards so the page starts
// taller than the viewport; otherwise the footer begins inside the
// viewport and shifts when the client renders the list after load
// (measured CLS 0.19 on the perf-budget URL). Card count is capped: the
// search page also embeds the browse manifest JSON, and shipping too much
// markup pushes FCP past its 2s budget (12 cards = FCP 2.27s, 6 cards
// keeps it under 2s while still holding the footer below the fold).
// Markup mirrors the client renderer (same tag-template spans, same
// sphere pseudo-tag, same card frame), so the client's re-render on
// astro:page-load is layout-neutral.
const PAGE_SIZE_SSR = 6;

const TYPE_LABELS_SSR: Record<string, string> = {
  sphere: 'Sphere', talent: 'Talent', feat: 'Feat', class: 'Class',
  archetype: 'Archetype', article: 'Article', 'class-trait': 'Trait',
  drawback: 'Drawback', boon: 'Boon', tradition: 'Tradition',
};

const SYSTEM_META_BY_LABEL: Record<string, { label: string; cssKey: string }> = Object.fromEntries(
  Object.entries(SYSTEMS).map(([, sys]) => [sys.label, { label: sys.label, cssKey: sys.cssKey }]),
);

function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// Tag badges: the client resolves them from #sp-tag-templates (TagBadge asSpan
// with tooltip data). Render the identical span server-side.
// fallow-ignore-next-line complexity
function tagTooltipAttrs(tagId: string): string {
  const tag = tagMap.get(tagId);
  if (!tag) return '';
  const label = tag.label || tagId;
  let source = '';
  if (tag.sourceBook !== '__built-in__') {
    source = bookMetaMap.get(tag.sourceBook)?.title ?? tag.sourceBook;
  }
  return ` data-tt-name="${escapeHtml(label)}"`
    + ` data-tt-desc="${escapeHtml(tag.description)}"`
    + ` data-tt-source="${escapeHtml(source)}"`;
}

function tagBadgeHtml(tagId: string): string {
  const tag = tagMap.get(tagId);
  const label = tag ? tag.label || tagId : tagId;
  const attrs = tagTooltipAttrs(tagId);
  return `<span class="tag-wrapper talent-tag" data-tag="${escapeHtml(tagId)}"${attrs}>${escapeHtml(label)}</span>`;
}

// fallow-ignore-next-line complexity
function cardSourceLabel(entry: ManifestEntry, typeLabel: string): string {
  const sysEntry = SYSTEM_META_BY_LABEL[entry.system ?? ''];
  if (entry.type === 'sphere') return sysEntry?.label ?? '';
  if (entry.sphere) return typeLabel;
  if (sysEntry) return `${sysEntry.label} · ${typeLabel}`;
  return typeLabel;
}

// fallow-ignore-next-line complexity
function cardTagRowHtml(entry: ManifestEntry, type: string): string {
  let html = '';
  if (entry.sphere && type !== 'sphere') {
    html += `<span class="tag-wrapper"><span class="talent-tag" data-tag="sphere-name" style="--tag-clr: var(--clr-ns)">${escapeHtml(entry.sphere)}</span></span>`;
  }
  const tagIds = (entry.tags ?? '').split(',').map(t => t.trim()).filter(Boolean);
  html += tagIds.map(t => tagBadgeHtml(t)).join('');
  if (!html) return '';
  return `<div class="talent-header-bottom">${html}</div>`;
}

// fallow-ignore-next-line complexity
function renderSsrCard(entry: ManifestEntry): string {
  const title = entry.title ?? 'Untitled';
  const type = entry.type ?? '';
  const sysEntry = SYSTEM_META_BY_LABEL[entry.system ?? ''];
  const typeLabel = TYPE_LABELS_SSR[type] ?? type;
  let cssColor = 'var(--clr-brand)';
  if (sysEntry?.cssKey) cssColor = `var(--clr-${sysEntry.cssKey})`;

  const sourceLabel = cardSourceLabel(entry, typeLabel);
  const sourceHtml = sourceLabel
    ? `<span class="talent-source">${escapeHtml(sourceLabel)}</span>`
    : '';
  const tagRow = cardTagRowHtml(entry, type);

  return `<a href="${entry.url}" class="sp-result accent-card" role="option" style="--clr-active: ${cssColor}; --clr-ns: ${cssColor}">
    <div class="talent-header">
      <div class="talent-header-top">
        <span class="talent-name">${escapeHtml(title)}</span>
        ${sourceHtml}
      </div>
      ${tagRow}
    </div>
  </a>`;
}

const initialResultsHtml = manifest.slice(0, PAGE_SIZE_SSR).map(renderSsrCard).join(' ');
---
<!-- fallow-ignore-next-line complexity -->
<WikiPage title="Search — Spheres Wiki" pagefindIgnore={true}>

  <h1 class="page-title">Search</h1>
  <hr class="page-title-rule" />

  <div class="search-page">
    <div class="search-page-bar">
      <svg aria-hidden="true" class="search-page-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8.5" cy="8.5" r="5.5"/><path d="M13 13l3.5 3.5"/></svg>
      <input
        id="sp-input"
        type="search"
        class="search-page-input"
        placeholder="Search spheres, classes, talents, feats…"
        autocomplete="off"
        aria-label="Search"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="sp-results"
        aria-expanded="false"
        aria-haspopup="listbox"
      />
    </div>

    <div class="search-page-filters" id="sp-filters">
      <div class="sp-filter-group" id="sp-system-group">
        <label for="sp-system-select" class="sp-filter-label eyebrow">System</label>
        <div class="ts-wrapper single plugin-clear_button ts-placeholder-wrapper" id="sp-system-select-placeholder">
          <div class="ts-control">
            <input type="text" autocomplete="off" placeholder="Any system…" readonly />
          </div>
        </div>
        <select id="sp-system-select" class="ts-hidden-select" autocomplete="off"></select>
      </div>
      <div class="sp-filter-group">
        <label for="sp-type-select" class="sp-filter-label eyebrow">Type</label>
        <div class="ts-wrapper single plugin-clear_button ts-placeholder-wrapper" id="sp-type-select-placeholder">
          <div class="ts-control">
            <input type="text" autocomplete="off" placeholder="Any type…" readonly />
          </div>
        </div>
        <select id="sp-type-select" class="ts-hidden-select" autocomplete="off"></select>
      </div>
      <div class="sp-filter-group" id="sp-sphere-group">
        <label for="sp-sphere-select" class="sp-filter-label eyebrow">Sphere</label>
        <div class="ts-wrapper single plugin-clear_button ts-placeholder-wrapper" id="sp-sphere-select-placeholder">
          <div class="ts-control">
            <input type="text" autocomplete="off" placeholder="Any sphere…" readonly />
          </div>
        </div>
        <select id="sp-sphere-select" class="ts-hidden-select" autocomplete="off"></select>
      </div>
      <div class="sp-filter-group" id="sp-tag-group">
        <label for="sp-tag-select" class="sp-filter-label eyebrow">Tag</label>
        <div class="ts-wrapper single plugin-clear_button ts-placeholder-wrapper" id="sp-tag-select-placeholder">
          <div class="ts-control">
            <input type="text" autocomplete="off" placeholder="Any tag…" readonly />
          </div>
        </div>
        <select id="sp-tag-select" class="ts-hidden-select" autocomplete="off"></select>
      </div>
    </div>

    <div
      id="sp-data"
      data-spheres={JSON.stringify(staticSpheres)}
      data-tags={JSON.stringify(staticTags)}
      hidden
    ></div>

    <div id="sp-status" class="sp-status">{manifest.length} results</div>
    <div id="sp-results" class="sp-results" role="listbox" aria-label="Search results" aria-live="polite">
      <Fragment set:html={initialResultsHtml} />
    </div>
    <div id="sp-load-more" class="sp-load-more-sentinel" hidden></div>

    <div id="sp-tag-templates" hidden>
      {[...tagMap.values()].map(tag => (
        <div data-tag-template={tag.id}>
          <TagBadge tagId={tag.id} tagMap={tagMap} bookMetaMap={bookMetaMap} asSpan={true} stripLinks={true} />
        </div>
      ))}
    </div>
  </div>

</WikiPage>

<style is:global>
  .search-page {
    width: 100%;
  }
  .search-page-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--clr-bg);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius);
    padding: 10px 14px;
    margin-bottom: 16px;
  }
  .search-page-icon {
    width: 16px;
    height: 16px;
    color: var(--clr-muted);
    flex-shrink: 0;
  }
  .search-page-input {
    flex: 1;
    background: none;
    border: none;
    outline: 2px solid transparent;
    outline-offset: 2px;
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--clr-text);
  }
  .search-page-input:focus-visible {
    outline-color: var(--clr-active);
    border-radius: 3px;
  }
  .search-page-input::placeholder {
    color: var(--clr-muted);
  }

  /* Filter row */
  .search-page-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-bottom: 16px;
  }
  .sp-filter-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  /* TomSelect overrides — scoped to filter groups */
  .sp-filter-group .ts-wrapper,
  .sp-filter-group select {
    width: 130px;
    position: relative;
  }
  #sp-system-group .ts-wrapper,
  #sp-system-group select {
    width: 172px;
  }
  #sp-sphere-group .ts-wrapper,
  #sp-sphere-group select {
    width: 155px;
  }
  .sp-filter-group .ts-control {
    border-radius: var(--radius) !important;
    border-color: var(--clr-border) !important;
    background: var(--clr-bg) !important;
    font-family: var(--font-body) !important;
    font-size: var(--fs-xs) !important;
    padding: 4px 28px 4px 8px !important;
    min-height: unset !important;
    box-shadow: none !important;
    cursor: pointer;
    color: var(--clr-text);
  }
  .sp-filter-group .ts-control.focus {
    border-color: var(--clr-brand) !important;
    box-shadow: 0 0 0 1px var(--clr-brand) !important;
    outline: none !important;
  }
  .sp-filter-group .ts-control input {
    font-family: var(--font-body) !important;
    font-size: var(--fs-xs) !important;
    color: var(--clr-text) !important;
    min-width: 0 !important;
  }
  .sp-filter-group .ts-control input::placeholder {
    color: var(--clr-muted) !important;
  }
  .sp-filter-group .ts-wrapper.has-items .ts-control input::placeholder {
    color: transparent !important;
  }
  /* Selected value text */
  .sp-filter-group .ts-control .item {
    color: var(--clr-text) !important;
    font-size: var(--fs-xs) !important;
    padding: 0 !important;
    margin: 0 !important;
    background: none !important;
    border: none !important;
  }
  /* Dropdown arrow */
  .sp-filter-group .ts-wrapper::after {
    content: '▾';
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    color: var(--clr-muted);
    pointer-events: none;
  }
  /* Clear button */
  .sp-filter-group .ts-control .clear-button {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    color: var(--clr-muted) !important;
    opacity: 0.7;
    background: none !important;
    border: none !important;
    padding: 0 !important;
    cursor: pointer;
  }
  .sp-filter-group .ts-control .clear-button:hover {
    color: var(--clr-text) !important;
    opacity: 1;
  }
  .sp-filter-group .ts-wrapper.has-items::after {
    display: none;
  }
  /* Dropdown */
  .sp-filter-group .ts-dropdown {
    border-radius: var(--radius) !important;
    border-color: var(--clr-border) !important;
    background: var(--clr-bg) !important;
    box-shadow: 0 6px 20px rgba(0,0,0,0.12) !important;
    font-family: var(--font-body) !important;
    font-size: var(--fs-xs) !important;
    color: var(--clr-text) !important;
    margin-top: 2px !important;
  }
  .sp-filter-group .ts-dropdown .ts-dropdown-content {
    padding: 4px 0 !important;
    max-height: 240px;
  }
  .sp-filter-group .ts-dropdown .option {
    padding: 6px 10px !important;
    color: var(--clr-text) !important;
  }
  .sp-filter-group .ts-dropdown .option:hover,
  .sp-filter-group .ts-dropdown .option.active {
    background: color-mix(in srgb, var(--clr-brand) 10%, transparent) !important;
    color: var(--clr-text) !important;
  }
  .sp-filter-group .ts-dropdown .option.selected {
    background: color-mix(in srgb, var(--clr-brand) 16%, transparent) !important;
    color: var(--clr-brand) !important;
    font-weight: 600;
  }

  /* Status */
  .sp-status {
    font-size: var(--fs-xs);
    color: var(--clr-muted);
    margin-bottom: 12px;
  }
  .sp-status.loading::after {
    content: '…';
  }

  /* Results */
  .sp-results {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  /* frame + padding from the shared .accent-card utility */
  .sp-result {
    display: block;
    margin: 0;
    text-decoration: none;
    color: var(--clr-text);
    transition: background 0.12s, box-shadow 0.12s;
  }
  .sp-result:hover {
    background: color-mix(in srgb, var(--clr-active) 4%, var(--clr-surface));
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    text-decoration: none;
  }
  .sp-result:focus-visible {
    background: color-mix(in srgb, var(--clr-active) 4%, var(--clr-surface));
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    text-decoration: none;
    outline: 2px solid var(--clr-active);
    outline-offset: 2px;
  }
  .sp-result-excerpt {
    font-size: var(--fs-xs);
    color: var(--clr-muted);
    line-height: 1.5;
    margin-top: 6px;
  }
  .sp-result-excerpt mark {
    background: color-mix(in srgb, var(--clr-active) 20%, transparent);
    color: var(--clr-text);
    border-radius: 2px;
    padding: 0 1px;
  }
  .sp-empty {
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    font-style: italic;
    padding: 24px 0;
    text-align: center;
  }

  /* Load more sentinel */
  .sp-load-more-sentinel {
    height: 1px;
    margin-top: 16px;
  }
</style>

<script>
  import "@/lib/searchClient";
</script>
