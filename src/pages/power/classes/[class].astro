---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import type { TocItem, TocGroup } from '@/components/TableOfContents.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { BOOK_COLLECTIONS } from '@/content.config';
import type { ClassEntry, ClassFeatureEntry, ClassTraitEntry, ArchetypeEntry, ArchetypeFeatureEntry, BookMeta } from '@/lib/types';

interface Props {
  cls: ClassEntry;
  classCollEntry: any;
  featureEntries: ClassFeatureEntry[];
  featureCollEntries: Map<string, any>;
  traitEntries: ClassTraitEntry[];
  traitCollEntries: Map<string, any>;
  sourceBook: BookMeta | undefined;
  archetypes: ArchetypeEntry[];
  archetypeFeatures: ArchetypeFeatureEntry[];
  archetypeFeatureCollEntries: Map<string, any>;
  archetypeCollEntries: Map<string, any>;
}

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { classMap, classFeatureMap, classTraitMap, archetypeMap, archetypeFeatureMap, bookMetaMap } = await resolveEntries();

  const allCollEntries = new Map<string, any>();
  for (const slug of BOOK_COLLECTIONS) {
    try {
      const entries = await getCollection(slug as any);
      for (const e of entries) {
        const t = (e.data as any).type;
        if (['class', 'class-feature', 'class-trait', 'archetype', 'archetype-feature'].includes(t)) {
          allCollEntries.set((e.data as any).id, e);
        }
      }
    } catch { /* empty collection */ }
  }

  const paths = [];

  for (const [, cls] of classMap) {
    if (cls.system !== 'power') continue;

    const featureEntries = [...classFeatureMap.values()]
      .filter(f => f.className === cls.id)
      .sort((a, b) => {
        const aMin = Array.isArray(a.level) ? Math.min(...a.level) : a.level;
        const bMin = Array.isArray(b.level) ? Math.min(...b.level) : b.level;
        return aMin - bMin;
      });

    const traitEntries = [...classTraitMap.values()]
      .filter(t => t.className === cls.id)
      .sort((a, b) => a.name.localeCompare(b.name));

    const featureCollEntries = new Map<string, any>();
    for (const f of featureEntries) {
      const entry = allCollEntries.get(f.id);
      if (entry) featureCollEntries.set(f.id, entry);
    }

    const traitCollEntries = new Map<string, any>();
    for (const t of traitEntries) {
      const entry = allCollEntries.get(t.id);
      if (entry) traitCollEntries.set(t.id, entry);
    }

    const classArchetypes = [...archetypeMap.values()]
      .filter(a => a.className === cls.id);

    const classArchetypeFeatures = [...archetypeFeatureMap.values()]
      .filter(f => classArchetypes.some(a => a.id === f.archetypeId))
      .sort((a, b) => {
        const aMin = Array.isArray(a.level) ? Math.min(...a.level) : a.level;
        const bMin = Array.isArray(b.level) ? Math.min(...b.level) : b.level;
        return aMin - bMin;
      });

    const archetypeFeatureCollEntries = new Map<string, any>();
    for (const f of classArchetypeFeatures) {
      const entry = allCollEntries.get(f.id);
      if (entry) archetypeFeatureCollEntries.set(f.id, entry);
    }

    const archetypeCollEntries = new Map<string, any>();
    for (const a of classArchetypes) {
      const entry = allCollEntries.get(a.id);
      if (entry) archetypeCollEntries.set(a.id, entry);
    }

    paths.push({
      params: { class: cls.id },
      props: {
        cls,
        classCollEntry: allCollEntries.get(cls.id),
        featureEntries,
        featureCollEntries,
        traitEntries,
        traitCollEntries,
        sourceBook: bookMetaMap.get(cls.sourceBook),
        archetypes: classArchetypes,
        archetypeCollEntries,
        archetypeFeatures: classArchetypeFeatures,
        archetypeFeatureCollEntries,
      },
    });
  }

  return paths;
}

const {
  cls,
  classCollEntry,
  featureEntries,
  featureCollEntries,
  traitEntries,
  traitCollEntries,
  sourceBook,
  archetypes = [],
  archetypeCollEntries = new Map(),
  archetypeFeatures = [],
  archetypeFeatureCollEntries = new Map(),
} = Astro.props;

const ClassContent = classCollEntry ? (await render(classCollEntry)).Content : null;

type RenderedTrait = { trait: ClassTraitEntry; Content: any };
type RenderedFeature = { feature: ClassFeatureEntry; Content: any; traits: RenderedTrait[] };

const featureRendered: RenderedFeature[] = [];
for (const feature of featureEntries) {
  const collEntry = featureCollEntries.get(feature.id);
  const { Content } = collEntry ? await render(collEntry) : { Content: null };

  const featureTraits = traitEntries.filter(t => t.featureId === feature.id);
  const traits: RenderedTrait[] = [];
  for (const trait of featureTraits) {
    const traitCollEntry = traitCollEntries.get(trait.id);
    const { Content: TraitContent } = traitCollEntry ? await render(traitCollEntry) : { Content: null };
    traits.push({ trait, Content: TraitContent });
  }

  featureRendered.push({ feature, Content, traits });
}

const tocOverview: TocItem = { id: 'overview', label: 'Overview' };
const tocGroups: TocGroup[] = featureRendered.length > 0 ? [{
  label: 'Class Features',
  categories: featureRendered.map(({ feature, traits }) => {
    const minLevel = Array.isArray(feature.level) ? Math.min(...feature.level) : feature.level;
    return {
      id: feature.id,
      label: feature.name,
      meta: `${minLevel}${ordinal(minLevel)}`,
      sub: traits.length > 0 ? traits.map(({ trait }) => ({ id: trait.id, label: trait.name })) : undefined,
    };
  }),
}] : [];

function levelLabel(level: number | number[]): string {
  if (Array.isArray(level)) {
    return level.map(l => `${l}${ordinal(l)}`).join(', ');
  }
  return `${level}${ordinal(level)}`;
}

function ordinal(n: number): string {
  if (n % 100 >= 11 && n % 100 <= 13) return 'th';
  switch (n % 10) {
    case 1: return 'st';
    case 2: return 'nd';
    case 3: return 'rd';
    default: return 'th';
  }
}
---
<WikiPage title={`${cls.name} — Spheres of Power Wiki`} activeNamespace="power">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url("/power/")} data-astro-prefetch="hover">Spheres of Power</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url("/power/classes/")} data-astro-prefetch="hover">Classes</a>
    <span class="breadcrumb-sep">›</span>
    <span>{cls.name}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">

      <div class="class-header-row">
        <h1
          class="page-title power"
          id="overview"
          data-pagefind-weight="10"
          data-pagefind-meta={`title:${cls.name}`}
          data-pagefind-meta="type:class"
          data-pagefind-meta="system:Spheres of Power"
        >
          {cls.name}
        </h1>

        {archetypes.length > 0 && (
          <div class="archetypes-selector-group" style="min-width: 250px; flex: 1; max-width: 400px; z-index: 10;">
            <label for="archetype-select" class="archetypes-selector-label">Archetypes:</label>
            <select id="archetype-select" class="ts-hidden-select" multiple autocomplete="off">
              {archetypes.map(arc => {
                const collEntry = archetypeCollEntries.get(arc.id);
                const rawText = collEntry?.body || '';
                const desc = rawText.trim().split('\n')[0].replace(/<[^>]+>/g, '').substring(0, 150) + (rawText.length > 150 ? '...' : '');
                return (
                  <option value={arc.id} data-name={arc.name} data-desc={desc || arc.name}>{arc.name}</option>
                );
              })}
            </select>
          </div>
        )}
      </div>
      <hr class="page-title-rule" />

      <div class="archetype-warning-banner" style="display: none;"></div>

      {ClassContent
        ? <div class="entry-description"><ClassContent /></div>
        : <p class="entry-description"><em>Description coming soon.</em></p>
      }

      {featureRendered.map(({ feature, Content: FeatureContent, traits }) => (
        <div class={`class-feature${feature.isTraitContainer ? ' class-feature--container' : ''}`} id={feature.id} data-level={JSON.stringify(feature.level)}>
          <h2 class="class-feature-heading">
            {feature.name}
            <span class="class-feature-level"> ({levelLabel(feature.level)})</span>
          </h2>

          {FeatureContent
            ? <div class="entry-description"><FeatureContent /></div>
            : null
          }

          {feature.isTraitContainer && (
            <button class="trait-catalog-toggle is-collapsed" data-feature-id={feature.id} aria-expanded="false" aria-controls={`${feature.id}-traits`}>
              {feature.name}
              <span class="trait-catalog-toggle-chevron" aria-hidden="true">▾</span>
            </button>
          )}

          {feature.isTraitContainer ? (
            <div class="trait-catalog-wrapper" id={`${feature.id}-traits`} aria-hidden="true">
              <div class="trait-catalog">
              {traits.map(({ trait, Content: TraitContent }) => (
                <div class="trait-catalog-entry" id={trait.id}>
                  <h3 class="trait-catalog-name">
                    <a href={url(`/power/classes/${cls.id}/traits/${trait.id}/`)} class="trait-catalog-link" data-astro-prefetch="hover">{trait.name}</a>
                    {trait.requires && (
                      <span class="trait-catalog-requires"> (requires {trait.requires})</span>
                    )}
                  </h3>
                  {TraitContent
                    ? <div class="entry-description"><TraitContent /></div>
                    : null
                  }
                </div>
              ))}
              </div>
            </div>
          ) : (
            traits.map(({ trait, Content: TraitContent }) => (
              <div class="class-trait" id={trait.id}>
                <h3 class="class-trait-name">
                  {trait.name}
                  {trait.requires && (
                    <span class="class-trait-requires"> (requires {trait.requires})</span>
                  )}
                </h3>
                {TraitContent
                  ? <div class="entry-description"><TraitContent /></div>
                  : null
                }
              </div>
            ))
          )}
        </div>
      ))}

      {/* Hidden Templates for Archetype Features to Avoid DOM Bloat */}
      {archetypeFeatures.map(async (feature) => {
        const collEntry = archetypeFeatureCollEntries.get(feature.id);
        const { Content } = collEntry ? await render(collEntry) : { Content: null };
        return (
          <template class="archetype-feature-template" data-feature-id={feature.id} data-name={feature.name} data-archetype-id={feature.archetypeId} data-level={JSON.stringify(feature.level)} data-replaces={JSON.stringify(feature.replaces || [])} data-alters={JSON.stringify(feature.alters || [])} data-mutually-exclusive={JSON.stringify(feature.mutuallyExclusive !== false)}>
            <div class="archetype-feature-rendered-content">
              {Content ? <Content /> : null}
            </div>
          </template>
        );
      })}

    </div>

    <aside class="right-rail" aria-label="Page contents">
      <TableOfContents overview={tocOverview} groups={tocGroups} system="power" />
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>

<script>
import TomSelect from 'tom-select';
import 'tom-select/dist/css/tom-select.css';

// Replaces matched text only inside text nodes — never touches attribute values.
function replaceInTextNodes(
  root: HTMLElement,
  regex: RegExp,
  makeNode: (match: string) => Node,
): void {
  const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null);
  const nodes: Text[] = [];
  let n: Node | null;
  while ((n = walker.nextNode())) nodes.push(n as Text);

  for (const textNode of nodes) {
    const text = textNode.textContent ?? '';
    regex.lastIndex = 0;
    if (!regex.test(text)) continue;

    const frag = document.createDocumentFragment();
    let last = 0;
    regex.lastIndex = 0;
    let m: RegExpExecArray | null;
    while ((m = regex.exec(text))) {
      if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
      frag.appendChild(makeNode(m[0]));
      last = m.index + m[0].length;
    }
    if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
    textNode.replaceWith(frag);
    regex.lastIndex = 0;
  }
}

document.addEventListener('astro:page-load', () => {

  // ──── TRAIT CATALOG TOGGLE ──────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('.trait-catalog-toggle').forEach(btn => {
    const featureId = btn.dataset.featureId!;
    const wrapper = document.getElementById(`${featureId}-traits`);
    if (!wrapper) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const willCollapse = isExpanded;
      
      btn.setAttribute('aria-expanded', (!willCollapse).toString());
      btn.classList.toggle('is-collapsed', willCollapse);
      wrapper.setAttribute('aria-hidden', willCollapse.toString());
      wrapper.classList.toggle('is-open', !willCollapse);
      document.dispatchEvent(new CustomEvent('class-feature-collapse', {
        detail: { id: featureId, collapsed: willCollapse },
      }));
    });
  });

  function rebindTraitToggles() {
    document.querySelectorAll<HTMLButtonElement>('.trait-catalog-toggle').forEach(btn => {
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      btn.parentNode!.replaceChild(newBtn, btn);

      const featureId = newBtn.dataset.featureId!;
      const wrapper = document.getElementById(`${featureId}-traits`);
      if (!wrapper) return;

      newBtn.addEventListener('click', () => {
        const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';
        const willCollapse = isExpanded;

        newBtn.setAttribute('aria-expanded', (!willCollapse).toString());
        newBtn.classList.toggle('is-collapsed', willCollapse);
        wrapper.setAttribute('aria-hidden', willCollapse.toString());
        wrapper.classList.toggle('is-open', !willCollapse);
        document.dispatchEvent(new CustomEvent('class-feature-collapse', {
          detail: { id: featureId, collapsed: willCollapse },
        }));
      });
    });
  }

  // ──── DYNAMIC ARCHETYPE SWAPPER ─────────────────────────────────────────
  const warningBanner = document.querySelector<HTMLElement>('.archetype-warning-banner');
  const table = document.querySelector<HTMLElement>('.content-main table');
  const tocGroupContainer = document.querySelector<HTMLElement>('.toc-list');
  const selectEl = document.getElementById('archetype-select') as HTMLSelectElement | null;

  // Stash original HTML of base features to enable clean hot-swapping/restoring
  const baseCards = Array.from(document.querySelectorAll<HTMLElement>('.class-feature:not(.dynamic-archetype-feature)'));
  baseCards.forEach(card => {
    if (!card.dataset.originalHtml) {
      card.dataset.originalHtml = card.innerHTML;
      card.dataset.originalDisplay = card.style.display || '';
      card.dataset.originalId = card.id;
    }
  });

  // Stash original Table HTML
  if (table && !table.dataset.originalHtml) {
    table.dataset.originalHtml = table.innerHTML;
  }

  // Stash original ToC HTML
  if (tocGroupContainer && !tocGroupContainer.dataset.originalHtml) {
    tocGroupContainer.dataset.originalHtml = tocGroupContainer.innerHTML;
  }

  // Parse HTML5 template strings containing compiled markdown features
  const templates = Array.from(document.querySelectorAll<HTMLTemplateElement>('.archetype-feature-template')).map(t => {
    const contentEl = t.content ? t.content.querySelector('.archetype-feature-rendered-content') : t.querySelector('.archetype-feature-rendered-content');
    return {
      featureId: t.dataset.featureId!,
      name: t.dataset.name!,
      archetypeId: t.dataset.archetypeId!,
      level: JSON.parse(t.dataset.level!),
      replaces: JSON.parse(t.dataset.replaces!) as string[],
      alters: JSON.parse(t.dataset.alters!) as string[],
      mutuallyExclusive: JSON.parse(t.dataset.mutuallyExclusive!),
      html: contentEl ? contentEl.innerHTML : t.innerHTML
    };
  });

  function isCompatible(candidateArcId: string, selectedArcIds: string[]): boolean {
    if (selectedArcIds.length === 0) return true;

    const candidateFeatures = templates.filter(f => f.archetypeId === candidateArcId);
    
    for (const selectedArcId of selectedArcIds) {
      if (selectedArcId === candidateArcId) continue;
      const selectedFeatures = templates.filter(f => f.archetypeId === selectedArcId);
      
      for (const cf of candidateFeatures) {
        for (const sf of selectedFeatures) {
          // Rule 1: Both replace the same feature and at least one is mutuallyExclusive
          const replacedIntersection = cf.replaces.filter(r => sf.replaces.includes(r));
          if (replacedIntersection.length > 0) {
            if (cf.mutuallyExclusive || sf.mutuallyExclusive) return false;
          }

          // Rule 2: One alters and one replaces the same feature and at least one is mutuallyExclusive
          const alterReplaceIntersection1 = cf.replaces.filter(r => sf.alters.includes(r));
          if (alterReplaceIntersection1.length > 0) {
            if (cf.mutuallyExclusive || sf.mutuallyExclusive) return false;
          }

          const alterReplaceIntersection2 = cf.alters.filter(a => sf.replaces.includes(a));
          if (alterReplaceIntersection2.length > 0) {
            if (cf.mutuallyExclusive || sf.mutuallyExclusive) return false;
          }

          // Rule 3: Both alter the same feature and at least one is mutuallyExclusive
          const altersIntersection = cf.alters.filter(a => sf.alters.includes(a));
          if (altersIntersection.length > 0) {
            if (cf.mutuallyExclusive || sf.mutuallyExclusive) return false;
          }
        }
      }
    }
    return true;
  }

  function updateArchetypes(selectedArcIds: string[]) {
    // 1. Reset all cards to baseline
    baseCards.forEach(card => {
      card.innerHTML = card.dataset.originalHtml!;
      card.style.display = card.dataset.originalDisplay!;
      card.id = card.dataset.originalId!; // Restore original ID if altered
      card.className = 'class-feature' + (card.dataset.originalHtml!.includes('trait-catalog-toggle') ? ' class-feature--container' : '');
    });

    // Remove any purely dynamic features (like Protean Aura)
    document.querySelectorAll('.dynamic-archetype-feature').forEach(c => c.remove());

    // Reset Table
    if (table) {
      table.innerHTML = table.dataset.originalHtml!;
    }

    // Reset ToC
    if (tocGroupContainer) {
      tocGroupContainer.innerHTML = tocGroupContainer.dataset.originalHtml!;
    }

    // Reset banner
    if (warningBanner) {
      warningBanner.style.display = 'none';
      warningBanner.innerHTML = '';
    }

    if (selectedArcIds.length === 0) {
      rebindTraitToggles();
      return;
    }

    // 2. Filter active archetype features
    const activeFeatures = templates.filter(f => selectedArcIds.includes(f.archetypeId));

    // 3. Conflict Checking Logic
    const replacedBy: Record<string, Array<{ af: typeof templates[0], arcName: string }>> = {};
    const alteredBy: Record<string, Array<{ af: typeof templates[0], arcName: string }>> = {};

    activeFeatures.forEach(af => {
      const cb = document.querySelector<HTMLInputElement>(`.archetype-checkbox[data-archetype-id="${af.archetypeId}"]`);
      const arcName = cb ? cb.dataset.archetypeName! : af.archetypeId;

      af.replaces.forEach(baseId => {
        if (!replacedBy[baseId]) replacedBy[baseId] = [];
        replacedBy[baseId].push({ af, arcName });
      });

      af.alters.forEach(baseId => {
        if (!alteredBy[baseId]) alteredBy[baseId] = [];
        alteredBy[baseId].push({ af, arcName });
      });
    });

    let conflictMsg = "";
    for (const baseId in replacedBy) {
      const repls = replacedBy[baseId];
      if (repls.length > 1) {
        const isAnyExclusive = repls.some(r => r.af.mutuallyExclusive);
        if (isAnyExclusive) {
          conflictMsg = `Conflict detected: Archetypes ${repls.map(r => r.arcName).join(' and ')} both attempt to replace the same feature (${baseId.replace('shifter-', '').replace(/-/g, ' ')}).`;
          break;
        }
      }
      const alts = alteredBy[baseId] || [];
      if (repls.length > 0 && alts.length > 0) {
        const isAnyExclusive = repls.some(r => r.af.mutuallyExclusive) || alts.some(a => a.af.mutuallyExclusive);
        if (isAnyExclusive) {
          conflictMsg = `Conflict detected: Archetype ${repls[0].arcName} replaces and ${alts[0].arcName} alters the same feature (${baseId.replace('shifter-', '').replace(/-/g, ' ')}).`;
          break;
        }
      }
    }

    if (!conflictMsg) {
      for (const baseId in alteredBy) {
        const alts = alteredBy[baseId];
        if (alts.length > 1) {
          const isAnyExclusive = alts.some(a => a.af.mutuallyExclusive);
          if (isAnyExclusive) {
            conflictMsg = `Conflict detected: Archetypes ${alts.map(a => a.arcName).join(' and ')} both attempt to alter the same feature (${baseId.replace('shifter-', '').replace(/-/g, ' ')}).`;
            break;
          }
        }
      }
    }

    if (conflictMsg) {
      if (warningBanner) {
        warningBanner.innerHTML = `<span class="warning-icon">⚠️</span> <span class="warning-text">${conflictMsg}</span>`;
        warningBanner.style.display = 'block';
      }
      return;
    }

    // 4. Hot-swap active features!
    activeFeatures.forEach(af => {
      const option = selectEl ? Array.from(selectEl.options).find(o => o.value === af.archetypeId) : null;
      const arcName = option ? option.dataset.name! : af.archetypeId;

      if (af.replaces.length > 0) {
        // Replacement: Swap in-place inside primary base feature node to preserve Scrollspy intersections
        const primaryBaseId = af.replaces[0];
        const primaryCard = document.getElementById(primaryBaseId);

        if (primaryCard) {
          primaryCard.id = af.featureId;
          primaryCard.className = 'class-feature class-feature--archetype';
          
          const displayLevel = Array.isArray(af.level) 
            ? af.level.map(l => `${l}${ordinal(l)}`).join(', ')
            : `${af.level}${ordinal(af.level)}`;

          primaryCard.innerHTML = `
            <h2 class="class-feature-heading" title="Replaces: ${primaryBaseId.replace('shifter-', '').replace(/-/g, ' ')}">
              ${af.name}
              <span class="class-feature-level"> (${displayLevel})</span>
              <span class="badge badge--archetype" title="Replaces ${primaryBaseId.replace('shifter-', '').replace(/-/g, ' ')}">${arcName}</span>
            </h2>
            <div class="entry-description">${af.html}</div>
          `;
        }

        // Hide other replaced base features (if many-to-one replacement)
        for (let i = 1; i < af.replaces.length; i++) {
          const extraCard = document.getElementById(af.replaces[i]);
          if (extraCard) {
            extraCard.style.display = 'none';
          }
        }
      } else if (af.alters.length > 0) {
        // Alteration: Retain original card but append premium modification section
        af.alters.forEach(baseId => {
          const baseCard = document.getElementById(baseId);
          if (baseCard) {
            baseCard.classList.add('is-altered');
            
            const modBlock = document.createElement('div');
            modBlock.className = 'archetype-modification-block';
            modBlock.innerHTML = `
              <div class="archetype-mod-header">
                <span class="archetype-mod-badge">${arcName} Modification</span>
              </div>
              <div class="archetype-mod-body">
                ${af.html}
              </div>
            `;
            baseCard.appendChild(modBlock);
          }
        });
      } else {
        // Purely new feature: Render dynamic element chronologically
        const displayLevel = Array.isArray(af.level) 
          ? af.level.map(l => `${l}${ordinal(l)}`).join(', ')
          : `${af.level}${ordinal(af.level)}`;

        const newCard = document.createElement('div');
        newCard.className = 'class-feature dynamic-archetype-feature class-feature--archetype';
        newCard.id = af.featureId;
        newCard.innerHTML = `
          <h2 class="class-feature-heading">
            ${af.name}
            <span class="class-feature-level"> (${displayLevel})</span>
            <span class="badge badge--archetype">${arcName}</span>
          </h2>
          <div class="entry-description">${af.html}</div>
        `;

        const baseFeaturesList = Array.from(document.querySelectorAll<HTMLElement>('.class-feature:not(.dynamic-archetype-feature)'));
        const afMinLevel = Array.isArray(af.level) ? Math.min(...af.level) : af.level;
        let inserted = false;

        for (const baseCard of baseFeaturesList) {
          const baseLevelRaw = JSON.parse(baseCard.dataset.level || '0');
          const baseMinLevel = Array.isArray(baseLevelRaw) ? Math.min(...baseLevelRaw) : baseLevelRaw;

          if (baseMinLevel > afMinLevel) {
            baseCard.parentNode!.insertBefore(newCard, baseCard);
            inserted = true;
            break;
          }
        }

        if (!inserted && baseFeaturesList.length > 0) {
          const lastCard = baseFeaturesList[baseFeaturesList.length - 1];
          lastCard.parentNode!.appendChild(newCard);
        }
      }
    });

    // 5. Update Class Features Table Rows
    if (table) {
      const rows = Array.from(table.querySelectorAll('tr'));
      rows.forEach(row => {
        const cells = Array.from(row.querySelectorAll('td'));
        if (cells.length < 6) return;
        const cell = cells[5];
        if (!cell) return;

        activeFeatures.forEach(af => {
          const option = selectEl ? Array.from(selectEl.options).find(o => o.value === af.archetypeId) : null;
          const arcName = option ? option.dataset.name! : af.archetypeId;

          af.replaces.forEach(baseId => {
            const baseName = (templates.find(t => t.featureId === baseId) ?? { name: baseId.replace(/^[a-z]+-/, '').replace(/-/g, ' ') }).name;
            replaceInTextNodes(cell, new RegExp(`\\b${baseName}\\b`, 'gi'), (match) => {
              const span = document.createElement('span');
              span.className = 'table-archetype-feature';
              span.title = `${arcName} replaces ${match}`;
              span.textContent = af.name;
              return span;
            });
          });

          af.alters.forEach(baseId => {
            const baseName = (templates.find(t => t.featureId === baseId) ?? { name: baseId.replace(/^[a-z]+-/, '').replace(/-/g, ' ') }).name;
            replaceInTextNodes(cell, new RegExp(`\\b${baseName}\\b`, 'gi'), (match) => {
              const frag = document.createDocumentFragment();
              frag.appendChild(document.createTextNode(match));
              const badge = document.createElement('span');
              badge.className = 'table-altered-badge';
              badge.title = `Altered by ${arcName}`;
              badge.textContent = ` (${arcName} Altered)`;
              frag.appendChild(badge);
              return frag;
            });
          });
        });
      });
    }

    // 6. Update ToC List Items
    if (tocGroupContainer) {
      activeFeatures.forEach(af => {
        const option = selectEl ? Array.from(selectEl.options).find(o => o.value === af.archetypeId) : null;
        const arcName = option ? option.dataset.name! : af.archetypeId;

        af.replaces.forEach(baseId => {
          const tocItem = tocGroupContainer.querySelector<HTMLElement>(`[data-toc-section="${baseId}"]`);
          if (tocItem) {
            const link = tocItem.querySelector<HTMLAnchorElement>('.toc-cat-link')!;
            const span = link.querySelector<HTMLElement>('span')!;
            span.innerHTML = `<span class="toc-archetype-text" title="Replaces ${span.textContent}">${af.name}</span>`;
            link.setAttribute('href', `#${af.featureId}`);
            tocItem.setAttribute('data-toc-section', af.featureId);
          }
        });

        af.alters.forEach(baseId => {
          const tocItem = tocGroupContainer.querySelector<HTMLElement>(`[data-toc-section="${baseId}"]`);
          if (tocItem) {
            const link = tocItem.querySelector<HTMLAnchorElement>('.toc-cat-link')!;
            const span = link.querySelector<HTMLElement>('span')!;
            if (!span.innerHTML.includes('toc-altered-badge')) {
              span.innerHTML = `${span.textContent} <span class="toc-altered-badge">(Altered)</span>`;
            }
          }
        });
      });
    }

    // Rebind toggles for trait catalogs (in case DOM elements were overwritten)
    rebindTraitToggles();
  }

  // Initialize TomSelect if present
  let tomSelectInstance: any = null;
  if (selectEl) {
    selectEl.classList.remove('ts-hidden-select');
    tomSelectInstance = new TomSelect(selectEl, {
      placeholder: 'Select Archetypes...',
      plugins: ['remove_button'],
      closeAfterSelect: true,
      maxOptions: null,
      render: {
        option: function(data: any, escape: any) {
          return '<div class="ts-custom-option">' +
            '<span class="title">' + escape(data.text) + '</span>' +
            '<div class="description" style="font-size: 0.8em; opacity: 0.7; margin-top: 2px;">' + escape(data.desc || '') + '</div>' +
          '</div>';
        }
      },
      onChange: function(values: string[]) {
        const urlParams = new URLSearchParams(window.location.search);
        if (values && values.length > 0) {
          urlParams.set('archetypes', values.join(','));
        } else {
          urlParams.delete('archetypes');
        }
        const newUrl = window.location.pathname + (urlParams.toString() ? '?' + urlParams.toString() : '');
        window.history.pushState({ path: newUrl }, '', newUrl);

        updateArchetypes(values || []);

        // Apply compatibility logic to disable invalid options
        const currentSelected = values || [];
        Object.keys(tomSelectInstance.options).forEach(optValue => {
          const isSelected = currentSelected.includes(optValue);
          const opt = tomSelectInstance.options[optValue];
          if (!isSelected) {
            const comp = isCompatible(optValue, currentSelected);
            if (opt.disabled !== !comp) {
              opt.disabled = !comp;
              tomSelectInstance.updateOption(optValue, opt);
            }
          } else {
            if (opt.disabled) {
              opt.disabled = false;
              tomSelectInstance.updateOption(optValue, opt);
            }
          }
        });
      }
    });

    // Read initial archetypes from query params on load
    const urlParams = new URLSearchParams(window.location.search);
    const initialArchetypes = urlParams.get('archetypes');
    if (initialArchetypes && tomSelectInstance) {
      const activeIds = initialArchetypes.split(',');
      tomSelectInstance.setValue(activeIds); // this triggers onChange which calls updateArchetypes
    }
  }



  function ordinal(n: number): string {
    if (n % 100 >= 11 && n % 100 <= 13) return 'th';
    switch (n % 10) {
      case 1: return 'st';
      case 2: return 'nd';
      case 3: return 'rd';
      default: return 'th';
    }
  }
});
</script>

