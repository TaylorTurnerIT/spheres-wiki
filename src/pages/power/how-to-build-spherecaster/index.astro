---
import { getCollection, render } from "astro:content";
import ArticlePage from "@/layouts/ArticlePage.astro";
import { resolveEntries } from "@/lib/resolveEntries";
import type { ArticleEntry } from "@/lib/types";

const entries = await getCollection("ultimate-spheres-of-power");
const entry = entries.find(
  (e: any) => e.data.type === "article" && e.data.id === "how-to-build-spherecaster",
);
if (!entry) {
  throw new Error(
    "Missing article entry: ultimate-spheres-of-power/articles/how-to-build-spherecaster.md",
  );
}
const { Content } = await render(entry);
const article = entry.data as ArticleEntry;

const { bookMetaMap } = await resolveEntries();
const book = bookMetaMap.get("ultimate-spheres-of-power");

const description =
  "A step-by-step guide to building a Spherecaster in Ultimate Spheres of Power: picking classes, selecting spheres, and understanding magic talents.";
---
<ArticlePage article={article} book={book} description={description}>
  <Content />
</ArticlePage>
