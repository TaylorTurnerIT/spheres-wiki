---
import { getEntry } from "astro:content";
import ArticlePage from "@/layouts/ArticlePage.astro";
import TabbedContent from "@/components/TabbedContent.astro";
import EntryCardList from "@/components/EntryCardList.astro";
import { url } from "@/lib/url";
import { getCastingTraditionPageData } from "@/lib/castingTraditions/pageData";
import {
  buildTraditionState,
  selectionFromTradition,
  validateTradition,
} from "@/lib/castingTraditions/rules";
import {
  exportTraditionMarkdown,
} from "@/lib/castingTraditions/export";
import type { ArticleEntry } from "@/lib/types";

const entry = await getEntry(
  "ultimate-spheres-of-power",
  "power/articles/casting-traditions",
);
if (!entry) {
  throw new Error(
    "Missing article entry: ultimate-spheres-of-power/articles/casting-traditions.md",
  );
}
const article = entry.data as ArticleEntry;

const {
  book,
  bookMetaMap,
  tagMap,
  allPowerDrawbacks,
  allPowerBoons,
  allPowerTraditions,
  standardTraditionCards,
  customTraditionCards,
  generalDrawbackCards,
  sphereDrawbackSections,
  boonCards,
} = await getCastingTraditionPageData();

const description =
  "Define how your magic works in Ultimate Spheres of Power with casting traditions, drawbacks, and boons.";

// Use rules/export functions at build time — satisfies V66 production import requirement
const _tradData = {
  drawbacks: allPowerDrawbacks,
  boons: allPowerBoons,
  traditions: allPowerTraditions,
};
// Validate standard traditions at build time (production use of validateTradition)
for (const t of allPowerTraditions.filter((tradition) => tradition.traditionKind === "standard")) {
  const sel = selectionFromTradition(t, _tradData);
  validateTradition(sel, _tradData);
}
// Production use of buildTraditionState + exportTraditionMarkdown (V66)
const _exampleState = buildTraditionState(
  { drawbacks: [], boons: [] },
  { drawbacks: [], boons: [] },
);
const _exampleExport = exportTraditionMarkdown(
  { name: "Preview", drawbacks: [], boons: [] },
  { drawbacks: [], boons: [] },
);
void _exampleState;
void _exampleExport;

const tabs = [
  {
    label: "Rules",
    slug: "rules",
    articleId: "power/articles/casting-traditions/rules",
    collection: "ultimate-spheres-of-power",
    showToc: true,
  },
  {
    label: "Standard Traditions",
    slug: "standard",
    articleId: "power/articles/casting-traditions/standard-traditions",
    collection: "ultimate-spheres-of-power",
    showToc: true,
  },
  {
    label: "Custom Traditions",
    slug: "custom",
    articleId: "power/articles/casting-traditions/custom-traditions",
    collection: "ultimate-spheres-of-power",
    showToc: true,
  },
  {
    label: "General Drawbacks",
    slug: "general-drawbacks",
    articleId: "power/articles/casting-traditions/general-drawbacks",
    collection: "ultimate-spheres-of-power",
    showToc: true,
  },
  {
    label: "Sphere-Specific Drawbacks",
    slug: "sphere-drawbacks",
    articleId: "power/articles/casting-traditions/sphere-drawbacks",
    collection: "ultimate-spheres-of-power",
    showToc: true,
  },
  {
    label: "Boons",
    slug: "boons",
    articleId: "power/articles/casting-traditions/boons",
    collection: "ultimate-spheres-of-power",
    showToc: true,
  },
  { label: "Builder", slug: "builder", showToc: false, builder: true },
];

const deferredAnchorTabs = {
  standard: [
    ...standardTraditionCards.map((card) => card.id),
  ],
  custom: [
    ...customTraditionCards.map((card) => card.id),
  ],
  "general-drawbacks": [
    ...generalDrawbackCards.map((card) => card.id),
  ],
  "sphere-drawbacks": [
    ...sphereDrawbackSections.flatMap((section) =>
      section.items.map((card) => card.id),
    ),
  ],
  boons: boonCards.map((card) => card.id),
};

---

<ArticlePage article={article} book={book} description={description}>
  <TabbedContent
    tabs={tabs}
    deferInactive
    deferredContentBase={url("/power/casting-traditions/tabs")}
    deferredTabs={[
      "standard",
      "custom",
      "general-drawbacks",
      "sphere-drawbacks",
      "boons",
    ]}
    deferredAnchorTabs={deferredAnchorTabs}
  >
    <!-- Standard Traditions -->
    <div slot="standard">
      <EntryCardList
        summary="Standard traditions"
        items={standardTraditionCards}
        emptyMessage="No standard traditions defined yet."
        tagMap={tagMap}
        bookMetaMap={bookMetaMap}
      />
    </div>

    <!-- Custom Traditions -->
    <div slot="custom">
      <EntryCardList
        summary="Custom traditions"
        items={customTraditionCards}
        emptyMessage="No custom traditions defined yet."
        tagMap={tagMap}
        bookMetaMap={bookMetaMap}
      />
    </div>

    <!-- General Drawbacks -->
    <div slot="general-drawbacks">
      <EntryCardList
        summary="General drawbacks"
        items={generalDrawbackCards}
        tagMap={tagMap}
        bookMetaMap={bookMetaMap}
      />
    </div>

    <!-- Sphere Drawbacks -->
    <div slot="sphere-drawbacks">
      <EntryCardList
        summary="Sphere-Specific drawbacks"
        sections={sphereDrawbackSections}
        tagMap={tagMap}
        bookMetaMap={bookMetaMap}
      />
    </div>

    <!-- Boons -->
    <div slot="boons">
      <EntryCardList
        summary="Boons"
        items={boonCards}
        tagMap={tagMap}
        bookMetaMap={bookMetaMap}
      />
    </div>

    <!-- Builder -->
    <div
      slot="builder"
      class="tradition-builder"
      data-builder-data-src={url("/power/casting-traditions/builder-data.json")}
    >
      <h2 class="builder-heading">Casting Tradition Builder</h2>
      <p class="builder-intro">Build and export a custom casting tradition. Changes update in real time.</p>

      <div class="builder-layout">
        <div class="builder-controls">
          <div class="builder-section">
            <label class="builder-label" for="tb-name">Tradition Name</label>
            <input id="tb-name" type="text" class="builder-input" placeholder="My Tradition" />
          </div>

          <div class="builder-section">
            <div class="builder-subsection-header">
              <span class="builder-label">Casting Ability Modifier</span>
              <button id="tb-cam-lock" class="builder-icon-btn" type="button" title="Locked: only rules-allowed abilities are selectable. Click to unlock (GM override)." aria-label="Toggle CAM restrictions">
                <svg width="14" height="14" viewBox="0 0 14 14"><rect x="3" y="6" width="8" height="6" rx="1" fill="currentColor"/><path d="M5 6V4a2 2 0 0 1 4 0v2" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
              </button>
            </div>
            <div id="tb-cam-options" class="builder-cam-row">
              {["str","dex","con","int","wis","cha"].map((a) => (
                <label class="cam-option">
                  <input type="radio" name="tb-cam" value={a} /> {a.toUpperCase()}
                </label>
              ))}
            </div>
          </div>

          <div class="builder-section">
            <div class="builder-subsection-header">
              <span class="builder-label">Start From Tradition</span>
            </div>
            <select id="tb-load-tradition" class="builder-select">
              <option value="">None</option>
            </select>
          </div>

          <div class="builder-section">
            <div class="builder-subsection-header">
              <span class="builder-label">General Drawbacks</span>
              <div class="builder-currency-group">
                <span id="tb-gdv-display" class="builder-currency-badge">0 Drawbacks</span>
                <div class="builder-manual-inline">
                  <span class="builder-manual-label">GM Adj.</span>
                  <button class="builder-stepper-btn" data-stepper="gdv" data-dir="down" type="button">−</button>
                  <span id="tb-manual-gdv" class="builder-manual-value">0</span>
                  <button class="builder-stepper-btn" data-stepper="gdv" data-dir="up" type="button">+</button>
                </div>
              </div>
            </div>
            <input id="tb-drawback-search" type="search" class="builder-input builder-search" placeholder="Filter drawbacks…" />
            <div id="tb-general-drawbacks" class="builder-checklist"></div>
          </div>

          <div class="builder-section">
            <div class="builder-subsection-header">
              <span class="builder-label">Boons</span>
              <div class="builder-currency-group">
                <span id="tb-boon-currency" class="builder-currency-badge">0 / 0 slots</span>
                <div class="builder-manual-inline">
                  <span class="builder-manual-label">GM Adj.</span>
                  <button class="builder-stepper-btn" data-stepper="bslots" data-dir="down" type="button">−</button>
                  <span id="tb-manual-bslots" class="builder-manual-value">0</span>
                  <button class="builder-stepper-btn" data-stepper="bslots" data-dir="up" type="button">+</button>
                </div>
              </div>
            </div>
            <input id="tb-boon-search" type="search" class="builder-input builder-search" placeholder="Filter boons…" />
            <div id="tb-boons" class="builder-checklist"></div>
          </div>

          <div class="builder-section">
            <div class="builder-subsection-header">
              <span class="builder-label">Sphere-Specific Drawbacks</span>
            </div>
            <div class="builder-filter-row">
              <select id="tb-sphere-filter" class="builder-select builder-filter-half">
                <option value="">All Spheres</option>
              </select>
              <input id="tb-sphere-drawback-search" type="search" class="builder-input builder-filter-half" placeholder="Filter…" />
            </div>
            <div id="tb-sphere-drawbacks" class="builder-checklist"></div>
          </div>
        </div>

        <div class="builder-summary" id="tb-summary">
          <h3 class="builder-summary-title">Summary <span id="tb-save-status" class="builder-save-status">Unsaved changes</span></h3>
          <div class="builder-summary-separator" aria-hidden="true"></div>
          <h2 id="tb-summary-name" class="builder-summary-name">Unnamed Tradition</h2>
          <div id="tb-diagnostics" class="builder-diagnostics" hidden></div>
          <div id="tb-summary-content" class="builder-summary-body"></div>
          <div class="builder-export">
            <div class="builder-export-tabs">
              <button class="builder-export-tab active" data-export="md">Markdown</button>
              <button class="builder-export-tab" data-export="json">JSON</button>
              <label class="builder-export-detailed">
                <input type="checkbox" id="tb-detailed-export" /> Detailed
              </label>
            </div>
            <textarea id="tb-export-output" class="builder-export-textarea" readonly rows="10"></textarea>
          </div>
          <div class="builder-save-area">
            <div class="builder-save-row">
              <button id="tb-save-btn" class="btn btn--solid">Save</button>
              <button id="tb-copy-btn" class="btn btn--solid">Copy</button>
              <button id="tb-reset-btn" class="btn">Reset to Defaults</button>
            </div>
            <div class="builder-save-row builder-save-row--divider">
              <select id="tb-saved-traditions" class="builder-select">
                <option value="">— Load saved tradition —</option>
              </select>
              <button id="tb-delete-saved" class="builder-icon-btn builder-delete-btn" type="button" title="Delete selected saved tradition">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </div>
            <div class="builder-catalog-row">
              <button id="tb-export-catalog" class="btn">Export Catalog</button>
              <button id="tb-import-catalog" class="btn" type="button">Import Catalog</button>
              <input type="file" id="tb-import-file" accept=".json" hidden />
              <span class="builder-catalog-info" title="Clearing browser data will remove saved traditions unless you export a backup.">
                <svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1" fill="none"/><path d="M6 5v3M6 3.5v.5" stroke="currentColor" stroke-width="1.2"/></svg>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </TabbedContent>
</ArticlePage>

<script>
  import {
    buildTraditionState,
    calculateGeneralDrawbackValue,
    calculateAvailableBoonSlots,
    calculateUnspentDrawbackValue,
    bonusSpellPointFormula,
    getAllowedCastingAbilities,
    selectionFromTradition,
    validateTradition,
  } from "@/lib/castingTraditions/rules";
  import {
    exportTraditionMarkdown,
    exportTraditionJson,
  } from "@/lib/castingTraditions/export";
  import {
    filterByText,
    groupBySphere,
    formatIncompatibleName,
    prerequisiteExcerpt,
    isSafeFix,
    type BuilderStore,
    type ClientDrawback,
    type SelectedIds,
  } from "@/lib/castingTraditions/builderHelpers";

  const SAVED_KEY = "spheres-wiki:saved-casting-traditions";
  const SCHEMA_VERSION = 1;
  let cleanupTraditionBuilderPage = () => {};
  let cleanupBuilderActivation = () => {};

  document.addEventListener("astro:before-swap", () => {
    cleanupTraditionBuilderPage();
    cleanupTraditionBuilderPage = () => {};
    cleanupBuilderActivation();
    cleanupBuilderActivation = () => {};
  });

  async function initTraditionBuilder(builder: HTMLElement) {
    cleanupTraditionBuilderPage();
    const root = builder;
    const controller = new AbortController();
    const { signal } = controller;
    const pendingTimers = new Set<ReturnType<typeof setTimeout>>();

    function schedule(callback: () => void, delay: number): void {
      const timer = setTimeout(() => {
        pendingTimers.delete(timer);
        if (!signal.aborted) callback();
      }, delay);
      pendingTimers.add(timer);
    }

    cleanupTraditionBuilderPage = () => {
      controller.abort();
      for (const timer of pendingTimers) clearTimeout(timer);
      pendingTimers.clear();
    };

    const dataUrl = root.dataset.builderDataSrc;
    const store: BuilderStore = dataUrl
      ? await fetch(dataUrl).then(async (response) => {
          if (!response.ok) {
            throw new Error(`Builder data request failed: ${response.status}`);
          }
          return (await response.json()) as BuilderStore;
        })
      : { drawbacks: [], boons: [], traditions: [] };

    // ── State ──────────────────────────────────────────────────
    let selDrawbacks: string[] = [];
    let selSphereDrawbacks: string[] = [];
    let selBoons: string[] = [];
    let selCam: string | undefined;
    let camOverride = false;
    let manualGDV = 0;
    let manualBoonSlots = 0;
    let exportMode: "md" | "json" = "md";
    let detailedExport = false;
    let saveStatus = "";

    function getSelectedIds(): SelectedIds {
      return { drawbacks: selDrawbacks, sphereDrawbacks: selSphereDrawbacks, boons: selBoons };
    }

    function getSelection() {
      return {
        name: (document.getElementById("tb-name") as HTMLInputElement)?.value || undefined,
        cam: selCam as any,
        camOverride: camOverride || undefined,
        manualGeneralDrawbackValue: manualGDV || undefined,
        manualBoonSlots: manualBoonSlots || undefined,
        drawbacks: selDrawbacks.map((id) => ({ id })),
        sphereDrawbacks: selSphereDrawbacks.map((id) => ({ id })),
        boons: selBoons.map((id) => ({ id })),
      };
    }

    function getTraditionData() {
      return {
        drawbacks: store.drawbacks as any[],
        boons: store.boons as any[],
        traditions: store.traditions as any[],
      };
    }

    function buildState() {
      return buildTraditionState(getSelection() as any, getTraditionData());
    }

    // ── CAM Lock ────────────────────────────────────────────
    function renderCamOptions() {
      const lockBtn = document.getElementById("tb-cam-lock");
      if (lockBtn) {
        lockBtn.classList.toggle("is-unlocked", camOverride);
        lockBtn.title = camOverride
          ? "Unlocked (GM override): any ability score is selectable. Click to lock."
          : "Locked: only rules-allowed abilities are selectable. Click to unlock (GM override).";
      }

      const disabledTooltip = "Unless a particular boon or magic trait is being used, this choice must be made from Intelligence, Wisdom, or Charisma. With GM permission, this can be overwritten by clicking the lock icon.";
      root.querySelectorAll<HTMLInputElement>('input[name="tb-cam"]').forEach((radio) => {
        if (camOverride) {
          radio.disabled = false;
          const label = radio.closest("label");
          if (label) label.classList.remove("cam-disabled");
          radio.title = "";
          return;
        }
        const state = buildState();
        const allowed = getAllowedCastingAbilities(state as any);
        const allowedIds = new Set(allowed.map((a) => a.ability));
        const isAllowed = allowedIds.has(radio.value as any);
        radio.disabled = !isAllowed;
        const label = radio.closest("label");
        if (label) {
          label.classList.toggle("cam-disabled", !isAllowed);
          label.title = isAllowed ? "" : disabledTooltip;
        }
        if (!isAllowed && radio.checked) {
          radio.checked = false;
          selCam = undefined;
        }
      });
    }

    // ── Manual adjustments ───────────────────────────────────
    function adjustManual(type: "gdv" | "bslots", delta: number) {
      if (type === "gdv") {
        manualGDV = Math.max(0, manualGDV + delta);
        const el = document.getElementById("tb-manual-gdv");
        if (el) el.textContent = String(manualGDV);
      } else {
        manualBoonSlots = Math.max(0, manualBoonSlots + delta);
        const el = document.getElementById("tb-manual-bslots");
        if (el) el.textContent = String(manualBoonSlots);
      }
      onUpdate();
    }

    // ── Summary ──────────────────────────────────────────────
    function renderSummary() {
      const selection = getSelection();
      const data = getTraditionData();
      const state = buildState();
      const rawGdv = calculateGeneralDrawbackValue(state as any);
      const gdv = rawGdv + manualGDV;
      const rawSlots = calculateAvailableBoonSlots(state as any);
      const slots = Math.max(0, rawSlots + manualBoonSlots);
      const boonCost = state.boons.reduce((sum, { ref }) => {
        const b = store.boons.find((bb) => bb.id === ref.id);
        return sum + (b?.boonCost ?? 0);
      }, 0);
      const unspent = calculateUnspentDrawbackValue(state as any);
      const spBonus = bonusSpellPointFormula(unspent);

      const gdvEl = document.getElementById("tb-gdv-display");
      if (gdvEl) gdvEl.textContent = `${gdv} Drawbacks`;
      const currEl = document.getElementById("tb-boon-currency");
      if (currEl) currEl.textContent = `${boonCost} / ${slots} slots`;
      const nameEl = document.getElementById("tb-summary-name");
      if (nameEl) {
        nameEl.textContent = selection.name?.trim() || "Unnamed Tradition";
      }

      const body = document.getElementById("tb-summary-content");
      if (body) {
        const rows = [
          `<strong>General Drawback Value:</strong> ${gdv}${manualGDV ? ` (base: ${rawGdv} + GM: ${manualGDV})` : ""}`,
          `<strong>Available Boon Slots:</strong> ${slots}${manualBoonSlots ? ` (base: ${rawSlots} + GM: ${manualBoonSlots})` : ""}`,
          ...(unspent > 0 && spBonus ? [`<strong>Bonus Spell Points:</strong> ${spBonus}`] : []),
          `<strong>Casting Ability Modifier:</strong> ${selCam?.toUpperCase() ?? "—"}${camOverride ? " (GM Override)" : ""}`,
        ];
        body.innerHTML = rows.map((r) => `<p class="builder-summary-row">${r}</p>`).join("");

        // Manual adjustments
        const manualEl = document.getElementById("tb-manual-gdv");
        if (manualEl) manualEl.textContent = String(manualGDV);
        const bslotEl = document.getElementById("tb-manual-bslots");
        if (bslotEl) bslotEl.textContent = String(manualBoonSlots);
      }

      // Diagnostics with formatted names and fix buttons
      const diags = validateTradition(selection as any, data as any);
      const diagEl = document.getElementById("tb-diagnostics");
      if (diagEl) {
        if (diags.length === 0) {
          diagEl.hidden = true;
          diagEl.innerHTML = "";
        } else {
          diagEl.hidden = false;
          diagEl.innerHTML = diags
            .map((d) => {
              // Format names for incompatibility diagnostics
              let message = d.message;
              if (d.code === "incompatible-selection") {
                const incompatId = d.sourceIds[1];
                if (incompatId) {
                  const name = formatIncompatibleName(incompatId, store);
                  message = `${store.drawbacks.find((dd) => dd.id === d.sourceIds[0])?.name ?? store.boons.find((bb) => bb.id === d.sourceIds[0])?.name ?? d.sourceIds[0]} is incompatible with ${name}.`;
                }
              }
              if (d.code === "missing-prerequisite") {
                const entryId = d.sourceIds[0];
                const entry = store.drawbacks.find((dd) => dd.id === entryId) ?? store.boons.find((bb) => bb.id === entryId);
                if (entry) {
                  const prereq = prerequisiteExcerpt(entry as any, store);
                  message = `${entry.name} requires ${prereq}.`;
                }
              }
              const safeFix = isSafeFix(d, store, getSelectedIds());
              const fixBtn = safeFix ? `<button class="builder-diag-fix" data-diag-code="${d.code}" data-diag-source="${d.sourceIds.join(",")}">Fix</button>` : "";
              return `<div class="builder-diag builder-diag--${d.severity}">${message} ${fixBtn}</div>`;
            })
            .join("");
          // Wire fix buttons
          diagEl.querySelectorAll<HTMLButtonElement>(".builder-diag-fix").forEach((btn) => {
            btn.addEventListener("click", () => {
              const sourceIds = btn.dataset.diagSource?.split(",") ?? [];
              const entry = store.drawbacks.find((d) => d.id === sourceIds[0]) ?? store.boons.find((b) => b.id === sourceIds[0]);
              if (!entry?.requires) return;
              // Collect required ids and add them
              const requiredIds = collectRequiredIdsForFix(entry.requires as any);
              for (const id of requiredIds) {
                if (store.drawbacks.some((d) => d.id === id) && !selDrawbacks.includes(id)) {
                  selDrawbacks.push(id);
                }
                if (store.boons.some((b) => b.id === id) && !selBoons.includes(id)) {
                  selBoons.push(id);
                }
              }
              onUpdate(true);
            }, { signal });
          });
        }
      }

      updateExport(selection, data);
    }

    function collectRequiredIdsForFix(predicate: any): string[] {
      const result: string[] = [];
      if (!predicate) return result;
      if (predicate.drawback) result.push(predicate.drawback);
      if (predicate.boon) result.push(predicate.boon);
      if (predicate.all) {
        for (const p of predicate.all) result.push(...collectRequiredIdsForFix(p));
      }
      if (predicate.any) {
        for (const p of predicate.any) result.push(...collectRequiredIdsForFix(p));
      }
      return result;
    }

    function updateExport(selection: any, data: any) {
      const output = document.getElementById("tb-export-output") as HTMLTextAreaElement;
      if (!output) return;
      if (exportMode === "md") {
        output.value = exportTraditionMarkdown(selection as any, data as any, detailedExport);
      } else {
        output.value = exportTraditionJson(selection as any, data as any);
      }
    }

    // ── Render checklists ──────────────────────────────────
    function renderGeneralDrawbacks() {
      const container = document.getElementById("tb-general-drawbacks");
      if (!container) return;
      const search = (document.getElementById("tb-drawback-search") as HTMLInputElement)?.value?.toLowerCase() ?? "";
      const generals = store.drawbacks.filter((d) => d.drawbackKind === "general");
      const visible = filterByText(generals, search);
      container.innerHTML = visible
        .map((d) => {
          const checked = selDrawbacks.includes(d.id) ? "checked" : "";
          return `<label class="builder-check-item" title="${escapeHtml(d.bodyPlain.slice(0, 200))}">
            <input type="checkbox" data-drawback="${d.id}" ${checked} />
            <span class="bcl-name">${d.name}<a href="#${d.id}" class="bcl-anchor" data-anchor-tab="general-drawbacks" data-anchor-id="${d.id}" title="View entry details"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"/><path d="m21 3-9 9"/><path d="M15 3h6v6"/></svg></a></span>
            <span class="bcl-badge">${d.drawbackValue} Drawbacks</span>
          </label>`;
        })
        .join("");
      container.querySelectorAll<HTMLInputElement>("input[type=checkbox][data-drawback]").forEach((cb) => {
        cb.addEventListener("change", () => {
          const id = cb.dataset.drawback!;
          if (cb.checked) {
            if (!selDrawbacks.includes(id)) selDrawbacks.push(id);
          } else {
            selDrawbacks = selDrawbacks.filter((d) => d !== id);
          }
          onUpdate();
        }, { signal });
      });
    }

    function renderSphereDrawbacks() {
      const container = document.getElementById("tb-sphere-drawbacks");
      if (!container) return;
      const sphereFilter = (document.getElementById("tb-sphere-filter") as HTMLSelectElement)?.value ?? "";
      const search = (document.getElementById("tb-sphere-drawback-search") as HTMLInputElement)?.value?.toLowerCase() ?? "";
      const sphere = store.drawbacks.filter((d) => d.drawbackKind === "sphere" || d.drawbackKind === "dual-sphere");
      let filtered = filterByText(sphere, search);
      if (sphereFilter) {
        filtered = filtered.filter((d) => (d.sphere === sphereFilter) || (d.spheres ?? []).includes(sphereFilter));
      }
      const grouped = groupBySphere(filtered as ClientDrawback[]);
      let html = "";
      for (const [sphereName, items] of grouped) {
        html += `<div class="bcl-group-header eyebrow">${sphereName}</div>`;
        for (const d of items) {
          const checked = selSphereDrawbacks.includes(d.id) ? "checked" : "";
          html += `<label class="builder-check-item" title="${escapeHtml(d.bodyPlain.slice(0, 200))}">
            <input type="checkbox" data-sphere-drawback="${d.id}" ${checked} />
            <span class="bcl-name">${d.name}<a href="#${d.id}" class="bcl-anchor" data-anchor-tab="sphere-drawbacks" data-anchor-id="${d.id}" title="View entry details"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"/><path d="m21 3-9 9"/><path d="M15 3h6v6"/></svg></a></span>
          </label>`;
        }
      }
      container.innerHTML = html;
      container.querySelectorAll<HTMLInputElement>("input[type=checkbox][data-sphere-drawback]").forEach((cb) => {
        cb.addEventListener("change", () => {
          const id = cb.dataset.sphereDrawback!;
          if (cb.checked) {
            if (!selSphereDrawbacks.includes(id)) selSphereDrawbacks.push(id);
          } else {
            selSphereDrawbacks = selSphereDrawbacks.filter((d) => d !== id);
          }
          onUpdate();
        }, { signal });
      });
    }

    function populateSphereFilter() {
      const sel = document.getElementById("tb-sphere-filter") as HTMLSelectElement;
      if (!sel) return;
      const sphereNames = new Set(store.drawbacks
        .filter((d) => d.drawbackKind === "sphere" || d.drawbackKind === "dual-sphere")
        .flatMap((d) => d.sphere ? [d.sphere] : (d.spheres ?? [])));
      sel.innerHTML = '<option value="">All Spheres</option>' +
        [...sphereNames].sort().map((s) => `<option value="${s}">${s}</option>`).join("");
    }

    function renderBoons() {
      const container = document.getElementById("tb-boons");
      if (!container) return;
      const search = (document.getElementById("tb-boon-search") as HTMLInputElement)?.value?.toLowerCase() ?? "";
      const visible = filterByText(store.boons, search);
      container.innerHTML = visible
        .map((b) => {
          const checked = selBoons.includes(b.id) ? "checked" : "";
          return `<label class="builder-check-item" title="${escapeHtml(b.bodyPlain.slice(0, 200))}">
            <input type="checkbox" data-boon="${b.id}" ${checked} />
            <span class="bcl-name">${b.name}<a href="#${b.id}" class="bcl-anchor" data-anchor-tab="boons" data-anchor-id="${b.id}" title="View entry details"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6"/><path d="m21 3-9 9"/><path d="M15 3h6v6"/></svg></a></span>
            <span class="bcl-badge bcl-boon">${b.boonCost} slot${b.boonCost !== 1 ? "s" : ""}</span>
          </label>`;
        })
        .join("");
      container.querySelectorAll<HTMLInputElement>("input[type=checkbox][data-boon]").forEach((cb) => {
        cb.addEventListener("change", () => {
          const id = cb.dataset.boon!;
          if (cb.checked) {
            if (!selBoons.includes(id)) selBoons.push(id);
          } else {
            selBoons = selBoons.filter((d) => d !== id);
          }
          onUpdate();
        }, { signal });
      });
    }

    function populateTraditionDropdown() {
      const sel = document.getElementById("tb-load-tradition") as HTMLSelectElement;
      if (!sel) return;
      sel.innerHTML =
        '<option value="">None</option>' +
        store.traditions
          .map((t) => `<option value="${t.id}">${t.name}</option>`)
          .join("");
      sel.addEventListener("change", () => {
        const tid = sel.value;
        if (!tid) return;
        const t = store.traditions.find((t) => t.id === tid);
        if (!t) return;
        const synthEntry = {
          ...t,
          type: "tradition" as const,
          sourceBook: "",
          tags: [],
          traditionKind: t.traditionKind as any,
          cam: t.cam as any,
        };
        const loaded = selectionFromTradition(synthEntry as any, getTraditionData() as any);
        selDrawbacks = loaded.drawbacks.map((r: any) => r.id);
        selSphereDrawbacks = (loaded.sphereDrawbacks ?? []).map((r: any) => r.id);
        selBoons = loaded.boons.map((r: any) => r.id);
        selCam = loaded.cam;
        camOverride = false;
        manualGDV = 0;
        manualBoonSlots = 0;
        if (loaded.name) {
          const nameInput = document.getElementById("tb-name") as HTMLInputElement;
          if (nameInput) nameInput.value = loaded.name;
        }
        onUpdate(true);
      }, { signal });
    }

    function syncCamRadio() {
      root.querySelectorAll<HTMLInputElement>('input[name="tb-cam"]').forEach((r) => {
        r.checked = r.value === selCam;
      });
    }

    // ── Save/Load ─────────────────────────────────────────
    function updateSaveStatus() {
      const el = document.getElementById("tb-save-status");
      if (el) el.textContent = saveStatus;
    }

    function manualSave() {
      const name = (document.getElementById("tb-name") as HTMLInputElement)?.value?.trim() || "Unnamed Tradition";
      const saved: any[] = loadSavedTraditions();
      const sel = document.getElementById("tb-saved-traditions") as HTMLSelectElement;
      const selectedId = sel?.value;

      // If a saved tradition is selected in the dropdown, ask to update vs create new
      if (selectedId && saved.some((s: any) => s.id === selectedId)) {
        const update = confirm(`"${name}" is already selected.\n\nOK = Update existing\nCancel = Save as new`);
        if (update) {
          const idx = saved.findIndex((s: any) => s.id === selectedId);
          if (idx !== -1) {
            saved[idx] = { ...saved[idx], name, ts: Date.now(), drawbacks: selDrawbacks, sphereDrawbacks: selSphereDrawbacks, boons: selBoons, cam: selCam, camOverride, manualGDV, manualBoonSlots };
          }
          try { localStorage.setItem(SAVED_KEY, JSON.stringify(saved)); saveStatus = "Saved"; } catch { saveStatus = "Save failed"; }
          updateSaveStatus();
          populateSavedDropdown(selectedId);
          return;
        }
      }

      const id = crypto.randomUUID();
      const record = {
        id,
        name,
        v: SCHEMA_VERSION,
        ts: Date.now(),
        drawbacks: selDrawbacks,
        sphereDrawbacks: selSphereDrawbacks,
        boons: selBoons,
        cam: selCam,
        camOverride,
        manualGDV,
        manualBoonSlots,
      };
      saved.push(record);
      try { localStorage.setItem(SAVED_KEY, JSON.stringify(saved)); saveStatus = "Saved"; } catch { saveStatus = "Save failed"; }
      updateSaveStatus();
      populateSavedDropdown(id);
    }

    function loadSavedTraditions(): any[] {
      try {
        const raw = localStorage.getItem(SAVED_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch { return []; }
    }

    function populateSavedDropdown(selectId?: string) {
      const sel = document.getElementById("tb-saved-traditions") as HTMLSelectElement;
      if (!sel) return;
      const saved = loadSavedTraditions();
      sel.innerHTML = '<option value="">— Load saved tradition —</option>' +
        saved.map((s: any) => `<option value="${s.id}">${s.name} (${new Date(s.ts).toLocaleDateString()})</option>`).join("");
      if (selectId) sel.value = selectId;
    }

    function loadSavedTradition(id: string) {
      const saved = loadSavedTraditions();
      const record = saved.find((s: any) => s.id === id);
      if (!record) return;
      selDrawbacks = record.drawbacks ?? [];
      selSphereDrawbacks = record.sphereDrawbacks ?? [];
      selBoons = record.boons ?? [];
      selCam = record.cam;
      camOverride = record.camOverride ?? false;
      manualGDV = record.manualGDV ?? 0;
      manualBoonSlots = record.manualBoonSlots ?? 0;
      const nameInput = document.getElementById("tb-name") as HTMLInputElement;
      if (nameInput) nameInput.value = record.name ?? "";
      onUpdate(true);
    }

    function deleteSavedTradition(id: string) {
      if (!confirm("Delete this saved tradition? This cannot be undone.")) return;
      const saved = loadSavedTraditions().filter((s: any) => s.id !== id);
      try { localStorage.setItem(SAVED_KEY, JSON.stringify(saved)); } catch {}
      populateSavedDropdown();
    }

    function resetDefaults() {
      if (selDrawbacks.length || selSphereDrawbacks.length || selBoons.length) {
        if (!confirm("Reset the builder to defaults? Your current selections will be lost. (Saved traditions are not affected.)")) return;
      }
      selDrawbacks = [];
      selSphereDrawbacks = [];
      selBoons = [];
      selCam = undefined;
      camOverride = false;
      manualGDV = 0;
      manualBoonSlots = 0;
      detailedExport = false;
      const nameInput = document.getElementById("tb-name") as HTMLInputElement;
      if (nameInput) nameInput.value = "";
      const detCheck = document.getElementById("tb-detailed-export") as HTMLInputElement;
      if (detCheck) detCheck.checked = false;
      const savedSel = document.getElementById("tb-saved-traditions") as HTMLSelectElement;
      if (savedSel) savedSel.value = "";
      onUpdate(true);
    }

    function exportCatalog() {
      const saved = loadSavedTraditions();
      if (saved.length === 0) { alert("No saved traditions to export."); return; }
      const blob = new Blob([JSON.stringify({ schemaVersion: SCHEMA_VERSION, traditions: saved }, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `casting-traditions-backup-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function importCatalog(file: File) {
      const reader = new FileReader();
      reader.onload = () => {
        try {
          const data = JSON.parse(reader.result as string);
          if (!data.traditions || !Array.isArray(data.traditions)) throw new Error("Invalid format");
          const mode = confirm("Merge imported traditions with existing saved traditions?\n\nOK = Merge\nCancel = Replace all") ? "merge" : "replace";
          let existing: any[] = mode === "merge" ? loadSavedTraditions() : [];
          const existingIds = new Set(existing.map((s: any) => s.id));
          for (const trad of data.traditions) {
            if (existingIds.has(trad.id)) {
              if (confirm(`Saved tradition "${trad.name}" already exists. Overwrite it?`)) {
                existing = existing.filter((s: any) => s.id !== trad.id);
                existingIds.delete(trad.id);
              }
            }
            existing.push(trad);
          }
          try { localStorage.setItem(SAVED_KEY, JSON.stringify(existing)); saveStatus = "Imported"; } catch { saveStatus = "Import failed"; }
          updateSaveStatus();
          populateSavedDropdown();
        } catch {
          alert("Invalid catalog file.");
        }
      };
      reader.readAsText(file);
    }

    function escapeHtml(s: string): string {
      return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
    }

    // ── Update cycle ──────────────────────────────────────
    function onUpdate(fullRender = false, syncUrl = true) {
      if (saveStatus === "Saved") { saveStatus = "Unsaved changes"; updateSaveStatus(); }
      renderCamOptions();
      if (fullRender) {
        syncCamRadio();
        renderGeneralDrawbacks();
        renderSphereDrawbacks();
      }
      renderBoons();
      renderSummary();
      syncActionButtons();
      if (syncUrl) encodeState();
    }

    // ── Wire UI events ────────────────────────────────────
    root.querySelectorAll<HTMLInputElement>('input[name="tb-cam"]').forEach((r) => {
      r.addEventListener("change", () => {
        selCam = r.value;
        onUpdate();
      }, { signal });
    });

    document.getElementById("tb-cam-lock")?.addEventListener("click", () => {
      camOverride = !camOverride;
      onUpdate(true);
    }, { signal });

    document.getElementById("tb-name")?.addEventListener("input", () => onUpdate(), { signal });

    document.getElementById("tb-drawback-search")?.addEventListener("input", () => renderGeneralDrawbacks(), { signal });
    document.getElementById("tb-boon-search")?.addEventListener("input", () => renderBoons(), { signal });
    document.getElementById("tb-sphere-filter")?.addEventListener("change", () => renderSphereDrawbacks(), { signal });
    document.getElementById("tb-sphere-drawback-search")?.addEventListener("input", () => renderSphereDrawbacks(), { signal });

    document.getElementById("tb-detailed-export")?.addEventListener("change", () => {
      detailedExport = (document.getElementById("tb-detailed-export") as HTMLInputElement)?.checked ?? false;
      updateExport(getSelection(), getTraditionData());
    }, { signal });

    root.querySelectorAll<HTMLButtonElement>(".builder-export-tab").forEach((btn) => {
      btn.addEventListener("click", () => {
        root.querySelectorAll(".builder-export-tab").forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        exportMode = (btn.dataset.export as "md" | "json") ?? "md";
        updateExport(getSelection(), getTraditionData());
      }, { signal });
    });

    document.getElementById("tb-copy-btn")?.addEventListener("click", async () => {
      const ta = document.getElementById("tb-export-output") as HTMLTextAreaElement;
      if (!ta) return;
      await navigator.clipboard.writeText(ta.value).catch(() => undefined);
      const btn = document.getElementById("tb-copy-btn") as HTMLButtonElement;
      const orig = btn.textContent;
      btn.textContent = "Copied!";
      schedule(() => { btn.textContent = orig; }, 1500);
    }, { signal });

    document.getElementById("tb-save-btn")?.addEventListener("click", () => { manualSave(); }, { signal });
    document.getElementById("tb-reset-btn")?.addEventListener("click", () => resetDefaults(), { signal });

    document.getElementById("tb-saved-traditions")?.addEventListener("change", () => {
      const id = (document.getElementById("tb-saved-traditions") as HTMLSelectElement)?.value;
      if (id) loadSavedTradition(id);
    }, { signal });

    document.getElementById("tb-delete-saved")?.addEventListener("click", () => {
      const id = (document.getElementById("tb-saved-traditions") as HTMLSelectElement)?.value;
      if (id) deleteSavedTradition(id);
    }, { signal });

    document.getElementById("tb-export-catalog")?.addEventListener("click", () => exportCatalog(), { signal });
    document.getElementById("tb-import-catalog")?.addEventListener("click", () => {
      document.getElementById("tb-import-file")?.click();
    }, { signal });
    document.getElementById("tb-import-file")?.addEventListener("change", () => {
      const input = document.getElementById("tb-import-file") as HTMLInputElement;
      const file = input.files?.[0];
      if (file) importCatalog(file);
      input.value = "";
    }, { signal });

    // Manual steppers
    root.querySelectorAll<HTMLButtonElement>(".builder-stepper-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const type = btn.dataset.stepper as "gdv" | "bslots";
        const dir = btn.dataset.dir === "up" ? 1 : -1;
        adjustManual(type, dir);
      }, { signal });
    });

    // Anchor links on checklist items — switch tab then scroll
    root.addEventListener("click", (e) => {
      const anchor = (e.target as HTMLElement).closest?.(".bcl-anchor");
      if (!anchor) return;
      e.preventDefault();
      const tab = (anchor as HTMLElement).dataset.anchorTab;
      const targetId = (anchor as HTMLElement).dataset.anchorId;
      if (!tab || !targetId) return;
      const tabBtn = root.closest(".tabbed-content")?.querySelector(`[data-tab="${tab}"]`) as HTMLButtonElement | null;
      if (tabBtn) tabBtn.click();
      schedule(() => {
        const card = document.getElementById(targetId);
        if (card) card.scrollIntoView({ behavior: "smooth", block: "start" });
      }, 100);
    }, { signal });

    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest?.("[data-action-add]") as HTMLElement | null;
      if (!btn) return;
      e.preventDefault();
      const id = btn.dataset.actionAdd!;
      const kind = btn.dataset.actionKind!;
      if (kind === "drawback") {
        if (selDrawbacks.includes(id)) selDrawbacks = selDrawbacks.filter((x) => x !== id);
        else selDrawbacks.push(id);
      } else if (kind === "sphere-drawback") {
        if (selSphereDrawbacks.includes(id)) selSphereDrawbacks = selSphereDrawbacks.filter((x) => x !== id);
        else selSphereDrawbacks.push(id);
      } else if (kind === "boon") {
        if (selBoons.includes(id)) selBoons = selBoons.filter((x) => x !== id);
        else selBoons.push(id);
      }
      onUpdate(kind === "drawback" || kind === "sphere-drawback");
    }, { signal });

    function syncActionButtons() {
      const selected = new Set([...selDrawbacks, ...selSphereDrawbacks, ...selBoons]);
      document.querySelectorAll("[data-action-add]").forEach((btn) => {
        const id = (btn as HTMLElement).dataset.actionAdd!;
        btn.classList.toggle("ec-action-added", selected.has(id));
        btn.textContent = selected.has(id) ? "Added" : "Add to Builder";
      });
    }

    // ── URL state ────────────────────────────────────────
    function encodeState() {
      const params = new URLSearchParams();
      if (selDrawbacks.length) params.set("d", selDrawbacks.join(","));
      if (selSphereDrawbacks.length) params.set("sd", selSphereDrawbacks.join(","));
      if (selBoons.length) params.set("b", selBoons.join(","));
      if (selCam) params.set("cam", selCam);
      const url = new URL(window.location.href);
      for (const [k, v] of params) url.searchParams.set(k, v);
      url.hash = "builder";
      window.history.replaceState(window.history.state, "", url);
    }

    function loadFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const d = params.get("d");
      const sd = params.get("sd");
      const b = params.get("b");
      const cam = params.get("cam");
      // Only load from URL if there are actual parameters
      if (!d && !sd && !b && !cam) return false;
      if (d) selDrawbacks = d.split(",").filter(Boolean);
      if (sd) selSphereDrawbacks = sd.split(",").filter(Boolean);
      if (b) selBoons = b.split(",").filter(Boolean);
      if (cam) selCam = cam;
      return true;
    }

    // ── Init ──────────────────────────────────────────────
    loadFromUrl();

    populateTraditionDropdown();
    populateSphereFilter();
    populateSavedDropdown();
    renderGeneralDrawbacks();
    renderSphereDrawbacks();
    onUpdate(true, false);
  }

  function initializeBuilderPage() {
    cleanupTraditionBuilderPage();
    cleanupBuilderActivation();
    cleanupBuilderActivation = () => {};

    const builderTab = document.querySelector<HTMLButtonElement>('.tab[data-tab="builder"]');
    if (!builderTab) return;

    const activationController = new AbortController();
    cleanupBuilderActivation = () => activationController.abort();
    let initialized = false;
    const initializeWhenVisible = () => {
      const builder = document.querySelector<HTMLElement>(".tradition-builder");
      const builderPanel = builder?.closest<HTMLElement>(".tab-panel");
      if (initialized || !builder || !builderPanel || builderPanel.hidden) return;
      initialized = true;
      void initTraditionBuilder(builder);
    };

    builderTab.addEventListener("click", () => {
      setTimeout(initializeWhenVisible, 0);
    }, { signal: activationController.signal });
    document.addEventListener("tab-content:loaded", initializeWhenVisible, {
      signal: activationController.signal,
    });
    initializeWhenVisible();
  }

  document.addEventListener("astro:page-load", initializeBuilderPage);
  document.addEventListener("DOMContentLoaded", initializeBuilderPage, { once: true });
  if (document.readyState !== "loading") initializeBuilderPage();
</script>

