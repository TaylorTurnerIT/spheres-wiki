---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import TagBadge from '@/components/TagBadge.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { BOOK_COLLECTIONS } from '@/content.config';
import { buildOrderedTagIds } from '@/lib/tags';
import type { FeatEntry, SphereEntry, BookMeta, TagEntry } from '@/lib/types';

interface Props {
  feat: FeatEntry;
  sphere: SphereEntry;
  collEntry: any;
  sourceBook: BookMeta | undefined;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { featMap, sphereMap, bookMetaMap, tagMap } = await resolveEntries();

  const allCollEntries = new Map<string, any>();
  for (const slug of BOOK_COLLECTIONS) {
    try {
      const entries = await getCollection(slug as any);
      for (const e of entries) {
        if ((e.data as any).type !== 'tag') {
          allCollEntries.set(`${(e.data as any).type}:${(e.data as any).id}`, e);
        }
      }
    } catch {}
  }

  const paths = [];
  for (const [, feat] of featMap) {
    if (feat.system !== 'power') continue;

    // Primary path
    const sphere = [...sphereMap.values()].find(s => s.id === feat.sphere && s.system === 'power');
    if (sphere) {
      paths.push({
        params: { sphere: sphere.id, feat: feat.id },
        props: { feat, sphere, collEntry: allCollEntries.get(`feat:${feat.id}`), sourceBook: bookMetaMap.get(feat.sourceBook), tagMap, bookMetaMap },
      });
    }

    // Dual sphere path
    if (feat.dualSphere) {
      const dualSphere = [...sphereMap.values()].find(s => s.id === feat.dualSphere && s.system === 'power');
      if (dualSphere) {
        paths.push({
          params: { sphere: dualSphere.id, feat: feat.id },
          props: { feat, sphere: dualSphere, collEntry: allCollEntries.get(`feat:${feat.id}`), sourceBook: bookMetaMap.get(feat.sourceBook), tagMap, bookMetaMap },
        });
      }
    }
  }

  return paths;
}

const { feat, sphere, collEntry, sourceBook, tagMap, bookMetaMap } = Astro.props;

const FeatContent = collEntry ? (await render(collEntry)).Content : null;
---
<WikiPage title={`${feat.name} — ${sphere.name} — Spheres of Power Wiki`} activeNamespace="power">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url("/power/")} data-astro-prefetch="hover">Spheres of Power</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url(`/power/${sphere.id}/`)} data-astro-prefetch="hover">{sphere.name}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{feat.name}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">
      <h1
        class="page-title power"
        id="overview"
        transition:name={`entry-title-${feat.id}`}
        data-pagefind-weight="2.0"
        data-pagefind-meta={`title:${feat.name}`}
        data-pagefind-meta={`sphere:${sphere.name}`}
        
        data-pagefind-filter="system:Spheres of Power"
        
        data-pagefind-filter="type:feat"
        data-pagefind-meta={`tags:${feat.tags.join(', ')}`}
      >
        {feat.name}
      </h1>
      <span data-pagefind-meta="system:Spheres of Power" hidden></span>
        <span data-pagefind-meta="type:feat" hidden></span>
      <div class="talent-page-meta">
        {buildOrderedTagIds(feat, bookMetaMap, tagMap, { includeSphere: true, currentSphereId: sphere.id })
          .map(tagId => <TagBadge tagId={tagId} tagMap={tagMap} bookMetaMap={bookMetaMap} />)
        }
      </div>
      <hr class="page-title-rule" />

      {FeatContent
        ? <div class="entry-description"><FeatContent /></div>
        : <p class="entry-description"><em>Description coming soon.</em></p>
      }
    </div>

    <aside class="right-rail" aria-label="Page contents">
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>
