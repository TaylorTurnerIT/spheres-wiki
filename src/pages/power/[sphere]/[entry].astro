---
import { render } from 'astro:content';
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import TagBadge from '@/components/TagBadge.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { BOOK_COLLECTIONS } from '@/content.config';
import { buildOrderedTagIds } from '@/lib/tags';
import type { TalentEntry, SphereEntry, ClassEntry, ClassFeatureEntry, BookMeta, TagEntry } from '@/lib/types';

interface Props {
  entry: TalentEntry | ClassFeatureEntry;
  sphere: SphereEntry | ClassEntry;
  collEntry: any;
  sourceBook: BookMeta | undefined;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { talentMap, sphereMap, classMap, classFeatureMap, bookMetaMap, tagMap } = await resolveEntries();

  const allCollEntries = new Map<string, any>();
  for (const slug of BOOK_COLLECTIONS) {
    try {
      const entries = await getCollection(slug as any);
      for (const e of entries) {
        if ((e.data as any).type !== 'tag') {
          allCollEntries.set((e.data as any).id, e);
        }
      }
    } catch {}
  }

  const paths = [];

  // Talents
  for (const [, talent] of talentMap) {
    if (talent.system !== 'power') continue;
    const sphere = [...sphereMap.values()].find(s => s.id === talent.sphere && s.system === 'power');
    if (sphere) {
      paths.push({
        params: { sphere: sphere.id, entry: talent.id },
        props: { entry: talent, sphere, collEntry: allCollEntries.get(talent.id), sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
      });
    }
    if (talent.dualSphere) {
      const dualSphere = [...sphereMap.values()].find(s => s.id === talent.dualSphere && s.system === 'power');
      if (dualSphere) {
        paths.push({
          params: { sphere: dualSphere.id, entry: talent.id },
          props: { entry: talent, sphere: dualSphere, collEntry: allCollEntries.get(talent.id), sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
        });
      }
    }
  }

  // Class Features
  for (const [, feature] of classFeatureMap) {
    if (feature.system !== 'power') continue;
    const cls = [...classMap.values()].find(c => c.id === feature.class && c.system === 'power');
    if (cls) {
      paths.push({
        params: { sphere: cls.id, entry: feature.id },
        props: { entry: feature, sphere: cls, collEntry: allCollEntries.get(feature.id), sourceBook: bookMetaMap.get(feature.sourceBook), tagMap, bookMetaMap },
      });
    }
  }

  return paths;
}

const { entry, sphere, collEntry, sourceBook, tagMap, bookMetaMap } = Astro.props;

const EntryContent = collEntry ? (await render(collEntry)).Content : null;
---
<WikiPage title={`${entry.name} — ${sphere.name} — Spheres of Power Wiki`} activeNamespace="power">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url("/power/")} data-astro-prefetch="hover">Spheres of Power</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url(`/power/${sphere.id}/`)} data-astro-prefetch="hover">{sphere.name}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{entry.name}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">
      <div
        class="page-title power"
        id="overview"
        transition:name={`entry-title-${entry.id}`}
        data-pagefind-weight="10"
        data-pagefind-meta={`title:${entry.name}`}
        data-pagefind-meta={`${sphere.type === 'sphere' ? 'sphere' : 'class'}:${sphere.name}`}
        data-pagefind-meta="system:Spheres of Power"
        data-pagefind-meta={`type:${entry.type}`}
        data-pagefind-meta={`tags:${entry.tags.join(', ')}`}
      >
        {entry.name}
      </div>
      <div class="talent-page-meta">
        {buildOrderedTagIds(entry, bookMetaMap, tagMap, { includeSphere: true, currentSphereId: sphere.id })
          .map(tagId => <TagBadge tagId={tagId} tagMap={tagMap} bookMetaMap={bookMetaMap} />)
        }
      </div>
      <hr class="page-title-rule" />

      {EntryContent
        ? <div class="entry-description"><EntryContent /></div>
        : <p class="entry-description"><em>Description coming soon.</em></p>
      }
    </div>

    <aside class="right-rail">
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>
