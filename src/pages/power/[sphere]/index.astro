---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import type { TocItem } from '@/components/TableOfContents.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { BOOK_COLLECTIONS } from '@/content/config';
import { splitBodyOnMarkers, renderMarkdownFragment } from '@/lib/renderBody';
import type { SphereEntry, ClassEntry, TalentEntry, FeatEntry, BookMeta } from '@/lib/types';

interface Props {
  kind: 'sphere' | 'class';
  sphere: SphereEntry | undefined;
  cls: ClassEntry | undefined;
  base: TalentEntry[];
  basic: TalentEntry[];
  advanced: TalentEntry[];
  feats: FeatEntry[];
  categories: Array<{ label: string; id: string; entries: Array<{ id: string; type: 'talent' | 'feat' }> }>;
  mainCollEntry: any;
  talentCollEntries: Map<string, any>;
  featCollEntries: Map<string, any>;
  sourceBook: BookMeta | undefined;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { sphereMap, classMap, talentMap, featMap, bookMetaMap } = await resolveEntries();

  const allCollEntries = new Map<string, any>();
  for (const slug of BOOK_COLLECTIONS) {
    try {
      const entries = await getCollection(slug as any);
      for (const e of entries) {
        allCollEntries.set((e.data as any).id, e);
      }
    } catch { /* empty collection */ }
  }

  const paths = [];

  for (const [, sphere] of sphereMap) {
    if (sphere.system !== 'power') continue;
    const all = [...talentMap.values()].filter(t => t.sphere === sphere.id && t.system === 'power');
    const base     = all.filter(t => t.tier === 'base').sort((a, b) => a.name.localeCompare(b.name));
    const basic    = all.filter(t => t.tier === 'basic').sort((a, b) => a.name.localeCompare(b.name));
    const advanced = all.filter(t => t.tier === 'advanced').sort((a, b) => a.name.localeCompare(b.name));
    const feats    = [...featMap.values()].filter(f => f.sphere === sphere.id && f.system === 'power').sort((a, b) => a.name.localeCompare(b.name));

    const talentCollEntries = new Map<string, any>();
    for (const t of [...base, ...basic, ...advanced]) {
      const entry = allCollEntries.get(t.id);
      if (entry) talentCollEntries.set(t.id, entry);
    }

    const featCollEntries = new Map<string, any>();
    for (const f of feats) {
      const entry = allCollEntries.get(f.id);
      if (entry) featCollEntries.set(f.id, entry);
    }

    // Dynamic Categorization
    type CategoryResult = { label: string; id: string; entries: Array<{ id: string; type: 'talent' | 'feat' }> };
    const categories: CategoryResult[] = [];
    const usedIds = new Set<string>();

    if (sphere.categoryDefinitions && sphere.categoryDefinitions.length > 0) {
      for (const def of sphere.categoryDefinitions) {
        const categoryEntries: Array<{ id: string; type: 'talent' | 'feat' }> = [];

        // Filter talents
        for (const t of all) {
          const tierMatch = !def.tiers || def.tiers.includes(t.tier);
          const tagMatch = !def.tags || def.tags.some(tag => t.tags.includes(tag));
          const excludeMatch = !def.excludeTags || !def.excludeTags.some(tag => t.tags.includes(tag));

          if (tierMatch && tagMatch && excludeMatch) {
            categoryEntries.push({ id: t.id, type: 'talent' });
            usedIds.add(t.id);
          }
        }

        // Filter feats
        for (const f of feats) {
          const tierMatch = !def.tiers || def.tiers.includes('feat');
          const tagMatch = !def.tags || def.tags.some(tag => f.tags.includes(tag));
          const excludeMatch = !def.excludeTags || !def.excludeTags.some(tag => f.tags.includes(tag));

          if (tierMatch && tagMatch && excludeMatch) {
            categoryEntries.push({ id: f.id, type: 'feat' });
            usedIds.add(f.id);
          }
        }

        if (categoryEntries.length > 0) {
          categories.push({
            label: def.label,
            id: def.label.toLowerCase().replace(/\s+/g, '-'),
            entries: categoryEntries
          });
        }
      }

      // Add remaining talents/feats that weren't categorized
      const remaining: Array<{ id: string; type: 'talent' | 'feat' }> = [];
      for (const t of all) { if (!usedIds.has(t.id)) remaining.push({ id: t.id, type: 'talent' }); }
      for (const f of feats) { if (!usedIds.has(f.id)) remaining.push({ id: f.id, type: 'feat' }); }

      if (remaining.length > 0) {
        categories.push({ label: 'Other Talents', id: 'other-talents', entries: remaining });
      }
    } else {
      // Default fallback if no categoryDefinitions
      if (basic.length > 0) categories.push({ label: 'Basic Talents', id: 'basic-talents', entries: basic.map(t => ({ id: t.id, type: 'talent' })) });
      if (advanced.length > 0) categories.push({ label: 'Advanced Talents', id: 'advanced-talents', entries: advanced.map(t => ({ id: t.id, type: 'talent' })) });
      if (feats.length > 0) categories.push({ label: 'Feats', id: 'feats', entries: feats.map(f => ({ id: f.id, type: 'feat' })) });
    }

    paths.push({
      params: { sphere: sphere.id },
      props: {
        kind: 'sphere' as const,
        sphere,
        cls: undefined,
        base,
        basic,
        advanced,
        feats,
        categories,
        mainCollEntry: allCollEntries.get(sphere.id),
        talentCollEntries,
        featCollEntries,
        sourceBook: bookMetaMap.get(sphere.sourceBook),
        bookMetaMap,
      },
    });
  }

  for (const [, cls] of classMap) {
    if (cls.system !== 'power') continue;
    paths.push({
      params: { sphere: cls.id },
      props: {
        kind: 'class' as const,
        sphere: undefined,
        cls,
        base: [],
        basic: [],
        advanced: [],
        feats: [],
        mainCollEntry: allCollEntries.get(cls.id),
        talentCollEntries: new Map(),
        featCollEntries: new Map(),
        sourceBook: bookMetaMap.get(cls.sourceBook),
        bookMetaMap,
      },
    });
  }

  return paths;
}

const { kind, sphere, cls, base, basic, advanced, feats, categories, mainCollEntry, talentCollEntries, featCollEntries, sourceBook, bookMetaMap } = Astro.props;
const { talentMap, featMap } = await resolveEntries();
const entryName = kind === 'sphere' ? sphere!.name : cls!.name;

const FIRST_PARTY = new Set(['Drop Dead Studios', 'Diamond Recreational Studios']);
const is3pp = (sbSlug: string) => {
  const pub = bookMetaMap.get(sbSlug)?.publisher;
  return !!pub && !FIRST_PARTY.has(pub);
};

// For sphere pages: split body on [TalentName] markers and render each segment
type RenderedSegment = { type: 'markdown'; html: string } | { type: 'base-ability'; id: string };
const bodySegments: RenderedSegment[] = [];
if (kind === 'sphere' && mainCollEntry) {
  for (const seg of splitBodyOnMarkers(mainCollEntry.body)) {
    if (seg.type === 'markdown') {
      bodySegments.push({ type: 'markdown', html: await renderMarkdownFragment(seg.text) });
    } else {
      bodySegments.push(seg);
    }
  }
}

// For class pages: render full body as-is
const MainContent = (kind === 'class' && mainCollEntry)
  ? (await mainCollEntry.render()).Content
  : null;

const talentRendered: Array<{ id: string; Content: any }> = [];
for (const [id, entry] of talentCollEntries) {
  const { Content } = await entry.render();
  talentRendered.push({ id, Content });
}

const featRendered: Array<{ id: string; Content: any }> = [];
for (const [id, entry] of featCollEntries) {
  const { Content } = await entry.render();
  featRendered.push({ id, Content });
}

// Build ToC
const tocItems: TocItem[] = [
  {
    id: 'overview',
    label: 'Overview',
    sub: base.length > 0 ? base.map(t => ({ id: t.id, label: t.name })) : undefined,
  },
  ...categories.map(cat => ({
    id: cat.id,
    label: cat.label,
    sub: cat.entries.map(e => {
      const talent = [...talentMap.values()].find(t => t.id === e.id);
      const feat = [...featMap.values()].find(f => f.id === e.id);
      return { id: e.id, label: talent?.name || feat?.name || 'Unknown' };
    })
  }))
];
---
<WikiPage title={`${entryName} — Spheres of Power Wiki`} activeNamespace="power">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url("/power/")} data-astro-prefetch="hover">Spheres of Power</a>
    <span class="breadcrumb-sep">›</span>
    <span>{entryName}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">

      {kind === 'sphere' && sphere && (
        <>
          <div
            class="page-title power"
            id="overview"
            data-pagefind-weight="10"
            data-pagefind-meta={`title:${sphere.name}`}
            data-pagefind-meta="type:sphere"
            data-pagefind-meta="system:Spheres of Power"
          >
            <svg class="si page-title-icon" aria-hidden="true"><use href={`#si-${sphere.icon}`} /></svg>
            {sphere.name}
          </div>
          <hr class="page-title-rule" />

          {bodySegments.map(seg => {
            if (seg.type === 'markdown') {
              return <div class="entry-description" set:html={seg.html} />;
            }
            const t = base.find(b => b.id === seg.id);
            const tContent = talentRendered.find(r => r.id === seg.id);
            return t ? (
              <div class="base-ability-block" id={t.id} data-pagefind-weight="0.5">
                <div class="base-ability-header">
                  <a href={url(`/power/${sphere!.id}/${t.id}/`)} class="base-ability-name" data-astro-prefetch="hover">{t.name}</a>
                  <span class="base-ability-badge">Base Ability</span>
                </div>
                {tContent && <div class="talent-body"><tContent.Content /></div>}
              </div>
            ) : null;
          })}

          {categories.map(cat => (
            <div style="margin-top: 18px;">
              <div class="section-heading">
                <span class="section-heading-text" id={cat.id}>{cat.label}</span>
                <div class="section-heading-rule"></div>
              </div>
              <div class="talent-list">
                {cat.entries.map(e => {
                  const talent = [...talentMap.values()].find(t => t.id === e.id);
                  const feat = [...featMap.values()].find(f => f.id === e.id);
                  const entry = talent || feat;
                  if (!entry) return null;

                  const content = talent ? talentRendered.find(r => r.id === e.id) : featRendered.find(r => r.id === e.id);
                  const extBook = entry.sourceBook !== sphere!.sourceBook ? bookMetaMap.get(entry.sourceBook) : undefined;
                  const tierLabel = talent ? (talent.tier.charAt(0).toUpperCase() + talent.tier.slice(1)) : 'Feat';

                  return (
                    <div class="talent-entry" id={entry.id} data-pagefind-weight="0.5">
                      <div class="talent-header">
                        <div class="talent-header-top">
                          <a
                            href={url(`/power/${sphere!.id}/${talent ? '' : 'feats/'}${entry.id}/`)}
                            class="talent-name"
                            data-astro-prefetch="hover"
                          >
                            {entry.name}
                          </a>
                          {extBook && <span class="talent-source">{extBook.title}</span>}
                        </div>
                        <div class="talent-header-bottom">
                          <span class={`talent-tier ${talent ? talent.tier : 'feat'}`}>{tierLabel}</span>
                          {is3pp(entry.sourceBook) && <span class="talent-tag" data-tag="3pp">3PP</span>}
                          {entry.tags.map(tag => <span class="talent-tag" data-tag={tag.toLowerCase()}>{tag}</span>)}
                        </div>
                      </div>
                      {content && <div class="talent-body"><content.Content /></div>}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </>
      )}
      {kind === 'class' && cls && (
        <>
          <div
            class="page-title power"
            id="overview"
            data-pagefind-weight="10"
            data-pagefind-meta={`title:${cls.name}`}
            data-pagefind-meta="type:class"
            data-pagefind-meta="system:Spheres of Power"
          >
            {cls.name}
          </div>
          <hr class="page-title-rule" />
          {MainContent && <div class="entry-description"><MainContent /></div>}
        </>
      )}

    </div>

    <aside class="right-rail">
      <TableOfContents items={tocItems} />
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>
