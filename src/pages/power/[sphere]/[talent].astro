---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import TagBadge from '@/components/TagBadge.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { BOOK_COLLECTIONS } from '@/content/config';
import { buildOrderedTagIds } from '@/lib/tags';
import type { TalentEntry, SphereEntry, BookMeta, TagEntry } from '@/lib/types';

interface Props {
  talent: TalentEntry;
  sphere: SphereEntry;
  collEntry: any;
  sourceBook: BookMeta | undefined;
  tagMap: Map<string, TagEntry>;
  bookMetaMap: Map<string, BookMeta>;
}

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { talentMap, sphereMap, bookMetaMap, tagMap } = await resolveEntries();

  const allCollEntries = new Map<string, any>();
  for (const slug of BOOK_COLLECTIONS) {
    try {
      const entries = await getCollection(slug as any);
      for (const e of entries) {
        allCollEntries.set((e.data as any).id, e);
      }
    } catch {}
  }

  const paths = [];
  for (const [, talent] of talentMap) {
    if (talent.system !== 'power') continue;

    // Primary path
    const sphere = [...sphereMap.values()].find(s => s.id === talent.sphere && s.system === 'power');
    if (sphere) {
      paths.push({
        params: { sphere: sphere.id, talent: talent.id },
        props: { talent, sphere, collEntry: allCollEntries.get(talent.id), sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
      });
    }

    // Dual sphere path
    if (talent.dualSphere) {
      const dualSphere = [...sphereMap.values()].find(s => s.id === talent.dualSphere && s.system === 'power');
      if (dualSphere) {
        paths.push({
          params: { sphere: dualSphere.id, talent: talent.id },
          props: { talent, sphere: dualSphere, collEntry: allCollEntries.get(talent.id), sourceBook: bookMetaMap.get(talent.sourceBook), tagMap, bookMetaMap },
        });
      }
    }
  }

  return paths;
}

const { talent, sphere, collEntry, sourceBook, tagMap, bookMetaMap } = Astro.props;

const TalentContent = collEntry ? (await collEntry.render()).Content : null;
---
<WikiPage title={`${talent.name} — ${sphere.name} — Spheres of Power Wiki`} activeNamespace="power">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url("/power/")} data-astro-prefetch="hover">Spheres of Power</a>
    <span class="breadcrumb-sep">›</span>
    <a href={url(`/power/${sphere.id}/`)} data-astro-prefetch="hover">{sphere.name}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{talent.name}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">
      <div
        class="page-title power"
        id="overview"
        data-pagefind-weight="10"
        data-pagefind-meta={`title:${talent.name}`}
        data-pagefind-meta={`sphere:${sphere.name}`}
        data-pagefind-meta="system:Spheres of Power"
        data-pagefind-meta="type:talent"
        data-pagefind-meta={`tier:${talent.tier}`}
        data-pagefind-meta={`tags:${talent.tags.join(', ')}`}
      >
        {talent.name}
      </div>
      <div class="talent-page-meta">
        {buildOrderedTagIds(talent, bookMetaMap, tagMap, { includeSphere: true, currentSphereId: sphere.id })
          .map(tagId => <TagBadge tagId={tagId} tagMap={tagMap} bookMetaMap={bookMetaMap} />)
        }
      </div>
      <hr class="page-title-rule" />

      {TalentContent
        ? <div class="entry-description"><TalentContent /></div>
        : <p class="entry-description"><em>Description coming soon.</em></p>
      }
    </div>

    <aside class="right-rail">
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>
