---
import WikiPage from '@/layouts/WikiPage.astro';
import SourceBookCallout from '@/components/SourceBookCallout.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import { BOOK_COLLECTIONS } from '@/content/config';
import type { TalentEntry, SphereEntry, BookMeta } from '@/lib/types';

interface Props {
  talent: TalentEntry;
  sphere: SphereEntry;
  collEntry: any;
  sourceBook: BookMeta | undefined;
}

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const { talentMap, sphereMap, bookMetaMap } = await resolveEntries();

  const allCollEntries = new Map<string, any>();
  for (const slug of BOOK_COLLECTIONS) {
    try {
      const entries = await getCollection(slug);
      for (const e of entries) {
        allCollEntries.set(e.id.replace(/\.md$/, ''), e);
      }
    } catch {}
  }

  const paths = [];
  for (const [, talent] of talentMap) {
    if (talent.namespace !== 'power') continue;
    const sphere = [...sphereMap.values()].find(s => s.id === talent.sphere && s.namespace === 'power');
    if (!sphere) continue;
    paths.push({
      params: { sphere: sphere.id, talent: talent.id },
      props: { talent, sphere, collEntry: allCollEntries.get(talent.id), sourceBook: bookMetaMap.get(talent.sourceBook) },
    });
  }

  return paths;
}

const { talent, sphere, collEntry, sourceBook } = Astro.props;

const TalentContent = collEntry ? (await collEntry.render()).Content : null;
---
<WikiPage title={`${talent.name} — ${sphere.name} — Spheres of Power Wiki`} activeNamespace="power">

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/" data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <a href="/power/" data-astro-prefetch="hover">Spheres of Power</a>
    <span class="breadcrumb-sep">›</span>
    <a href={`/power/${sphere.id}/`} data-astro-prefetch="hover">{sphere.name}</a>
    <span class="breadcrumb-sep">›</span>
    <span>{talent.name}</span>
  </nav>

  <div class="content-columns">
    <div class="content-main">
      <div class="page-title power" id="overview">{talent.name}</div>
      <span class={`talent-tier ${talent.tier}`}>{talent.tier}</span>
      <hr class="page-title-rule" />

      {TalentContent
        ? <div class="entry-description"><TalentContent /></div>
        : <p class="entry-description"><em>Description coming soon.</em></p>
      }
    </div>

    <aside class="right-rail">
      <SourceBookCallout book={sourceBook} />
    </aside>
  </div>

</WikiPage>
