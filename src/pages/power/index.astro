---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import ResourceCard from '@/components/ResourceCard.astro';

const { sphereMap, classMap } = await resolveEntries();

const spheres = [...sphereMap.values()]
  .filter(s => s.system === 'power')
  .sort((a, b) => a.name.localeCompare(b.name));

const baseClassIds = [
  'armorist', 'elementalist', 'eliciter', 'fey-adept', 'hedgewitch',
  'incanter', 'mageknight', 'shifter', 'soul-weaver', 'symbiat',
  'thaumaturge', 'wraith'
];

const classes = [...classMap.values()]
  .filter(c => c.system === 'power' && baseClassIds.includes(c.id))
  .sort((a, b) => a.name.localeCompare(b.name));

// Prestige classes usually aren't in the baseClassIds but are power system
// For now, we'll look for anything with "Prestige" in its name or tags if possible,
// but since we don't have that yet, we'll just prep the section.
const prestigeClasses = [...classMap.values()]
  .filter(c => c.system === 'power' && !baseClassIds.includes(c.id) && c.tags?.includes('prestige'))
  .sort((a, b) => a.name.localeCompare(b.name));

---
<WikiPage title="Spheres of Power — Spheres Wiki" activeNamespace="power" pagefindIgnore={true}>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Spheres of Power</span>
  </nav>

  <h1 class="page-title power">Spheres of Power</h1>
  <hr class="page-title-rule" />

  <div class="section-heading">
    <span class="section-heading-text">Getting Started</span>
    <div class="section-heading-rule"></div>
  </div>
  <div class="power-intro">
    <ResourceCard
      name="Using Spheres of Power"
      description="Fundamental rules for casting, spell points, and caster levels."
      href={url("/power/using-spheres-of-power/")}
    >
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 14.5h8M8 1v11M4.5 5.5l3.5-3.5 3.5 3.5"/>
      </svg>
    </ResourceCard>
    <ResourceCard
      name="How to Build a Spherecaster"
      description="A step-by-step guide to creating your first magical character."
      href={url("/power/how-to-build-spherecaster/")}
    >
      <svg slot="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.5 3.5v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1zM4 6.5h8M4 9.5h5"/>
      </svg>
    </ResourceCard>
  </div>

  <div class="section-heading">
    <span class="section-heading-text">Magic Spheres</span>
    <div class="section-heading-rule"></div>
  </div>
  <div class="entry-grid sphere-grid">
    {spheres.map(s => (
      <a href={url(`/power/${s.id}/`)} class="entry-card power sphere-card" data-astro-prefetch="hover">
        <div class="entry-card-header">
          <svg class="si entry-card-icon" aria-hidden="true"><use href={`#si-${s.icon}`} /></svg>
          <span class="entry-card-name">{s.name}</span>
        </div>
      </a>
    ))}
  </div>

  <div class="section-heading">
    <span class="section-heading-text">Other Spheres</span>
    <div class="section-heading-rule"></div>
  </div>
  <div class="entry-grid other-spheres-grid">
    <a href={url("/power/bear/")} class="entry-card power sphere-card" data-astro-prefetch="hover">
      <div class="entry-card-header">
        <svg class="si entry-card-icon" aria-hidden="true"><use href="#si-bear" /></svg>
        <span class="entry-card-name">Bear</span>
      </div>
    </a>
    <a href={url("/power/technomancy/")} class="entry-card power sphere-card" data-astro-prefetch="hover">
      <div class="entry-card-header">
        <svg class="si entry-card-icon" aria-hidden="true"><use href="#si-technomancy" /></svg>
        <span class="entry-card-name">Technomancy</span>
      </div>
    </a>
  </div>

  <div class="section-heading">
    <span class="section-heading-text">Spherecaster Classes</span>
    <div class="section-heading-rule"></div>
  </div>
  <div class="entry-grid class-grid">
    {classes.map(c => (
      <a href={url(`/power/classes/${c.id}/`)} class="entry-card power" data-astro-prefetch="hover">
        <div class="entry-card-header">
          <span class="entry-card-name">{c.name}</span>
        </div>
      </a>
    ))}
  </div>

  {prestigeClasses.length > 0 && (
    <>
      <div class="section-heading">
        <span class="section-heading-text">Prestige Classes</span>
        <div class="section-heading-rule"></div>
      </div>
      <div class="entry-grid class-grid">
        {prestigeClasses.map(c => (
          <a href={url(`/power/classes/${c.id}/`)} class="entry-card power" data-astro-prefetch="hover">
            <div class="entry-card-header">
              <span class="entry-card-name">{c.name}</span>
            </div>
          </a>
        ))}
      </div>
    </>
  )}

  <div class="power-footer-grid">
    <div class="footer-section">
      <div class="section-heading">
        <span class="section-heading-text">Feats</span>
        <div class="section-heading-rule"></div>
      </div>
      <ul class="link-list">
        <li><a href={url("/power/feats/")}>General Feats</a></li>
        <li><a href={url("/power/feats/casting-feats/")}>Casting Feats</a></li>
        <li><a href={url("/power/feats/dual-sphere-feats/")}>Dual Sphere Feats</a></li>
      </ul>
    </div>

    <div class="footer-section">
      <div class="section-heading">
        <span class="section-heading-text">Equipment</span>
        <div class="section-heading-rule"></div>
      </div>
      <ul class="link-list">
        <li><a href={url("/power/equipment/")}>Magical Items</a></li>
        <li><a href={url("/power/equipment/staves/")}>Staves</a></li>
        <li><a href={url("/power/equipment/weapons/")}>Weapons & Armor</a></li>
      </ul>
    </div>

    <div class="footer-section">
      <div class="section-heading">
        <span class="section-heading-text">Rules</span>
        <div class="section-heading-rule"></div>
      </div>
      <ul class="link-list">
        <li><a href={url("/power/casting-traditions/")}>Casting Traditions</a></li>
        <li><a href={url("/power/oaths/")}>Oaths</a></li>
        <li><a href={url("/power/wild-magic/")}>Wild Magic</a></li>
      </ul>
    </div>
  </div>

</WikiPage>

<style>
  .power-intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .sphere-grid {
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
    margin-bottom: 40px;
  }

  .other-spheres-grid {
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
    margin-bottom: 40px;
  }

  .class-grid {
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 12px;
    margin-bottom: 40px;
  }

  .entry-card.power {
    border-left-width: 4px;
    background: var(--clr-bg);
    transition: all 0.2s ease;
  }

  .entry-card.power:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(23, 75, 147, 0.12);
    border-color: var(--clr-power);
    background: var(--clr-surface);
  }

  .entry-card.power .entry-card-name {
    color: var(--clr-power);
    font-size: var(--fs-md);
  }

  .power-footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 40px;
    margin-top: 24px;
    margin-bottom: 64px;
    padding: 32px;
    background: color-mix(in srgb, var(--clr-power) 5%, var(--clr-surface));
    border-radius: 8px;
    border: 1px solid var(--clr-border);
  }

  .footer-section .section-heading {
    margin-top: 0;
  }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .link-list li {
    margin-bottom: 10px;
  }

  .link-list a {
    color: var(--clr-power);
    text-decoration: none;
    font-weight: 600;
    display: inline-block;
    transition: transform 0.15s ease;
  }

  .link-list a:hover {
    transform: translateX(4px);
    color: color-mix(in srgb, var(--clr-power) 80%, black);
  }
</style>
