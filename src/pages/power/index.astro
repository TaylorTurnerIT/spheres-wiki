---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';

const { sphereMap, classMap } = await resolveEntries();

const spheres = [...sphereMap.values()]
  .filter(s => s.system === 'power')
  .sort((a, b) => a.name.localeCompare(b.name));

const classes = [...classMap.values()]
  .filter(c => c.system === 'power')
  .sort((a, b) => a.name.localeCompare(b.name));
---
<WikiPage title="Spheres of Power — Spheres Wiki" activeNamespace="power" pagefindIgnore={true}>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Spheres of Power</span>
  </nav>

  <h1 class="page-title power">Spheres of Power</h1>
  <hr class="page-title-rule" />

  <div class="power-top">
    <div class="power-spheres">
      <div class="section-heading">
        <span class="section-heading-text">Magic Spheres</span>
        <div class="section-heading-rule"></div>
      </div>
      <div class="entry-grid sphere-grid">
        {spheres.map(s => (
          <a href={url(`/power/${s.id}/`)} class="entry-card power sphere-card" data-astro-prefetch="hover">
            <div class="entry-card-header">
              <svg class="si entry-card-icon" aria-hidden="true"><use href={`#si-${s.icon}`} /></svg>
              <span class="entry-card-name">{s.name}</span>
            </div>
          </a>
        ))}
      </div>
    </div>

    {classes.length > 0 && (
      <div class="power-classes">
        <div class="section-heading">
          <span class="section-heading-text">Spherecaster Classes</span>
          <div class="section-heading-rule"></div>
        </div>
        <div class="entry-grid class-grid">
          {classes.map(c => (
            <a href={url(`/power/classes/${c.id}/`)} class="entry-card power" data-astro-prefetch="hover">
              <div class="entry-card-header">
                <span class="entry-card-name">{c.name}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

</WikiPage>

<style>
  .power-top {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 24px;
    align-items: start;
  }

  .class-grid {
    grid-template-columns: 1fr;
  }

  @media (max-width: 900px) {
    .power-top {
      grid-template-columns: 1fr;
    }
  }
</style>
