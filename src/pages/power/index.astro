      <circle cx="778" cy="20"  r="1.2" fill="#7AABFF" opacity=".65"/>
      <circle cx="755" cy="74"  r="1.0" fill="#9ABFFF" opacity=".5"/>
      <circle cx="732" cy="36"  r="1.1" fill="#7AABFF" opacity=".6"/>
      <circle cx="770" cy="108" r="0.9" fill="#9ABFFF" opacity=".45"/>
      <circle cx="712" cy="94"  r="1.0" fill="#7AABFF" opacity=".5"/>
      <circle cx="785" cy="55"  r="0.8" fill="#9ABFFF" opacity=".4"/>
      <circle cx="690" cy="18"  r="1.1" fill="#7AABFF" opacity=".55"/>
      <circle cx="745" cy="127" r="1.0" fill="#9ABFFF" opacity=".35"/>
    </svg>
  </div>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Spheres of Power</span>
  </nav>

  <h1 class="page-title power">Spheres of Power</h1>
  <p>Spheres of Power is a unique magic system created by Drop Dead Studios for use with the Pathfinder Roleplaying Game. In this variant system, players choose their magical abilities from among twenty different spheres, spending Magic Talents to create a uniquely customized character. Spheres of Power is more about what you can do than what you can't — it gives you the tools you need to create a character, then lets you decide how to flavor it.</p>


  <!-- <div class="section-heading">
    <span class="section-heading-text">Getting Started</span>
    <div class="section-heading-rule"></div>
  </div> -->
  <hr class="page-title-rule" />
  <div class="gs-grid">
    <a href={url("/power/using-spheres-of-power/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 3h5a1 1 0 0 1 1 1v9H2V3zM14 3H9a1 1 0 0 0-1 1v9h6V3z"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">Using Spheres of Power</div>
        <div class="gs-card-desc">Fundamental rules for casting, spell points, and caster levels.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
    <a href={url("/power/how-to-build-spherecaster/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 3.5v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1zM4 6.5h8M4 9.5h5"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">How to Build a Spherecaster</div>
        <div class="gs-card-desc">A step-by-step guide to creating your first magical character.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
  </div>
  <hr class="page-title-rule" />

  <div class="section-heading">
    <span class="section-heading-text">Magic Spheres</span>
    <div class="section-heading-rule"></div>
  </div>
  <SphereBadgeGrid spheres={spheres} system="power" />

  <SphereBadgeGrid className="other-badge-grid">
    <SphereBadge id="bear" name="Bear" icon="bear" system="power" badge="April Fools" />
    <SphereBadge id="technomancy" name="Technomancy" icon="technomancy" system="power" badge="3PP" />
  </SphereBadgeGrid>

  <div class="classes-and-links">
    <div class="class-column">
      <div class="section-heading" style="margin-top: 0;">
        <span class="section-heading-text">Spherecaster Classes</span>
        <div class="section-heading-rule"></div>
      </div>
      <div class="class-lists">
      {classTiers.map(tier => {
        const tierClasses = tier.ids.map(id => classById.get(id)).filter(Boolean);
        return tierClasses.length > 0 && (
          <div class="class-tier-group">
            <div class="class-tier-label">{tier.label}</div>
            <div class="class-roster">
              {tierClasses.map(c => (
                <a href={url(`/power/classes/${c!.id}/`)} class="class-item" data-astro-prefetch="hover">
                  <div class="class-item-header">
                    <span class="class-item-name">{c!.name}</span>
                  </div>
                  {classDescs[c!.id] && <p class="class-item-desc">{classDescs[c!.id]}</p>}
                </a>
              ))}
            </div>
          </div>
        );
      })}

      {prestigeClasses.length > 0 && (
        <div class="class-tier-group">
          <div class="class-tier-label">Prestige Classes</div>
          <div class="class-roster">
            {prestigeClasses.map(c => (
              <a href={url(`/power/classes/${c.id}/`)} class="class-item" data-astro-prefetch="hover">
                <div class="class-item-header">
                  <span class="class-item-name">{c.name}</span>
                </div>
                {classDescs[c.id] && <p class="class-item-desc">{classDescs[c.id]}</p>}
              </a>
            ))}
          </div>
        </div>
      )}
      </div>
    </div>

    <div class="quick-links-column">
      <div class="section-heading" style="margin-top: 0;">
        <span class="section-heading-text">Quick Links</span>
        <div class="section-heading-rule"></div>
      </div>
      <div class="quick-links-grid">
      <div class="quick-links-group">
        <h3 class="quick-links-heading">Feats</h3>
        <ul class="quick-links-list">
          <li><a href={url("/power/feats/")}>General Feats</a></li>
          <li><a href={url("/power/feats/casting-feats/")}>Casting Feats</a></li>
          <li><a href={url("/power/feats/dual-sphere-feats/")}>Dual Sphere Feats</a></li>
        </ul>
      </div>
      <div class="quick-links-group">
        <h3 class="quick-links-heading">Equipment</h3>
        <ul class="quick-links-list">
          <li><a href={url("/power/equipment/")}>Magical Items</a></li>
          <li><a href={url("/power/equipment/staves/")}>Staves</a></li>
          <li><a href={url("/power/equipment/weapons/")}>Weapons &amp; Armor</a></li>
        </ul>
      </div>
      <div class="quick-links-group">
        <h3 class="quick-links-heading">Rules</h3>
        <ul class="quick-links-list">
          <li><a href={url("/power/casting-traditions/")}>Casting Traditions</a></li>
          <li><a href={url("/power/oaths/")}>Oaths</a></li>
          <li><a href={url("/power/wild-magic/")}>Wild Magic</a></li>
        </ul>
      </div>
    </div>
    </div>
  </div>

</WikiPage>

