---
import { url } from "@/lib/url";
import WikiPage from '@/layouts/WikiPage.astro';
import { resolveEntries } from '@/lib/resolveEntries';

const { sphereMap, classMap } = await resolveEntries();

const spheres = [...sphereMap.values()]
  .filter(s => s.system === 'power')
  .sort((a, b) => a.name.localeCompare(b.name));

const baseClassIds = [
  'armorist', 'elementalist', 'eliciter', 'fey-adept', 'hedgewitch',
  'incanter', 'mageknight', 'shifter', 'soul-weaver', 'symbiat',
  'thaumaturge', 'wraith'
];

const classes = [...classMap.values()]
  .filter(c => c.system === 'power' && baseClassIds.includes(c.id))
  .sort((a, b) => a.name.localeCompare(b.name));

const prestigeClasses = [...classMap.values()]
  .filter(c => c.system === 'power' && !baseClassIds.includes(c.id) && c.tags?.includes('prestige'))
  .sort((a, b) => a.name.localeCompare(b.name));

const classDescs: Record<string, string> = {
  'armorist':     'Focuses on summoning magical weapons and armor to suit the task at hand.',
  'mageknight':   'Essentially a Magic Swordsman, with natural resilience against magical effects and martial techniques powered by Spell Points.',
  'elementalist': 'Focuses on manipulating one or more elements, specializing in the Destruction sphere.',
  'eliciter':     'Focuses on the use of the Mind Sphere to dominate enemies and bend them to your will.',
  'hedgewitch':   'Built around Paths — thematic combinations of powers that can be mixed to create a uniquely talented individual.',
  'shifter':      'Focuses on the Alteration Sphere, with unmatched ability to take and exploit different forms.',
  'symbiat':      'Possessed by a spirit granting control of the Mind and Telekinesis spheres, excelling as a battlefield leader.',
  'wraith':       'Excels in a variety of areas thanks to its choice of a Haunt Path and a suite of supernatural Wraith Haunts.',
  'fey-adept':    'Specializes in the Illusion Sphere, with the ability to imitate other powers through Shadowstuff.',
  'incanter':     'Not so much a class as a toolkit — trades class abilities for more Magic Talents and casting-focused feats than anyone else.',
  'soul-weaver':  'An expert in the use of Life and Death, with a particular emphasis on summoning and bolstering the spirits of the dead.',
  'thaumaturge':  'A dedicated specialist — knows fewer Magic Talents but can enhance and break the limits of what they focus on.',
};

const classTiers = [
  { label: 'Low Casters',  ids: ['armorist', 'mageknight'] },
  { label: 'Mid Casters',  ids: ['elementalist', 'eliciter', 'hedgewitch', 'shifter', 'symbiat', 'wraith'] },
  { label: 'High Casters', ids: ['fey-adept', 'incanter', 'soul-weaver', 'thaumaturge'] },
];

const classById = new Map(
  [...classMap.values()].filter(c => c.system === 'power').map(c => [c.id, c])
);
---
<WikiPage title="Spheres of Power — Spheres Wiki" activeNamespace="power" pagefindIgnore={true}>

  <div class="power-banner" aria-hidden="true">
    <svg viewBox="0 0 800 140" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="pwrBannerGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#1E60BE" stop-opacity="0.32"/>
          <stop offset="100%" stop-color="#0D2850" stop-opacity="0"/>
        </radialGradient>
      </defs>
      <rect width="800" height="140" fill="#0D2850"/>
      <rect width="800" height="140" fill="url(#pwrBannerGlow)"/>
      <!-- Wide orbital ellipses -->
      <!-- <ellipse cx="400" cy="70" rx="345" ry="46" fill="none" stroke="#2A5C9E" stroke-width="0.5" opacity="0.22"/> -->
      <!-- <ellipse cx="400" cy="70" rx="265" ry="33" fill="none" stroke="#3A6EB5" stroke-width="0.5" opacity="0.2" transform="rotate(-15 400 70)"/> -->
      <!-- <ellipse cx="400" cy="70" rx="185" ry="23" fill="none" stroke="#4A80C8" stroke-width="0.6" opacity="0.26" transform="rotate(20 400 70)"/> -->
      <!-- Central orb scaled up from IntroCard (scale 1.9x, centered at 400,70) -->
      <g transform="translate(400,70) scale(1.9) translate(-100,-40)">
        <circle cx="100" cy="40" r="30" fill="#174B93" opacity=".35"/>
        <circle cx="100" cy="40" r="22" fill="#1E60BE" opacity=".4"/>
        <path d="M 76 40 A 24 9 0 0 1 124 40" fill="none" stroke="#5B8ED4" stroke-width="1" opacity=".45" transform="rotate(-35 100 40)"/>
        <circle cx="100" cy="40" r="13" fill="#2E6FD6" opacity=".95"/>
        <circle cx="100" cy="40" r="8"  fill="#4A90E8"/>
        <circle cx="97"  cy="37" r="3"  fill="#A0CCFF" opacity=".7"/>
        <path d="M 124 40 A 24 9 0 0 1 76 40" fill="none" stroke="#5B8ED4" stroke-width="1" opacity=".45" transform="rotate(-35 100 40)"/>
      </g>
      <!-- Stars: far left -->
      <circle cx="22"  cy="18"  r="1.2" fill="#7AABFF" opacity=".55"/>
      <circle cx="45"  cy="72"  r="1.0" fill="#9ABFFF" opacity=".5"/>
      <circle cx="68"  cy="38"  r="1.1" fill="#7AABFF" opacity=".6"/>
      <circle cx="30"  cy="110" r="0.9" fill="#9ABFFF" opacity=".4"/>
      <circle cx="88"  cy="94"  r="1.0" fill="#7AABFF" opacity=".45"/>
      <circle cx="15"  cy="52"  r="0.8" fill="#9ABFFF" opacity=".4"/>
      <circle cx="110" cy="20"  r="1.1" fill="#7AABFF" opacity=".55"/>
      <circle cx="55"  cy="125" r="1.0" fill="#9ABFFF" opacity=".35"/>
      <!-- Stars: left-center -->
      <circle cx="155" cy="14"  r="1.0" fill="#7AABFF" opacity=".5"/>
      <circle cx="190" cy="58"  r="1.1" fill="#9ABFFF" opacity=".5"/>
      <circle cx="220" cy="100" r="0.9" fill="#7AABFF" opacity=".45"/>
      <circle cx="175" cy="118" r="1.0" fill="#9ABFFF" opacity=".4"/>
      <circle cx="245" cy="32"  r="1.2" fill="#7AABFF" opacity=".6"/>
      <circle cx="135" cy="82"  r="0.9" fill="#9ABFFF" opacity=".45"/>
      <!-- Stars: right-center -->
      <circle cx="555" cy="16"  r="1.0" fill="#7AABFF" opacity=".5"/>
      <circle cx="610" cy="58"  r="1.1" fill="#9ABFFF" opacity=".5"/>
      <circle cx="580" cy="105" r="0.9" fill="#7AABFF" opacity=".45"/>
      <circle cx="625" cy="122" r="1.0" fill="#9ABFFF" opacity=".4"/>
      <circle cx="660" cy="34"  r="1.2" fill="#7AABFF" opacity=".6"/>
      <circle cx="640" cy="86"  r="0.9" fill="#9ABFFF" opacity=".45"/>
      <!-- Stars: far right -->
      <circle cx="778" cy="20"  r="1.2" fill="#7AABFF" opacity=".65"/>
      <circle cx="755" cy="74"  r="1.0" fill="#9ABFFF" opacity=".5"/>
      <circle cx="732" cy="36"  r="1.1" fill="#7AABFF" opacity=".6"/>
      <circle cx="770" cy="108" r="0.9" fill="#9ABFFF" opacity=".45"/>
      <circle cx="712" cy="94"  r="1.0" fill="#7AABFF" opacity=".5"/>
      <circle cx="785" cy="55"  r="0.8" fill="#9ABFFF" opacity=".4"/>
      <circle cx="690" cy="18"  r="1.1" fill="#7AABFF" opacity=".55"/>
      <circle cx="745" cy="127" r="1.0" fill="#9ABFFF" opacity=".35"/>
    </svg>
  </div>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={url("/")} data-astro-prefetch="hover">Home</a>
    <span class="breadcrumb-sep">›</span>
    <span>Spheres of Power</span>
  </nav>

  <h1 class="page-title power">Spheres of Power</h1>
  <p>Spheres of Power is a unique magic system created by Drop Dead Studios for use with the Pathfinder Roleplaying Game. In this variant system, players choose their magical abilities from among twenty different spheres, spending Magic Talents to create a uniquely customized character. Spheres of Power is more about what you can do than what you can't — it gives you the tools you need to create a character, then lets you decide how to flavor it.</p>


  <!-- <div class="section-heading">
    <span class="section-heading-text">Getting Started</span>
    <div class="section-heading-rule"></div>
  </div> -->
  <hr class="page-title-rule" />
  <div class="gs-grid">
    <a href={url("/power/using-spheres-of-power/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 3h5a1 1 0 0 1 1 1v9H2V3zM14 3H9a1 1 0 0 0-1 1v9h6V3z"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">Using Spheres of Power</div>
        <div class="gs-card-desc">Fundamental rules for casting, spell points, and caster levels.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
    <a href={url("/power/how-to-build-spherecaster/")} class="gs-card" data-astro-prefetch="hover">
      <div class="gs-card-icon">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 3.5v9a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1zM4 6.5h8M4 9.5h5"/>
        </svg>
      </div>
      <div class="gs-card-body">
        <div class="gs-card-title">How to Build a Spherecaster</div>
        <div class="gs-card-desc">A step-by-step guide to creating your first magical character.</div>
      </div>
      <span class="gs-card-arrow" aria-hidden="true">→</span>
    </a>
  </div>
  <hr class="page-title-rule" />

  <div class="section-heading">
    <span class="section-heading-text">Magic Spheres</span>
    <div class="section-heading-rule"></div>
  </div>
  <div class="entry-grid sphere-badge-grid">
    {spheres.map(s => (
      <a href={url(`/power/${s.id}/`)} class="sphere-badge power" data-astro-prefetch="hover">
        <div class="sphere-badge-icon">
          <svg class="si" aria-hidden="true"><use href={`#si-${s.icon}`} /></svg>
        </div>
        <span class="sphere-badge-name">{s.name}</span>
      </a>
    ))}
  </div>

  <div class="entry-grid sphere-badge-grid other-badge-grid">
    <a href={url("/power/bear/")} class="sphere-badge power" data-astro-prefetch="hover">
      <div class="sphere-badge-icon">
        <svg class="si" aria-hidden="true"><use href="#si-bear" /></svg>
      </div>
      <span class="sphere-badge-name">Bear</span>
    </a>
    <a href={url("/power/technomancy/")} class="sphere-badge power" data-astro-prefetch="hover">
      <div class="sphere-badge-icon">
        <svg class="si" aria-hidden="true"><use href="#si-technomancy" /></svg>
      </div>
      <span class="sphere-badge-name">Technomancy</span>
    </a>
  </div>

  <div class="section-heading">
    <span class="section-heading-text">Spherecaster Classes</span>
    <div class="section-heading-rule"></div>
  </div>

  <div class="classes-and-links">
    <div class="class-lists">
      {classTiers.map(tier => {
        const tierClasses = tier.ids.map(id => classById.get(id)).filter(Boolean);
        return tierClasses.length > 0 && (
          <div class="class-tier-group">
            <div class="class-tier-label">{tier.label}</div>
            <div class="class-roster">
              {tierClasses.map(c => (
                <a href={url(`/power/classes/${c!.id}/`)} class="class-item" data-astro-prefetch="hover">
                  <div class="class-item-header">
                    <span class="class-item-name">{c!.name}</span>
                    <span class="class-item-arrow" aria-hidden="true">→</span>
                  </div>
                  {classDescs[c!.id] && <p class="class-item-desc">{classDescs[c!.id]}</p>}
                </a>
              ))}
            </div>
          </div>
        );
      })}

      {prestigeClasses.length > 0 && (
        <>
          <div class="section-heading prestige-heading">
            <span class="section-heading-text">Prestige Classes</span>
            <div class="section-heading-rule"></div>
          </div>
          <div class="class-roster">
            {prestigeClasses.map(c => (
              <a href={url(`/power/classes/${c.id}/`)} class="class-item" data-astro-prefetch="hover">
                <div class="class-item-header">
                  <span class="class-item-name">{c.name}</span>
                  <span class="class-item-arrow" aria-hidden="true">→</span>
                </div>
                {classDescs[c.id] && <p class="class-item-desc">{classDescs[c.id]}</p>}
              </a>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="quick-links-grid">
      <div class="quick-links-group">
        <h3 class="quick-links-heading">Feats</h3>
        <ul class="quick-links-list">
          <li><a href={url("/power/feats/")}>General Feats</a></li>
          <li><a href={url("/power/feats/casting-feats/")}>Casting Feats</a></li>
          <li><a href={url("/power/feats/dual-sphere-feats/")}>Dual Sphere Feats</a></li>
        </ul>
      </div>
      <div class="quick-links-group">
        <h3 class="quick-links-heading">Equipment</h3>
        <ul class="quick-links-list">
          <li><a href={url("/power/equipment/")}>Magical Items</a></li>
          <li><a href={url("/power/equipment/staves/")}>Staves</a></li>
          <li><a href={url("/power/equipment/weapons/")}>Weapons &amp; Armor</a></li>
        </ul>
      </div>
      <div class="quick-links-group">
        <h3 class="quick-links-heading">Rules</h3>
        <ul class="quick-links-list">
          <li><a href={url("/power/casting-traditions/")}>Casting Traditions</a></li>
          <li><a href={url("/power/oaths/")}>Oaths</a></li>
          <li><a href={url("/power/wild-magic/")}>Wild Magic</a></li>
        </ul>
      </div>
    </div>
  </div>

</WikiPage>

<style>
  /* ── Banner ──────────────────────────────────────────── */
  .power-banner {
    margin: calc(-1 * var(--sp-4)) calc(-1 * var(--sp-5)) 20px;
    border-radius: 0 var(--radius) 0 0;
    overflow: hidden;
    position: relative;
  }

  .power-banner::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 12px;
    background: linear-gradient(to bottom, transparent, var(--clr-surface));
    pointer-events: none;
  }

  .power-banner svg {
    display: block;
    width: 100%;
    height: 200px;
  }

  /* ── Page header ─────────────────────────────────────── */
  .page-title-rule {
    width: 100%;
  }

  .page-subtitle {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    font-style: italic;
    color: var(--clr-muted);
    margin-bottom: 20px;
    line-height: 1.55;
  }

  /* ── Getting Started links ───────────────────────────── */
  .gs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }

  .gs-card {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    padding: 3px 0;
    text-decoration: none;
    color: var(--clr-text);
    transition: color 0.12s ease;
  }

  .gs-card::before {
    content: '›';
    font-size: 1.1em;
    color: var(--clr-muted);
    opacity: 0.55;
    flex-shrink: 0;
    line-height: 1.4;
    transition: color 0.12s ease, opacity 0.12s ease, transform 0.15s ease;
  }

  .gs-card:hover {
    color: var(--clr-power);
    text-decoration: none;
  }

  .gs-card:hover::before {
    color: var(--clr-power);
    opacity: 1;
    transform: translateX(3px);
  }

  .gs-card:hover .gs-card-title {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--clr-power) 35%, transparent);
    text-underline-offset: 3px;
  }

  .gs-card-icon {
    display: none;
  }

  .gs-card-body {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .gs-card-title {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--clr-power);
    line-height: 1.4;
  }

  .gs-card-desc {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    font-style: italic;
    line-height: 1.35;
  }

  .gs-card-arrow {
    display: none;
  }

  /* ── Sphere badge grid ───────────────────────────────── */
  .sphere-badge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 0;
    border-top: 1px solid var(--clr-border);
    border-left: 1px solid var(--clr-border);
    margin-bottom: 0;
    background: var(--clr-bg);
  }

  .other-badge-grid {
    margin-top: 6px;
    margin-bottom: 24px;
  }

  .sphere-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px 2px;
    border-right: 1px solid var(--clr-border);
    border-bottom: 1px solid var(--clr-border);
    text-decoration: none;
    transition: all 0.2s ease;
    aspect-ratio: 1 / 1.1;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .sphere-badge:hover {
    z-index: 2;
    background: var(--clr-surface);
    box-shadow: inset 0 0 0 2px var(--clr-power);
    transform: scale(1.02);
  }

  .sphere-badge-icon {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 2px;
    color: var(--clr-power);
    transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    flex-shrink: 0;
  }

  .sphere-badge:hover .sphere-badge-icon {
    transform: scale(1.05);
  }

  .si {
    width: 74px;
    height: 74px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.15));
  }

  .sphere-badge-name {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    color: var(--clr-power);
    line-height: 1;
    letter-spacing: 0.01em;
    width: 100%;
    padding: 0 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 0;
  }

  @media (min-width: 1280px) {
    .sphere-badge-grid {
      grid-template-columns: repeat(12, 1fr);
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .sphere-badge-grid {
      grid-template-columns: repeat(10, 1fr);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .sphere-badge-grid {
      grid-template-columns: repeat(8, 1fr);
    }
  }

  /* ── Classes + links layout ─────────────────────────── */
  .classes-and-links {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 32px;
    align-items: start;
    margin-bottom: 48px;
  }

  .class-lists {
    min-width: 0;
  }

  .prestige-heading {
    margin-top: 24px;
  }

  /* ── Class tier groups ───────────────────────────────── */
  .class-tier-group + .class-tier-group {
    margin-top: 18px;
  }

  .class-tier-label {
    font-family: var(--font-display);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clr-muted);
    opacity: 0.75;
    padding-bottom: 5px;
  }

  /* ── Class roster (editorial list) ──────────────────── */
  .class-roster {
    display: flex;
    flex-direction: column;
  }

  .class-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 7px 0;
    border-bottom: 0.5px solid var(--clr-border);
    text-decoration: none;
    color: var(--clr-text);
    transition: color 0.12s ease;
  }

  .class-item:first-child {
    border-top: 0.5px solid var(--clr-border);
  }

  .class-item-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .class-item-name {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--clr-power);
    letter-spacing: 0.02em;
    line-height: 1.2;
    transition: text-decoration-color 0.12s ease;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
  }

  .class-item-arrow {
    font-family: var(--font-body);
    font-size: var(--fs-md);
    color: var(--clr-muted);
    opacity: 0;
    flex-shrink: 0;
    transition: opacity 0.12s ease, transform 0.12s ease;
  }

  .class-item-desc {
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    color: var(--clr-muted);
    font-style: italic;
    line-height: 1.4;
    margin: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .class-item:hover .class-item-name {
      text-decoration-color: color-mix(in srgb, var(--clr-power) 35%, transparent);
    }

    .class-item:hover .class-item-arrow {
      opacity: 0.6;
      transform: translateX(3px);
    }
  }

  /* ── Quick links (vertical sidebar) ─────────────────── */
  .quick-links-grid {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--clr-border);
    border-radius: 6px;
    overflow: hidden;
    background: color-mix(in srgb, var(--clr-power) 4%, var(--clr-surface));
    position: sticky;
    top: 16px;
  }

  .quick-links-group {
    padding: 16px 16px 14px;
    border-bottom: 1px solid var(--clr-border);
  }

  .quick-links-group:last-child {
    border-bottom: none;
  }

  .quick-links-heading {
    font-family: var(--font-display);
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--clr-power);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--clr-border);
  }

  .quick-links-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .quick-links-list a {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 6px;
    font-family: var(--font-body);
    font-size: var(--fs-md);
