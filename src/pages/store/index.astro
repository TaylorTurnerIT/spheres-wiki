---
import WikiPage from '@/layouts/WikiPage.astro';
import BookCard from '@/components/BookCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StoreCarousel from '@/components/StoreCarousel.astro';
import { resolveEntries } from '@/lib/resolveEntries';
import {
  CORE_BOOK_SLUGS,
  bookPublisher,
  isVisibleThirdParty,
  isOfficialPublisher,
  byNewestFirst,
  latestBook,
  groupByPublisher,
} from '@/lib/bookCuration';
import type { BookMeta } from '@/lib/types';
const { bookMetaMap } = await resolveEntries();
const allBooks = [...bookMetaMap.values()];

// Featured Core Books (with "Coming Soon" placeholders for missing)
type FeaturedBook = BookMeta & { isComingSoon?: boolean };
const featuredCoreBooks: FeaturedBook[] = CORE_BOOK_SLUGS.map(slug => {
  const existing = allBooks.find(b => b.slug === slug);
  if (existing) return existing;
  return {
    title: slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    publisher: 'Drop Dead Studios',
    slug,
    publishedDate: '1970-01-01',
    isComingSoon: true
  };
});

// Groupings by publisher (newest-first within group, groups by size)
const sortedTPGroups = groupByPublisher(allBooks.filter(isVisibleThirdParty));
const ddsBooks = allBooks.filter(b => bookPublisher(b) === 'Drop Dead Studios').sort(byNewestFirst);
const diamondBooks = allBooks.filter(b => bookPublisher(b) === 'Diamond Recreational Studios').sort(byNewestFirst);

// Latest arrivals
const latestFirstParty = latestBook(allBooks, isOfficialPublisher);
const latestThirdParty = allBooks.filter(isVisibleThirdParty).sort(byNewestFirst)[0];
---
<WikiPage title="Store — Spheres Wiki">

  <h1 class="page-title">Store</h1>
  <hr class="page-title-rule" />

  <div class="store-top-row">
    {/* New Arrivals */}
    <div class="store-top-col">
      {(latestFirstParty || latestThirdParty) && (
        <SectionHeading label="New Arrivals" size="md" style="margin-top: 10px;" />
      )}
      <div style="display: flex; gap: 14px; padding: 12px 8px 16px 0; margin-top: -12px;">
        {latestFirstParty && (
          <div class="new-arrival-item">
            <BookCard book={latestFirstParty} />
            <div class="arrival-badge official">Official</div>
          </div>
        )}
        {latestThirdParty && (
          <div class="new-arrival-item">
            <BookCard book={latestThirdParty} />
            <div class="arrival-badge third-party">Third-Party</div>
          </div>
        )}
      </div>
    </div>

    {/* Featured Releases */}
    <div class="store-top-col">
      <SectionHeading label="Featured Core Releases" size="md" style="margin-top: 10px;" />
      
      <StoreCarousel>
        {featuredCoreBooks.map(book => (
          <BookCard book={book} comingSoon={!!book.isComingSoon} />
        ))}
      </StoreCarousel>
    </div>
  </div>

  {/* Official Section */}
  <SectionHeading label="Official Publishers" size="md" style="margin-top: 20px;" />

  <div style="margin-top: 15px;">
    <SectionHeading label="Drop Dead Studios" />
    {ddsBooks.length > 0 ? (
      <StoreCarousel>
        {ddsBooks.map(book => <BookCard book={book} />)}
      </StoreCarousel>
    ) : <p class="store-empty">No DDS books available yet.</p>}
  </div>

  <div style="margin-top: 15px;">
    <SectionHeading label="Diamond Recreational Studios" />
    {diamondBooks.length > 0 ? (
      <StoreCarousel>
        {diamondBooks.map(book => <BookCard book={book} />)}
      </StoreCarousel>
    ) : <p class="store-empty">No DRS books available yet.</p>}
  </div>

  {/* Third Party Section */}
  {sortedTPGroups.length > 0 && (
    <>
      <SectionHeading label="Third Party Content" size="md" style="margin-top: 20px;" />

      {sortedTPGroups.map(group => (
        <div style="margin-top: 15px;">
          <SectionHeading label={group.name} />
          <StoreCarousel>
            {group.books.map(book => <BookCard book={book} />)}
          </StoreCarousel>
        </div>
      ))}
    </>
  )}

</WikiPage>

<style>
  .store-top-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 30px;
    align-items: start;
    margin-bottom: 25px;
  }
  @media (max-width: 1024px) {
    .store-top-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .new-arrival-item {
    flex: 0 0 180px;
    max-width: 180px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .arrival-badge {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
    padding: 3px 0;
    border-radius: 3px;
  }
  .arrival-badge.official {
    background: var(--clr-brand);
    color: #fff;
  }
  .arrival-badge.third-party {
    background: var(--clr-surface);
    color: var(--clr-text);
    border: 0.5px solid var(--clr-border);
  }

  .store-empty {
    font-size: var(--fs-xs);
    color: var(--clr-muted);
    font-style: italic;
    margin: 10px 0 30px;
  }
</style>
