---
import WikiPage from '@/layouts/WikiPage.astro';
import BookCard from '@/components/BookCard.astro';
import { resolveEntries } from '@/lib/resolveEntries';

const { bookMetaMap } = await resolveEntries();
const books = [...bookMetaMap.values()].sort(
  (a, b) => new Date(a.publishedDate).getTime() - new Date(b.publishedDate).getTime()
);
---
<WikiPage title="Store — Spheres Wiki">

  <div class="page-title">Store</div>
  <hr class="page-title-rule" />

  <div class="section-heading">
    <span class="section-heading-text">Official Books</span>
    <div class="section-heading-rule"></div>
  </div>

  {books.length === 0 ? (
    <p style="font-size: 14px; color: var(--clr-muted);">No books available yet.</p>
  ) : (
    <div class="store-grid">
      {books.map(book => <BookCard book={book} />)}
    </div>
  )}

</WikiPage>
