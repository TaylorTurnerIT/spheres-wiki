---
import WikiPage from '@/layouts/WikiPage.astro';
import BookCard from '@/components/BookCard.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StoreCarousel from '@/components/StoreCarousel.astro';
import { resolveEntries } from '@/lib/resolveEntries';

const { bookMetaMap } = await resolveEntries();
const allBooks = [...bookMetaMap.values()];

// Core Slugs
const CORE_SLUGS = [
  'ultimate-spheres-of-power',
  'spheres-of-might',
  'spheres-of-guile',
  'champions-of-the-spheres'
];

const OFFICIAL_PUBLISHERS = new Set(['Drop Dead Studios', 'Diamond Recreational Studios']);
const getPublisher = (book: any) =>
  typeof book.publisher === 'string' && book.publisher.trim() !== ''
    ? book.publisher
    : 'Unknown';
const isVisibleThirdParty = (book: any) => {
  const publisher = getPublisher(book);
  return !OFFICIAL_PUBLISHERS.has(publisher) && publisher !== 'Unknown' && !publisher.startsWith('__');
};

// Helper to sort by date descending
const sortByDate = (a: any, b: any) => new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime();

// Featured Core Books (with placeholders for missing)
const featuredCoreBooks = CORE_SLUGS.map(slug => {
  const existing = allBooks.find(b => b.slug === slug);
  if (existing) return existing;
  // Placeholder
  return {
    title: slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    publisher: 'Drop Dead Studios',
    slug,
    isComingSoon: true
  };
});

// Groupings (Core system content now in respective publishers, so we just filter by publisher)
const diamondBooks = allBooks.filter(b => getPublisher(b) === 'Diamond Recreational Studios').sort(sortByDate);
const ddsBooks = allBooks.filter(b => getPublisher(b) === 'Drop Dead Studios').sort(sortByDate);

// Latest arrivals
const latestFirstParty = allBooks.filter(b => OFFICIAL_PUBLISHERS.has(getPublisher(b))).sort(sortByDate)[0];
const latestThirdParty = allBooks.filter(isVisibleThirdParty).sort(sortByDate)[0];

const thirdPartyGroups = allBooks
  .filter(isVisibleThirdParty)
  .reduce((acc, book) => {
    const publisher = getPublisher(book);
    if (!acc[publisher]) acc[publisher] = [];
    acc[publisher].push(book);
    return acc;
  }, {} as Record<string, typeof allBooks>);

// Sort each TP group by date and sort groups by book count descending
const sortedTPGroups = Object.entries(thirdPartyGroups)
  .map(([name, group]) => ({ name, books: group.sort(sortByDate) }))
  .sort((a, b) => b.books.length - a.books.length);
---
<WikiPage title="Store — Spheres Wiki">

  <h1 class="page-title">Store</h1>
  <hr class="page-title-rule" />

  <div class="store-top-row">
    {/* New Arrivals */}
    <div class="store-top-col">
      {(latestFirstParty || latestThirdParty) && (
        <SectionHeading label="New Arrivals" size="md" style="margin-top: 10px;" />
      )}
      <div style="display: flex; gap: 14px; padding: 12px 8px 16px 0; margin-top: -12px;">
        {latestFirstParty && (
          <div class="new-arrival-item">
            <BookCard book={latestFirstParty} />
            <div class="arrival-badge official">Official</div>
          </div>
        )}
        {latestThirdParty && (
          <div class="new-arrival-item">
            <BookCard book={latestThirdParty} />
            <div class="arrival-badge third-party">Third-Party</div>
          </div>
        )}
      </div>
    </div>

    {/* Featured Releases */}
    <div class="store-top-col">
      <SectionHeading label="Featured Core Releases" size="md" style="margin-top: 10px;" />
      
      <StoreCarousel>
        {featuredCoreBooks.map(book => (
          ('isComingSoon' in book && book.isComingSoon) ? (
             <div class="store-card coming-soon-card">
               <div class="store-card-cover-placeholder">
                 <span>Coming Soon</span>
               </div>
               <div class="store-title">{book.title}</div>
               <div class="store-publisher">{book.publisher}</div>
             </div>
          ) : (
            <BookCard book={book as any} />
          )
        ))}
      </StoreCarousel>
    </div>
  </div>

  {/* Official Section */}
  <SectionHeading label="Official Publishers" size="md" style="margin-top: 20px;" />

  <div style="margin-top: 15px;">
    <SectionHeading label="Drop Dead Studios" />
    {ddsBooks.length > 0 ? (
      <StoreCarousel>
        {ddsBooks.map(book => <BookCard book={book} />)}
      </StoreCarousel>
    ) : <p class="store-empty">No DDS books available yet.</p>}
  </div>

  <div style="margin-top: 15px;">
    <SectionHeading label="Diamond Recreational Studios" />
    {diamondBooks.length > 0 ? (
      <StoreCarousel>
        {diamondBooks.map(book => <BookCard book={book} />)}
      </StoreCarousel>
    ) : <p class="store-empty">No DRS books available yet.</p>}
  </div>

  {/* Third Party Section */}
  {sortedTPGroups.length > 0 && (
    <>
      <SectionHeading label="Third Party Content" size="md" style="margin-top: 20px;" />

      {sortedTPGroups.map(group => (
        <div style="margin-top: 15px;">
          <SectionHeading label={group.name} />
          <StoreCarousel>
            {group.books.map(book => <BookCard book={book} />)}
          </StoreCarousel>
        </div>
      ))}
    </>
  )}

</WikiPage>

<style>
  .store-top-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 30px;
    align-items: start;
    margin-bottom: 25px;
  }
  @media (max-width: 1024px) {
    .store-top-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .new-arrival-item {
    flex: 0 0 180px;
    max-width: 180px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .arrival-badge {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
    padding: 3px 0;
    border-radius: 3px;
  }
  .arrival-badge.official {
    background: var(--clr-brand);
    color: #fff;
  }
  .arrival-badge.third-party {
    background: var(--clr-surface);
    color: var(--clr-text);
    border: 0.5px solid var(--clr-border);
  }

  .coming-soon-card {
    opacity: 0.6;
    cursor: default;
    box-shadow: none !important;
    transform: none !important;
  }
  .coming-soon-card .store-card-cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-muted);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .store-empty {
    font-size: var(--fs-xs);
    color: var(--clr-muted);
    font-style: italic;
    margin: 10px 0 30px;
  }
</style>
