{
  "name": "spheres-wiki",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "postinstall": "bun scripts/patch-fontsource.mjs",
    "build": "bun run test && bun run lint && bun run validate && bun run check-cross && bun run check-identity && bun scripts/check-idioms.mjs && bun scripts/check-base-abilities.mjs && bun run fallow-audit && astro check && astro build && pagefind --site dist && bun run check-routes && bun scripts/check-links.mjs && bun scripts/check-toc.mjs && bun run check-performance",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "format": "biome format --write .",
    "lint": "biome check .",
    "validate": "bun scripts/validate.mjs && bun scripts/check-feat-category-tags.mjs && bun scripts/check-feat-category-membership.mjs",
    "repair-feat-categories": "node scripts/repair-feat-category-membership.mjs --write",
    "fallow": "fallow",
    "fallow-audit": "fallow audit --max-crap 30 --fail-on-issues --explain --gate all",
    "check-base": "bun scripts/check-base-abilities.mjs",
    "check-cross": "bun scripts/check-cross-sphere.mjs",
    "check-routes": "bun scripts/check-content-routes.mjs",
    "check-identity": "bun scripts/check-identity-collisions.mjs",
    "check-identity-report": "bun scripts/check-identity-collisions.mjs --write",
    "check-performance": "bun scripts/check-performance.mjs",
    "check-toc": "bun scripts/check-toc.mjs",
    "audit": "bun scripts/validate.mjs && bun scripts/check-base-abilities.mjs && bun scripts/check-cross-sphere.mjs"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "^0.4.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "astro": "^7.2.4",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tom-select": "^2.6.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/sitemap": "^3.7.3",
    "@biomejs/biome": "^2.5.10",
    "@lhci/cli": "^0.15.1",
    "fallow": "^3.17.0",
    "happy-dom": "^20.11.12",
    "lightningcss": "^1.33.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
