{
  "name": "spheres-wiki",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "postinstall": "node scripts/patch-fontsource.mjs",
    "build": "node scripts/validate.mjs && node scripts/check-base-abilities.mjs && npm run fallow-audit && astro build && pagefind --site dist && node scripts/check-toc.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:docker": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from playwright",
    "test:e2e:docker:full": "docker build -f Dockerfile.e2e -t spheres-wiki-e2e . && docker run --rm spheres-wiki-e2e",
    "test:all": "vitest run && playwright test",
    "validate": "node scripts/validate.mjs",
    "fallow": "fallow",
    "fallow-audit": "fallow audit --max-crap 30 --fail-on-issues --explain",
    "check-base": "node scripts/check-base-abilities.mjs",
    "check-cross": "node scripts/check-cross-sphere.mjs",
    "check-toc": "node scripts/check-toc.mjs",
    "audit": "node scripts/validate.mjs && node scripts/check-base-abilities.mjs && node scripts/check-cross-sphere.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/crimson-text": "^5.2.7",
    "astro": "^6.3.3",
    "rehype-raw": "^7.0.0",
    "tom-select": "^2.6.1",
    "uipro-cli": "^2.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "fallow": "^2.97.0",
    "pagefind": "^1.5.2",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
