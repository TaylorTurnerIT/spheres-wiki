{
  "name": "spheres-wiki",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/validate.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:docker": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from playwright",
    "test:e2e:docker:full": "docker build -f Dockerfile.e2e -t spheres-wiki-e2e . && docker run --rm spheres-wiki-e2e",
    "test:all": "vitest run && playwright test",
    "validate": "node scripts/validate.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/crimson-text": "^5.2.7",
    "accessibility": "^6.1.0",
    "astro": "^6.3.3",
    "rehype-raw": "^7.0.0",
    "tom-select": "^2.6.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.60.0",
    "pagefind": "^1.5.2",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
